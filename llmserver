    if not name: return []
    found = {}
    for qs in ('author=%s&sort=downloads&limit=500' % q(owner), 'search=%s&sort=downloads&limit=100' % q(re.split(r'[-_.]', name)[0][:12])):
        try: rows = getj('%s/api/models?%s' % (HF, qs))
        except (urllib.error.HTTPError, Offline, ValueError): continue
        for r in rows if isinstance(rows, list) else []:
            i = r.get('id') or r.get('modelId')
            if i and '/' in i: found.setdefault(i.lower(), i)
    near = difflib.get_close_matches(repo.lower(), list(found), n=n, cutoff=0.75)
    return [found[k] for k in near]

def plan_hub(engine, repo, ref, quant, user_rc):
    P = new_plan(engine, repo, ref, quant)
    try:
        info = getj('%s/api/models/%s/revision/%s' % (HF, repo, q(ref)))
    except urllib.error.HTTPError as e:
        # the Hub shows a gated model's details to anyone; 401/404 here means no such repository
        # (or a private one this account cannot see), so check the name before asking for a login
        if e.code == 403 or (e.headers.get('X-Error-Code') or '') == 'GatedRepo':
            finding(P, 'M-ACCESS', 'Hugging Face refused access to %s (HTTP %d): it is gated or private. Accept its terms on the Hub and log in (llmserver hf auth login), or set HF_TOKEN' % (repo, e.code))
        else:
            near = similar_repos(repo)
            msg = '%s%s was not found on Hugging Face. Check the spelling' % (repo, '' if ref == 'main' else ' (revision %s)' % ref)
            msg += ('; did you mean %s?' % (near[0] if len(near) == 1 else ', '.join(near[:-1]) + ' or ' + near[-1])) if near else '.'
            msg += ' If it is a private repository, %s.' % ('your token cannot see it' if TOK else "log in first: 'llmserver hf auth login' (or set HF_TOKEN)")
            finding(P, 'M-NOT-FOUND', msg)
        return P
    except Offline as e:
        return plan_local(engine, repo, ref, quant, user_rc, 'Hugging Face could not be reached (%s)' % e)
    P['commit'] = info.get('sha')
    card = info.get('cardData') or {}
    lic = card.get('license') or next((t[8:] for t in info.get('tags') or [] if t.startswith('license:')), None)
    P['license'] = lic; P['gated'] = info.get('gated') or False
    if not lic: finding(P, 'M-NO-LICENSE', 'the model card states no license')
    if P['gated']: finding(P, 'M-GATED', 'a gated model: its terms were accepted on the Hub')
    try:
        tree = hub_tree(repo, P['commit'])
    except Offline as e:
        return plan_local(engine, repo, P['commit'], quant, user_rc, 'Hugging Face could not be reached (%s)' % e)
    for e in tree:
        if e.get('type') != 'file': continue
        if e['path'].startswith('/') or '..' in e['path'].split('/') or '\\' in e['path']:
            finding(P, 'M-FORMAT', 'the repository lists a file path that leaves the model folder', e['path']); continue
        lfs = e.get('lfs') or {}
        P['files'].append({'path': e['path'], 'size': int(e.get('size') or 0), 'sha256': lfs.get('oid'),
                           'git_oid': e.get('oid'), 'class': classify(e['path']), 'scan': e.get('securityFileStatus')})
    P['remote_code_approved'] = previous_rc_approval(P)
    select(P, info, user_rc)
    return P

def plan_local(engine, repo, ref, quant, user_rc, why):
    """No Hub: inventory from the local cache at the cached commit, hashed here."""
    P = new_plan(engine, repo, ref, quant); P['source'] = 'local'
    d = hub_repo_dir(repo); commit = ref
    rf = os.path.join(d, 'refs', ref)
    if os.path.isfile(rf): commit = open(rf).read().strip()
    snap = os.path.join(d, 'snapshots', commit)
    if not os.path.isdir(snap):
        cands = sorted((os.path.join(d, 'snapshots', c) for c in os.listdir(os.path.join(d, 'snapshots'))), key=os.path.getmtime) \
            if os.path.isdir(os.path.join(d, 'snapshots')) else []
        if not cands:
            finding(P, 'M-HUB-OFFLINE', why + ', and %s is not downloaded yet. Connect to the network (or set HF_ENDPOINT to a mirror) and try again' % repo)
            P['findings'][-1]['severity'] = 'block'; P['findings'][-1]['override'] = 'no'
            return P
        snap = cands[-1]; commit = os.path.basename(snap)
    P['commit'] = commit
    finding(P, 'M-HUB-OFFLINE', why + '; using the cached files of commit %s, which have no scan results' % commit[:12])
    for root, _, fs in os.walk(snap):
        for n in fs:
            full = os.path.join(root, n); rel = os.path.relpath(full, snap)
            try: size = os.path.getsize(full)
            except OSError: continue
            P['files'].append({'path': rel, 'size': size, 'sha256': None, 'git_oid': None, 'class': classify(rel), 'scan': None, 'local': True})
    P['remote_code_approved'] = previous_rc_approval(P)
    select(P, {}, user_rc, local=True)
    return P

def gguf_parts(path):
    """a GGUF and, for a split model, all of its parts (same folder)"""
    m = SPLIT.search(os.path.basename(path))
    if not m: return [path]
    d = os.path.dirname(path); stem = SPLIT.sub('', os.path.basename(path)); n = int(m.group(2))
    return [os.path.join(d, '%s-%05d-of-%05d.gguf' % (stem, i, n)) for i in range(1, n + 1)]

def plan_file(engine, path):
    """a GGUF on this computer: no Hugging Face scans, so the file itself is checked (header, SHA-256, local scanners)"""
    P = new_plan(engine, path, 'local', None); P['source'] = 'file'; P['commit'] = 'local'
    if engine != 'llama':
        finding(P, 'M-NOT-FOUND', 'a GGUF file on this computer is served by llama.cpp: use llama:%s' % path); return P
    parts = gguf_parts(path)
    missing = [x for x in parts if not os.path.isfile(x)]
    if missing:
        finding(P, 'M-NOT-FOUND', '%s does not exist (or is not a file)' % missing[0]); return P
    d = os.path.dirname(path); stem = SPLIT.sub('', os.path.basename(path))[:-5].lower()
    mm = sorted(x for x in os.listdir(d) if x.lower().endswith('.gguf') and 'mmproj' in x.lower())
    if len(mm) > 1:   # several projectors: the one named after the model
        mm = [x for x in mm if any(w and w in x.lower() for w in (stem, stem.rsplit('-', 1)[0]))][:1] or []
    files = parts + [os.path.join(d, mm[0])] if mm else parts
    for x in files:
        st = os.stat(x)
        P['files'].append({'path': x, 'size': st.st_size, 'mtime': int(st.st_mtime), 'sha256': None, 'git_oid': None,
                           'class': 'weights-gguf', 'scan': None, 'local': True})
    P['main'] = parts[0]
    if mm: P['mmproj'] = files[-1]
    P['selected'] = sorted(files); P['skipped'] = []
    finding(P, 'M-LOCAL-FILE', 'a file on this computer, not from Hugging Face, so there are no scan results; llmserver checks that it is a GGUF, records its SHA-256 and runs the local scanners')
    return P

def select(P, info, user_rc, local=False):
    eng = P['engine']; files = P['files']
    sel = []
    if eng == 'vllm':
        top = [f for f in files if '/' not in f['path']]
        st = [f for f in top if f['class'] == 'weights-st']
        if any(f['path'].startswith('model') for f in st):
            st = [f for f in st if not f['path'].startswith('consolidated')]
        pk = [f for f in top if f['class'] == 'weights-pickle' and ('model' in f['path'] or f['path'].endswith(('.bin', '.pt', '.pth')))]
        P['weights_format'] = 'safetensors' if st else ('pickle' if pk else None)
        if st: sel += st
        elif pk:
            if os.environ.get('T_ALLOW_PICKLE') == '1' and LEVEL != 'strict':
                sel += pk
            else:
                finding(P, 'M-PICKLE-ONLY', 'this repository has only pickle weights (%s), which can run code when loaded' % ', '.join(f['path'] for f in pk[:3]))
                if os.environ.get('T_ALLOW_PICKLE') == '1' or 'M-PICKLE-ONLY' in os.environ.get('T_ACCEPT', '').split(): sel += pk
        else:
            gg = [f for f in files if f['class'] == 'weights-gguf' and 'mmproj' not in f['path'].lower()]
            if gg:
                qs = sorted({quant_of(f['path']) for f in gg if quant_of(f['path'])})
                finding(P, 'M-NO-WEIGHTS', 'this is a GGUF repository (%s), and vLLM needs safetensors weights. Serve it with llama.cpp instead: llmserver llama:%s%s' % (
                    ', '.join(f['path'] for f in gg[:3]) + (', ...' if len(gg) > 3 else ''), P['repo'], ':' + next((q for q in ('Q4_K_M', 'Q5_K_M', 'Q8_0') if q in qs), qs[0]) if qs else ''))
            else:
                finding(P, 'M-NO-WEIGHTS', 'no safetensors (or pickle) weights at the top level of the repository')
        sel += [f for f in top if f['class'] == 'text' and not f['path'].lower().endswith('.md') and f['size'] < 200 << 20]
        # remote code
        cfg = {}
        if not local and any(f['path'] == 'config.json' for f in top):
            try: cfg = json.loads(http('%s/%s/resolve/%s/config.json' % (HF, P['repo'], P['commit']))[0])
            except Exception: cfg = {}
        elif local:
            try: cfg = json.load(open(snap_path(P, 'config.json')))
            except Exception: cfg = {}
        amap = cfg.get('auto_map') or {}
        refs = sorted({v for v in (x if isinstance(x, list) else [x] for x in amap.values()) for v in v if isinstance(v, str)})
        xrepo = sorted({r.split('--')[0] for r in refs if '--' in r})
        code = [f for f in top if f['path'].endswith('.py')]
        if amap or user_rc:
            P['remote_code'] = True
            why = 'its config asks to load code from the repository (auto_map)' if amap else 'the engine flags include --trust-remote-code'
            finding(P, 'M-REMOTE-CODE', '%s: %s' % (why, ', '.join('%s (%d bytes)' % (f['path'], f['size']) for f in code) or 'no .py files at the top level'))
            if xrepo: finding(P, 'M-REMOTE-XREPO', 'the code comes from other repositories (%s), which llmserver does not fetch' % ', '.join(xrepo))
            if P.get('remote_code_approved') or os.environ.get('T_RC_OK') == '1': sel += code
        # expected size
        params = (info.get('safetensors') or {}).get('parameters') or {}
        if params and all(k in DTB for k in params):
            P['expected_weight_bytes'] = int(sum(n * DTB[k] for k, n in params.items()))
    elif eng in ('llama', 'ollama'):
        want = (P['quant'] or 'Q4_K_M').upper()
        if want == 'LATEST': want = 'Q4_K_M'
        gg = [f for f in files if f['class'] == 'weights-gguf' and 'mmproj' not in f['path'].lower()]
        match = [f for f in gg if quant_of(f['path']) == want]
        if not match: match = [f for f in gg if want in f['path'].upper().rsplit('/', 1)[-1]]
        groups = {}
        for f in match:
            key = (f['path'].rsplit('/', 1)[0] if '/' in f['path'] else '', SPLIT.sub('', f['path'].rsplit('/', 1)[-1]))
            groups.setdefault(key, []).append(f)
        if not groups:
            have = sorted({quant_of(f['path']) for f in gg if quant_of(f['path'])})
            finding(P, 'M-NOT-FOUND', 'no %s GGUF in %s%s' % (want, P['repo'], ('; it has ' + ', '.join(have)) if have else ''))
        else:
            rn = P['repo'].split('/')[-1].lower().replace('-gguf', '').replace('_gguf', '')
            key = sorted(groups, key=lambda k: (rn not in k[1].lower(), k[0].count('/'), len(k[0]), k[1]))[0]
            parts = sorted(groups[key], key=lambda f: f['path'])
            sel += parts; P['main'] = parts[0]['path']
            if eng == 'ollama' and len(parts) > 1:
                finding(P, 'M-NOT-FOUND', 'this quant is split into %d files, which Ollama cannot pull; serve it with llama.cpp' % len(parts))
            mm = [f for f in files if f['class'] == 'weights-gguf' and 'mmproj' in f['path'].lower()
                  and (f['path'].rsplit('/', 1)[0] if '/' in f['path'] else '') == key[0]]
            if mm and eng == 'llama':
                mm.sort(key=lambda f: (0 if 'f16' in f['path'].lower() else 1, f['path']))
                sel.append(mm[0]); P['mmproj'] = mm[0]['path']
            # a ceiling, not an estimate: small models and dynamic quants reach 11+ bits per weight,
            # but no quantization stores more than 16 bits per parameter (32 for F32)
            total = (info.get('gguf') or {}).get('total')
            # the Hub describes one GGUF per repository: when it holds several models (a fine-tune and its
            # base, a draft model), that count may belong to another file, so it is no ceiling for this one
            def stem(p):   # the model a file is for: its name without the quant, the split part and .gguf
                n = SPLIT.sub('.gguf', p.rsplit('/', 1)[-1]); n = n[:-5] if n.lower().endswith('.gguf') else n
                return re.sub(r'[-_.]+', '-', QRE.sub('', n)).strip('-').lower()
            stems = sorted({stem(f['path']) for f in gg}, key=len)
            one_model = all(x.startswith(stems[0]) for x in stems) if stems else True
            if total and one_model: P['expected_weight_bytes'] = int(total * (32.5 if want == 'F32' else 16.5) / 8)
    # facts about the files that are not downloaded
    names = {f['path'] for f in sel}
    risky = [f for f in files if f['class'] in RISKY and f['path'] not in names]
    if risky:
        finding(P, 'M-EXTRA-EXEC', 'the repository also holds %d code, script, archive or program file(s) that are not downloaded: %s'
                % (len(risky), ', '.join(f['path'] for f in risky[:6]) + (' ...' if len(risky) > 6 else '')))
    P['selected'] = sorted(names)
    P['skipped'] = [{'path': f['path'], 'class': f['class'], 'size': f['size']} for f in files if f['path'] not in names]
    if P['skipped']:
        finding(P, 'M-SKIPPED', '%d file(s) of the repository are not needed and not downloaded (%s)' % (
            len(P['skipped']), human(sum(f['size'] for f in P['skipped']))))
    for f in files:
        if f['path'] in names and not local: scan_rules(P, f)
    w = sum(f['size'] for f in files if f['path'] in names and f['class'].startswith('weights'))
    P['weight_bytes'] = w
    if P['expected_weight_bytes'] and w > P['expected_weight_bytes'] * (1.05 if eng != 'vllm' else 1.15):
        finding(P, 'M-SIZE', 'the weights are %s, more than the %s their parameter count explains' % (human(w), human(P['expected_weight_bytes'])))

def human(n):
    n = float(n or 0)
    for u in ('B', 'KB', 'MB', 'GB', 'TB'):
        if n < 1000 or u == 'TB': return ('%d %s' % (n, u)) if u in ('B', 'KB') else ('%.1f %s' % (n, u))
        n /= 1000

def plan_ollama_registry(name, tag):
    P = new_plan('ollama', None, tag, None, name=name + ':' + tag); P['source'] = 'registry'
    full = name if '/' in name else 'library/' + name
    try:
        body, _ = http('%s/v2/%s/manifests/%s' % (REG, full, q(tag)), accept='application/vnd.docker.distribution.manifest.v2+json')
    except urllib.error.HTTPError as e:
        finding(P, 'M-NOT-FOUND', '%s:%s is not in the Ollama registry (HTTP %d)' % (name, tag, e.code)); return P
    except Offline as e:
        finding(P, 'M-HUB-OFFLINE', 'the Ollama registry could not be reached (%s)' % e); return P
    m = json.loads(body)
    P['commit'] = hashlib.sha256(body).hexdigest()
    for l in m.get('layers', []) + ([m['config']] if m.get('config') else []):
        P['files'].append({'path': l.get('mediaType', 'layer'), 'size': int(l.get('size') or 0),
                           'sha256': str(l.get('digest', ''))[7:], 'class': 'weights-gguf' if str(l.get('mediaType', '')).endswith('.model') else 'text', 'scan': None})
    P['selected'] = [f['path'] for f in P['files']]
    finding(P, 'M-REGISTRY', 'the Ollama registry publishes no security scan results; its layers are checked by digest only')
    return P

def cmd_plan(engine, model, user_rc='0'):
    user_rc = user_rc == '1'
    ref_override = os.environ.get('T_REF')
    if engine == 'ollama':
        if model.startswith(('hf.co/', 'huggingface.co/')):
            rest = model.split('/', 1)[1]
            repo, _, quant = rest.partition(':')
            P = plan_hub('ollama', repo, ref_override or 'main', quant or None, False)
            P['name'] = model
        else:
            name, _, tag = model.partition(':')
            P = plan_ollama_registry(name, tag or 'latest')
    elif model.startswith('/'):
        P = plan_file(engine, model)
    else:
        base, _, rev = model.partition('@')
        quant = None
        if engine == 'llama':
            base, _, quant = base.partition(':'); quant = quant or None
        P = plan_hub(engine, base, ref_override or rev or 'main', quant, user_rc)
    if os.environ.get('T_ATTACHED') == '1' and engine == 'ollama':
        finding(P, 'M-ATTACHED', 'the attached Ollama daemon keeps its own store, which llmserver cannot read to check the pulled files')
    decide(P)
    save(P)
    emit(P)

def save(P):
    out = os.environ.get('T_OUT')
    if not out: return
    tmp = out + '.tmp'
    with open(tmp, 'w') as f: json.dump(P, f, indent=1, sort_keys=True)
    os.replace(tmp, out)

def emit(P):
    print('commit\t%s' % (P.get('commit') or ''))
    print('decision\t%s' % P.get('decision', 'pass'))
    print('source\t%s' % P.get('source'))
    print('remote\t%d' % (1 if P.get('remote_code') else 0))
    print('rcok\t%d' % (1 if (P.get('remote_code_approved') or os.environ.get('T_RC_OK') == '1') else 0))
    if P.get('main'): print('main\t%s' % P['main'])
    if P.get('mmproj'): print('mmproj\t%s' % P['mmproj'])
    print('wformat\t%s' % (P.get('weights_format') or ''))
    for f in P['selected']: print('select\t%s' % f)
    for f in P['findings']:
        sev = 'accepted' if f.get('accepted') else f['severity']
        print('finding\t%s\t%s\t%s\t%s\t%s' % (sev, f['id'], f['override'], f.get('file') or '-', f['message'].replace('\t', ' ').replace('\n', ' ')))

# ---- after the download -------------------------------------------------------------
def git_oid(path, size):
    h = hashlib.sha1(b'blob %d\0' % size)
    with open(path, 'rb') as f:
        for c in iter(lambda: f.read(1 << 22), b''): h.update(c)
    return h.hexdigest()

def sha256_file(path):
    h = hashlib.sha256()
    with open(path, 'rb') as f:
        for c in iter(lambda: f.read(1 << 22), b''): h.update(c)
    return h.hexdigest()

def format_check(path, cls, size):
    with open(path, 'rb') as f: head = f.read(16)
    if head[:4] == b'\x7fELF' or head[:2] == b'MZ':
        return 'this file is a program (ELF/PE), not data'
    if cls == 'weights-st':
        if len(head) < 9: return 'too short for safetensors'
        n = struct.unpack('<Q', head[:8])[0]
        if n > size - 8 or n > 100 << 20 or head[8:9] != b'{': return 'not a valid safetensors header'
        with open(path, 'rb') as f:
            f.seek(8); hdr = json.loads(f.read(n))
        end = max([int(v['data_offsets'][1]) for k, v in hdr.items() if k != '__metadata__'] or [0])
        if 8 + n + end != size:
            return 'the file is %d bytes, but its safetensors header accounts for %d: extra data is hidden in it' % (size, 8 + n + end)
    elif cls == 'weights-gguf':
        if head[:4] != b'GGUF': return 'not a GGUF file'
    elif cls not in ('weights-pickle',) and head[:4] == b'PK\x03\x04':
        return 'this file is a zip archive (it could hold a pickle)'
    return None

def cmd_post(planfile):
    global LEVEL
    P = json.load(open(planfile)); LEVEL = P.get('level', LEVEL)
    P['findings'] = [f for f in P['findings'] if f['id'] not in ('M-HASH', 'M-FORMAT', 'M-NO-HASH', 'M-DIGEST')]
    verify = os.environ.get('T_VERIFY', 'require') != 'off'
    byp = {f['path']: f for f in P['files']}
    hashed = 0
    if P['engine'] == 'ollama':
        post_ollama(P)
    else:
        for path in P['selected']:
            f = byp[path]; link = snap_path(P, path)
            if not os.path.exists(link):
                finding(P, 'M-HASH', 'was not downloaded', path); continue
            real = os.path.realpath(link); size = os.path.getsize(real)
            if f.get('local'): f['size'] = size
            if size != f['size']:   # (cannot happen for local files: their size was just read)
                finding(P, 'M-HASH', 'is %d bytes, but Hugging Face lists %d' % (size, f['size']), path); remove(link, real); continue
            why = format_check(real, f['class'], size)
            if why:
                finding(P, 'M-FORMAT', why, path); remove(link, real); continue
            if not verify:
                continue
            if f.get('sha256'):
                got = sha256_file(real); hashed += size
                if got != f['sha256']:
                    finding(P, 'M-HASH', 'SHA-256 %s does not match the %s Hugging Face lists' % (got[:16], f['sha256'][:16]), path); remove(link, real); continue
            elif f.get('git_oid'):
                if git_oid(real, size) != f['git_oid']:
                    finding(P, 'M-HASH', 'its content does not match the git object Hugging Face lists', path); remove(link, real); continue
            else:
                f['sha256'] = sha256_file(real); hashed += size
                if P.get('source') != 'file':
                    finding(P, 'M-NO-HASH', 'no checksum came from Hugging Face; recorded the local SHA-256', path)
            if P.get('source') == 'file': f['mtime'] = int(os.path.getmtime(real))
        if not verify:
            finding(P, 'M-NO-HASH', 'hash check skipped (LLMSERVER_VERIFY=off)')
        here = [os.path.realpath(snap_path(P, p)) for p in P['selected'] if os.path.exists(snap_path(P, p))]
        local_scans(P, here, 'M-LOCAL-SCAN', [x for x in here if x.endswith('.py') or classify(x) == 'code'])
        P['local_scans_files'] = len(here)
    P['verified_bytes'] = hashed
    P['verified_at'] = now()
    decide(P); save_to(planfile, P); emit(P)

def post_ollama(P):
    man = os.environ.get('T_MANIFEST', '')
    if os.environ.get('T_ATTACHED') == '1' or not man or not os.path.isfile(man):
        if os.environ.get('T_ATTACHED') != '1':
            finding(P, 'M-ATTACHED', 'the Ollama store is not readable from this account, so the pulled files could not be compared')
        return
    m = json.load(open(man))
    local = {str(l.get('digest', ''))[7:] for l in m.get('layers', [])}
    P['local_digests'] = sorted(local)
    if P.get('source') == 'registry':
        want = {f['sha256'] for f in P['files'] if f['class'] == 'weights-gguf'}
        if not want <= local:
            finding(P, 'M-DIGEST', 'the pulled model layers differ from the registry manifest that was checked')
    else:
        want = {f.get('sha256') for f in P['files'] if f['path'] == P.get('main')}
        if not want or not (want <= local):
            finding(P, 'M-DIGEST', 'Ollama pulled a different file than the checked %s (digest mismatch)' % P.get('main'))

def remove(link, real):
    for p in (real, link):
        try: os.remove(p)
        except OSError: pass

def save_to(path, P):
    tmp = path + '.tmp'
    with open(tmp, 'w') as f: json.dump(P, f, indent=1, sort_keys=True)
    os.replace(tmp, path)

