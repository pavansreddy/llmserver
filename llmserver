webui_apply() {  # write the changed RAG_KV values into Open WebUI's database (it is not running) -> the keys written
  local py e want="" ev dk jv
  py=$(helper_python) || return 0
  for e in "${RAG_KV[@]}"; do read -r ev dk jv <<<"$e"; want+="${want:+,}\"$dk\":$jv"; done
  py_env "$py" -I - "$webui_home/data/webui.db" "$webui_home/llmserver-applied.json" "{$want}" <<'PY'
import json, os, sqlite3, sys, time
db, applied_path, want = sys.argv[1], sys.argv[2], json.loads(sys.argv[3])
try: applied = json.load(open(applied_path))
except (OSError, ValueError): applied = {}
changed = []
if os.path.exists(db):
    c = sqlite3.connect(db, timeout=30)
    if c.execute("select 1 from sqlite_master where type='table' and name='config'").fetchone():
        cur = {}
        for k, v in c.execute('select key, value from config'):
            try: cur[k] = json.loads(v) if isinstance(v, (str, bytes)) else v
            except ValueError: cur[k] = v
        for k, v in want.items():
            if applied.get(k, object()) == v or cur.get(k, object()) == v: continue
            c.execute('insert into config (key, value, updated_at) values (?, ?, ?) on conflict(key) do update set value = excluded.value, updated_at = excluded.updated_at',
                      (k, json.dumps(v), int(time.time())))
            changed.append(k)
        c.commit()
    c.close()
tmp = applied_path + '.tmp'
with open(tmp, 'w') as f: json.dump(want, f)
os.replace(tmp, applied_path)
print(' '.join(changed))
PY
}
