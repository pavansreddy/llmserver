import json, os, re, struct, sys, io, urllib.error, urllib.request, urllib.parse
HF = os.environ.get('HF_ENDPOINT', 'https://huggingface.co').rstrip('/')
REG = os.environ.get('LLMSERVER_OLLAMA_REGISTRY', 'https://registry.ollama.ai').rstrip('/')
TOK = os.environ.get('HF_TOKEN') or os.environ.get('HUGGING_FACE_HUB_TOKEN')
HEAD = 8 << 20  # bytes of a GGUF header to fetch; metadata comes before the tokenizer

class Redirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        new = super().redirect_request(req, fp, code, msg, headers, newurl)
        if new is not None and urllib.parse.urlsplit(newurl).netloc != urllib.parse.urlsplit(req.full_url).netloc:
            new.remove_header('Authorization')  # never send the token to another host
        return new
OPEN = urllib.request.build_opener(Redirect)

def get(url, limit=None, accept=None):
    h = {'User-Agent': 'llmserver'}
    if limit: h['Range'] = 'bytes=0-%d' % (limit - 1)
    if accept: h['Accept'] = accept
    if TOK and url.startswith(HF): h['Authorization'] = 'Bearer ' + TOK
    with OPEN.open(urllib.request.Request(url, headers=h), timeout=8) as r:
        return r.read(limit) if limit else r.read()

FMT = {0: '<B', 1: '<b', 2: '<H', 3: '<h', 4: '<I', 5: '<i', 6: '<f', 7: '<?', 10: '<Q', 11: '<q', 12: '<d'}
def gguf(f, partial):
    def rd(fmt):
        n = struct.calcsize(fmt); b = f.read(n)
        if len(b) < n: raise EOFError
        return struct.unpack(fmt, b)[0]
    def rs():
        n = rd('<Q'); b = f.read(n)
        if len(b) < n: raise EOFError
        return b.decode('utf-8', 'replace')
    def val(t):
        if t in FMT: return rd(FMT[t])
        if t == 8: return rs()
        if t == 9:
            et, n = rd('<I'), rd('<Q')
            if et in FMT and n > 4096:
                f.seek(struct.calcsize(FMT[et]) * n, 1); return None
            return [val(et) for _ in range(n)]
        raise ValueError(t)
    if f.read(4) != b'GGUF': raise ValueError('not gguf')
    rd('<I'); rd('<Q')
    md = {}
    for _ in range(rd('<Q')):
        k = rs()
        arch = md.get('general.architecture')
        if partial and k.startswith('tokenizer.') and arch and arch + '.block_count' in md:
            break  # everything needed has been read
        try:
            md[k] = val(rd('<I'))
        except EOFError:
            if arch and arch + '.block_count' in md: break
            raise
    arch = md['general.architecture']
    g = lambda k, d=None: md.get(arch + '.' + k, d)
    layers, emb = int(g('block_count')), int(g('embedding_length', 0) or 0)
    hc = g('attention.head_count', 0) or 0
    heads = max(hc) if isinstance(hc, list) else int(hc)
    kvh = g('attention.head_count_kv', heads)
    kl = g('attention.key_length', emb // heads if heads else 0)
    vl = g('attention.value_length', emb // heads if heads else 0)
    per = kvh if isinstance(kvh, list) else [kvh] * layers
    fai = g('full_attention_interval')
    if isinstance(fai, int) and fai > 1 and not isinstance(kvh, list):
        per = [kvh if (i + 1) % fai == 0 else 0 for i in range(layers)]  # hybrid: only full-attention layers keep a KV cache
    kvel = sum(int(x or 0) for x in per) * (int(kl) + int(vl))
    return dict(layers=layers, kvel=kvel, ctx=int(g('context_length', 0) or 0), heads=heads,
                experts=int(g('expert_count', 0) or 0), used=int(g('expert_used_count', 0) or 0))

def out(**kw):
    print(' '.join('%s=%s' % (k, v) for k, v in kw.items() if v is not None))

def st_config(cfg):
    c = cfg.get('text_config') or cfg.get('llm_config') or cfg
    heads = int(c.get('num_attention_heads') or 0)
    layers = int(c.get('num_hidden_layers') or 0)
    kvh = int(c.get('num_key_value_heads') or heads)
    hd = int(c.get('head_dim') or (int(c.get('hidden_size', 0)) // heads if heads else 0))
    types = c.get('layer_types')
    att = sum(1 for t in types if 'linear' not in str(t) and 'mamba' not in str(t)) if isinstance(types, list) else layers
    if isinstance(c.get('kv_lora_rank'), int):  # multi-head latent attention keeps a compressed cache
        kvel = att * (c['kv_lora_rank'] + int(c.get('qk_rope_head_dim') or 0))
    else:
        kvel = att * kvh * hd * 2
    ctx = int(c.get('max_position_embeddings') or cfg.get('max_position_embeddings') or 0)
    return dict(layers=layers, kvel=kvel, ctx=ctx, heads=heads,
                experts=int(c.get('num_local_experts') or c.get('num_experts') or c.get('n_routed_experts') or 0),
                used=int(c.get('num_experts_per_tok') or c.get('num_experts_per_token') or c.get('moe_topk') or 0))

def st_weights(files):  # [(path, size)] -> bytes of one copy of the weights
    top = [(p, s) for p, s in files if '/' not in p]
    st = [(p, s) for p, s in top if p.endswith('.safetensors')]
    if any(p.startswith('model') for p, _ in st):
        st = [(p, s) for p, s in st if not p.startswith('consolidated')]
    if not st:
        st = [(p, s) for p, s in top if p.endswith('.bin') and 'model' in p]
    return sum(s for _, s in st)

QRE = re.compile(r'(?i)(?:UD-)?(?:IQ\d_[A-Z]+|Q\d_K(?:_[A-Z]+)?|Q\d_\d|TQ\d_\d|MXFP4(?:_MOE)?|BF16|F16|F32)')
def quant_of(path):
    m = QRE.findall(path.split('/')[-1]) or QRE.findall(path)
    return m[-1].upper() if m else None

def main(cmd, *a):
    try:
        if cmd == 'local-gguf':  # paths... (first non-mmproj file carries the metadata)
            w = sum(os.path.getsize(p) for p in a)
            main_f = next(p for p in a if 'mmproj' not in p.lower())
            with open(main_f, 'rb') as f: d = gguf(f, False)
            out(w=w, **d)
        elif cmd == 'local-st':  # snapshot dir
            files = [(p, os.path.getsize(os.path.join(a[0], p))) for p in os.listdir(a[0])]
            with open(os.path.join(a[0], 'config.json')) as f: d = st_config(json.load(f))
            out(w=st_weights(files), **d)
        elif cmd == 'local-ollama':  # manifest blobdir
            m = json.load(open(a[0])); w = 0; d = {}
            for l in m.get('layers', []):
                w += int(l.get('size') or 0) if 'model' in l.get('mediaType', '') or 'projector' in l.get('mediaType', '') else 0
                if l.get('mediaType', '').endswith('.model'):
                    with open(os.path.join(a[1], l['digest'].replace(':', '-')), 'rb') as f: d = gguf(f, True)
            out(w=w, **d)
        elif cmd == 'hf-gguf':  # repo tag
            first, w = None, 0
            try:   # the llama.cpp-style manifest, where the Hub still serves it
                m = json.loads(get('%s/v2/%s/manifests/%s' % (HF, a[0], a[1])))
                first = m['ggufFile']['rfilename']
                w = m['ggufFile']['size'] + (m.get('mmprojFile') or {}).get('size', 0)
            except Exception:
                first = None
            if first is None:   # otherwise: the repo's file list, the quant's GGUF (or its shards) + projector
                tree = json.loads(get('%s/api/models/%s/tree/main?recursive=true' % (HF, a[0])))
                want = None if a[1] == 'latest' else a[1].upper()
                files = [(e['path'], int(e.get('size') or 0)) for e in tree if e.get('type') == 'file' and e.get('path', '').endswith('.gguf')]
                main = [(p, sz) for p, sz in files if 'mmproj' not in p.lower() and (quant_of(p) or '').upper() == (want or 'Q4_K_M')]
                if not main and want is None:   # no Q4_K_M: the smallest quant the repo has
                    q = {}
                    for p, sz in files:
                        t = quant_of(p)
                        if t and 'mmproj' not in p.lower(): q.setdefault(t, []).append((p, sz))
                    if q: main = min(q.values(), key=lambda v: sum(sz for _, sz in v))
                if not main: raise KeyError('no %s GGUF in %s' % (a[1], a[0]))
                main.sort()
                first = main[0][0]
                proj = [sz for p, sz in files if 'mmproj' in p.lower()]
                w = sum(sz for _, sz in main) + (min(proj) if proj else 0)
            d = {}
            try:
                d = gguf(io.BytesIO(get('%s/%s/resolve/main/%s' % (HF, a[0], urllib.parse.quote(first)), HEAD)), True)
            except Exception:
                pass
            out(w=w, **d)
        elif cmd == 'hf-st':  # repo rev
            info = json.loads(get('%s/api/models/%s/revision/%s?blobs=true' % (HF, a[0], urllib.parse.quote(a[1], safe=''))))
            files = [(s['rfilename'], int(s.get('size') or 0)) for s in info.get('siblings', [])]
            d = st_config(json.loads(get('%s/%s/resolve/%s/config.json' % (HF, a[0], a[1]))))
            out(w=st_weights(files), **d)
        elif cmd == 'hf-quants':  # repo -> TAG:bytes,... smallest first
            tree = json.loads(get('%s/api/models/%s/tree/main?recursive=true' % (HF, a[0])))
            q = {}
            for e in tree:
                p = e.get('path', '')
                if e.get('type') == 'file' and p.endswith('.gguf') and 'mmproj' not in p.lower():
                    t = quant_of(p)
                    if t: q[t] = q.get(t, 0) + int(e.get('size') or 0)
            out(quants=','.join('%s:%d' % kv for kv in sorted(q.items(), key=lambda kv: kv[1])) or None)
        elif cmd == 'ollama-lib':  # name[:tag]
            name, _, tag = a[0].partition(':')
            name = name if '/' in name else 'library/' + name
            m = json.loads(get('%s/v2/%s/manifests/%s' % (REG, name, tag or 'latest'),
                               accept='application/vnd.docker.distribution.manifest.v2+json'))
            w = 0; d = {}
            for l in m.get('layers', []):
                mt = l.get('mediaType', '')
                if mt.endswith('.model') or mt.endswith('.projector'): w += int(l.get('size') or 0)
                if mt.endswith('.model'):
                    try: d = gguf(io.BytesIO(get('%s/v2/%s/blobs/%s' % (REG, name, l['digest']), HEAD)), True)
                    except Exception: pass
            out(w=w, **d)
        elif cmd in ('bench', 'bench-chat'):
            # bench:      base-url model key prompt-tokens gen-tokens  (fixed-length decode: ignore_eos)
            # bench-chat: base-url model key effort engine             (one real answer: thinking and answer apart)
            import time, random
            base, model, key = a[0], a[1], a[2]
            h = {'Content-Type': 'application/json'}
            if key: h['Authorization'] = 'Bearer ' + key
            nop = urllib.request.build_opener(urllib.request.ProxyHandler({}))
            def kinds(c):   # ('think'|'text', piece) for one streamed choice
                d = c.get('delta') or {}
                r = c.get('reasoning') or c.get('reasoning_content') or d.get('reasoning') or d.get('reasoning_content')
                t = c.get('text') or d.get('content')
                return ([('think', r)] if r else []) + ([('text', t)] if t else [])
            def measure(path, payload):
                req = urllib.request.Request(base + path, data=json.dumps(payload).encode(), headers=h)
                t0 = time.monotonic(); ev = []; usage = {}
                with nop.open(req, timeout=900) as r:
                    for raw in r:
                        line = raw.decode('utf-8', 'replace').strip()
                        if not line.startswith('data:'): continue
                        data = line[5:].strip()
                        if data == '[DONE]': break
                        try: d = json.loads(data)
                        except ValueError: continue
                        if isinstance(d.get('error'), dict): raise RuntimeError(d['error'].get('message') or 'the server reported an error')
                        if d.get('usage'): usage = d['usage']
                        now = time.monotonic()
                        for c in d.get('choices') or []:
                            for k, piece in kinds(c): ev.append((now, k, piece))
                return t0, time.monotonic(), ev, usage
            def pct(xs, q):
                if not xs: return 0
                xs = sorted(xs); i = min(len(xs) - 1, max(0, int(round(q / 100.0 * (len(xs) - 1)))))
                return xs[i]
            if cmd == 'bench':
                n_prompt, n_gen = int(a[3]), int(a[4])
                words = ('the', 'of', 'river', 'light', 'stone', 'quiet', 'market', 'north', 'paper', 'seven', 'garden', 'signal')
                rnd = random.Random()
                text = 'Run %d. ' % rnd.randrange(10**9) + ' '.join(rnd.choice(words) for _ in range(max(n_prompt - 8, 1)))
                p = {'model': model, 'prompt': text, 'max_tokens': n_gen, 'temperature': 0, 'stream': True,
                     'ignore_eos': True, 'stream_options': {'include_usage': True}}
                ev = []
                try:
                    t0, end, ev, usage = measure('/v1/completions', p)
                except urllib.error.HTTPError as e:
                    if e.code not in (404, 405, 501): raise
                if not ev:   # no plain completions here: measure through the chat endpoint
                    p.pop('prompt'); p['messages'] = [{'role': 'user', 'content': text}]
                    t0, end, ev, usage = measure('/v1/chat/completions', p)
                if not ev: raise RuntimeError('the server answered without any tokens')
                times = [t for t, _, _ in ev]
                ctok = int(usage.get('completion_tokens') or len(ev))
                per = max(1.0, ctok / float(len(ev)))   # tokens per streamed chunk (normally 1)
                gaps = [(y - x) * 1000 / per for x, y in zip(times, times[1:])]
                out(ttft=round(times[0] - t0, 4), gen=round(times[-1] - times[0], 4), e2e=round(end - t0, 4),
                    ptok=int(usage.get('prompt_tokens') or 0), ctok=ctok, chunks=len(ev),
                    think=sum(1 for _, k, _ in ev if k == 'think'),
                    itl50=round(pct(gaps, 50), 2), itl90=round(pct(gaps, 90), 2), itl99=round(pct(gaps, 99), 2))
            else:
                effort, engine = a[3], a[4]
                p = {'model': model, 'stream': True, 'max_tokens': 2048, 'stream_options': {'include_usage': True},
                     'messages': [{'role': 'user', 'content': 'A train leaves at 09:40 and the trip takes 2 hours 35 minutes. When does it arrive? Answer briefly.'}]}
                if effort:
                    if effort != 'none' or engine == 'ollama': p['reasoning_effort'] = effort
                    if engine in ('llama', 'vllm'):
                        p['chat_template_kwargs'] = {'enable_thinking': False} if effort == 'none' else {'reasoning_effort': effort}
                t0, end, ev, usage = measure('/v1/chat/completions', p)
                if not ev: raise RuntimeError('the server answered without any tokens')
                # thinking: reasoning pieces, or text inside <think>...</think> when the server does not split it
                kind = []; inside = False
                for t, k, piece in ev:
                    if k == 'text' and '<think>' in piece: inside = True
                    kind.append((t, 'think' if k == 'think' or inside else 'text'))
                    if k == 'text' and '</think>' in piece: inside = False
                th = [t for t, k in kind if k == 'think']; tx = [t for t, k in kind if k == 'text']
                ctok = int(usage.get('completion_tokens') or len(ev))
                rt = (usage.get('completion_tokens_details') or {}).get('reasoning_tokens')
                per = max(1.0, ctok / float(len(ev)))
                think_tok = int(rt) if rt is not None else int(round(len(th) * per))
                out(ttft=round(ev[0][0] - t0, 4), e2e=round(end - t0, 4), ctok=ctok, ptok=int(usage.get('prompt_tokens') or 0),
                    think_tok=think_tok, think_s=round((th[-1] - th[0]) if th else 0, 4),
                    ans_tok=max(0, ctok - think_tok), ttfa=round((tx[0] - t0) if tx else 0, 4),
                    ans_s=round((tx[-1] - tx[0]) if len(tx) > 1 else 0, 4))
        else:
            out(err='usage')
    except Exception as e:
        msg = str(e).replace('\n', ' ')[:200]
        out(err=type(e).__name__ + (': ' + msg if msg else ''))
main(*sys.argv[1:])
PY
}
mi_parse() {  # "key=value ..." from pyinfo -> MI_*; status 1 when no weight size came back
  local kv w=0
  MI_W=0 MI_KVEL=0 MI_LAYERS=0 MI_TCTX=0 MI_HEADS=0 MI_EXPERTS=0 MI_EUSED=0
  for kv in $1; do
    case $kv in
      w=*) w=${kv#w=} ;; kvel=*) MI_KVEL=${kv#*=} ;; layers=*) MI_LAYERS=${kv#*=} ;;
      ctx=*) MI_TCTX=${kv#*=} ;; heads=*) MI_HEADS=${kv#*=} ;; experts=*) MI_EXPERTS=${kv#*=} ;;
      used=*) MI_EUSED=${kv#*=} ;;
    esac
  done
  [[ $w =~ ^[0-9]+$ ]] && ((w > 0)) || return 1
  MI_W=$(((w + 1048575) / 1048576))
}
mi_remote_args() {  # engine model -> pyinfo arguments for a registry lookup
  local m=$2
  case $1 in
    llama) m=${m%%@*}; printf '%s\n' hf-gguf "${m%%:*}" "$([[ $m == *:* ]] && echo "${m#*:}" || echo latest)" ;;
    vllm) printf '%s\n' hf-st "${m%%@*}" "$([[ $m == *@* ]] && echo "${m#*@}" || echo main)" ;;
    ollama)
      if [[ $m == hf.co/* || $m == huggingface.co/* ]]; then m=${m#*/}
        printf '%s\n' hf-gguf "${m%%:*}" "$([[ $m == *:* ]] && echo "${m#*:}" || echo latest)"
      else printf '%s\n' ollama-lib "$m"; fi ;;
  esac
}
model_info() {  # engine model [1 = never go online]
  local e=$1 m=$2 r="" files=() f snap manifest line args=()
  MI_SRC=none MI_EST=0
  if is_cached "$e" "$m" 2>/dev/null; then
    case $e in
      llama) while IFS= read -r -d '' f; do files+=("$f"); done < <(llama_files "$m")
             ((${#files[@]})) && r=$(pyinfo local-gguf "${files[@]}") ;;
      vllm) snap=$(vllm_snapshot "$m") && r=$(pyinfo local-st "$snap") ;;
      ollama) manifest=$(ollama_manifest "$m")
              [[ -r $manifest ]] && r=$(pyinfo local-ollama "$manifest" "${manifest%%/manifests/*}/blobs") ;;
    esac
    if [[ -n $r ]] && mi_parse "$r"; then MI_SRC=local; mi_store "$e:$m"; mi_fill "$e" "$m"; return 0; fi
  fi
  if [[ -r $info_file ]]; then
    line=$(grep -F "$e:$m"$'\t' "$info_file" | tail -n1 || true)
    if [[ -n $line ]]; then
      IFS=$'\t' read -r _ MI_W MI_KVEL MI_LAYERS MI_TCTX MI_HEADS MI_EXPERTS MI_EUSED <<<"$line"
      MI_SRC=cache; mi_fill "$e" "$m"; return 0
    fi
  fi
  [[ ${3-0} == 1 ]] && return 0
  mapfile -t args < <(mi_remote_args "$e" "$m")
  r=$(pyinfo "${args[@]}")
  if mi_parse "$r"; then MI_SRC=remote; mi_store "$e:$m"; mi_fill "$e" "$m"; fi
  return 0
}
mi_store() {
  mkdir -p "$state_dir" 2>/dev/null || return 0
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$1" "$MI_W" "$MI_KVEL" "$MI_LAYERS" "$MI_TCTX" "$MI_HEADS" "$MI_EXPERTS" "$MI_EUSED" >> "$info_file" 2>/dev/null || true
}
bpw10() {  # engine model -> rough bits per weight x10, from the quantization in the name
  local s=${2^^}
  case $1 in
    vllm)
      case $s in *AWQ*|*GPTQ*|*INT4*|*W4A16*|*NF4*|*BNB*) echo 45 ;; *FP8*|*INT8*|*W8A8*) echo 85 ;; *) echo 160 ;; esac ;;
    *)
      case $s in *IQ1*|*TQ1*) echo 18 ;; *IQ2*|*TQ2*) echo 25 ;; *Q2_*) echo 30 ;; *IQ3*|*Q3_*) echo 39 ;;
        *Q5_*) echo 57 ;; *Q6_*) echo 66 ;; *Q8_*) echo 85 ;; *BF16*|*F16*) echo 160 ;; *F32*) echo 320 ;;
        *MXFP4*) echo 43 ;; *) echo 48 ;; esac ;;
  esac
}
mi_fill() {  # estimate the KV cache size when the architecture could not be read
  local p10
  [[ $MI_KVEL =~ ^[0-9]+$ ]] || MI_KVEL=0
  for p10 in MI_LAYERS MI_TCTX MI_HEADS MI_EXPERTS MI_EUSED; do [[ ${!p10} =~ ^[0-9]+$ ]] || printf -v "$p10" 0; done
  if ((MI_W > 0 && MI_KVEL == 0)); then
    p10=$((MI_W * 800 / (1024 * $(bpw10 "$1" "$2"))))   # parameters, in tenths of a billion
    MI_KVEL=$(((45 * p10 / 10 + 900) * 50)); MI_EST=1
  fi
}


# ---- fit advisor -------------------------------------------------------------
# fit_eval ENGINE MODEL MODE CTX -> F_RATING good | tight | offload | cpu | no | unknown, and the
# figures behind it. MODE is 'total' (the whole machine, nothing else running) or 'now' (the
# memory free right now, plus FREE_ADD: what stopping the planned models gives back).
F_RATING="" F_NEED=0 F_CAP=0 F_CTX=0 F_CTXFIT=0 F_FRAC=100 F_TP=1 F_UTIL="" F_NGL="" F_KVTOK=0 F_MSG="" F_SUGG=()
kv_millibytes() {  # KV cache element type -> bytes per element x1000
  case ${1,,} in
    f32) echo 4000 ;; f16|bf16|auto|"") echo 2000 ;; q8_0|fp8*) echo 1063 ;; q6_k) echo 820 ;;
    q5_0|q5_k*) echo 688 ;; q5_1) echo 750 ;; q4_0|q4_k*|iq4_nl) echo 563 ;; q4_1) echo 625 ;;
    *) echo 2000 ;;
  esac
}
flag_in() {  # name... -> the last value given for any of those flags in FIT_FLAGS
  local i v="" n
  for ((i = 0; i < ${#FIT_FLAGS[@]}; i++)); do
    for n in "$@"; do
      if [[ ${FIT_FLAGS[i]} == "$n" ]]; then v=${FIT_FLAGS[i + 1]-}
      elif [[ ${FIT_FLAGS[i]} == "$n="* ]]; then v=${FIT_FLAGS[i]#*=}; fi
    done
  done
  printf '%s\n' "$v"
}
has_flag() {  # name... -> is any of those flags among the user's engine flags (FIT_FLAGS)?
  local t n
  for t in "${FIT_FLAGS[@]}"; do for n in "$@"; do [[ $t == "$n" || $t == "$n="* ]] && return 0; done; done
  return 1
}
FIT_FLAGS=()  # the user's engine flags (or KEY=VALUE settings for Ollama) that change memory use
kv_tok_bytes() {  # engine -> bytes of KV cache per token of context
  local k v
  case $1 in
    llama) k=$(kv_millibytes "$(flag_in -ctk --cache-type-k)"); v=$(kv_millibytes "$(flag_in -ctv --cache-type-v)") ;;
    ollama) k=$(kv_millibytes "$(flag_in OLLAMA_KV_CACHE_TYPE)"); v=$k ;;
    vllm) case $(flag_in --kv-cache-dtype) in fp8*) k=1000 ;; *) k=2000 ;; esac; v=$k ;;
  esac
  echo $((MI_KVEL * (k + v) / 2000))
}
mib_ceil() { echo $((($1 + 1048575) / 1048576)); }
round_ctx() { local c=$1; ((c >= 2048)) && c=$((c / 1024 * 1024)); echo "$c"; }
fit_eval() {  # engine model mode ctx(number|fit|auto)
  local e=$1 mode=$3
  gpu_view "$e"
  view_mode "$mode"
  MODE_FOR_VLLM=$mode
  fit_core "$e" "$4"
}
fit_core() {  # engine ctx: rate the model on the GPUs in V_* (V_F = the memory it may use)
  local e=$1 want=$2 cap=0 total=0 ovh res=${CFG[VRAM_RESERVE_MB]} n kvmib need ctx tctx L per i ram
  F_RATING=unknown F_NEED=0 F_CAP=0 F_CTX=0 F_CTXFIT=0 F_FRAC=100 F_TP=1 F_UTIL="" F_NGL="" F_MSG="" F_SUGG=()
  ram=$((RAM_AVAIL > 0 ? RAM_AVAIL : RAM_TOTAL))
  ((MI_W > 0)) || { F_MSG="it is not downloaded and its size could not be read online, so llmserver cannot yet check that it fits in memory"; return 0; }
  F_KVTOK=$(( $(kv_tok_bytes "$e") + DRAFT_KVEL * 2 ))   # the draft keeps its own 16-bit KV cache
  tctx=$MI_TCTX
  n=${#V_T[@]}
  cap=$(sum "${V_F[@]}")
  total=$(sum "${V_T[@]}")
  ((cap > total)) && cap=$total
  # the context to judge: a number, the largest that fits ('fit'), or the engine's default ('auto')
  case $want in
    auto) if [[ $e == vllm ]]; then ctx=${tctx:-0}; else ctx=4096; fi; ((ctx > 0)) || ctx=4096 ;;
    fit) ctx=0 ;;
    *) ctx=$want ;;
  esac

  if [[ $e == vllm ]]; then
    fit_vllm "$ctx"; return 0
  fi

  ovh=$((512 + 256 * (n > 1 ? n - 1 : 0) + DRAFT_W))
  if ((n > 0)); then
    # largest context that leaves 10% of the VRAM free (the same margin that rates a fit GOOD)
    F_CTXFIT=0
    if ((F_KVTOK > 0)); then
      i=$((cap * 90 / 100 - res - MI_W - ovh))
      ((i > 0)) && F_CTXFIT=$(round_ctx $((i * 1048576 / F_KVTOK)))
      ((tctx > 0 && F_CTXFIT > tctx)) && F_CTXFIT=$tctx
    fi
    if ((ctx == 0)); then  # 'fit'
      if ((F_CTXFIT >= 4096)); then ctx=$F_CTXFIT; ((tctx == 0 && ctx > 32768)) && ctx=32768
      else ctx=$((tctx > 0 && tctx < 8192 ? tctx : 8192)); fi
    fi
  else
    ((ctx == 0)) && ctx=$((tctx > 0 && tctx < 8192 ? tctx : 8192))
  fi
  F_CTX=$ctx
  kvmib=$(mib_ceil $((F_KVTOK * ctx)))
  need=$((MI_W + kvmib + ovh)); F_NEED=$need; F_CAP=$cap
  ((tctx > 0 && ctx > tctx)) && F_SUGG+=("context $ctx is beyond the $tctx tokens this model was trained for; quality usually drops past that point")

  if ((n == 0)); then
    if ((MI_W + kvmib + 512 <= ram * 9 / 10)); then F_RATING=cpu
    else F_RATING=no; fi
    return 0
  fi
  if ((need + res <= cap * 90 / 100)); then F_RATING=good
  elif ((need + res <= cap)); then F_RATING=tight
  else
    L=${MI_LAYERS:-0}; ((L > 0)) || L=1
    per=$(( (MI_W + kvmib + L - 1) / L ))   # one layer's weights and cache
    i=$(( (cap - res - ovh) / (per > 0 ? per : 1) )); ((i < 0)) && i=0; ((i > L)) && i=$L
    F_FRAC=$((i * 100 / L)); ((MI_LAYERS > 0)) && F_NGL=$i
    if (( (MI_W + kvmib) * (100 - F_FRAC) / 100 <= ram * 9 / 10 )); then F_RATING=offload; else F_RATING=no; fi
  fi
  return 0
}
fit_vllm() {  # ctx (0 = fit). vLLM keeps everything on the GPU and splits with tensor parallelism
  local want=$1 tp tpuser n=${#V_T[@]} res=${CFG[VRAM_RESERVE_MB]} ovh=$((1536 + DRAFT_W)) tmin fmin avail pool kvmib ctx tctx=$MI_TCTX i u
  F_CTX=$want
  if ((n == 0)) || [[ -n $C_FATAL ]]; then
    if [[ $V_KIND == cpu && -z $C_FATAL ]]; then F_RATING=cpu; else F_RATING=no; fi
    ((F_CTX > 0)) || F_CTX=$((tctx > 0 && tctx < 4096 ? tctx : 4096))
    F_NEED=$((MI_W + ovh + $(mib_ceil $((F_KVTOK * F_CTX))))); return 0
  fi
  tpuser=$(flag_in -tp --tensor-parallel-size)
  for tp in ${tpuser:-1 2 4 8}; do
    if [[ ! $tp =~ ^[0-9]+$ ]] || ((tp < 1 || tp > n)); then continue; fi
    ((MI_HEADS > 0 && MI_HEADS % tp != 0)) && continue
    tmin=${V_T[0]} fmin=${V_F[0]}                       # the smallest of the GPUs used
    for ((i = 0; i < tp; i++)); do ((V_T[i] < tmin)) && tmin=${V_T[i]}; ((V_F[i] < fmin)) && fmin=${V_F[i]}; done
    avail=$((fmin - res)); ((avail > tmin * 90 / 100)) && avail=$((tmin * 90 / 100))   # 0.9 is vLLM's own ceiling
    pool=$((avail - MI_W / tp - ovh))                    # per GPU, MiB, for the KV cache
    ((pool > 0)) || continue
    ctx=$((F_KVTOK > 0 ? pool * tp * 1048576 / F_KVTOK : 0))
    ((tctx > 0 && ctx > tctx)) && ctx=$tctx
    F_CTXFIT=$(round_ctx "$ctx")
    if ((want == 0)); then ((F_CTXFIT >= 2048)) || continue; F_CTX=$F_CTXFIT
    else ((F_CTXFIT >= want)) || continue; F_CTX=$want; fi
    F_TP=$tp
    kvmib=$(mib_ceil $((F_KVTOK * F_CTX / tp)))
    F_NEED=$((MI_W / tp + ovh + kvmib)); F_CAP=$avail
    if ((want == 0 || F_NEED * 100 <= F_CAP * 90)); then F_RATING=good; else F_RATING=tight; fi
    if [[ $MODE_FOR_VLLM != total ]]; then
      # vLLM claims a share of each GPU up front; take what this model needs plus 10%, so the
      # rest of the GPU stays available to other models
      u=$(( (F_NEED * 110 + tmin - 1) / tmin ))
      ((u > avail * 100 / tmin)) && u=$((avail * 100 / tmin))
      ((u < 90)) && F_UTIL=$(printf '0.%02d' "$u")
    fi
    return 0
  done
  F_RATING=no
  ((F_CTX > 0)) || F_CTX=$((tctx > 0 && tctx < 4096 ? tctx : 4096))
  F_NEED=$((MI_W + ovh + $(mib_ceil $((F_KVTOK * F_CTX))))); F_CAP=$(sum "${V_F[@]}")
  ((want > 0 && F_CTXFIT > 0)) && F_SUGG+=("vLLM could run it with --ctx $F_CTXFIT")
  return 0
}
MODE_FOR_VLLM=total

# advise ENGINE MODEL MODE CTX [quiet]: evaluate and explain. Status 1 = should not be started.
advise() {  # MODE: total (the machine) | now (free now) | place (the best GPUs now; sets PLACE_IDX)
  local e=$1 m=$2 mode=$3 want=$4 quiet=${5-0} gm spare what s q t size best="" guard=${CFG[VRAM_GUARD]}
  ((guard_off)) && guard=off
  if [[ $mode == place ]]; then place "$e" "$m" "$want"; else PLACE_NOTE=""; fit_eval "$e" "$m" "$mode" "$want"; fi
  for s in "${C_WARN[@]}"; do ((quiet)) || warn "$s"; done
  if [[ -n $C_FATAL ]]; then
    F_RATING=no F_MSG="$e cannot run on this machine: $C_FATAL"
    ((quiet)) || warn "$F_MSG"
    [[ $guard == enforce || $guard == strict ]] && return 1
    return 0
  fi
  gm="$(gb "$F_CAP") of VRAM on ${V_DESC:-no GPU}"
  [[ $mode != total && -n $PLACE_NOTE ]] && gm+=" ($PLACE_NOTE)"
  [[ $mode == total ]] && gm+=" (with nothing else running)"
  spare=$((F_CAP - F_NEED))
  what="$m needs about $(gb "$F_NEED")$([[ $e == vllm && $F_TP -gt 1 ]] && echo ' per GPU' || true) at $F_CTX tokens of context ($(gb "$MI_W") weights$( ((MI_EST)) && echo ', KV cache estimated from the size' || echo ' + KV cache')$( ((DRAFT_W > 0)) && echo " + $(gb "$DRAFT_W") draft model" || true)$([[ $e == vllm && $F_TP -gt 1 ]] && echo ", split over $F_TP GPUs" || true))"
  case $F_RATING in
    good) F_MSG="$what; it fits in $gm$([[ $e == vllm && $F_TP -gt 1 ]] && echo ' each' || true) with $(gb "$spare") to spare, so it should run well" ;;
    tight) F_MSG="$what; it fits in $gm with only $(gb $((spare > 0 ? spare : 0))) to spare, so long prompts or parallel requests may run out of memory" ;;
    offload) F_MSG="$what; that is more than $gm, so about $F_FRAC% of it runs on the GPU and the rest on the CPU: expect generation to be several times slower" ;;
    cpu) F_MSG="$what; with no usable GPU it runs on the CPU from system RAM ($(gb "$RAM_AVAIL") available): expect slow generation" ;;
    no) if [[ $e == vllm ]]; then F_MSG="$what; that does not fit in the VRAM of ${V_DESC:-any GPU} ($(gb "$(sum "${V_T[@]}")") in total), and vLLM cannot offload to the CPU, so it will not run"
        elif ((${#V_T[@]} == 0)); then F_MSG="$what; this machine has no GPU that $e can use and only $(gb "$RAM_AVAIL") of free RAM, so it will not run"
        else F_MSG="$what; this machine has $(gb "$F_CAP") of usable VRAM and $(gb "$RAM_AVAIL") of free RAM, so it will not run"; fi ;;
    unknown) F_MSG="memory check skipped for $m: ${F_MSG}" ;;
  esac
  # suggestions
  if [[ $F_RATING != good && $F_RATING != unknown && $quiet != 2 ]]; then
    if [[ $e != vllm && $F_CTXFIT -ge 4096 && $F_CTXFIT -lt $F_CTX ]]; then F_SUGG+=("--ctx $F_CTXFIT fits entirely on the GPU"); fi
    if [[ ($e == llama || $m == hf.co/*) && $F_RATING != good ]]; then
      local repo=${m#hf.co/}; repo=${repo%%:*}
      q=$(pyinfo hf-quants "$repo"); q=${q#quants=}
      if [[ -n $q && $q != err=* ]]; then
        local room smaller="" sctx=0 c cur=${m##*:} where="on the GPU" limit=$((F_CAP * 90 / 100 - CFG[VRAM_RESERVE_MB]))
        cur=${cur%%@*}; cur=${cur^^}
        if ((${#V_T[@]} == 0)); then where="in RAM" limit=$((RAM_AVAIL * 90 / 100)); fi
        for t in ${q//,/ }; do
          [[ ${t%:*} == "$cur" ]] && continue
          size=$((${t##*:} / 1048576))
          ((size < MI_W)) || continue   # only ever suggest something smaller
          room=$((limit - size - 512))   # MiB left for the KV cache
          ((room > 0)) || continue
          if ((room >= $(mib_ceil $((F_KVTOK * F_CTX))))); then best="${t%:*} ($(gb "$size"))"
          elif ((F_KVTOK > 0)); then
            c=$(round_ctx $((room * 1048576 / F_KVTOK)))
            ((MI_TCTX > 0 && c > MI_TCTX)) && c=$MI_TCTX
            if ((c >= 4096)); then smaller="${t%:*} ($(gb "$size"))" sctx=$c; fi
          fi
        done
        if [[ -n $best ]]; then F_SUGG+=("the $best quantization of this repo fits $where at the same context: $PROG $e:$repo:${best%% *}")
        elif [[ -n $smaller ]]; then F_SUGG+=("the $smaller quantization fits $where with up to $sctx tokens of context: $PROG $e:$repo:${smaller%% *} --ctx $sctx")
        elif [[ $F_RATING != cpu ]]; then F_SUGG+=("no quantization in this repo fits $where; a model with fewer parameters would")
        fi
      fi
    fi
    if [[ $F_RATING == offload && $MI_EXPERTS -gt 0 && $e == llama ]] && llama_help_has --n-cpu-moe; then
      F_SUGG+=("this is a mixture-of-experts model: '-- --n-cpu-moe N' keeps attention on the GPU and moves only expert weights to the CPU, which is usually much faster than plain layer offload")
    fi
    if [[ $e == vllm && $F_RATING == no ]]; then
      F_SUGG+=("try a quantized build of this model (AWQ, GPTQ or FP8), or a GGUF build with llama.cpp, which can offload to the CPU")
    fi
  fi
  if [[ $quiet != 2 && ($F_RATING == good || $F_RATING == tight) ]]; then partition_hint; fi
  speed_est "$e"
  if ((!quiet)); then
    case $F_RATING in
      good|unknown) info "$F_MSG" ;;
      *) warn "$F_MSG" ;;
    esac
    [[ -n $F_TPS && " ${pass[*]} " != *" --rerank"* ]] && info "  $(speed_line)"   # (a reranker generates nothing)
    for s in "${F_SUGG[@]}"; do info "  suggestion: $s"; done
  fi
  case $F_RATING:$guard in
    no:enforce|no:strict|offload:strict|tight:strict) return 1 ;;
  esac
  return 0
}
partition_hint() {  # a GPU whose driver offers finer memory partitions, and a model that fits in one
  local i modes cur n
  for i in "${V_IDX[@]}"; do
    [[ -v G_VENDOR[i] && ${G_VENDOR[i]} == amd && -n ${G_PARTS[i]-} && ${G_PARTS[i]} == *,* ]] || continue
    cur=${G_PART[i]##*/}; modes=${G_PARTS[i]}
    n=$(tr ',' '\n' <<<"$modes" | sed -n 's/^NPS\([0-9]*\)$/\1/p' | sort -n | tail -n1)
    if [[ ! $cur =~ ^NPS([0-9]+)$ || ! $n =~ ^[0-9]+$ ]] || ((n <= BASH_REMATCH[1])); then continue; fi
    if ((F_NEED * n + CFG[VRAM_RESERVE_MB] <= G_TOTAL[i] * 90 / 100)); then
      F_SUGG+=("${G_NAME[i]} is in memory mode $cur and also offers $modes. This model would fit in one NPS$n partition, which keeps its memory local and can lower single-user latency. Changing modes needs root, affects every user of the GPU, and makes each partition appear as a separate GPU")
      return 0
    fi
  done
  return 0
}
rank() { case $1 in good) echo 0 ;; tight) echo 1 ;; offload|cpu) echo 2 ;; no) echo 3 ;; *) echo 0 ;; esac; }
LLAMA_HELP=""
llama_help_has() {
  [[ $LLAMA_KIND != none ]] || return 1
  [[ -n $LLAMA_HELP ]] || LLAMA_HELP=$("${LLAMA_SERVE[@]}" --help 2>&1 || true)
  grep -qE -- "(^|[[:space:],])$1([[:space:],=]|\$)" <<<"$LLAMA_HELP"
}
post_start_check() {  # after the model is loaded: did it actually fit?
  local ps i idx=("${PLACE_IDX[@]}")
  [[ ${CFG[VRAM_GUARD]} == off ]] || ((guard_off)) && return 0
  case $ENGINE in
    llama|vllm)
      refresh_hw
      ((${#idx[@]})) || idx=("${!G_VENDOR[@]}")
      for i in "${idx[@]}"; do
        if ((G_TOTAL[i] - G_USED[i] < G_TOTAL[i] * 15 / 1000 + 256)); then
          warn "GPU $i (${G_NAME[i]}) is full ($(gb "${G_USED[i]}") of $(gb "${G_TOTAL[i]}") used). If generation is slow, the driver may be spilling into system RAM; lower --ctx, pick a smaller model, or stop another model"
        fi
      done ;;
    ollama)
      if ollama_load "$(hostport "$(connect_host "$HOST")" "$PORT")" && ((OL_SIZE > 0 && OL_VRAM < OL_SIZE)); then
        warn "Ollama placed only $((OL_VRAM * 100 / OL_SIZE))% of the model on the GPU; the rest runs on the CPU. Lower --ctx or pick a smaller model"
      fi ;;
  esac
  return 0
}


# ---- tuning rules ------------------------------------------------------------
# config/tuning (in LLMSERVER_HOME) holds rules such as
#   when vendor=amd, rocm>=10.0, rocm<10.1: env GPU_MAX_HW_QUEUES=1
# Each rule sets an environment variable or adds an engine flag only on matching hardware and
# software. A rule never overrides a variable already in your environment or a flag you passed.
tuning_file=$config_dir/tuning
TUNE_ENV=() TUNE_FLAGS=() TUNE_LOG=() TUNE_WARNED=0 T_VENDOR="" T_ROCM="" T_CC="" T_GFX="" T_VRAM=""
tune_facts() {  # engine -> facts the conditions test, for the GPUs that engine would use
  local i v=() c="" g="" vr=""
  local idx=("${PLACE_IDX[@]}")
  if ((${#idx[@]} == 0)); then gpu_view "$1"; for i in "${V_IDX[@]}"; do ((i >= 0)) && idx+=("$i"); done; fi
  for i in "${idx[@]}"; do
    [[ " ${v[*]} " == *" ${G_VENDOR[i]} "* ]] || v+=("${G_VENDOR[i]}")
    if [[ ${G_VENDOR[i]} == nvidia && -n ${G_CAP[i]} ]]; then [[ -z $c ]] || ! ver_ge "${G_CAP[i]}" "$c" && c=${G_CAP[i]}; fi
    [[ ${G_VENDOR[i]} == amd && -n ${G_CAP[i]} ]] && g=${G_CAP[i]}
    [[ -z $vr ]] || ((G_TOTAL[i] / 1024 < vr)) && vr=$((G_TOTAL[i] / 1024))
  done
  if ((${#v[@]} == 0)); then T_VENDOR=none; elif ((${#v[@]} > 1)); then T_VENDOR=mixed; else T_VENDOR=${v[0]}; fi
  T_CC=$c T_GFX=$g T_VRAM=$vr T_ROCM=""
  if [[ $1 == vllm ]]; then
    vllm_backend
    local ver; ver=$(py_env timeout 20 "$(vllm_python)" -I -c 'import importlib.metadata as m; print(m.version("torch"))' 2>/dev/null || true)
    [[ $ver =~ \+rocm([0-9.]+) ]] && T_ROCM=${BASH_REMATCH[1]}
  fi
  if [[ -z $T_ROCM && -r ${ROCM_PATH:-/opt/rocm}/.info/version ]]; then
    T_ROCM=$(<"${ROCM_PATH:-/opt/rocm}/.info/version"); T_ROCM=${T_ROCM%%-*}
  fi
}
tune_cond() {  # key op want -> 0 match, 1 no match, 2 unknown key
  local k=$1 op=$2 want=$3 have
  case $k in
    engine) have=$ENGINE ;; vendor) have=$T_VENDOR ;; backend) have=${V_KIND,,} ;; gpus) have=${#V_T[@]} ;;
    vram) have=$T_VRAM ;; rocm) have=$T_ROCM ;; driver) have=$NV_DRIVER ;; cc) have=$T_CC ;;
    gfx) have=$T_GFX ;; model) have=${MODEL-} ;;
    *) return 2 ;;
  esac
  [[ -n $have ]] || return 1  # unknown here: the rule does not apply
  # shellcheck disable=SC2053  # '=' and '!=' match $want as a pattern on purpose
  case $op in
    =) [[ $have == $want ]] ;;
    '!=') [[ $have != $want ]] ;;
    '>=') ver_ge "$have" "$want" ;;
    '<') ! ver_ge "$have" "$want" ;;
    '>') ver_ge "$have" "$want" && [[ $have != "$want" ]] ;;
    '<=') ! ver_ge "$have" "$want" || [[ $have == "$want" ]] ;;
  esac
}
twarn() { ((TUNE_WARNED)) || warn "$@"; }  # report a bad rule once per run, not per engine
tune_rules() {  # engine -> TUNE_ENV TUNE_FLAGS TUNE_LOG for the rules that match
  local line n=0 conds act arg c k op v ok rc name t why
  TUNE_ENV=() TUNE_FLAGS=() TUNE_LOG=()
  [[ ${CFG[TUNING]} == on && -r $tuning_file ]] || return 0
  tune_facts "$1"
  while IFS= read -r line || [[ -n $line ]]; do
    n=$((n + 1))
    why=""; [[ $line == *"#"* ]] && why=${line#*#} && why=${why#"${why%%[![:space:]]*}"}
    line=${line%%#*}; line=${line%"${line##*[![:space:]]}"}; line=${line#"${line%%[![:space:]]*}"}
    [[ -n $line ]] || continue
    if [[ ! $line =~ ^when[[:space:]]+([^:]+):[[:space:]]*(env|flag|note)[[:space:]]+(.+)$ ]]; then
      twarn "$tuning_file line $n is not a rule ('when CONDITIONS: env|flag|note ...'); ignored"; continue
    fi
    conds=${BASH_REMATCH[1]} act=${BASH_REMATCH[2]} arg=${BASH_REMATCH[3]} ok=1
    IFS=',' read -ra cs <<<"$conds"
    for c in "${cs[@]}"; do
      c=${c#"${c%%[![:space:]]*}"}; c=${c%"${c##*[![:space:]]}"}
      if [[ ! $c =~ ^([a-z]+)[[:space:]]*(\>=|\<=|!=|=|\>|\<)[[:space:]]*(.+)$ ]]; then twarn "$tuning_file line $n: cannot read the condition '$c'; rule ignored"; ok=0; break; fi
      k=${BASH_REMATCH[1]} op=${BASH_REMATCH[2]} v=${BASH_REMATCH[3]}
      tune_cond "$k" "$op" "$v" && rc=0 || rc=$?
      if ((rc == 2)); then twarn "$tuning_file line $n: unknown condition '$k'; rule ignored"; ok=0; break; fi
      ((rc == 0)) || { ok=0; break; }
    done
    ((ok)) || continue
    case $act in
      env)
        [[ $arg =~ ^([A-Za-z_][A-Za-z0-9_]*)=(.*)$ ]] || { twarn "$tuning_file line $n: 'env' needs NAME=VALUE"; continue; }
        name=${BASH_REMATCH[1]}
        if [[ -v $name ]]; then TUNE_LOG+=("line $n: kept your $name=${!name} instead of $arg"); continue; fi
        for t in "${FIT_FLAGS[@]}"; do [[ $t == "$name="* ]] && { TUNE_LOG+=("line $n: kept your $t"); continue 2; }; done
        TUNE_ENV+=("$arg"); TUNE_LOG+=("line $n: $arg${why:+ ($why)}") ;;
      flag)
        if [[ $1 == ollama ]]; then TUNE_LOG+=("line $n: skipped, 'ollama serve' takes no flags"); continue; fi
        read -ra t <<<"$arg"
        for c in "${FIT_FLAGS[@]}"; do [[ $c == "${t[0]}" || $c == "${t[0]}="* ]] && { TUNE_LOG+=("line $n: kept your own ${t[0]}"); continue 2; }; done
        if [[ $1 == llama ]] && ((preflight)) && ! llama_help_has "${t[0]}"; then
          LLAMA_HELP=${LLAMA_HELP:-x}; [[ $LLAMA_HELP == *--ctx-size* ]] && { TUNE_LOG+=("line $n: skipped, this llama.cpp build has no ${t[0]}"); continue; }
        fi
        TUNE_FLAGS+=("${t[@]}"); TUNE_LOG+=("line $n: $arg${why:+ ($why)}") ;;
      note) TUNE_LOG+=("line $n: note: $arg") ;;
    esac
  done < "$tuning_file"
  TUNE_WARNED=1
  return 0
}
write_tuning_template() {
  [[ -e $tuning_file ]] && return 0
  mkdir -p "$config_dir"
  cat > "$tuning_file" <<'TPL'
# llmserver tuning rules: environment variables or engine flags applied only on matching systems.
#
#   when CONDITION[, CONDITION...]: ACTION        # text after # is shown as the reason
#
# Conditions (about the GPUs the chosen engine will use):
#   engine=llama|vllm|ollama   vendor=nvidia|amd|mixed|none   backend=cuda|rocm|vulkan|cpu|...
#   gpus>=N   vram>=GB (smallest GPU)   driver>=X (NVIDIA driver)   cc>=X (NVIDIA compute capability)
#   rocm>=X (ROCm version)   gfx=PATTERN (AMD target, e.g. gfx9*)   model=PATTERN
#   '=' and '!=' accept * wildcards; '<', '<=', '>', '>=' compare versions.
# Actions:
#   env NAME=VALUE             set an environment variable for the engine
#   flag --engine-flag [VALUE] add an engine flag (llama.cpp and vLLM)
#   note TEXT                  only print TEXT
#
# A rule never overrides a variable that is already set in your environment or a flag you passed.
# 'llmserver check' lists the rules that apply, and --dry-run shows the resulting command. Measure
# with 'llmserver bench' before and after enabling a rule.
#
# Example, from AMD's ROCm blog of 2026-10-20 about single-request inference: on ROCm 10.0 the
# default of 4 hardware queues made their optimized path 10-25% slower. Untested elsewhere.
# when vendor=amd, rocm>=10.0, rocm<10.1: env GPU_MAX_HW_QUEUES=1   # fewer hardware queues on ROCm 10.0
TPL
}

# ---- speculative decoding ----------------------------------------------------
# A small draft model proposes several tokens; the served model checks them all in one pass.
# The draft comes from --draft or from 'draft=' in a menu entry; 'draft-n=' or --draft-n sets
# how many tokens it proposes per step. Its memory is counted in the fit check.
D_ENGINE="" D_MODEL="" D_SPEC="" D_N="" DRAFT_KVEL=0
PORT_TOKEN=""   # port= in a menu entry: the port that model always gets
resolve_draft() {  # ENGINE EXTRA -> D_*, PORT_TOKEN; strips draft= / draft-n= / port= from EXTRA. Status 1 + R_ERR on a bad draft
  local t ds="" dn="" toks=() keep=()
  read -ra toks <<<"$EXTRA"
  for t in "${toks[@]}"; do
    case $t in draft=*) ds=${t#draft=} ;; draft-n=*) dn=${t#draft-n=} ;; port=*) PORT_TOKEN=${t#port=} ;; *) keep+=("$t") ;; esac
  done
  EXTRA="${keep[*]}"
  [[ -n ${opt_draft-} ]] && ds=$opt_draft
  [[ -n ${opt_draft_n-} ]] && dn=$opt_draft_n
  ((no_draft)) && ds=""
  D_ENGINE="" D_MODEL="" D_SPEC="" D_N=${dn:-${CFG[DRAFT_N]}} DRAFT_W=0 DRAFT_KVEL=0
  [[ -n $ds ]] || return 0
  if [[ ! $D_N =~ ^[0-9]+$ ]] || ((D_N < 1 || D_N > 64)); then R_ERR="the draft length must be 1-64, got '$D_N'"; return 1; fi
  case $ENGINE in
    ollama) R_ERR="Ollama has no speculative decoding; serve the model with llama.cpp or vLLM to use a draft"; return 1 ;;
    llama)
      [[ $ds == ngram ]] && { R_ERR="'ngram' drafting is offered for vLLM only; give llama.cpp a small GGUF model of the same family as its draft"; return 1; }
      parse_spec "$ds" llama || { R_ERR="draft: $R_ERR"; return 1; }
      [[ $R_ENGINE == llama ]] || { R_ERR="a llama.cpp draft must be a GGUF repo (llama:ORG/REPO-GGUF:QUANT)"; return 1; } ;;
    vllm)
      if [[ $ds == ngram ]]; then D_SPEC=ngram; return 0; fi
      parse_spec "$ds" vllm || { R_ERR="draft: $R_ERR"; return 1; }
      [[ $R_ENGINE == vllm ]] || { R_ERR="a vLLM draft must be a Hugging Face repo (vllm:ORG/REPO) or 'ngram'"; return 1; } ;;
  esac
  D_ENGINE=$R_ENGINE D_MODEL=$R_MODEL D_SPEC=$R_SPEC
}
draft_info() {  # [offline] size the draft -> DRAFT_W, DRAFT_KVEL. Clobbers MI_*: call before the main model_info
  DRAFT_W=0 DRAFT_KVEL=0
  [[ -n $D_MODEL ]] || return 0
  model_info "$D_ENGINE" "$D_MODEL" "${1-0}"
  DRAFT_W=$MI_W DRAFT_KVEL=$MI_KVEL
  ((DRAFT_W > 0)) || [[ ${1-0} == 1 ]] || warn "the draft model $D_SPEC could not be sized, so its memory is not counted"
  return 0
}
draft_flags() {  # append the engine's speculative-decoding flags to AUTO_FLAGS
  local t js
  [[ -n $D_SPEC ]] || return 0
  for t in "${FIT_FLAGS[@]}"; do
    case $t in
      -hfd|--hf-repo-draft|-md|--model-draft|--speculative-config|--speculative-config=*)
        warn "your engine flags already configure speculative decoding, so --draft / draft= is ignored"; return 0 ;;
    esac
  done
  case $ENGINE in
    llama)
      if ! llama_help_has -md || ! llama_help_has --draft-max; then
        die "this llama.cpp build has no draft-model options (-md, --draft-max); update llama.cpp or drop the draft. Nothing was stopped"
      fi
      AUTO_FLAGS+=(-md "${D_PATH:-<checked ${D_MODEL%%@*} GGUF>}" --draft-max "$D_N") ;;
    vllm)
      if [[ $D_SPEC == ngram ]]; then
        js="{\"method\":\"ngram\",\"num_speculative_tokens\":$D_N,\"prompt_lookup_max\":4}"
      else
        js="{\"model\":\"${D_MODEL%%@*}\",\"num_speculative_tokens\":$D_N"
        if [[ -n ${D_COMMIT-} ]]; then js+=",\"revision\":\"$D_COMMIT\""
        elif [[ $D_MODEL == *@* ]]; then js+=",\"revision\":\"${D_MODEL#*@}\""; fi
        js+="}"
      fi
      AUTO_FLAGS+=(--speculative-config "$js") ;;
  esac
  info "speculative decoding: $D_SPEC proposes $D_N token(s) per step; '$PROG bench' (and a run with --no-draft) shows whether it helps"
}
entry_prepare() {  # menu index -> ENGINE MODEL EXTRA FIT_FLAGS and draft sizes, for list/check; status 1 on a bad draft
  local i=$1 rc=0
  ENGINE=${specs[i]%%:*} MODEL=${specs[i]#*:} EXTRA=${extras[i]}
  local opt_draft="" opt_draft_n=""   # command-line drafts apply to the model being served, not the whole menu
  resolve_draft || rc=1
  draft_info 1
  FIT_FLAGS=(); read -ra FIT_FLAGS <<<"$EXTRA"
  return "$rc"
}

# ---- bench and speed estimates -----------------------------------------------
# Generating a token reads every active weight once, so decode speed is close to memory
# bandwidth / bytes per token. 'bench' measures the running server; from a model that sits
# entirely on the GPU it derives the effective bandwidth of those GPUs (or of the CPU) and
# stores it, so the advisor can estimate the speed of any other model on this machine.
bench_file=$state_dir/bench.tsv
calib_file=$state_dir/calibration
gpu_key() {  # the GPU set an engine uses (from V_DESC) -> "name+name"
  local d=${1:-cpu} out="" part
  [[ $d == cpu || -z $d ]] && { echo cpu; return; }
  IFS=',' read -ra parts <<<"$d"
  for part in "${parts[@]}"; do
    part=${part#"${part%%[![:space:]]*}"}
    [[ $part =~ ^[A-Za-z]+[0-9]+:[[:space:]]*(.*)$ ]] && part=${BASH_REMATCH[1]}
    out+="${out:+ + }$part"
  done
  printf '%s\n' "$out"
}
active_mib() {  # weights read per generated token (mixture-of-experts reads only the routed experts)
  if ((MI_EXPERTS > 0 && MI_EUSED > 0)); then
    echo $((MI_W * (10 * MI_EXPERTS + 90 * MI_EUSED) / (100 * MI_EXPERTS)))
  else echo "$MI_W"; fi
}
calib_get() {  # key [engine] -> per-device bandwidth in MB/s, preferring the same engine
  local key=$1 e=${2-} k ce bw _ best="" any=""
  [[ -r $calib_file ]] || return 1
  while IFS=$'\t' read -r k ce bw _; do
    [[ $k == "$key" && $bw =~ ^[0-9]+$ ]] || continue
    any=$bw; [[ $ce == "$e" ]] && best=$bw
  done < "$calib_file"
  [[ -n ${best:-$any} ]] || return 1
  echo "${best:-$any}"
}
calib_lookup() {  # GPU set -> MB/s for one device; a set is as fast as its slowest member
  local key=$1 e=$2 bw part min=""
  if bw=$(calib_get "$key" "$e"); then echo "$bw"; return 0; fi
  [[ $key == *" + "* ]] || return 1
  IFS='+' read -ra parts <<<"$key"
  for part in "${parts[@]}"; do
    part=${part#"${part%%[![:space:]]*}"}; part=${part%"${part##*[![:space:]]}"}
    bw=$(calib_get "$part" "$e") || return 1
    [[ -z $min ]] || ((bw < min)) && min=$bw
  done
  echo "$min"
}
DRAFT_W=${DRAFT_W:-0}
F_TPS="" F_TPS_LONG="" F_TPS_SRC=""
speed_est() {  # after fit_eval: expected decode tokens/s from measured bandwidth
  local e=$1 act bytes gbw cbw eff kvlong frac t10
  F_TPS="" F_TPS_LONG="" F_TPS_SRC=""
  ((MI_W > 0)) || return 0
  act=$(( $(active_mib) * 1048576 + DRAFT_W * 1048576 / 4 ))
  kvlong=$((F_KVTOK * F_CTX))
  case $F_RATING in
    good|tight)
      gbw=$(calib_lookup "$(gpu_key "$V_DESC")" "$e") || return 0
      eff=$gbw; [[ $e == vllm ]] && eff=$((gbw * F_TP * 85 / 100))
      F_TPS=$((eff * 1000000 / act)); F_TPS_LONG=$((eff * 1000000 / (act + kvlong)))
      F_TPS_SRC="GPU bandwidth measured by '$PROG bench'" ;;
    cpu)
      cbw=$(calib_get cpu "$e" || calib_get cpu) || return 0
      F_TPS=$((cbw * 1000000 / act)); F_TPS_LONG=$((cbw * 1000000 / (act + kvlong)))
      F_TPS_SRC="CPU bandwidth measured by '$PROG bench'" ;;
    offload)
      gbw=$(calib_lookup "$(gpu_key "$V_DESC")" "$e") || return 0
      cbw=$(calib_get cpu "$e" || calib_get cpu) || return 0
      frac=$F_FRAC; bytes=$((act + kvlong / 2))
      # time per token = GPU share / GPU bandwidth + CPU share / CPU bandwidth (in microseconds)
      t10=$(( bytes * frac / 100 / gbw + bytes * (100 - frac) / 100 / cbw ))
      ((t10 > 0)) && F_TPS=$((1000000 / t10))
      F_TPS_SRC="GPU and CPU bandwidth measured by '$PROG bench'" ;;
  esac
  return 0
}
speed_line() {  # human summary of F_TPS*
  if [[ -n $F_TPS ]]; then
    printf 'expected generation speed about %s tokens/s' "$F_TPS"
    [[ -n $F_TPS_LONG && $F_TPS_LONG != "$F_TPS" && $F_TPS_LONG -gt 0 ]] && printf ' (about %s near a full %s-token context)' "$F_TPS_LONG" "$F_CTX"
    printf ', from %s\n' "$F_TPS_SRC"
  fi
}
bench_view() {  # engine "G:MiB,..." -> V_* limited to the GPUs a running model sits on (as if alone)
  local g p keep=()
  gpu_view "$1"; view_mode total
  [[ -n $2 ]] || return 0
  for p in "${!V_IDX[@]}"; do
    g=${V_IDX[p]}
    ((g >= 0)) && (($(usage_on "$2" "$g") > 0)) && keep+=("$p")
  done
  ((${#keep[@]})) || return 0
  local at=() af=() ax=() an=()
  for p in "${keep[@]}"; do at+=("${V_T[p]}") af+=("${V_F[p]}") ax+=("${V_IDX[p]}") an+=("${V_N[p]}"); done
  V_T=("${at[@]}") V_F=("${af[@]}") V_IDX=("${ax[@]}") V_N=("${an[@]}")
  V_DESC=$(IFS=','; printf '%s' "${V_N[*]}"); V_DESC=${V_DESC//,/, }
}
median() { printf '%s\n' "$@" | sort -g | awk '{a[NR]=$1} END {if (NR) print (NR % 2 ? a[(NR+1)/2] : (a[NR/2] + a[NR/2+1]) / 2)}'; }
B_TTFT="" B_PREFILL="" B_TPS="" B_PTOK="" B_CTOK="" B_GEN="" B_E2E="" B_TPOT="" B_ITL50="" B_ITL90="" B_ITL99="" B_THINK=0
bench_series() {  # base model key prompt-tokens -> medians over the runs in B_* (times in seconds, ITL/TPOT in ms)
  local i r kv ttft=() pre=() tps=() gen=() e2e=() tpot=() i50=() i90=() i99=() ptok=0 ctok=0 think=0
  pyinfo bench "$1" "$2" "$3" "$4" "$b_gen" >/dev/null  # warm-up
  for ((i = 0; i < b_runs; i++)); do
    r=$(pyinfo bench "$1" "$2" "$3" "$4" "$b_gen")
    [[ $r == err=* ]] && die "the benchmark request failed (${r#err=}); is the server still answering? '$PROG ps'"
    local t=0 g=0 e=0 p=0 c=0 a50=0 a90=0 a99=0 th=0
    for kv in $r; do
      case $kv in ttft=*) t=${kv#*=} ;; gen=*) g=${kv#*=} ;; e2e=*) e=${kv#*=} ;; ptok=*) p=${kv#*=} ;; ctok=*) c=${kv#*=} ;;
        itl50=*) a50=${kv#*=} ;; itl90=*) a90=${kv#*=} ;; itl99=*) a99=${kv#*=} ;; think=*) th=${kv#*=} ;; esac
    done
    ((p > 0)) || p=$4
    ttft+=("$t") gen+=("$g") e2e+=("$e") i50+=("$a50") i90+=("$a90") i99+=("$a99"); ptok=$p ctok=$c think=$th
    pre+=("$(awk -v p="$p" -v t="$t" 'BEGIN {print (t > 0 ? p / t : 0)}')")
    tps+=("$(awk -v c="$c" -v g="$g" 'BEGIN {print (g > 0 && c > 1 ? (c - 1) / g : 0)}')")
    tpot+=("$(awk -v c="$c" -v g="$g" 'BEGIN {print (c > 1 ? g * 1000 / (c - 1) : 0)}')")
  done
  B_TTFT=$(median "${ttft[@]}") B_PREFILL=$(median "${pre[@]}") B_TPS=$(median "${tps[@]}") B_PTOK=$ptok B_CTOK=$ctok
  B_GEN=$(median "${gen[@]}") B_E2E=$(median "${e2e[@]}") B_TPOT=$(median "${tpot[@]}") B_THINK=$think
  B_ITL50=$(median "${i50[@]}") B_ITL90=$(median "${i90[@]}") B_ITL99=$(median "${i99[@]}")
}
bench_json() {  # name of an associative array of bench figures -> JSON object
  local -n F=$1
  jo prompt_tokens "$(jn "${F[ptok]}")" ttft_s "$(jn "${F[ttft]}")" prompt_tokens_per_s "$(jn "${F[pre]}")" \
    generated_tokens "$(jn "${F[ctok]}")" generation_s "$(jn "${F[gen]}")" decode_tokens_per_s "$(jn "${F[tps]}")" \
    tpot_ms "$(jn "${F[tpot]}")" itl_p50_ms "$(jn "${F[itl50]}")" itl_p90_ms "$(jn "${F[itl90]}")" itl_p99_ms "$(jn "${F[itl99]}")" \
    e2e_s "$(jn "${F[e2e]}")" thinking_chunks "$(jn "${F[think]}")"
}
# shellcheck disable=SC2059   # the format is the caller's fixed unit pattern
bench_table() {  # label value-short [value-long] [unit format]: one row of the report
  local label=$1 a=$2 b=$3 f=${4:-%.2f}
  printf '  %-22s %16s' "$label" "$( [[ $a == - ]] && echo - || printf "$f" "$a")"
  [[ -n $b ]] && printf ' %16s' "$( [[ $b == - ]] && echo - || printf "$f" "$b")"
  echo
}
cmd_bench() {
  local e m base key="" ctx long draft args cmdline tp s_ttft s_tps s_ptok l_ttft="" l_pre="" l_tps="" l_ptok=0 bw key2 kvb
  if ((b_history)); then
    [[ -s $bench_file ]] || { echo "No benchmark results yet; start a server and run '$PROG bench'."; return 0; }
    printf '%-16s  %-40s %7s %8s %7s | %6s %9s %7s  %s\n' "date" "model" "ctx" "TTFT s" "tok/s" "long" "prefill/s" "tok/s" "draft, flags"
    tail -n 20 "$bench_file" | while IFS=$'\t' read -r d sp ct dr fl st stp lp _ lpre ltp; do
      [[ $dr == - ]] && dr="" ; [[ $fl == - ]] && fl=""
      printf '%-16s  %-40s %7s %8s %7s | %6s %9s %7s  %s\n' "$d" "${sp:0:40}" "$ct" "$st" "$stp" "$lp" "$lpre" "$ltp" "${dr:+draft $dr; }$fl"
    done
    return 0
  fi
  helper_python >/dev/null || runtime_ready || die "bench needs llmserver's runtime; run '$PROG install runtime'"
  running_scan
  if [[ -n $sel ]]; then rec_select "$sel" || die "$R_ERR"
  elif ((${#R_FILES[@]} == 1)); then REC=${R_FILES[0]}
  elif ((${#R_FILES[@]} == 0)); then die "no model started by $PROG is running; start one (for example '$PROG 1'), then run '$PROG bench'"
  else die "several models are running; say which to measure: '$PROG bench MODEL' (a name, menu number or port; see '$PROG ps')"; fi
  load_rec "$REC"
  e=${ST[ENGINE]} m=${ST[MODEL]} ctx=${ST[CTX]-} draft=${ST[DRAFT]-}
  base="http://$(hostport "$(connect_host "${ST[HOST]}")" "${ST[PORT]}")"
  [[ -s $key_file ]] && key=$(<"$key_file")
  cmdline=""; [[ -n ${ST[PID]-} ]] && cmdline=$(tr '\0' ' ' 2>/dev/null < "/proc/${ST[PID]}/cmdline" || true)
  info "benchmarking ${ST[SPEC]}: $b_runs run(s) per prompt after a warm-up, $b_gen tokens generated per run"
  bench_series "$base" "$(model_id "$e" "$m")" "$key" 128
  s_ttft=$B_TTFT s_tps=$B_TPS s_ptok=$B_PTOK
  local -A S=([ptok]=$B_PTOK [ctok]=$B_CTOK [ttft]=$B_TTFT [pre]=$B_PREFILL [gen]=$B_GEN [tps]=$B_TPS [tpot]=$B_TPOT
    [itl50]=$B_ITL50 [itl90]=$B_ITL90 [itl99]=$B_ITL99 [e2e]=$B_E2E [think]=$B_THINK)
  local -A LG=()
  ((B_CTOK >= b_gen * 9 / 10)) || warn "the model stopped after $B_CTOK of $b_gen tokens (this engine ignored ignore_eos); speeds are based on fewer tokens"
  # the long prompt must fit the context the server really has (with 'auto' only the server knows it;
  # Ollama loads the model on first use, so this is asked after the short runs)
  local real; real=$(server_ctx)
  [[ $ctx =~ ^[0-9]+$ ]] || ctx=$real
  ((real > 0 && real < ctx)) && ctx=$real
  long=${b_long:-8192}
  if [[ $ctx =~ ^[0-9]+$ ]] && ((ctx > 0 && long > ctx - b_gen - 64)); then
    long=$((ctx - b_gen - 64))
    [[ -n $b_long ]] && warn "--long $b_long does not fit the server's context ($ctx tokens); measuring with $long"
  fi
  ((long >= 1024)) || { long=0; [[ $ctx =~ ^[0-9]+$ ]] && ((ctx > 0)) && info "the server's context is $ctx tokens, too small for the long-prompt measurement"; }
  if [[ $e == ollama ]] && ollama_load "${base#http://}" && ((OL_SIZE > 0 && OL_VRAM < OL_SIZE)); then
    warn "Ollama keeps $((100 - OL_VRAM * 100 / OL_SIZE))% of this model in system RAM (no room on the GPUs), so generation runs partly on the CPU and is much slower than the GPUs allow. Stop other models ('$PROG ps') and restart this one ('$PROG ${ST[SPEC]} --restart') to measure it on the GPUs alone"
  fi
  if ((long > 0)); then
    bench_series "$base" "$(model_id "$e" "$m")" "$key" "$long"
    l_ttft=$B_TTFT l_pre=$B_PREFILL l_tps=$B_TPS l_ptok=$B_PTOK
    LG=([ptok]=$B_PTOK [ctok]=$B_CTOK [ttft]=$B_TTFT [pre]=$B_PREFILL [gen]=$B_GEN [tps]=$B_TPS [tpot]=$B_TPOT
      [itl50]=$B_ITL50 [itl90]=$B_ITL90 [itl99]=$B_ITL99 [e2e]=$B_E2E [think]=$B_THINK)
  fi
  # one real answer: how long the model thinks, and when the answer starts
  local cr="" kv; local -A C=()
  ((json)) || info "asking one real question to measure thinking and answer separately${opt_reasoning:+ (reasoning: $opt_reasoning)}"
  cr=$(pyinfo bench-chat "$base" "$(model_id "$e" "$m")" "$key" "$opt_reasoning" "$e")
  if [[ $cr == err=* ]]; then ((json)) || warn "the chat measurement failed (${cr#err=}); the numbers above are still valid"; cr=""
  else for kv in $cr; do C[${kv%%=*}]=${kv#*=}; done; fi
  local thinking=0; [[ ${C[think_tok]:-0} -gt 0 ]] && thinking=1
  if ((json)); then
    local js_s js_l="null" js_c="null"
    js_s=$(bench_json S); ((long > 0)) && js_l=$(bench_json LG)
    [[ -n $cr ]] && js_c=$(jo ttft_s "$(jn "${C[ttft]}")" thinking_tokens "$(jn "${C[think_tok]}")" thinking_s "$(jn "${C[think_s]}")" \
      time_to_answer_s "$(jn "${C[ttfa]}")" answer_tokens "$(jn "${C[ans_tok]}")" answer_s "$(jn "${C[ans_s]}")" e2e_s "$(jn "${C[e2e]}")" \
      output_tokens "$(jn "${C[ctok]}")" reasoning "$(js "${opt_reasoning:-default}")")
    jo model "$(js "${ST[SPEC]}")" engine "$(js "$e")" runs "$(jn "$b_runs")" generated_tokens "$(jn "$b_gen")" context "$(jn "${ctx:-}")" \
      short "$js_s" long "$js_l" chat "$js_c"; echo
  else
    echo
    printf '  %-22s %16s' "" "short prompt"; ((long > 0)) && printf ' %16s' "long prompt"; echo
    bench_table "prompt tokens" "${S[ptok]}" "${LG[ptok]:-}" '%d'
    echo "  Prefill (reading the prompt)"
    bench_table "  TTFT (first token)" "${S[ttft]}" "${LG[ttft]:-}" '%.2f s'
    bench_table "  prompt speed" "-" "${LG[pre]:-}" '%.0f tok/s'
    echo "  Decode (writing the answer)"
    bench_table "  tokens generated" "${S[ctok]}" "${LG[ctok]:-}" '%d'
    bench_table "  generation time" "${S[gen]}" "${LG[gen]:-}" '%.2f s'
    bench_table "  decode speed" "${S[tps]}" "${LG[tps]:-}" '%.1f tok/s'
    bench_table "  TPOT (per token)" "${S[tpot]}" "${LG[tpot]:-}" '%.1f ms'
    bench_table "  ITL p50" "${S[itl50]}" "${LG[itl50]:-}" '%.1f ms'
    bench_table "  ITL p90" "${S[itl90]}" "${LG[itl90]:-}" '%.1f ms'
    bench_table "  ITL p99" "${S[itl99]}" "${LG[itl99]:-}" '%.1f ms'
    echo "  End to end"
    bench_table "  E2E latency" "${S[e2e]}" "${LG[e2e]:-}" '%.2f s'
    ((${S[think]:-0} > 0)) && echo "  (the server streamed these tokens as thinking; they are counted as generated tokens)"
    if [[ -n $cr ]]; then
      echo
      echo "  One real answer${opt_reasoning:+ (reasoning: $opt_reasoning)}"
      printf '    %-22s %s\n' "TTFT (first token)" "$(printf '%.2f s' "${C[ttft]}")"
      if ((thinking)); then
        printf '    %-22s %s\n' "thinking" "$(printf '%d token%s in %.1f s' "${C[think_tok]}" "$( ((C[think_tok] == 1)) || echo s)" "${C[think_s]}")"
        printf '    %-22s %s\n' "time to answer" "$(printf '%.2f s (the first answer token, after the thinking)' "${C[ttfa]}")"
      else
        printf '    %-22s %s\n' "thinking" "none (the model answered directly)"
      fi
      printf '    %-22s %s\n' "answer" "$(printf '%d token%s in %.1f s' "${C[ans_tok]}" "$( ((C[ans_tok] == 1)) || echo s)" "${C[ans_s]}")"
      printf '    %-22s %s\n' "E2E latency" "$(printf '%.2f s for %d tokens' "${C[e2e]}" "${C[ctok]}")"
    fi
    echo
    echo "  TTFT: time to first token. TPOT: time per output token after the first (decode). ITL: the gaps between"
    echo "  tokens as they arrive (p50 typical, p99 the slowest 1%). E2E: from the request to the last token."
    echo "  Medians of $b_runs run(s) after a warm-up; decode runs generate exactly $b_gen tokens (ignore_eos)."
    echo
  fi
  [[ -n $draft || $cmdline == *--speculative-config* || $cmdline == *" -hfd "* || $cmdline == *--model-draft* ]] && draft=${draft:-on}
  if [[ -n $draft ]]; then
    info "speculative decoding is on ($draft). Its gain depends on how predictable the text is, and these prompts are synthetic; compare against a run with '--no-draft', and judge by tokens/s, not by how many drafted tokens were accepted"
  fi
  mkdir -p "$state_dir"
  local flags; flags=$(sed -E 's/.*--port [0-9]+ ?//; s/--api-key [^ ]+//' <<<"$cmdline" | cut -c1-60)
  [[ -n ${ST[TUNE]-} ]] && flags="${ST[TUNE]} $flags"
  if ((long == 0)); then l_ptok=- l_ttft=- l_pre=- l_tps=-; else l_pre=$(printf '%.0f' "$l_pre") l_tps=$(printf '%.1f' "$l_tps"); fi
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$(date '+%Y-%m-%d %H:%M')" "${ST[SPEC]}" "${ctx:-?}" "${draft:--}" \
    "${flags:--}" "$(printf '%.2f' "$s_ttft")" "$(printf '%.1f' "$s_tps")" "$l_ptok" "$l_ttft" "$l_pre" "$l_tps" >> "$bench_file"
  info "saved to the history; '$PROG bench --history' compares runs"

  # calibrate: only a model that sits entirely on the GPU (or entirely on the CPU), without drafting
  [[ -z $draft ]] || return 0
  model_info "$e" "$m" 1
  ((MI_W > 0)) || return 0
  FIT_FLAGS=(); read -ra FIT_FLAGS <<<"$cmdline"
  bench_view "$e" "$(rec_usage)"
  fit_core "$e" "${ctx:-auto}"
  kvb=$((F_KVTOK * (s_ptok + b_gen / 2)))
  bw=$(awk -v t="$s_tps" -v b="$(( $(active_mib) * 1048576 + kvb ))" 'BEGIN {printf "%d", t * b / 1000000}')
  ((bw > 0)) || return 0
  case $F_RATING in
    good|tight)
      tp=$(flag_in -tp --tensor-parallel-size); [[ $tp =~ ^[0-9]+$ ]] || tp=1
      [[ $e == vllm ]] && bw=$((bw * 100 / (85 * tp)))
      key2=$(gpu_key "$V_DESC") ;;
    cpu) key2=cpu ;;
    *) info "this model runs partly on the CPU, so the result is not used to estimate other models' speed"; return 0 ;;
  esac
  { [[ -r $calib_file ]] && grep -v -F "$key2"$'\t'"$e"$'\t' "$calib_file"; printf '%s\t%s\t%s\t%s\n' "$key2" "$e" "$bw" "$(date +%F)"; } > "$calib_file.tmp" && mv -f "$calib_file.tmp" "$calib_file"
  info "effective memory bandwidth of $([[ $key2 == cpu ]] && echo 'the CPU' || echo "$key2") with $e: about $((bw / 1000)) GB/s; '$PROG check' now estimates generation speed for other models from it"
}

# ---- JSON views ----------------------------------------------------------------
# The same data the text commands print, for tools: every size is in MiB, every time in
# seconds, GPU numbers are llmserver's own (as 'check' prints them), and missing values are null.
json_gpu() {  # G [key value...] -> GPU object
  local i=$1; shift
  jo index "$i" vendor "$(js "${G_VENDOR[i]}")" name "$(js "${G_NAME[i]}")" \
    total_mib "$(jn "${G_TOTAL[i]}")" used_mib "$(jn "${G_USED[i]}")" free_mib "$(jn $((G_TOTAL[i] - G_USED[i])))" \
    usable "$(jt gpu_allowed "$i")" excluded_reason "$(if gpu_allowed "$i"; then printf null; else js "$(gpu_why_not "$i")"; fi)" \
    compute "$(js "${G_CAP[i]}")" numa_node "$(jn "${G_NUMA[i]:--1}")" partition "$(js "${G_PART[i]}")" \
    bus_id "$(js "${G_BUS[i]-}")" uuid "$(js "${G_UUID[i]-}")" "$@"
}
json_limits() {
  container_probe
  local masks=()
  [[ $INH_CUDA != __unset__ ]] && masks+=(CUDA_VISIBLE_DEVICES "$(js "$INH_CUDA")")
  [[ $INH_ROCR != __unset__ ]] && masks+=(ROCR_VISIBLE_DEVICES "$(js "$INH_ROCR")")
  [[ $INH_HIP != __unset__ ]] && masks+=(HIP_VISIBLE_DEVICES "$(js "$INH_HIP")")
  jo container "$([[ -n $CT_KIND ]] && js "$CT_KIND" || printf null)" \
    memory_limit_mib "$( ((CT_MEM_LIMIT > 0)) && jn "$CT_MEM_LIMIT" || printf null)" memory_used_mib "$( ((CT_MEM_LIMIT > 0)) && jn "$CT_MEM_USED" || printf null)" \
    cpu_quota "$(jn "$CT_CPU_QUOTA")" cpus_allowed "$(js "$CT_CPUS")" cpus_allowed_count "$(jn "$CT_NCPU")" \
    inherited_gpu_masks "$(jo "${masks[@]}")"
}
json_hw() {  # hardware object: GPUs, RAM, NUMA nodes and limits
  local i gpus=() nodes
  detect_hw
  nodes=$( { compgen -G "$sysfs/devices/system/node/node[0-9]*" || true; } | wc -l)
  for i in "${!G_VENDOR[@]}"; do gpus+=("$(json_gpu "$i")"); done
  jo gpus "$(ja "${gpus[@]}")" ram "$(jo total_mib "$(jn "$RAM_TOTAL")" available_mib "$(jn "$RAM_AVAIL")" host_total_mib "$(jn "$RAM_HOST")")" \
    numa_nodes "$(jn "$nodes")" limits "$(json_limits)"
}
json_usage() {  # "G:MiB,..." -> [{"gpu":G,"mib":M},...]
  local kv items=()
  IFS=',' read -ra kvs <<<"$1"
  for kv in "${kvs[@]}"; do [[ $kv == *:* ]] && items+=("$(jo gpu "$(jn "${kv%%:*}")" mib "$(jn "${kv#*:}")")"); done
  ja "${items[@]}"
}
json_rec() {  # ST -> running-model object
  local u gp=() kv cpu=null
  u=$(rec_usage)
  if [[ ${ST[ENGINE]} == ollama ]] && ollama_load "$(hostport "$(connect_host "${ST[HOST]}")" "${ST[PORT]}")" && ((OL_SIZE > 0)); then
    cpu=$((100 - OL_VRAM * 100 / OL_SIZE))
  fi
  IFS=',' read -ra kvs <<<"$u"
  for kv in "${kvs[@]}"; do [[ $kv == *:* ]] && gp+=("${kv%%:*}"); done
  jo spec "$(js "${ST[SPEC]}")" model "$(js "${ST[MODEL]}")" engine "$(js "${ST[ENGINE]}")" \
    port "$(jn "${ST[PORT]}")" url "$(js "$(rec_url)")" pid "$(jn "${ST[PID]-}")" managed "$(jb "${ST[MANAGED]:-1}")" \
    state "$(js "${ST[STATE]:-ready}")" listening "$(jt rec_listening)" pinned "$(jt is_pinned "${ST[SPEC]}")" \
    gpus "$(ja "${gp[@]}")" vram_mib "$(jn "$(usage_total "$u")")" usage "$(json_usage "$u")" \
    measured "$(jt test -n "${ST[MEAS]-}")" ctx "$(jn "${ST[CTX]-}")" draft "$(js "${ST[DRAFT]-}")" \
    uptime_s "$(jn $(($(date +%s) - ${ST[STARTED]:-0})))" idle_s "$(jn "$(rec_idle)")" adopted "$(jb "${ST[ADOPTED]:-0}")" \
    run "$(js "${ST[RUN]-}")" log "$(js "${ST[LOG]-}")" commit "$(js "${ST[COMMIT]-}")" trust "$(js "${ST[TRUST]-}")" sandbox "$(js "${ST[SANDBOX]-}")" \
    cpu_percent "$cpu"
}
json_verdict() {  # after advise: the verdict and the figures behind it
  jo rating "$(js "$F_RATING")" need_mib "$(jn "$F_NEED")" usable_mib "$(jn "$F_CAP")" ctx "$(jn "$F_CTX")" \
    fits_ctx "$(jn "$F_CTXFIT")" weights_mib "$(jn "$MI_W")" kv_bytes_per_token "$(jn "$F_KVTOK")" \
    tensor_parallel "$(jn "$F_TP")" gpu_memory_utilization "$(jn "$F_UTIL")" gpu_layers "$(jn "$F_NGL")" on_gpu_percent "$(jn "$F_FRAC")" \
    tokens_per_s "$(jn "$F_TPS")" tokens_per_s_full_ctx "$(jn "$F_TPS_LONG")" sized_from "$(js "${MI_SRC:-}")" \
    message "$(js "$F_MSG")" suggestions "$(jsa "${F_SUGG[@]}")"
}
NOW_STATE="" NOW_GPUS=() NOW_EVICT=() NOW_PORT="" NOW_WHY=""
now_eval() {  # engine model ctx, after a 'total' verdict -> NOW_*: can it start next to what runs now?
  local e=$1 m=$2 w=$3 f
  NOW_STATE="" NOW_GPUS=() NOW_EVICT=() NOW_PORT="" NOW_WHY=""
  running_scan
  if f=$(rec_find "$SPEC"); then load_rec "$f"; NOW_STATE=running NOW_PORT=${ST[PORT]}; return 0; fi
  if ! ok_rating "$F_RATING"; then NOW_STATE=never; return 0; fi
  ((${#R_FILES[@]})) || { NOW_STATE=fits; place "$e" "$m" "$w"; NOW_GPUS=("${PLACE_IDX[@]}"); return 0; }
  plan_start "$e" "$m" "$w"
  case $P_STATE in
    fits|evict|offload) NOW_STATE=$P_STATE ;;
    *) NOW_STATE=blocked NOW_WHY=${R_ERR:-not enough memory} ;;
  esac
  NOW_GPUS=("${PLACE_IDX[@]}")
  for f in "${P_EVICT[@]}"; do load_rec "$f" && NOW_EVICT+=("$(jo spec "$(js "${ST[SPEC]}")" port "$(jn "${ST[PORT]}")" idle_s "$(jn "$(rec_idle)")")"); done
  return 0
}
json_now() {
  jo state "$(js "$NOW_STATE")" gpus "$(ja "${NOW_GPUS[@]}")" port "$(jn "$NOW_PORT")" \
    would_stop "$(ja "${NOW_EVICT[@]}")" reason "$([[ -n $NOW_WHY ]] && js "$NOW_WHY" || printf null)"
}
json_engines() {
  local e items=() ENGINE MODEL="" uses=() k
  for e in llama vllm ollama; do
    if ! engine_installed "$e"; then items+=("$(jo name "$(js "$e")" installed false enabled "$(jt engine_enabled "$e")" source "$(js "$(engine_source "$e")")")"); continue; fi
    gpu_view "$e"; uses=()
    for k in "${!V_N[@]}"; do uses+=("$(jo gpu "$(jn "${V_IDX[k]}")" name "$(js "${V_N[k]}")" total_mib "$(jn "${V_T[k]}")" free_mib "$(jn "${V_F[k]}")")"); done
    [[ $e == vllm ]] && vllm_backend
    ENGINE=$e; FIT_FLAGS=(); tune_rules "$e"
    local ver="" var=""
    if [[ $(engine_source "$e") == managed ]] && comp_meta "$e"; then ver=${CM[VERSION]} var=${CM[VARIANT]}; fi
    items+=("$(jo name "$(js "$e")" installed true enabled "$(jt engine_enabled "$e")" source "$(js "$(engine_source "$e")")" \
      version "$(js "$ver")" build "$(js "$var")" \
      backend "$(js "$([[ $e == vllm ]] && echo "$VLLM_BACKEND" || echo "${V_KIND:-cpu}")")" gpus "$(ja "${uses[@]}")" \
      problem "$([[ -n $C_FATAL ]] && js "$C_FATAL" || printf null)" notes "$(jsa "${C_WARN[@]}")" tuning "$(jsa "${TUNE_LOG[@]}")")")
  done
  ja "${items[@]}"
}

# ---- check command -----------------------------------------------------------
print_hw() {  # [hw-only]
  local i e s
  detect_hw
  NUMA_NODES=$( { compgen -G "$sysfs/devices/system/node/node[0-9]*" || true; } | wc -l)
  echo "${C_B}Hardware${C_0}"
  if ((${#G_VENDOR[@]} == 0)); then echo "  GPU    none found (NVIDIA via nvidia-smi, AMD via the amdgpu driver)"; fi
  for i in "${!G_VENDOR[@]}"; do
    s="  GPU $i  ${G_VENDOR[i]^^}  ${G_NAME[i]}  $(gb "${G_TOTAL[i]}") VRAM, $(gb $((G_TOTAL[i] - G_USED[i]))) free"
    [[ -n ${G_CAP[i]} ]] && s+=", $([[ ${G_VENDOR[i]} == nvidia ]] && echo "compute ${G_CAP[i]}" || echo "${G_CAP[i]}")"
    [[ ${G_VENDOR[i]} == nvidia && -n $NV_DRIVER ]] && s+=", driver $NV_DRIVER"
    [[ ${G_VENDOR[i]} == amd ]] && s+=", ROCm kernel driver $( ((AMD_KFD)) && echo loaded || echo 'not loaded')"
    ((${G_NUMA[i]:--1} >= 0)) && ((NUMA_NODES > 1)) && s+=", NUMA node ${G_NUMA[i]}"
    gpu_allowed "$i" || s+="  (not used: $(gpu_why_not "$i"))"
    echo "$s"
    if [[ ${G_PART[i]} == MIG ]]; then
      echo "         MIG is enabled: engines see MIG instances, each with part of this GPU's memory"
    elif [[ -n ${G_PART[i]} ]]; then
      echo "         partition mode ${G_PART[i]}${G_PARTS[i]:+ (memory modes offered: ${G_PARTS[i]})}"
    fi
  done
  echo "  RAM    $(gb "$RAM_TOTAL"), $(gb "$RAM_AVAIL") available$( ((RAM_TOTAL < RAM_HOST)) && echo " (cgroup limit; the host has $(gb "$RAM_HOST"))" || true)$( ((NUMA_NODES > 1)) && echo ", $NUMA_NODES NUMA nodes (placement: ${CFG[NUMA]})" || true)"
  [[ -n $CT_DESC ]] && echo "  Limits $CT_DESC"
  [[ -z ${1-} ]] || return 0
  echo "${C_B}Engines${C_0}"
  for e in llama vllm ollama; do
    if ! engine_installed "$e"; then
      if [[ $(engine_source "$e") == managed ]]; then printf '  %-7s not installed; %s\n' "$e" "$(plan_line "$e")"
      elif [[ $(engine_where "$e") == PATH ]]; then printf '  %-7s not found on PATH (LLMSERVER_%s_SOURCE=system)\n' "$e" "${e^^}"
      else printf '  %-7s no %s program in %s (LLMSERVER_%s_SOURCE)\n' "$e" "$e" "$(engine_where "$e")" "${e^^}"; fi
      continue
    fi
    if [[ $(engine_source "$e") == managed ]] && comp_meta "$e"; then printf '  %-7s managed %s, %s build\n' "$e" "${CM[VERSION]}" "${CM[VARIANT]}"
    elif [[ $e == ollama && -z $OLLAMA_BIN ]]; then :
    else printf '  %-7s your copy: %s\n' "$e" "$( { [[ $e == llama ]] && echo "$LLAMA_BIN"; } || { [[ $e == vllm ]] && echo "$VLLM_BIN"; } || echo "$OLLAMA_BIN")"; fi
    gpu_view "$e"
    s=""
    case $e in
      llama) if ((LLAMA_DEVS_KNOWN)); then s="build sees: ${V_DESC:-CPU only}"; else s="uses: ${V_DESC:-CPU}"; fi ;;
      vllm) vllm_backend; s="$VLLM_BACKEND build; uses: ${V_DESC:-no GPU}" ;;
      ollama) s="uses: ${V_DESC:-CPU}$([[ -n ${CFG[OLLAMA_ATTACH]} ]] && echo " (daemon at ${CFG[OLLAMA_ATTACH]})" || true)" ;;
    esac
    printf '  %-7s %s\n' "" "$s"
    [[ -n $C_FATAL ]] && printf '          problem: %s\n' "$C_FATAL"
    for s in "${C_WARN[@]}"; do printf '          note: %s\n' "$s"; done
    local ENGINE=$e MODEL=""
    FIT_FLAGS=(); tune_rules "$e"
    for s in "${TUNE_LOG[@]}"; do printf '          tuning rule, %s\n' "$s"; done
  done
}
cmd_check() {  # [model]: hardware report, then advice for one model or every menu entry
  local i e m ctx w r
  if ((json)); then check_json; return 0; fi
  ctx=${CFG[CTX]}
  print_hw
  if [[ -n $sel ]]; then
    choose "$sel" || die "$R_ERR"
    resolve_draft || die "$R_ERR"
    echo "${C_B}Model${C_0}  $SPEC${D_SPEC:+  (draft: $D_SPEC, $D_N tokens per step)}"
    echo "  security: $(trust_summary "$ENGINE" "$MODEL")"
    FIT_FLAGS=()
    case $ENGINE in
      llama) read -ra FIT_FLAGS <<<"${CFG[LLAMA_FLAGS]} $EXTRA" ;;
      vllm) read -ra FIT_FLAGS <<<"${CFG[VLLM_FLAGS]} $EXTRA" ;;
      *) read -ra FIT_FLAGS <<<"$EXTRA" ;;
    esac
    FIT_FLAGS+=("${pass[@]}")
    engine_installed "$ENGINE" || warn "the $ENGINE engine is not installed; judging the hardware only"
    draft_info
    model_info "$ENGINE" "$MODEL"
    ctx=$(ctx_for "$ctx")
    advise "$ENGINE" "$MODEL" total "$ctx" 1 || true
    echo "  verdict: ${F_RATING^^}$(case $MI_SRC in local) echo ' (sized from the downloaded files)' ;; remote) echo ' (sized from the registry before downloading)' ;; cache) echo ' (sized from an earlier lookup)' ;; esac)"
    echo "  $F_MSG" | fold -s -w 100 | sed '2,$s/^/  /'
    [[ $F_RATING == good || $F_RATING == tight ]] && [[ $ctx == fit ]] && echo "  context: $F_CTX tokens (the largest that fits; CTX=fit)"
    [[ $ctx =~ ^[0-9]+$ && $ctx != "${CFG[CTX]}" ]] && echo "  context: $ctx tokens, the most this model supports (LLMSERVER_CTX is ${CFG[CTX]})"
    check_now "$ENGINE" "$MODEL" "$ctx"
    ((F_TP > 1)) && echo "  vLLM will split it over $F_TP GPUs (--tensor-parallel-size $F_TP)"
    if [[ -n $F_TPS ]]; then echo "  speed: $(speed_line)" | fold -s -w 100 | sed '2,$s/^/    /'
    elif [[ $F_RATING != no && $F_RATING != unknown ]]; then echo "  speed: run '$PROG bench' once with a model that fits on the GPU to get speed estimates"; fi
    for i in "${F_SUGG[@]}"; do echo "  suggestion: $i" | fold -s -w 100 | sed '2,$s/^/    /'; done
    tune_rules "$ENGINE"
    for i in "${TUNE_LOG[@]}"; do echo "  tuning rule, $i"; done
    return 0
  fi
  ((${#specs[@]})) || { echo "The menu is empty; '$PROG check MODEL' judges any model."; return 0; }
  echo "${C_B}Menu${C_0} (context: $ctx)"
  mi_prefetch
  for i in "${!specs[@]}"; do
    e=${specs[i]%%:*} m=${specs[i]#*:}
    entry_prepare "$i" || { printf '%3d) %-9s %s\n               %s\n' "$((i + 1))" PROBLEM "$(spec_show "${specs[i]}")" "$R_ERR"; continue; }
    model_info "$e" "$m" 1
    SPEC=${specs[i]}
    w=$(ctx_for "$ctx")
    advise "$e" "$m" total "$w" 2 || true
    r=$F_RATING
    printf '%3d) %-9s %s\n' "$((i + 1))" "${F_RATING^^}" "$(spec_show "${specs[i]}")"
    [[ $F_RATING == unknown ]] || printf '               %s\n' "$(gb "$F_NEED") needed at $F_CTX tokens; $(gb "$F_CAP") usable${F_TPS:+; about $F_TPS tokens/s}"
    if ok_rating "$r"; then
      advise "$e" "$m" now "$w" 2 || true
      ok_rating "$F_RATING" || printf '               right now: %s\n' "only $(gb "$F_CAP") free next to the running models; '$PROG capacity' shows what would have to stop"
    fi
  done
  echo "GOOD fits on the GPU; TIGHT fits with little headroom; OFFLOAD runs partly on the CPU (slow);"
  echo "CPU runs on the CPU only; NO will not run; UNKNOWN could not be sized. These verdicts assume nothing"
  echo "else is running; '$PROG capacity' shows what fits next to the running models. '$PROG check N' explains one entry."
}
check_now() {  # engine model ctx: one line on whether it fits next to what is running now
  local e=$1 m=$2 w=$3 f
  now_eval "$e" "$m" "$w"
  case $NOW_STATE in
    running) echo "  right now: running on port $NOW_PORT" ;;
    never) ;;
    fits) if ((${#R_FILES[@]})); then echo "  right now: fits next to the ${#R_FILES[@]} running model(s), on GPU $(IFS=,; echo "${NOW_GPUS[*]:--}")"
          else echo "  right now: nothing else is running, so the verdict above applies"; fi ;;
    evict) echo "  right now: does not fit next to the running models; starting it would stop: $(for f in "${P_EVICT[@]}"; do load_rec "$f" && printf '%s ' "${ST[SPEC]}"; done)" ;;
    offload) echo "  right now: only partly on the GPU unless other models stop (they are pinned)" ;;
    *) echo "  right now: cannot start: $NOW_WHY" ;;
  esac
  return 0
}
check_json() {
  local i e m w v models=()
  detect_hw
  if [[ -n $sel ]]; then
    choose "$sel" || die "$R_ERR"
    resolve_draft || die "$R_ERR"
    FIT_FLAGS=()
    case $ENGINE in
      llama) read -ra FIT_FLAGS <<<"${CFG[LLAMA_FLAGS]} $EXTRA" ;;
      vllm) read -ra FIT_FLAGS <<<"${CFG[VLLM_FLAGS]} $EXTRA" ;;
      *) read -ra FIT_FLAGS <<<"$EXTRA" ;;
    esac
    FIT_FLAGS+=("${pass[@]}")
    draft_info; model_info "$ENGINE" "$MODEL"
    w=$(ctx_for "${CFG[CTX]}")
    advise "$ENGINE" "$MODEL" total "$w" 2 || true
    v=$(json_verdict)
    tune_rules "$ENGINE"
    local tl; tl=$(jsa "${TUNE_LOG[@]}")
    now_eval "$ENGINE" "$MODEL" "$w"
    models+=("$(jo entry null spec "$(js "$SPEC")" engine "$(js "$ENGINE")" installed "$(jt engine_installed "$ENGINE")" \
      draft "$(js "$D_SPEC")" verdict "$v" right_now "$(json_now)" tuning "$tl")")
  else
    mi_prefetch
    for i in "${!specs[@]}"; do
      e=${specs[i]%%:*} m=${specs[i]#*:} SPEC=${specs[i]}
      if ! entry_prepare "$i"; then models+=("$(jo entry "$((i + 1))" spec "$(js "$SPEC")" engine "$(js "$e")" problem "$(js "$R_ERR")")"); continue; fi
      model_info "$e" "$m" 1
      w=$(ctx_for "${CFG[CTX]}")
      advise "$e" "$m" total "$w" 2 || true
      v=$(json_verdict)
      now_eval "$e" "$m" "$w"
      models+=("$(jo entry "$((i + 1))" spec "$(js "$SPEC")" engine "$(js "$e")" installed "$(jt engine_installed "$e")" \
        draft "$(js "$D_SPEC")" verdict "$v" right_now "$(json_now)")")
    done
  fi
  jo version "$(js "$VERSION")" context "$(js "${CFG[CTX]}")" hardware "$(json_hw)" engines "$(json_engines)" models "$(ja "${models[@]}")"; echo
}
mi_prefetch() {  # look up every menu entry that is neither cached nor known, in parallel
  local i e m todo=()
  for i in "${!specs[@]}"; do
    e=${specs[i]%%:*} m=${specs[i]#*:}
    if ! grep -qF "${specs[i]}"$'\t' "$info_file" 2>/dev/null && ! is_cached "$e" "$m" 2>/dev/null; then todo+=("$i"); fi
  done
  for i in "${todo[@]}"; do (model_info "${specs[i]%%:*}" "${specs[i]#*:}" >/dev/null 2>&1) & done
  wait
  return 0
}


# ---- running models ----------------------------------------------------------
# Every model llmserver starts has a record in $run_dir: engine, port, process (pid, start time
# and boot id, so a reused pid or a reboot is never mistaken for the model), GPUs, the memory it
# was expected to need and the memory it was measured to use. Each model has its own port; a
# model keeps the port it had last time when that port is free.
#
# Consistency: records, ports and pins change only under a short state lock (fd 8), and every
# write goes to a temporary file that is renamed into place, so readers never see half a file.
# Starts and stops also hold the start lock (fd 9) for their whole duration. Both are flock(1)
# locks, which the kernel releases when a process dies, so a crash never leaves a stale lock.
# A crash can still lose a record (killed between spawning a server and recording it) or leave
# models stopped for an eviction; running_scan re-adopts such servers from the marker variables
# every server carries, and 'doctor --fix' restarts the models an interrupted start stopped.
run_dir=$state_dir/running
ports_file=$state_dir/ports
pins_file=$state_dir/pins
BOOT_ID=$(cat /proc/sys/kernel/random/boot_id 2>/dev/null || echo unknown)
STATE_LOCKED=0
state_lock() {  # take the state lock (nests); waits up to 30s
  if ((STATE_LOCKED++)); then return 0; fi
  have flock || return 0
  mkdir -p "$state_dir"
  exec 8>> "$state_dir/state.lock"
  flock -w 30 8 || die "another $PROG has held the state lock for 30s; try again (or run '$PROG doctor')"
}
state_unlock() {
  ((STATE_LOCKED > 0)) || return 0
  STATE_LOCKED=$((STATE_LOCKED - 1))
  if ((STATE_LOCKED == 0)) && have flock; then exec 8>&-; fi
  return 0
}
declare -A ST=()
spec_id() { printf '%s\n' "${1//[^A-Za-z0-9._-]/_}"; }
load_rec() {  # record file -> ST
  local line
  ST=()
  [[ -r $1 ]] || return 1
  while IFS= read -r line; do
    if [[ $line =~ ^([A-Z_]+)=(.*)$ ]]; then ST[${BASH_REMATCH[1]}]=${BASH_REMATCH[2]}; fi
  done < "$1"
  [[ -n ${ST[ENGINE]-} ]]
}
OL_SIZE=0 OL_VRAM=0 OL_CTX=0 PS_CPU=0
ollama_load() {  # host:port -> OL_SIZE OL_VRAM (bytes) and OL_CTX of the loaded model; status 1 when none is loaded
  local ps
  OL_SIZE=0 OL_VRAM=0 OL_CTX=0
  ps=$(lcurl --max-time 3 "http://$1/api/ps" 2>/dev/null) || return 1
  ps=${ps//\": /\":}
  [[ $ps =~ \"size\":([0-9]+) ]] || return 1
  OL_SIZE=${BASH_REMATCH[1]}
  [[ $ps =~ \"size_vram\":([0-9]+) ]] && OL_VRAM=${BASH_REMATCH[1]}
  [[ $ps =~ \"context_length\":([0-9]+) ]] && OL_CTX=${BASH_REMATCH[1]}
  return 0
}
server_ctx() {  # the context the running server in ST really has (0 when it does not say)
  local base out
  base=$(hostport "$(connect_host "${ST[HOST]}")" "${ST[PORT]}")
  case ${ST[ENGINE]} in
    ollama) ollama_load "$base" && { echo "$OL_CTX"; return 0; } ;;
    llama) out=$(lcurl --max-time 3 "http://$base/props" 2>/dev/null) || true
           out=${out//\": /\":}
           [[ $out =~ \"n_ctx\":([0-9]+) ]] && { echo "${BASH_REMATCH[1]}"; return 0; } ;;
    vllm) out=$(lcurl --max-time 3 "http://$base/v1/models" 2>/dev/null) || true
          out=${out//\": /\":}
          [[ $out =~ \"max_model_len\":([0-9]+) ]] && { echo "${BASH_REMATCH[1]}"; return 0; } ;;
  esac
  echo 0
}
rec_alive() {  # is the server in ST still running?
  if [[ ${ST[MANAGED]-1} == 0 ]]; then  # a model on an attached Ollama daemon: still loaded there?
    local ps
    ps=$(lcurl --max-time 3 "http://${ST[HOST]}:${ST[PORT]}/api/ps" 2>/dev/null) || return 1
    ps=${ps//\": /\":}
    [[ $ps == *"\"name\":\"${ST[MODEL]}"* ]]
    return
  fi
  [[ -z ${ST[BOOT]-} || ${ST[BOOT]} == "$BOOT_ID" ]] || return 1   # recorded before a reboot
  [[ -n ${ST[PID]-} ]] && pid_alive "${ST[PID]}" && [[ $(pid_starttime "${ST[PID]}") == "${ST[STARTTIME]-}" ]]
}
rec_write() {  # file KEY=VALUE...: atomically, under the state lock, stamped with the boot id
  local f=$1 tmp=$1.tmp.$$
  shift
  mkdir -p "${f%/*}"
  state_lock
  (umask 077; printf '%s\n' "$@" "BOOT=$BOOT_ID" > "$tmp") && mv -f -- "$tmp" "$f"
  state_unlock
}
rec_remove() {  # file [pid]: delete a record, only if it still describes that pid
  state_lock
  if [[ -z ${2-} ]] || { load_rec "$1" && [[ ${ST[PID]-} == "$2" ]]; }; then rm -f -- "$1"; fi
  state_unlock
}
R_FILES=() SCAN_REMOVED=() SCAN_ADOPTED=()
running_scan() {  # -> R_FILES, the records of models that are still running (stale ones are removed)
  local f
  R_FILES=() SCAN_REMOVED=() SCAN_ADOPTED=()
  if [[ -d $run_dir ]]; then
    for f in "$run_dir"/*.state; do
      [[ -e $f ]] || continue
      if load_rec "$f" && rec_alive; then
        R_FILES+=("$f")
        # started by an llmserver that was killed before it saw the model come up
        if [[ ${ST[STATE]-} == starting && -n ${ST[OWNER]-} ]] && ! pid_alive "${ST[OWNER]}" && rec_healthy; then
          state_lock; sed -i 's/^STATE=starting$/STATE=ready/' "$f"; state_unlock
          note "${ST[SPEC]} came up after the $PROG starting it was interrupted; recorded as ready"
        fi
        continue
      fi
      state_lock   # check again under the lock: another run may have just rewritten it
      if load_rec "$f" && rec_alive; then R_FILES+=("$f")
      elif [[ -e $f ]]; then
        note "${ST[SPEC]:-$f} is no longer running (pid ${ST[PID]:-?}); its record was removed"
        SCAN_REMOVED+=("${ST[SPEC]:-${f##*/}}")
        rm -f -- "$f"
      fi
      state_unlock
    done
  fi
  adopt_orphans
  return 0
}
rec_healthy() {  # does the server in ST answer its health check?
  lcurl -o /dev/null --max-time 3 "http://$(hostport "$(connect_host "${ST[HOST]}")" "${ST[PORT]}")$([[ ${ST[ENGINE]} == ollama ]] && echo /api/version || echo /health)" 2>/dev/null
}
proc_env() {  # pid name -> value of that variable in the process's environment
  local kv
  while IFS= read -r -d '' kv; do [[ $kv == "$2="* ]] && { printf '%s\n' "${kv#*=}"; return 0; }; done 2>/dev/null < "/proc/$1/environ"
  return 1
}
starter_alive() {  # pid -> is its parent an llmserver that is still starting it?
  local pp
  pp=$(proc_field "$1" 1) || return 1
  [[ $pp =~ ^[0-9]+$ ]] && ((pp > 1)) && pid_alive "$pp" && tr '\0' ' ' 2>/dev/null < "/proc/$pp/cmdline" | grep -q "$PROG"
}
adopt_orphans() {  # servers llmserver started whose record was lost (llmserver was killed): track them again
  local env pid known=" " f spec port host
  for f in "${R_FILES[@]}"; do load_rec "$f" && known+="${ST[PID]-} "; done
  while IFS= read -r env; do
    pid=${env#/proc/}; pid=${pid%%/*}
    [[ $pid =~ ^[0-9]+$ && $known != *" $pid "* ]] || continue
    # the server itself (it leads its own process group), not one of its workers; and not one
    # that a running llmserver is still starting
    if [[ $(proc_field "$pid" 2 2>/dev/null) != "$pid" ]] || ! pid_alive "$pid"; then continue; fi
    starter_alive "$pid" && continue
    spec=$(proc_env "$pid" LLMSERVER_SERVED_SPEC) || continue
    port=$(proc_env "$pid" LLMSERVER_SERVED_PORT) || continue
    host=$(proc_env "$pid" LLMSERVER_SERVED_HOST || echo 127.0.0.1)
    [[ $port =~ ^[0-9]+$ && $spec == *:* ]] || continue
    f=$run_dir/$(spec_id "$spec").state
    state_lock
    if ! { load_rec "$f" && rec_alive; }; then
      rec_write "$f" "ENGINE=${spec%%:*}" "MODEL=${spec#*:}" "SPEC=$spec" "HOST=$host" "PORT=$port" "PID=$pid" \
        "STARTTIME=$(pid_starttime "$pid")" "MANAGED=1" "LOG=$(readlink "/proc/$pid/fd/1" 2>/dev/null || true)" \
        "STARTED=$(date +%s)" "CTX=$(proc_env "$pid" LLMSERVER_SERVED_CTX || true)" "STATE=ready" "ADOPTED=1"
      ports_set "$spec" "$port"
      warn "found $spec running on port $port (pid $pid) without a record, left by an interrupted $PROG; it is tracked again"
      SCAN_ADOPTED+=("$spec")
      R_FILES+=("$f")
    fi
    state_unlock
  done < <(grep -lsz '^LLMSERVER_SERVED_SPEC=' /proc/[0-9]*/environ 2>/dev/null || true)
  return 0
}
rec_find() {  # spec -> the record file of that running model
  local f
  for f in "${R_FILES[@]}"; do load_rec "$f" && [[ ${ST[SPEC]} == "$1" ]] && { printf '%s\n' "$f"; return 0; }; done
  return 1
}
REC=""
rec_select() {  # a spec, menu number, port or name fragment -> REC, the record of a running model (R_ERR otherwise)
  local q=$1 f hits=()
  REC=""
  if [[ $q =~ ^[0-9]+$ ]] && ((10#$q <= ${#specs[@]})) && ((10#$q >= 1)); then q=${specs[10#$q - 1]}; fi
  for f in "${R_FILES[@]}"; do
    load_rec "$f" || continue
    if [[ ${ST[SPEC]} == "$q" || ${ST[MODEL]} == "$q" || ${ST[PORT]} == "$q" || ${ST[PORT]} == "${q#:}" ]]; then REC=$f; return 0; fi
    [[ ${ST[SPEC],,} == *"${q,,}"* ]] && hits+=("$f")
  done
  if ((${#hits[@]} == 1)); then REC=${hits[0]}; return 0; fi
  if ((${#hits[@]} > 1)); then R_ERR="'$1' matches several running models; be more specific (see '$PROG ps')"
  else R_ERR="no running model matches '$1' (see '$PROG ps')"; fi
  return 1
}
rec_idle() {  # seconds since the model in ST last did anything: its server last wrote to its log
  local last=${ST[STARTED]:-0} m
  if [[ -n ${ST[LOG]-} && -e ${ST[LOG]} ]]; then m=$(stat -c %Y -- "${ST[LOG]}" 2>/dev/null || echo 0); ((m > last)) && last=$m; fi
  echo $(($(date +%s) - last))
}
dur() {  # seconds -> 3d4h, 2h5m, 7m, 12s
  local s=$1
  if ((s >= 86400)); then printf '%dd%dh' $((s / 86400)) $((s % 86400 / 3600))
  elif ((s >= 3600)); then printf '%dh%dm' $((s / 3600)) $((s % 3600 / 60))
  elif ((s >= 60)); then printf '%dm' $((s / 60))
  else printf '%ds' "$s"; fi
}
is_pinned() { [[ -r $pins_file ]] && grep -qxF -- "$1" "$pins_file"; }
ports_get() { [[ -r $ports_file ]] && awk -F'\t' -v s="$1" '$1 == s {p = $2} END {if (p) print p}' "$ports_file"; }
ports_set() {  # spec port: remember the port of a model (one model per port)
  mkdir -p "$state_dir"
  state_lock
  { if [[ -r $ports_file ]]; then awk -F'\t' -v s="$1" -v p="$2" '$1 != s && $2 != p' "$ports_file"; fi; printf '%s\t%s\n' "$1" "$2"; } > "$ports_file.tmp.$$" && mv -f -- "$ports_file.tmp.$$" "$ports_file"
  state_unlock
}
port_holder() {  # port -> short description of whatever listens there
  local pid
  pid=$(port_owner "$1" 2>/dev/null) || { echo "another program"; return; }
  echo "pid $pid ($(cmd_of "$pid"))"
}
pick_port() {  # spec explicit-port -> PORT: explicit, else the model's last port, else the first free one
  local spec=$1 want=$2 used=" " reserved=" " p f pass
  for f in "${R_FILES[@]}"; do load_rec "$f" && [[ ${ST[SPEC]} != "$spec" ]] && used+="${ST[PORT]} "; done
  if [[ -n $want ]]; then
    if [[ ! $want =~ ^[0-9]+$ ]] || ((want < 1 || want > 65535)); then die "port must be 1-65535, got '$want'"; fi
    [[ $used == *" $want "* ]] && die "port $want is already used by another model llmserver runs (see '$PROG ps')"
    port_in_use "$want" && die "port $want is in use by $(port_holder "$want"); choose another with --port"
    PORT=$want; return 0
  fi
  if [[ -n ${RESTART_FILE-} ]] && load_rec "$RESTART_FILE"; then PORT=${ST[PORT]}; return 0; fi   # --restart keeps the port
  p=$(ports_get "$spec" || true)
  if [[ -n $p && $used != *" $p "* ]] && ! port_in_use "$p"; then PORT=$p; return 0; fi
  [[ -n $p ]] && note "port $p, which $spec used before, is taken now; picking another"
  [[ -r $ports_file ]] && reserved+="$(awk -F'\t' -v s="$spec" '$1 != s {printf "%s ", $2}' "$ports_file")"
  for pass in 1 2; do   # first avoid ports remembered for other models, then take any free one
    for ((p = CFG[PORT]; p <= CFG[PORT] + CFG[PORT_SPAN] && p <= 65535; p++)); do
      [[ $used == *" $p "* ]] && continue
      [[ $pass == 1 && $reserved == *" $p "* ]] && continue
      port_in_use "$p" && continue
      PORT=$p; return 0
    done
  done
  die "no free port between ${CFG[PORT]} and $((CFG[PORT] + CFG[PORT_SPAN])); stop a model or raise LLMSERVER_PORT_SPAN"
}

# ---- memory use per GPU ------------------------------------------------------
# NVIDIA reports memory per process, so a model's use is measured live from its process group.
# AMD does not, so a model's use is the change in each GPU's used memory measured when it
# started (starts are serialised by a lock so the measurement is attributable).
declare -A PG_USE=()  # "pgid:G index" -> MiB, from nvidia-smi
PG_READ=0
nv_usage() {
  local out pid bus mib i pg
  ((PG_READ)) && return 0
  PG_READ=1 PG_USE=()
  have nvidia-smi || return 0
  out=$(nvidia-smi --query-compute-apps=pid,gpu_bus_id,used_memory --format=csv,noheader,nounits 2>/dev/null) || return 0
  while IFS=', ' read -r pid bus mib; do
    [[ $pid =~ ^[0-9]+$ && $mib =~ ^[0-9]+$ ]] || continue
    bus=${bus,,}; ((${#bus} > 12)) && bus=${bus: -12}
    pg=$(proc_field "$pid" 2 2>/dev/null) || pg=$pid   # process group = the server's own pid
    for i in "${!G_BUS[@]}"; do
      [[ ${G_VENDOR[i]} == nvidia && ${G_BUS[i]} == "$bus" ]] || continue
      PG_USE[$pg:$i]=$(( ${PG_USE[$pg:$i]:-0} + mib ))
    done
  done <<<"$out"
}
rec_usage() {  # ST -> "G:MiB,G:MiB" this model uses now (measured live on NVIDIA, else as recorded)
  local i out="" v
  detect_hw; nv_usage
  if [[ -n ${ST[PID]-} ]]; then
    for i in "${!G_VENDOR[@]}"; do
      v=${PG_USE[${ST[PID]}:$i]-}
      [[ -n $v ]] && out+="${out:+,}$i:$v"
    done
  fi
  if [[ -z $out ]]; then out=${ST[MEAS]:-${ST[EST]-}}; fi
  printf '%s\n' "$out"
}
usage_on() {  # "G:MiB,..." G -> MiB on that GPU
  local kv
  IFS=',' read -ra kvs <<<"$1"
  for kv in "${kvs[@]}"; do [[ ${kv%%:*} == "$2" ]] && { echo "${kv#*:}"; return; }; done
  echo 0
}
usage_total() { local kv mib=0; IFS=',' read -ra kvs <<<"$1"; for kv in "${kvs[@]}"; do [[ $kv == *:* ]] && mib=$((mib + ${kv#*:})); done; echo "$mib"; }

# ---- placement ---------------------------------------------------------------
# place ENGINE MODEL CTX -> PLACE_IDX (G indices; empty = no specific GPUs) and F_* for the best
# placement on free VRAM (plus FREE_ADD): one GPU if possible (the one it fits most snugly),
# else the fewest GPUs together, else spread over all and partly on the CPU.
PLACE_IDX=() PLACE_NOTE=""
subset_eval() {  # engine want pos... -> V_* restricted to those view positions, then fit_core
  local e=$1 want=$2 p at=() af=() ax=() an=()
  shift 2
  for p in "$@"; do at+=("${ALL_T[p]}") af+=("${ALL_F[p]}") ax+=("${ALL_I[p]}") an+=("${ALL_N[p]}"); done
  V_T=("${at[@]}") V_F=("${af[@]}") V_IDX=("${ax[@]}") V_N=("${an[@]}")
  V_DESC=$(IFS=','; printf '%s' "${V_N[*]}"); V_DESC=${V_DESC//,/, }
  fit_core "$e" "$want"
}
ALL_T=() ALL_F=() ALL_I=() ALL_N=()
place() {
  local e=$1 want=$3 n p k best=() tight=() asc=() desc=() r
  refresh_hw
  gpu_view "$e"
  view_mode now
  MODE_FOR_VLLM=now
  PLACE_IDX=()
  ALL_T=("${V_T[@]}") ALL_F=("${V_F[@]}") ALL_I=("${V_IDX[@]}") ALL_N=("${V_N[@]}")
  n=${#V_T[@]}
  if ((n == 0 || MI_W <= 0)) || [[ -n $C_FATAL || " ${V_IDX[*]} " == *" -1 "* ]]; then
    # no GPU, a model of unknown size, or llama.cpp devices that cannot be matched to detected
    # GPUs: no per-GPU placement; the engine sees every GPU it would use anyway
    fit_core "$e" "$want"
    ((n == 0 || MI_W <= 0)) && return 0
    for p in "${V_IDX[@]}"; do [[ $p == -1 ]] || PLACE_IDX+=("$p"); done
    [[ " ${V_IDX[*]} " == *" -1 "* ]] && PLACE_IDX=()
    return 0
  fi
  mapfile -t asc < <(for p in "${!ALL_F[@]}"; do printf '%s %s\n' "${ALL_F[p]}" "$p"; done | sort -n | cut -d' ' -f2)
  mapfile -t desc < <(printf '%s\n' "${asc[@]}" | tac)
  if [[ $e == vllm ]]; then
    subset_eval "$e" "$want" "${desc[@]}"       # tensor parallelism over the GPUs with the most free memory
    for ((k = 0; k < F_TP && k < n; k++)); do PLACE_IDX+=("${ALL_I[desc[k]]}"); done
    subset_eval "$e" "$want" "${desc[@]:0:F_TP}"
    return 0
  fi
  for p in "${asc[@]}"; do                       # one GPU, the snuggest fit
    subset_eval "$e" "$want" "$p"
    if [[ $F_RATING == good ]]; then best=("$p"); break; fi
    [[ $F_RATING == tight && ${#tight[@]} -eq 0 ]] && tight=("$p")
  done
  if ((${#best[@]} == 0)); then                   # the fewest GPUs together, most free first
    for ((k = 2; k <= n; k++)); do
      subset_eval "$e" "$want" "${desc[@]:0:k}"
      if [[ $F_RATING == good ]]; then best=("${desc[@]:0:k}"); break; fi
      [[ $F_RATING == tight && ${#tight[@]} -eq 0 ]] && tight=("${desc[@]:0:k}")
    done
  fi
  ((${#best[@]})) || best=("${tight[@]}")
  ((${#best[@]})) || best=("${desc[@]}")          # nothing fits: spread over all, the rest on the CPU
  subset_eval "$e" "$want" "${best[@]}"
  for p in "${best[@]}"; do PLACE_IDX+=("${ALL_I[p]}"); done
  return 0
}

# ---- planning a start: what fits, and what would have to stop -----------------
# plan_start ENGINE MODEL CTX -> P_STATE fits | evict | offload | no, P_EVICT (records to stop,
# least recently used first), P_FORCED (how many of those MAX_MODELS requires), and the
# placement it leads to. Pinned models are never chosen.
P_STATE="" P_EVICT=() P_FORCED=0 P_CANDS=()
sim_evict() {  # record files -> FREE_ADD (the memory they would give back), PLACE_NOTE
  local f u names=() kv
  FREE_ADD=() PLACE_NOTE=""
  for f in "$@"; do
    load_rec "$f" || continue
    u=$(rec_usage)
    IFS=',' read -ra kvs <<<"$u"
    for kv in "${kvs[@]}"; do [[ $kv == *:* ]] && FREE_ADD[${kv%%:*}]=$(( ${FREE_ADD[${kv%%:*}]:-0} + ${kv#*:} )); done
    names+=("${ST[SPEC]#*:}")
  done
  ((${#names[@]})) && PLACE_NOTE="once $(IFS=','; printf '%s' "${names[*]}" | sed 's/,/, /g') stop"
  return 0
}
plan_eval() {  # engine model ctx records... -> F_* for that eviction set
  local e=$1 m=$2 w=$3
  shift 3
  sim_evict "$@"
  place "$e" "$m" "$w"
}
ok_rating() { [[ $1 == good || $1 == tight ]]; }
plan_start() {
  local e=$1 m=$2 w=$3 f i idle running=0 forced=() opt=() kept=() n trial
  P_STATE="" P_EVICT=() P_FORCED=0 P_CANDS=()
  # candidates: running models other than this one, unpinned, least recently used first
  for f in "${R_FILES[@]}"; do
    load_rec "$f" || continue
    [[ ${ST[SPEC]} == "$SPEC" ]] && continue
    running=$((running + 1))
    is_pinned "${ST[SPEC]}" && continue
    printf -v idle '%012d' "$(rec_idle)"
    P_CANDS+=("$idle $f")
  done
  mapfile -t P_CANDS < <(printf '%s\n' "${P_CANDS[@]}" | grep . | sort -r | cut -d' ' -f2-)
  if ((CFG[MAX_MODELS] > 0 && running + 1 > CFG[MAX_MODELS])); then
    n=$((running + 1 - CFG[MAX_MODELS]))
    ((n <= ${#P_CANDS[@]})) || { P_STATE=no; R_ERR="LLMSERVER_MAX_MODELS=${CFG[MAX_MODELS]} models are running and too many of them are pinned to make room"; return 0; }
    forced=("${P_CANDS[@]:0:n}")
  fi
  P_FORCED=${#forced[@]}
  plan_eval "$e" "$m" "$w" "${forced[@]}"
  if ok_rating "$F_RATING"; then P_EVICT=("${forced[@]}"); P_STATE=fits; ((P_FORCED)) && P_STATE=evict; return 0; fi
  [[ $F_RATING == unknown ]] && { P_EVICT=("${forced[@]}"); P_STATE=fits; return 0; }
  # add the least recently used models one by one until it fits on the GPU
  opt=()
  for f in "${P_CANDS[@]:P_FORCED}"; do
    opt+=("$f")
    plan_eval "$e" "$m" "$w" "${forced[@]}" "${opt[@]}"
    ok_rating "$F_RATING" && break
  done
  if ((${#opt[@]})) && ok_rating "$F_RATING"; then
    # drop any that turned out not to be needed, most recently used first
    kept=("${opt[@]}")
    for ((i = ${#opt[@]} - 1; i >= 0; i--)); do
      trial=()
      for f in "${kept[@]}"; do [[ $f == "${opt[i]}" ]] || trial+=("$f"); done
      plan_eval "$e" "$m" "$w" "${forced[@]}" "${trial[@]}"
      ok_rating "$F_RATING" && kept=("${trial[@]}")
    done
    P_EVICT=("${forced[@]}" "${kept[@]}"); P_STATE=evict
    plan_eval "$e" "$m" "$w" "${P_EVICT[@]}"
    return 0
  fi
  # even stopping every unpinned model is not enough for the GPU: run it as it fits now
  P_EVICT=("${forced[@]}")
  plan_eval "$e" "$m" "$w" "${forced[@]}"
  case $F_RATING in
    offload|cpu) P_STATE=offload ;;
    *) P_STATE=no ;;
  esac
  return 0
}
evict_lines() {  # records -> human list
  local f
  for f in "$@"; do
    load_rec "$f" || continue
    printf '    %s  (port %s, %s, idle %s)\n' "${ST[SPEC]}" "${ST[PORT]}" "$(gb "$(usage_total "$(rec_usage)")")" "$(dur "$(rec_idle)")"
  done
}

ctx_for() {  # wanted context -> what this model gets: a number is capped at the model's trained context
  local w=$1
  if [[ $w =~ ^[0-9]+$ ]] && ((MI_TCTX > 0 && w > MI_TCTX)); then w=$MI_TCTX; fi
  printf '%s\n' "$w"
}

# ---- stopping, snapshots and rollback ----------------------------------------
cmd_of() {  # pid -> a short, readable command line
  local a=() c
  mapfile -d '' -t a 2>/dev/null < "/proc/$1/cmdline" || true
  ((${#a[@]})) || return 0
  a[0]=${a[0]##*/}
  if ((${#a[@]} > 1)) && [[ ${a[1]} == /* ]]; then a[1]=${a[1]##*/}; fi
  c=${a[*]}
  printf '%s' "${c:0:70}"
}
# Before a model is stopped to make room, its command line, environment, working directory and
# record are saved in $state_dir/rollback.*, with the run that stopped it ('owner'). The run
# deletes them once the new model is up, or restarts the models from them if it fails. If the
# run itself is killed in between, the snapshots stay behind; 'doctor --fix' restarts them.
snapshot_new() {  # -> a private snapshot directory owned by this run
  local d
  d=$(mktemp -d "$state_dir/rollback.XXXXXX")
  printf '%s %s %s %s %s\n' "$$" "$(pid_starttime $$)" "$BOOT_ID" "$RUN_ID" "${SPEC:-?}" > "$d/owner"
  printf '%s\n' "$d"
}
snapshot_proc() {  # pid -> a snapshot directory holding its argv, environment and cwd
  local d
  d=$(snapshot_new)
  if ! { cp "/proc/$1/cmdline" "$d/argv" 2>/dev/null && cp "/proc/$1/environ" "$d/environ" 2>/dev/null; }; then rm -rf -- "$d"; return 1; fi
  readlink "/proc/$1/cwd" > "$d/cwd" 2>/dev/null || echo / > "$d/cwd"
  printf '%s\n' "$d"
}
snapshot_orphaned() {  # dir -> is it left by a run that no longer exists?
  local pid st boot _
  read -r pid st boot _ 2>/dev/null < "$1/owner" || return 0
  [[ $boot != "$BOOT_ID" ]] && return 0
  ! { pid_alive "$pid" && [[ $(pid_starttime "$pid") == "$st" ]]; }
}
lock_owner() {  # who holds the start lock, for messages
  local pid spec
  read -r pid spec 2>/dev/null < "$lock_file.owner" || { echo "another $PROG"; return; }
  if pid_alive "$pid"; then echo "$PROG pid $pid (starting $spec)"; else echo "another $PROG"; fi
}
INTERRUPTED=()
find_interrupted() {  # -> INTERRUPTED: snapshot directories of models an interrupted start stopped
  local d
  INTERRUPTED=()
  for d in "$state_dir"/rollback.*; do
    [[ -d $d && -r $d/rec ]] || continue
    snapshot_orphaned "$d" && INTERRUPTED+=("$d")
  done
  return 0
}
relaunch() {  # snapshot-dir log -> pid of the restarted process
  local a=() e=() kv cwd v
  mapfile -d '' -t a < "$1/argv"; mapfile -d '' -t e < "$1/environ"; cwd=$(<"$1/cwd")
  (
    cd "$cwd" 2>/dev/null || cd /
    for v in $(compgen -e); do unset "$v" 2>/dev/null || true; done
    for kv in "${e[@]}"; do
      # shellcheck disable=SC2163  # kv holds NAME=value
      if [[ $kv =~ ^[A-Za-z_][A-Za-z0-9_]*= ]]; then export "$kv"; fi
    done
    exec 8>&- 9>&-
    if have setsid; then exec setsid "${a[@]}" >> "$2" 2>&1 < /dev/null; fi
    exec "${a[@]}" >> "$2" 2>&1 < /dev/null
  ) &
  printf '%s\n' "$!"
}
STOPPED_SNAP=() STOPPED_REC=()
stop_rec() {  # record file [keep-snapshot]: stop that model and remove its record
  local f=$1 snap="" t0=$SECONDS
  load_rec "$f" || return 0
  if [[ ${ST[MANAGED]-1} == 0 ]]; then
    if [[ -n ${2-} ]]; then snap=$(snapshot_new); cp -- "$f" "$snap/rec"; STOPPED_SNAP+=("$snap"); TEMP_DIRS+=("$snap"); fi
    lcurl -o /dev/null --max-time 30 -H 'Content-Type: application/json' \
      -d "{\"model\":\"${ST[MODEL]}\",\"keep_alive\":0}" "http://${ST[HOST]}:${ST[PORT]}/api/generate" 2>/dev/null || true
    info "unloaded ${ST[SPEC]} from the Ollama daemon at ${ST[HOST]}:${ST[PORT]}"
  else
    if [[ -n ${2-} ]] && snap=$(snapshot_proc "${ST[PID]}"); then
      cp -- "$f" "$snap/rec"; STOPPED_SNAP+=("$snap"); TEMP_DIRS+=("$snap")
    fi
    info "stopping ${ST[SPEC]} (port ${ST[PORT]}, pid ${ST[PID]})"
    if ! stop_pid "${ST[PID]}" 1; then warn "pid ${ST[PID]} did not stop"; return 1; fi
    note "stopped ${ST[SPEC]} in $((SECONDS - t0))s"
  fi
  STOPPED_REC+=("$(cat -- "$f")")
  rec_remove "$f" "${ST[PID]-}"
}
restore_snapshot() {  # snapshot dir -> restart that model and record it again; status 1 if it failed
  local d=$1 log pid rf
  load_rec "$d/rec" || return 1
  rf=$run_dir/$(spec_id "${ST[SPEC]}").state
  if [[ ${ST[MANAGED]-1} == 0 ]]; then   # a model unloaded from an attached Ollama daemon
    ollama_preload "${ST[HOST]}:${ST[PORT]}" "${ST[MODEL]}" 2>/dev/null || return 1
    state_lock; cp -- "$d/rec" "$rf.tmp.$$" && mv -f -- "$rf.tmp.$$" "$rf"; state_unlock
    warn "rolled back: reloaded ${ST[SPEC]} on the Ollama daemon"
    return 0
  fi
  [[ -r $d/argv ]] || return 1
  log=${ST[LOG]:-$log_dir/$(spec_id "${ST[SPEC]}").log}
  pid=$(relaunch "$d" "$log")
  sleep 1
  pid_alive "$pid" || { warn "could not restart ${ST[SPEC]}; see $log"; return 1; }
  state_lock
  sed -e "s/^PID=.*/PID=$pid/" -e "s/^STARTTIME=.*/STARTTIME=$(pid_starttime "$pid")/" -e "s/^STARTED=.*/STARTED=$(date +%s)/" \
    -e "s/^BOOT=.*/BOOT=$BOOT_ID/" "$d/rec" > "$rf.tmp.$$" && mv -f -- "$rf.tmp.$$" "$rf"
  state_unlock
  warn "rolled back: ${ST[SPEC]} is restarting on port ${ST[PORT]} (pid $pid). It needs time to load; see '$PROG ps'"
  return 0
}
rollback() {  # restart what stop_rec stopped for this start
  local d n=0
  for d in "${STOPPED_SNAP[@]}"; do
    if restore_snapshot "$d"; then n=$((n + 1)); rm -rf -- "$d"; fi
  done
  ((n)) && note "rollback restored $n model(s)"
  return 0
}
# ---- commands for running models ---------------------------------------------
rec_url() { printf 'http://%s/v1\n' "$(hostport "$(client_host "${ST[HOST]}")" "${ST[PORT]}")"; }
rec_listening() { [[ ${ST[MANAGED]-1} == 0 ]] || port_in_use "${ST[PORT]}"; }  # no HTTP request, so idle time stays honest
gpu_names() {  # "G:MiB,..." -> "GPU 0, GPU 1"
  local kv out=""
  IFS=',' read -ra kvs <<<"$1"
  for kv in "${kvs[@]}"; do [[ $kv == *:* ]] && out+="${out:+,}${kv%%:*}"; done
  printf '%s' "${out:--}"
}
cmd_ps() {  # [--json]
  local f u json=${1-} h
  running_scan
  if [[ $json == json ]]; then
    local items=()
    for f in "${R_FILES[@]}"; do load_rec "$f" && items+=("$(json_rec)"); done
    jo version "$(js "$VERSION")" max_models "$(jn "${CFG[MAX_MODELS]}")" evict "$(js "${CFG[EVICT]}")" models "$(ja "${items[@]}")"; echo
    return 0
  fi
  if ((${#R_FILES[@]} == 0)); then echo "no models are running (start one with '$PROG MODEL')"; ps_services; return 1; fi
  printf '%-44s %-6s %6s %8s %-7s %9s %8s %7s %7s  %s\n' MODEL ENGINE PORT PID GPU VRAM CTX UP IDLE STATE
  for f in "${R_FILES[@]}"; do
    load_rec "$f" || continue
    u=$(rec_usage); h=starting; [[ ${ST[STATE]:-ready} == ready ]] && rec_listening && h=listening
    is_pinned "${ST[SPEC]}" && h+=",pinned"; [[ ${ST[ADOPTED]:-0} == 1 ]] && h+=",adopted"; [[ -n ${ST[ROLE]-} ]] && h+=",${ST[ROLE]}"
    if [[ ${ST[ENGINE]} == ollama ]] && ollama_load "$(hostport "$(connect_host "${ST[HOST]}")" "${ST[PORT]}")" && ((OL_SIZE > 0 && OL_VRAM < OL_SIZE)); then
      h+=",$((100 - OL_VRAM * 100 / OL_SIZE))%-on-cpu"; PS_CPU=1
    fi
    local shown; shown=$(spec_show "${ST[SPEC]}"); ((${#shown} > 44)) && shown=...${shown: -41}
    printf '%-44s %-6s %6s %8s %-7s %9s %8s %7s %7s  %s\n' "$shown" "${ST[ENGINE]}" "${ST[PORT]}" "${ST[PID]:-daemon}" \
      "$(gpu_names "$u")" "$(gb "$(usage_total "$u")")" "${ST[CTX]:-auto}" "$(dur $(($(date +%s) - ${ST[STARTED]:-0})))" "$(dur "$(rec_idle)")" "$h"
  done
  echo "Idle = time since the server last wrote to its log. Clients: '$PROG env MODEL'. Memory: '$PROG capacity'."
  ((PS_CPU)) && echo "N%-on-cpu: Ollama keeps that share of the model in system RAM (no room on the GPUs), which makes generation much slower; stop another model and restart this one."
  ps_services
}
ps_services() {  # the gateway and Open WebUI, when they run
  local out=()
  svc_alive gateway && out+=("gateway     $(gateway_url)  (pid ${ST[PID]}): one address for every running model")
  svc_alive webui && out+=("Open WebUI  $(webui_urls | head -n 1)  (pid ${ST[PID]})")
  svc_alive searxng && out+=("SearXNG     http://127.0.0.1:${ST[PORT]}  (pid ${ST[PID]}): web search for Open WebUI")
  ((${#out[@]})) || return 0
  echo; echo "Services:"; printf '  %s\n' "${out[@]}"
}
cmd_stop() {  # MODEL | all
  local f n=0
  running_scan
  if [[ -z $sel ]]; then
    case ${#R_FILES[@]} in
      0) info "no models are running"; return 0 ;;
      1) sel=all ;;
      *) die "several models are running; say which: '$PROG stop MODEL' (a name, menu number or port) or '$PROG stop all'. See '$PROG ps'" ;;
    esac
  fi
  if [[ $sel == all ]]; then
    for f in "${R_FILES[@]}"; do stop_rec "$f" && n=$((n + 1)); done
  else
    rec_select "$sel" || die "$R_ERR"
    stop_rec "$REC" && n=1
  fi
  info "stopped $n model(s)"
}
cmd_pin() {  # pin|unpin MODEL
  local spec f
  [[ -n $sel ]] || die "say which model: '$PROG $1 MODEL'"
  running_scan
  local hits=() s
  if rec_select "$sel"; then load_rec "$REC"; spec=${ST[SPEC]}
  elif [[ $sel =~ ^[0-9]+$ ]]; then choose "$sel" || die "$R_ERR"; spec=$SPEC
  else
    # an exact or partial name of a menu entry or a pinned model, else any model name
    while IFS= read -r s; do
      [[ -n $s ]] || continue
      if [[ $s == "$sel" || ${s#*:} == "$sel" ]]; then hits=("$s"); break; fi
      [[ ${s,,} == *"${sel,,}"* ]] && hits+=("$s")
    done < <({ printf '%s\n' "${specs[@]}"; if [[ -r $pins_file ]]; then cat -- "$pins_file"; fi; } | sort -u)
    if ((${#hits[@]} == 1)); then spec=${hits[0]}
    elif ((${#hits[@]} > 1)); then die "'$sel' matches several models: ${hits[*]}; be more specific"
    else choose "$sel" || die "$R_ERR"; spec=$SPEC; fi
  fi
  mkdir -p "$state_dir"
  if [[ $1 == pin ]]; then
    state_lock; is_pinned "$spec" || printf '%s\n' "$spec" >> "$pins_file"; state_unlock
    info "pinned $spec: it is never stopped to make room for another model"
  else
    state_lock
    if [[ -r $pins_file ]]; then { grep -vxF -- "$spec" "$pins_file" > "$pins_file.tmp.$$" || true; } && mv -f -- "$pins_file.tmp.$$" "$pins_file"; fi
    state_unlock
    info "unpinned $spec"
  fi
}
cmd_env() {  # [MODEL]
  local f
  running_scan
  if [[ -n $sel ]]; then rec_select "$sel" || die "$R_ERR"; f=$REC
  elif ((${#R_FILES[@]} == 1)); then f=${R_FILES[0]}
  elif ((${#R_FILES[@]} == 0)); then die "no models are running"
  else
    echo "# several models are running; each has its own base URL. '$PROG env MODEL' prints one."
    for f in "${R_FILES[@]}"; do load_rec "$f" && printf '# %-44s %s\n' "${ST[SPEC]}" "$(rec_url)"; done
    return 0
  fi
  load_rec "$f"
  echo "export LLMSERVER_MODEL='${ST[MODEL]}'"
  echo "export OPENAI_BASE_URL='$(rec_url)'"
  if [[ ${ST[ENGINE]} != ollama && ${CFG[AUTH]} != none && -s $key_file ]] && { [[ ${CFG[AUTH]} == key ]] || ! is_loopback "${ST[HOST]}"; }; then
    echo "export OPENAI_API_KEY='$(<"$key_file")'"
  else
    echo "export OPENAI_API_KEY='none'  # this server does not check the key"
  fi
}
cmd_logs() {  # [MODEL]: follow a model's server output
  local f
  running_scan
  if [[ -n $sel ]]; then rec_select "$sel" || die "$R_ERR"; f=$REC
  elif ((${#R_FILES[@]} == 1)); then f=${R_FILES[0]}
  else die "say which model's log to follow: '$PROG logs MODEL' (see '$PROG ps'); '$PROG log' shows llmserver's own activity log"; fi
  load_rec "$f"
  [[ -n ${ST[LOG]-} && -r ${ST[LOG]} ]] || die "${ST[SPEC]} has no log file"
  exec tail -n 100 -f -- "${ST[LOG]}"
}
cmd_log() {  # llmserver's own activity log
  [[ -r $log_file ]] || { echo "no activity recorded yet ($log_file)"; return 0; }
  if ((l_errors)); then grep -E 'level=(warn|error)' "$log_file" | tail -n "$l_lines" || true
  else tail -n "$l_lines" -- "$log_file"; fi
  if ((l_follow)); then exec tail -n 0 -f -- "$log_file"; fi
}

# ---- skills for AI agents, and the pinned hf CLI -------------------------------------
# 'llmserver skills' keeps each skill in ~/.llmserver/skills and links it from where agents
# look (~/.agents/skills and ~/.claude/skills); with --project, the skill goes in the
# project's .agents/skills, linked from its .claude/skills. Two are
# generated here: 'llmserver' (how to use this tool) and 'hf-cli' (the pinned hf's own skill,
# rewritten to call 'llmserver hf'). Others come only from Hugging Face's skills marketplace
# and pass the S- rules first. Every installed file is recorded with its SHA-256, so updates,
# 'doctor' and 'uninstall' touch only what llmserver put there, unchanged.
skill_rec_dir=$trust_dir/records/skill
SK_GENERATED=" llmserver hf-cli "
SK_LINKDIRS=()
skill_scope() {  # global|project -> SK_SCOPE SK_SCOPE_ID SK_CENTRAL SK_LINKDIRS
  SK_SCOPE=$1
  if [[ $1 == project ]]; then
    SK_CENTRAL=$PWD/.agents/skills SK_LINKDIRS=("$PWD/.claude/skills")
    SK_SCOPE_ID=project-$(printf '%s' "$PWD" | sha256sum | cut -c1-12)
  else
    SK_CENTRAL=$lhome/skills SK_SCOPE_ID=global
    SK_LINKDIRS=("$HOME/.agents/skills" "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/skills")
  fi
}
skill_links() { local IFS=$'\t'; read -r -a SK_LINKS <<<"${SF[links]}"; }   # SF -> SK_LINKS
skill_unlink() {  # link central -> removes the link only if it is ours (points at central)
  [[ -L $1 && $(readlink -f -- "$1") == "$(readlink -m -- "$2")" ]] && rm -f -- "$1"
  return 0
}
skills_relocate() {  # once: global skills of llmserver < 2.1 move from ~/.agents/skills into the home, linked from both agent folders
  local f c new l ld free=() links=() n=0
  compgen -G "$skill_rec_dir/global__*.json" >/dev/null && helper_python >/dev/null || return 0
  for f in "$skill_rec_dir"/global__*.json; do
    skill_fields "$f"; c=${SF[central]}
    [[ $c != "$lhome/skills/"* && -d $c && ! -L $c ]] || continue
    skill_scope global; new=$SK_CENTRAL/${SF[name]}
    [[ -e $new || -L $new ]] && continue
    free=()
    for ld in "${SK_LINKDIRS[@]}"; do   # link only where the place is free, ours, or the old copy itself
      l=$ld/${SF[name]}
      if [[ ! -e $l && ! -L $l || $l == "$c" || -L $l && $(readlink -f -- "$l") == "$(readlink -f -- "$c")" ]]; then free+=("$l"); fi
    done
    if ! (umask 022; mkdir -p -- "$SK_CENTRAL" "${SK_LINKDIRS[@]}") || ! mv -T -- "$c" "$new"; then continue; fi
    links=()
    for l in "${free[@]}"; do ln -sfn -- "$new" "$l.llmserver-new.$$" && mv -Tf -- "$l.llmserver-new.$$" "$l" && links+=("$l"); done
    trustpy skill-relocate "$f" "$new" "${links[@]}" && n=$((n + 1))
  done
  ((n)) && info "moved $n agent skill(s) into $lhome/skills (the agents' folders now link to them)"
  return 0
}
skill_rec() { printf '%s/%s__%s.json\n' "$skill_rec_dir" "$SK_SCOPE_ID" "$1"; }
declare -A SF=()
skill_fields() { local k v; SF=(); while IFS=$'\t' read -r k v; do SF[$k]=$v; done < <(trustpy skill-fields "$1"); }
hf_bin() { local d; d=$(comp_current helper) && [[ -x $d/bin/hf ]] && printf '%s\n' "$d/bin/hf"; }
skill_generate() {  # name dir -> the generated skill in dir/name; SK_GEN (generator versions)
  local name=$1 dir=$2/$1 hf out
  mkdir -p "$dir"
  case $name in
    llmserver) skill_llmserver_md > "$dir/SKILL.md"; SK_GEN="llmserver=$VERSION" ;;
    hf-cli)
      hf=$(hf_bin) || trust_exit 3 "the hf CLI comes with llmserver's runtime: '$PROG install runtime'"
      py_env "$hf" skills preview > "$dir/.preview" 2>/dev/null || trust_exit 3 "the pinned hf could not generate its skill"
      out=$(trustpy hfcli-rewrite "$dir/.preview" "$dir/SKILL.md" "$VERSION") || trust_exit 3 "${out#*$'\t'}"
      rm -f -- "$dir/.preview"
      SK_GEN="llmserver=$VERSION,huggingface_hub=${out#ok$'\t'}" ;;
  esac
}
skill_stage() {  # name stage-dir -> plan file SK_PLAN and its lines SK_LINES
  local name=$1 st=$2
  SK_PLAN=$st/plan.json
  if [[ $SK_GENERATED == *" $name "* ]]; then
    skill_generate "$name" "$st"
    SK_LINES=$(TP_OUT=$SK_PLAN trustpy skill-local "$name" "$st/$name" generated "$SK_GEN")
  else
    skill_name_ok "$name" || trust_exit 3 "'$name' is not a skill name"
    SK_LINES=$(TP_OUT=$SK_PLAN TP_ACCEPT="${opt_accept[*]}" trustpy skill-fetch "$name" "$st")
  fi
  [[ -n $SK_LINES ]] || trust_exit 3 "the skill check gave no answer"
}
skill_name_ok() { [[ $1 =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$ ]]; }
skill_show_files() {  # plan lines -> the files, for review
  local k p n h scripts=0
  while IFS=$'\t' read -r k p n h; do
    [[ $k == file ]] || continue
    [[ $p == *.py || $p == *.sh || $p == *.js || $p == *.ts || $p == *.tsx ]] && scripts=1
    printf '    %-56s %8s  sha256 %s\n' "$p" "$n" "${h:0:16}" >&2
  done <<<"$1"
  return 0
}
skill_decide() {  # name plan-lines verb -> exits on a refusal; asks when needed
  local name=$1 lines=$2 verb=$3 reply
  trust_report "$lines"
  case $TR_DEC in
    block) [[ -n $TR_AVAIL ]] && printf '%s\n' "$PROG: ${C_R}error${C_0}: $TR_AVAIL" >&2
      trust_exit 3 "the skill $name was refused by the checks; nothing was ${verb}${TR_IDS:+. To accept a listed risk anyway, add --accept-risk ID (for example --accept-risk ${TR_IDS%% *})}" ;;
    ask)
      if ((yes)); then info "security: --yes accepts the warnings above"
      elif [[ -t 0 && -t 2 ]]; then
        printf '%s: %s the skill %s despite the warnings above? [y/N]: ' "$PROG" "$verb" "$name" >&2
        IFS= read -r reply || reply=""
        [[ ${reply,,} == y* ]] || trust_exit 4 "the skill $name was not $verb"
      else trust_exit 4 "the skill $name has warnings (above) and there is no terminal to ask; pass --yes, or --accept-risk ID for each"; fi ;;
  esac
  return 0
}
skill_state() {  # record -> "ok", "missing", "unknown", or what changed (one line per item)
  local out
  out=$(trustpy skill-verify "$1")
  if [[ $out == missing$'\t'* ]]; then echo missing; return; fi
  [[ $out == *summary$'\t'* ]] || { echo unknown; return; }   # never call files unchanged without checking them
  grep -E '^(changed|added|nolink)' <<<"$out" | tr '\t' ' ' || echo ok
}
setup_webui() {  # setup: offer Open WebUI (once, with WEBUI=ask)
  local reply mark=$state_dir/webui-offered
  case ${CFG[WEBUI]} in
    off) return 0 ;;
    ask)
      [[ -e $mark ]] && return 0
      ((!yes)) && [[ -t 0 && -t 2 ]] || return 0
      echo >&2
      printf 'Install Open WebUI, a web chat for the running models (about %d GB)? [y/N]: ' "$((PIN_SIZE[webui] / 1000))" >&2
      IFS= read -r reply || reply=""
      mkdir -p "$state_dir" && : > "$mark"
      [[ ${reply,,} == y* ]] || { info "skipped; '$PROG webui' installs and starts it later"; return 0; }
      printf 'Who may use it? 1) people on your network, each with an account  2) only this computer [1]: ' >&2
      IFS= read -r reply || reply=""
      if [[ $reply == 2 ]]; then CFG[WEBUI_HOST]=127.0.0.1; else CFG[WEBUI_HOST]=0.0.0.0; fi
      cfg_write LLMSERVER_WEBUI_HOST "${CFG[WEBUI_HOST]}" 0
      printf 'Also web search in the chat, through a private SearXNG (about %d MB)? The questions people search for go to public search engines (Google, Bing, DuckDuckGo and others), from this computer [y/N]: ' "${PIN_SIZE[searxng]}" >&2
      IFS= read -r reply || reply=""
      if [[ ${reply,,} == y* ]]; then CFG[WEBUI_SEARCH]=on; cfg_write LLMSERVER_WEBUI_SEARCH on 0; fi ;;
  esac
  ( yes=1 webui_start ) || warn "Open WebUI did not start; '$PROG webui' tries again"
}
setup_skills() {  # setup: offer the llmserver and hf-cli skills (once, with SKILLS=ask)
  local reply mark=$trust_dir/skills-offered
  case ${CFG[SKILLS]} in
    off) return 0 ;;
    ask)
      [[ -e $mark ]] && return 0
      ((!yes)) && [[ -t 0 && -t 2 ]] || return 0
      echo >&2
      printf 'Install the llmserver and hf-cli skills for AI agents (Claude Code and others) into %s (linked from ~/.agents/skills and ~/.claude/skills)? [y/N]: ' "$lhome/skills" >&2
      IFS= read -r reply || reply=""
      mkdir -p "$trust_dir" && : > "$mark"
      [[ ${reply,,} == y* ]] || { info "skipped; '$PROG skills add' installs them later"; return 0; } ;;
  esac
  ( cmd_skills add ) || warn "the skills were not installed; '$PROG skills add' tries again"
}
skill_place() {  # name staged-dir plan: install it in SK_CENTRAL, linked from SK_LINKDIRS, replacing only what llmserver put there
  local name=$1 staged=$2 plan=$3 cdir=$SK_CENTRAL c=$SK_CENTRAL/$1 rec state who new l ld links=()
  rec=$(skill_rec "$name")
  if [[ -e $c || -L $c ]]; then
    if [[ -s $rec ]]; then
      state=$(skill_state "$rec")
      if [[ $state != ok && $state != missing ]] && ((!opt_force)); then
        trust_exit 3 "the skill $name in $c was changed after llmserver installed it ($(tr '\n' ' ' <<<"$state")); --force replaces it"
      fi
    elif ((!opt_force)); then
      trust_exit 3 "$c exists and was not installed by $PROG; --force replaces it"
    fi
  fi
  for ld in "${SK_LINKDIRS[@]}"; do
    l=$ld/$name
    if [[ -e $l || -L $l ]] && ! [[ -L $l && $(readlink -f -- "$l") == "$(readlink -m -- "$c")" ]] && ((!opt_force)); then
      trust_exit 3 "$l exists and is not llmserver's link to $c; --force replaces it"
    fi
  done
  (umask 022; mkdir -p -- "$cdir" "${SK_LINKDIRS[@]}") || trust_exit 3 "could not create $cdir or the agents' skill folders"
  find "$staged" -type d -exec chmod 755 {} + && find "$staged" -type f -exec chmod 644 {} +
  new=$cdir/.$name.llmserver-new.$$
  rm -rf -- "$new"; cp -R -- "$staged" "$new" || { rm -rf -- "$new"; trust_exit 3 "could not copy the skill into $cdir"; }
  if [[ -e $c || -L $c ]]; then mv -- "$c" "$c.llmserver-old.$$"; fi
  mv -T -- "$new" "$c" || { [[ -e $c.llmserver-old.$$ ]] && mv -- "$c.llmserver-old.$$" "$c"; trust_exit 3 "could not install $c"; }
  rm -rf -- "$c.llmserver-old.$$"
  for ld in "${SK_LINKDIRS[@]}"; do
    l=$ld/$name
    if [[ -d $l && ! -L $l ]]; then rm -rf -- "$l"; fi
    if [[ $SK_SCOPE == global ]]; then ln -sfn -- "$c" "$l.llmserver-new.$$"   # absolute: survives a moved home ('doctor --fix' re-points it)
    else ln -sfn -- "$(realpath -m --relative-to="$ld" "$c")" "$l.llmserver-new.$$"; fi   # relative: the project folder can move
    mv -Tf -- "$l.llmserver-new.$$" "$l"; links+=("$l")
  done
  who=${USER:-$(id -un)}@$(hostname 2>/dev/null || echo localhost)
  trustpy skill-record "$plan" "$rec" "$SK_SCOPE" "$c" "$who" "$VERSION" "${links[@]}" >/dev/null
  [[ -s $rec ]] || trust_exit 3 "could not write the skill record $rec"
  log_write info "skills: installed $name ($SK_SCOPE) at $c by $who${opt_accept[*]:+, accepted ${opt_accept[*]}}"
}
skill_add() {  # name verb(add|update) -> installs it in SK_SCOPE
  local name=$1 verb=$2 st rec changed
  st=$(mktemp -d "$lhome/tmp/skill.XXXXXX")
  info "checking the skill $name"
  skill_stage "$name" "$st"
  rec=$(skill_rec "$name")
  local local_state=ok
  if [[ $verb == update && -s $rec ]]; then
    local_state=$(skill_state "$rec")
    if [[ $local_state != ok && $local_state != missing ]] && ((!opt_force)); then
      rm -rf -- "$st"
      trust_exit 3 "the skill $name was changed after llmserver installed it ($(tr '\n' ' ' <<<"$local_state")); --force replaces your changes"
    fi
  fi
  if [[ $verb == update && -s $rec && $local_state == ok ]]; then
    changed=$(diff <(python_hashes "$rec") <(awk -F'\t' '$1 == "file" {print $2 "\t" $4}' <<<"$SK_LINES" | sort) || true)
    if [[ -z $changed ]]; then info "the skill $name is up to date"; rm -rf -- "$st"; return 0; fi
    info "the skill $name changed:"; printf '%s\n' "$changed" | sed -n 's/^[<>] /    /p' | sort -u >&2
  fi
  echo "$PROG: the skill $name has these files:" >&2
  skill_show_files "$SK_LINES"
  skill_decide "$name" "$SK_LINES" "$( [[ $verb == add ]] && echo installed || echo updated)"
  skill_place "$name" "$st/$name" "$SK_PLAN"
  rm -rf -- "$st"
  info "${C_B}${verb/add/install}ed${C_0} the skill $name in $SK_CENTRAL/$name (linked from $(printf '%s, ' "${SK_LINKDIRS[@]/%//$name}" | sed 's/, $//'))"
}
python_hashes() {  # record -> "path<TAB>sha256" lines, sorted
  local py; py=$(helper_python) || return 0
  py_env "$py" -I -c 'import json,sys; [print("%s\t%s" % (f["path"], f["sha256"])) for f in json.load(open(sys.argv[1]))["files"]]' "$1" | sort
}
skill_remove() {  # name -> removes it from SK_SCOPE, only if unchanged (or --force)
  local name=$1 rec state c l SK_LINKS=()
  rec=$(skill_rec "$name")
  [[ -s $rec ]] || trust_exit 3 "the skill $name was not installed by $PROG in the $SK_SCOPE scope ($SK_CENTRAL)"
  skill_fields "$rec"; c=${SF[central]}; skill_links
  state=$(skill_state "$rec")
  if [[ $state != ok && $state != missing ]] && ((!opt_force)); then
    trust_exit 3 "the skill $name in $c was changed after llmserver installed it ($(tr '\n' ' ' <<<"$state")); --force removes it anyway"
  fi
  for l in "${SK_LINKS[@]}"; do skill_unlink "$l" "$c"; done
  [[ -d $c && ! -L $c ]] && rm -rf -- "$c"
  rm -f -- "$rec"
  log_write info "skills: removed $name ($SK_SCOPE) from $c"
  info "removed the skill $name ($c and its links)"
}
cmd_skills() {  # list | check | preview | add | update | remove, then names
  local sub=$1 name st out k a b f inst
  shift
  local names=("$@")
  runtime_ready || die "skills need llmserver's runtime: '$PROG install runtime'"
  lhome_init; mkdir -p "$skill_rec_dir" "$trust_dir/cache"
  skills_relocate
  skill_scope "$( ((opt_project)) && echo project || echo global)"
  case $sub in
    list)
      out=$(trustpy skills-market)
      inst=$(trustpy skill-list)
      if ((json)); then
        py_env "$(helper_python)" -I -c '
import json, sys
inst = json.loads(sys.argv[2]); market = []
for line in sys.argv[1].splitlines():
    p = line.split("\t")
    if p[0] == "skill": market.append({"name": p[1], "description": p[2] if len(p) > 2 else ""})
print(json.dumps({"marketplace": market, "marketplace_reachable": not sys.argv[1].startswith("error"), "installed": inst,
                  "generated": ["llmserver", "hf-cli"]}))' "$out" "$inst"
        return 0
      fi
      echo "${C_B}Installed by $PROG${C_0}"
      py_env "$(helper_python)" -I -c '
import json, sys
rows = json.loads(sys.argv[1])
if not rows: print("  none (\x27llmserver skills add\x27 installs the llmserver and hf-cli skills)")
for r in rows: print("  %-36s %-8s %-12s %s" % (r["name"], r["scope"], r["source"], r["path"]))' "$inst"
      echo "${C_B}Generated by $PROG${C_0}"
      echo "  llmserver                            how to use llmserver (from this script, version $VERSION)"
      echo "  hf-cli                               the Hugging Face CLI, as 'llmserver hf' (from the pinned hf)"
      echo "${C_B}Hugging Face skills marketplace${C_0}"
      if [[ $out == error* ]]; then echo "  could not be reached"; return 0; fi
      while IFS=$'\t' read -r k a b; do [[ $k == skill && $SK_GENERATED != *" $a "* ]] && printf '  %-36s %s\n' "$a" "${b:0:90}"; done <<<"$out"
      echo "Install with '$PROG skills add NAME' (global) or add --project for this folder. Each is checked first."
      return 0 ;;
    check|preview)
      ((${#names[@]} == 1)) || die "say which skill: '$PROG skills $sub NAME'"
      name=${names[0]}; st=$(mktemp -d "$lhome/tmp/skill.XXXXXX")
      skill_stage "$name" "$st"
      if [[ $sub == preview ]]; then
        if [[ -f $st/$name/SKILL.md ]]; then cat -- "$st/$name/SKILL.md"; fi
        echo; echo "---- files of $name:"; skill_show_files "$SK_LINES" 2>&1
        rm -rf -- "$st"; return 0
      fi
      if ((json)); then cat -- "$SK_PLAN"; echo; rm -rf -- "$st"; return 0; fi
      echo "$PROG: the skill $name has these files:" >&2; skill_show_files "$SK_LINES"
      trust_report "$SK_LINES"; rm -rf -- "$st"
      case $TR_DEC in
        pass) info "result: $name passes the checks" ;;
        ask) info "result: $name passes with the warnings above; 'skills add' asks first (or takes --yes)" ;;
        block) trust_exit 3 "result: $name would be refused" ;;
      esac
      return 0 ;;
    add)
      ((${#names[@]})) || names=(hf-cli llmserver)
      for name in "${names[@]}"; do skill_add "$name" add; done ;;
    update)
      if ((${#names[@]} == 0)); then
        for f in "$skill_rec_dir/$SK_SCOPE_ID"__*.json; do [[ -s $f ]] && names+=("$(basename "${f#*__}" .json)"); done
        ((${#names[@]})) || { info "no skills installed by $PROG in the $SK_SCOPE scope"; return 0; }
      fi
      for name in "${names[@]}"; do
        [[ -s $(skill_rec "$name") ]] || trust_exit 3 "the skill $name is not installed by $PROG in the $SK_SCOPE scope; '$PROG skills add $name'"
        skill_add "$name" update
      done ;;
    remove)
      ((${#names[@]})) || die "say which skill: '$PROG skills remove NAME'"
      for name in "${names[@]}"; do skill_remove "$name"; done ;;
  esac
}
skills_refresh() {  # regenerate the generated skills whose source changed (after an upgrade, or doctor --fix)
  local f rec n=0
  skills_relocate
  for f in "$skill_rec_dir"/*.json; do
    [[ -s $f ]] || continue
    skill_fields "$f"
    [[ ${SF[source]} == generated ]] || continue
    if [[ ${SF[scope]} == project ]]; then
      SK_SCOPE=project SK_SCOPE_ID=${f##*/}; SK_SCOPE_ID=${SK_SCOPE_ID%%__*}
      SK_CENTRAL=${SF[central]%/*}; skill_links; SK_LINKDIRS=("${SK_LINKS[@]%/*}")
    else skill_scope global; fi
    ( skill_add "${SF[name]}" update ) >/dev/null 2>&1 && n=$((n + 1))
  done
  ((n)) && info "refreshed $n generated skill(s)"
  return 0
}
doctor_skills() {  # findings about the installed skills
  local f state out listed="" k a b
  compgen -G "$skill_rec_dir/*.json" >/dev/null || return 0
  helper_python >/dev/null || return 0
  skills_relocate
  out=$(trustpy skills-market 2>/dev/null) || true
  [[ $out == error* ]] || listed=" $(awk -F'\t' '$1 == "skill" {printf "%s ", $2}' <<<"$out")"
  for f in "$skill_rec_dir"/*.json; do
    skill_fields "$f"
    state=$(skill_state "$f")
    case $state in
      ok) ;;
      missing) dfind warn skills "${SF[name]} (${SF[scope]}): ${SF[central]} is gone; '$PROG skills add ${SF[name]}' installs it again"; continue ;;
      *) dfind warn skills "${SF[name]} (${SF[scope]}): changed since it was installed: $(tr '\n' ' ' <<<"$state")" ;;
    esac
    if [[ ${SF[source]} == generated ]]; then
      if [[ ${SF[generator]} != *"llmserver=$VERSION"* ]]; then
        if ((opt_fix)); then dfind fixed skills "${SF[name]}: regenerated for llmserver $VERSION"
        else dfind info skills "${SF[name]}: generated by an older llmserver; 'doctor --fix' or '$PROG skills update ${SF[name]}' regenerates it"; fi
      fi
    elif [[ -n $listed && $listed != *" ${SF[name]} "* ]]; then
      dfind warn skills "${SF[name]}: no longer listed in Hugging Face's skills marketplace; consider '$PROG skills remove ${SF[name]}'"
    fi
  done
  ((opt_fix)) && skills_refresh >/dev/null
  dfind ok skills "$(compgen -G "$skill_rec_dir/*.json" | wc -l) skill(s) installed by $PROG are recorded"
  return 0
}
hf_link_path() { printf '%s\n' "${XDG_BIN_HOME:-$HOME/.local/bin}/hf"; }
readonly HF_LINK_MARK='# llmserver-hf-link'
cmd_hf() {  # the pinned hf CLI, in a clean environment
  local hf p rc
  case ${hf_args[0]-} in
    --link)
      p=$(hf_link_path)
      if [[ -e $p || -L $p ]] && ! grep -qF "$HF_LINK_MARK" "$p" 2>/dev/null; then die "$p exists and is not llmserver's; nothing was changed"; fi
      mkdir -p "${p%/*}"
      printf '#!/bin/sh\n%s (made by "llmserver hf --link"; "llmserver hf --unlink" removes it)\nexec %q hf "$@"\n' \
        "$HF_LINK_MARK" "$(readlink -f -- "${BASH_SOURCE[0]}")" > "$p.tmp.$$" && chmod 755 "$p.tmp.$$" && mv -f -- "$p.tmp.$$" "$p"
      info "wrote $p: 'hf' now runs llmserver's pinned hf$( [[ :$PATH: == *":${p%/*}:"* ]] || echo " (add ${p%/*} to PATH to use it)")"
      return 0 ;;
    --unlink)
      p=$(hf_link_path)
      if grep -qF "$HF_LINK_MARK" "$p" 2>/dev/null; then rm -f -- "$p"; info "removed $p"; else info "there is no llmserver hf link at $p"; fi
      return 0 ;;
    update) die "the hf CLI is pinned by llmserver; '$PROG upgrade runtime' updates it" ;;
    extensions|ext) [[ ${hf_args[1]-} == install ]] && die "hf extensions would install code into llmserver's runtime, which is hash-locked; this is refused" ;;
    skills) [[ ${hf_args[1]-} == add || ${hf_args[1]-} == update ]] && die "use '$PROG skills ${hf_args[1]}', which checks skills before they are installed" ;;
  esac
  runtime_ready || die "the hf CLI comes with llmserver's runtime: '$PROG install runtime'"
  hf=$(hf_bin) || die "the hf CLI is missing from llmserver's runtime; '$PROG doctor --fix'"
  py_env "$hf" "${hf_args[@]}" && rc=0 || rc=$?
  exit "$rc"
}
skill_llmserver_md() {  # the 'llmserver' skill, generated from this version
  cat <<EOF3
---
name: llmserver
description: "Serve local LLMs with llmserver (llama.cpp, vLLM, Ollama), each model on its own OpenAI-compatible port, and inspect them: which models run, on which port and GPU, what fits, and whether a model passed llmserver's security checks. Use when the user wants to start, stop, list, check, benchmark or connect to a local model, or asks about local GPU capacity."
---

# llmserver ($VERSION)

\`llmserver\` serves local language models. Each running model has its own OpenAI-compatible endpoint, \`http://HOST:PORT/v1\`.

## Read state (safe, read-only; prefer --json)

- \`llmserver ps --json\`: running models. For each: \`spec\`, \`url\`, \`port\`, \`gpus\`, \`vram_mib\`, \`state\`, \`commit\`, \`trust\`.
- \`llmserver env MODEL\`: \`OPENAI_BASE_URL\` and \`OPENAI_API_KEY\` exports for a model. The key file is \`~/.llmserver/config/api-key\`; never print the key back to the user.
- \`llmserver check [MODEL] --json\`: hardware, and whether MODEL fits (\`rating\`: good, tight, offload, cpu, no, unknown).
- \`llmserver capacity --json\`: free GPU memory and which menu models fit now.
- \`llmserver list --json\`: the menu (\`entry\` numbers can be used as MODEL).
- \`llmserver trust check MODEL --json\`: the security checks for a model, without downloading.
- \`llmserver trust show MODEL --json\`, \`llmserver trust list --json\`: check records.
- \`llmserver models outdated --json\`, \`llmserver doctor --json\`, \`llmserver versions --json\`.
- \`llmserver config list --json\`: the settings in effect and where each comes from (secrets are hidden).

MODEL is a menu number or \`llama:ORG/REPO-GGUF:QUANT\`, \`vllm:ORG/REPO\`, \`ollama:NAME[:TAG]\`.

## Act (ask the user first)

- Start: \`llmserver MODEL\`. Starting may stop other models to make room; it asks, unless \`--evict\` is given. Use \`-n\` (dry run) first to show the plan.
- Stop: \`llmserver stop MODEL\` (or \`all\`). Benchmark: \`llmserver bench MODEL\`.
- Ask a running model one question: \`llmserver chat MODEL "question"\` (prints only the answer on stdout). Do not add \`--yes\` unless the user agreed to start the model.
- One address for every running model: \`llmserver gateway start\`, then \`http://127.0.0.1:8000/v1\` (the model is chosen by its name, as \`/v1/models\` lists it).
- A web chat for people: \`llmserver webui\` (installs about 2.5 GB on first use; ask the user first). Documents use hybrid search and a reranker; \`llmserver config set webui_reranker best\` uses bge-reranker-v2-m3 on llama.cpp (a GPU model).
- Web search in that chat: \`llmserver config set webui_search on\`, then \`llmserver webui restart\`. The questions then go to public search engines: ask the user first.
- Menu: \`llmserver model add MODEL\` (checks that the name exists), \`llmserver model rm N\`.
- Settings: \`llmserver config set NAME VALUE\` (checked before it is saved), \`llmserver config unset NAME\`.
- Exit status 3 means the security checks refused a model; 4 means they need an answer or an approval. Show the findings to the user. Do not add \`--yes\`, \`--accept-risk\` or \`--remote-code\`, and do not run \`llmserver trust approve\`, unless the user decides to.

## Never do without an explicit request

- \`llmserver uninstall\`, \`llmserver doctor --fix\`, \`llmserver trust revoke\`, \`llmserver models update\`, \`llmserver model rm --purge\`, \`llmserver model purge\`, \`llmserver key new\`, \`llmserver autostart on|off\`.
- Install another hf CLI. The Hugging Face CLI is \`llmserver hf ...\`.
- Edit \`/etc/llmserver_env\` or files under \`~/.llmserver\` directly; use the \`model\` and \`config\` commands, which check what they write.
EOF3
}

# ---- export, import and offline install (air-gapped transfer) -----------------------------
# 'export' writes checked models (and, with --with-engines, everything 'install' would download)
# into one tar; 'import' and 'install --from' verify it before anything is placed: the
# signature over SHA256SUMS (ssh-keygen -Y, when LLMSERVER_TRUST_SIGNERS is set; required with
# SECURITY=strict), then every member's SHA-256. Engines installed from a bundle get the same
# pinned checksums and hash locks as online.
readonly SIG_NAMESPACE=llmserver-bundle
export_engines() {  # dir -> the files an offline install needs, for this machine's engines
  local d=$1 a f ver var url tag comps=() vars=() py lock klock
  mkdir -p "$d/files" "$d/python" "$d/wheels" "$d/locks"
  ver=$(pin uv); a=$(arch_of uv) || die "no uv build for $(uname -m)"
  f=uv-$a-unknown-linux-musl.tar.gz
  fetch_verified "$GH/astral-sh/uv/releases/download/$ver/$f" "$(pin_sha "$f")" "$d/files/$f" || die "could not download $f"
  export_python "$(pin python_helper)" "$d/python"
  printf '%s\n' "$HELPER_LOCK" > "$d/locks/helper.txt"
  info "collecting llmserver's helper packages (hash-checked)"
  trustpy wheels "$d/locks/helper.txt" "$d/wheels" "$(pin python_helper)" >/dev/null || die "could not collect the helper packages"
  rm -f -- "$d/locks/helper.txt"
  comps=(runtime)
  if comp_meta llama; then
    var=${CM[VARIANT]} f=$(llama_asset "$var")
    info "adding llama.cpp ${CM[VERSION]} ($var)"
    fetch_verified "$GH/ggml-org/llama.cpp/releases/download/${CM[VERSION]}/$f" "$(pin_sha "$f")" "$d/files/$f" || die "could not download $f"
    if [[ $var == cuda-* ]]; then
      fetch_verified "$GH/ggml-org/llama.cpp/releases/download/${CM[VERSION]}/cudart-$f" "$(pin_sha "cudart-$f")" "$d/files/cudart-$f" || die "could not download cudart-$f"
    fi
    comps+=(llama); vars+=("llama=$var")
  fi
  if comp_meta ollama; then
    var=${CM[VARIANT]} a=$(arch_of ollama)
    info "adding Ollama ${CM[VERSION]} ($var)"
    for f in "ollama-linux-$a.tar.zst" $([[ $var == rocm ]] && echo "ollama-linux-$a-rocm.tar.zst"); do
      fetch_verified "$GH/ollama/ollama/releases/download/${CM[VERSION]}/$f" "$(pin_sha "$f@${CM[VERSION]}")" "$d/files/$f" || die "could not download $f"
    done
    comps+=(ollama); vars+=("ollama=$var")
  fi
  if comp_meta vllm; then
    var=${CM[VARIANT]} py=${CM[PYTHON]} lock=$lhome/locks/${CM[LOCK]}
    [[ -s $lock ]] || die "vLLM's lock file $lock is missing; '$PROG doctor --fix' reinstalls vLLM"
    info "adding vLLM ${CM[VERSION]} ($var) and its packages; this downloads several GB"
    export_python "$py" "$d/python"
    cp -- "$lock" "$d/locks/"
    trustpy wheels "$lock" "$d/wheels" "$py" | tail -n 1 >/dev/null || die "could not collect vLLM's packages"
    klock=${lock%.txt}-kernels.txt
    if [[ -s $klock ]]; then cp -- "$klock" "$d/locks/"; trustpy wheels "$klock" "$d/wheels" "$py" >/dev/null || die "could not collect the FlashInfer kernels"; fi
    comps+=(vllm); vars+=("vllm=$var")
  fi
  [[ -s $lhome/pins.local ]] && cp -- "$lhome/pins.local" "$d/pins.local"
  printf '{"components": %s, "variants": %s, "arch": "%s"}\n' "$(jsa "${comps[@]}")" "$(jsa "${vars[@]}")" "$(uname -m)" > "$d/engines.json"
  EXPORT_COMPS=("${comps[@]}")
}
export_python() {  # version dir: the python-build-standalone archive uv would install (uv checks its hash on install)
  local v=$1 d=$2 url tag f
  url=$(uvc python list "$v" --only-downloads --show-urls 2>/dev/null | awk -v want="cpython-$v-linux-$(uname -m)-gnu" '$1 == want && $2 ~ /^https:/ {print $2; exit}')
  [[ -n $url ]] || die "uv knows no download for Python $v on this machine"
  tag=${url%/*}; tag=${tag##*/}; f=${url##*/}; f=${f//%2B/+}
  mkdir -p "$d/$tag"
  [[ -s $d/$tag/$f ]] && return 0
  info "adding Python $v"
  curl -sSfL --proto '=https' --proto-redir '=https' --tlsv1.2 --retry 3 -o "$d/$tag/$f.part" -- "$url" || die "could not download Python $v"
  mv -f -- "$d/$tag/$f.part" "$d/$tag/$f"
}
cmd_export() {  # MODEL... -o FILE [--with-engines] [--sign KEY]
  local out=$opt_output name rec recs=() work st who line n=0 eng=- man
  [[ -n $out ]] || die "say where to write the bundle: '$PROG export MODEL... -o FILE'"
  ((${#export_names[@]} || opt_with_engines)) || die "say which models to export (menu numbers or specs), and/or --with-engines"
  [[ -z $opt_sign || -r $opt_sign ]] || die "the signing key $opt_sign is not readable"
  [[ -z $opt_sign ]] || have ssh-keygen || die "signing needs ssh-keygen (OpenSSH)"
  runtime_ready || die "export needs llmserver's runtime: '$PROG install runtime'"
  [[ $out == /* ]] || out=$PWD/$out
  for name in "${export_names[@]}"; do
    choose "$name" || die "$R_ERR"
    [[ $MODEL == /* ]] && die "$SPEC is a file on this computer; copy the file itself to the other machine, and add it there with '$PROG model add PATH'"
    rec=$(trust_find "$ENGINE" "$MODEL") || die "$SPEC has no check record; start it, or '$PROG trust approve $SPEC', first"
    trust_fields "$rec"
    case ${TF[status]} in
      revoked) die "$SPEC: its check record was revoked; it cannot be exported" ;;
      accepted) [[ $SEC_LEVEL == strict ]] && die "SECURITY=strict: $SPEC is accepted but not approved; '$PROG trust approve $SPEC' first"
                warn "$SPEC was accepted, not approved; the importing side sees status 'imported' with 'accepted' at export" ;;
    esac
    line=$(trust_enforce "$ENGINE" "$MODEL" "$rec")
    [[ $line == ok* ]] || die "$SPEC: $(cut -f3 <<<"$line"); start it once to download it again"
    if [[ $ENGINE == ollama ]]; then recs+=("$rec=$(trust_manifest "$ENGINE" "$MODEL")"); else recs+=("$rec"); fi
    n=$((n + 1))
  done
  ((opt_with_engines)) && install_lock   # before the staging folder: taking the lock empties $lhome/tmp
  work=$(mktemp -d "$lhome/tmp/export.XXXXXX")
  if ((opt_with_engines)); then export_engines "$work/engines"; eng=$work/engines; fi
  who=${USER:-$(id -un)}@$(hostname 2>/dev/null || echo localhost)
  info "writing the bundle (hashing every file)"
  trustpy bundle-write "$work/bundle" "$who" "$VERSION" "$eng" "${recs[@]}" > "$work/out" || { cat -- "$work/out" >&2; rm -rf -- "$work"; trust_exit 3 "the bundle was not written"; }
  if [[ -n $opt_sign ]]; then
    ssh-keygen -Y sign -q -f "$opt_sign" -n "$SIG_NAMESPACE" "$work/bundle.d/SHA256SUMS" </dev/null ||
      { rm -rf -- "$work"; die "ssh-keygen could not sign the bundle with $opt_sign"; }
  fi
  mkdir -p "$(dirname -- "$out")"
  trustpy bundle-pack "$work/bundle.d" "$out" >/dev/null || { rm -rf -- "$work"; die "could not write $out"; }
  man=$(awk -F'\t' '$1 == "id" {print $2}' "$work/out")
  rm -rf -- "$work"
  log_write info "export: bundle $man with $n model(s)${opt_with_engines:+ and engines} to $out${opt_sign:+, signed with $opt_sign}"
  info "${C_B}exported${C_0} $n model(s)$( ((opt_with_engines)) && echo " and the engines (${EXPORT_COMPS[*]})" || true) to $out ($(hsize "$(stat -c %s -- "$out")")$([[ -n $opt_sign ]] && echo ', signed' || echo ', not signed'))"
  info "on the other machine: '$PROG import $(basename -- "$out")'$( ((opt_with_engines)) && echo " (first '$PROG install --from $(basename -- "$out")' if llmserver is not installed there)" || true)"
}
bundle_open() {  # bundle -> BUNDLE_DIR, a checked copy of its contents; exits 3 on any doubt
  local f=$1 st bad sig=0 principal listed members
  [[ -f $f && -r $f ]] || die "cannot read $f"
  lhome_init
  st=$(mktemp -d "$lhome/tmp/bundle.XXXXXX")
  BUNDLE_DIR=$st
  bad=$(tar -tvf "$f" 2>/dev/null | awk '$1 !~ /^-/ {print $NF}' | head -n 3) || true
  [[ -z $bad ]] || { rm -rf -- "$st"; trust_exit 3 "$f holds entries that are not plain files ($bad); refused"; }
  members=$(tar -tf "$f") || { rm -rf -- "$st"; trust_exit 3 "$f is not a readable tar file"; }
  grep -qE '(^/|(^|/)\.\.(/|$))' <<<"$members" && { rm -rf -- "$st"; trust_exit 3 "$f holds paths outside the bundle; refused"; }
  grep -qx SHA256SUMS <<<"$members" || { rm -rf -- "$st"; trust_exit 3 "$f is not an llmserver bundle (no SHA256SUMS)"; }
  tar -xf "$f" -C "$st" --no-same-owner --no-same-permissions SHA256SUMS
  grep -qx SHA256SUMS.sig <<<"$members" && { tar -xf "$f" -C "$st" --no-same-owner --no-same-permissions SHA256SUMS.sig; sig=1; }
  # the signature first
  if [[ -n ${CFG[TRUST_SIGNERS]} ]]; then
    ((sig)) || { rm -rf -- "$st"; trust_exit 3 "$f is not signed, and LLMSERVER_TRUST_SIGNERS requires a signature"; }
    have ssh-keygen || { rm -rf -- "$st"; trust_exit 3 "checking the signature needs ssh-keygen (OpenSSH)"; }
    principal=$(ssh-keygen -Y find-principals -s "$st/SHA256SUMS.sig" -f "${CFG[TRUST_SIGNERS]}" 2>/dev/null | head -n 1) || principal=""
    [[ -n $principal ]] || { rm -rf -- "$st"; trust_exit 3 "$f is signed by a key that is not in ${CFG[TRUST_SIGNERS]}; refused"; }
    ssh-keygen -Y verify -f "${CFG[TRUST_SIGNERS]}" -I "$principal" -n "$SIG_NAMESPACE" -s "$st/SHA256SUMS.sig" < "$st/SHA256SUMS" >/dev/null 2>&1 ||
      { rm -rf -- "$st"; trust_exit 3 "the signature of $f does not verify; refused"; }
    info "signature: good, by $principal (${CFG[TRUST_SIGNERS]})"
    BUNDLE_SIGNER=$principal
  elif [[ $SEC_LEVEL == strict ]]; then
    rm -rf -- "$st"; trust_exit 3 "SECURITY=strict needs signed bundles: set LLMSERVER_TRUST_SIGNERS to an ssh allowed_signers file"
  elif ((sig)); then
    warn "$f is signed, but LLMSERVER_TRUST_SIGNERS is not set, so the signature was not checked"
  else
    warn "$f is not signed; its files are checked against SHA256SUMS only"
  fi
  # exactly the listed members, then every hash
  listed=$( { sed -E 's/^[0-9a-f]{64}  //' "$st/SHA256SUMS"; echo SHA256SUMS; if ((sig)); then echo SHA256SUMS.sig; fi; } | LC_ALL=C sort)
  grep -qvE '^[0-9a-f]{64}  [^/][^[:cntrl:]]*$' "$st/SHA256SUMS" && { rm -rf -- "$st"; trust_exit 3 "SHA256SUMS in $f is malformed; refused"; }
  [[ $listed == "$(LC_ALL=C sort <<<"$members")" ]] || { rm -rf -- "$st"; trust_exit 3 "$f holds files that SHA256SUMS does not list (or lacks listed ones); refused"; }
  info "checking every file of the bundle"
  tar -xf "$f" -C "$st" --no-same-owner --no-same-permissions
  (cd "$st" && sha256sum -c --strict --quiet SHA256SUMS) >&2 || { rm -rf -- "$st"; trust_exit 3 "files in $f do not match SHA256SUMS; nothing was placed"; }
  BUNDLE_VERSION=$(sed -nE 's/^ "llmserver": "([^"]*)",?$/\1/p' "$st/manifest.json")
  BUNDLE_ARCH=$(sed -nE 's/^ "arch": "([^"]*)",?$/\1/p' "$st/manifest.json")
  BUNDLE_ID=$(sed -nE 's/^ "id": "([^"]*)",?$/\1/p' "$st/manifest.json")
  return 0
}
cmd_import() {  # BUNDLE: place its checked models and records
  local f=$sel out store who k a b n=0
  [[ -n $f ]] || die "say which bundle: '$PROG import FILE'"
  runtime_ready || die "import needs llmserver's runtime. If this machine has no network, run '$PROG install --from $f' first (with a bundle exported --with-engines)"
  bundle_open "$f"
  [[ $BUNDLE_VERSION == "$VERSION" ]] || warn "the bundle was written by llmserver $BUNDLE_VERSION; this is $VERSION"
  store=$(ollama_manifest x:y); store=${store%%/manifests/*}
  who=${USER:-$(id -un)}@$(hostname 2>/dev/null || echo localhost)
  out=$(trustpy bundle-place "$BUNDLE_DIR" "$store" "$who") || { rm -rf -- "$BUNDLE_DIR"; trust_exit 3 "the models could not be placed"; }
  while IFS=$'\t' read -r k a b; do [[ $k == placed ]] && { info "imported $a (commit ${b:0:12})"; n=$((n + 1)); }; done <<<"$out"
  rm -rf -- "$BUNDLE_DIR"
  log_write info "import: bundle $BUNDLE_ID ($n model(s)) from $f${BUNDLE_SIGNER:+, signed by $BUNDLE_SIGNER}"
  info "${C_B}imported${C_0} $n model(s); they start from these files, without a network ('$PROG trust list' shows them)"
}
install_archive() {  # a llama.cpp or Ollama release file the user downloaded -> installed as llmserver's own copy, if it is the pinned one
  local f=$1 n v a comp="" var=""
  n=${f##*/}
  pins_load
  a=$(arch_of llama 2>/dev/null || true)
  for v in cpu vulkan cuda-12.8 cuda-13.4; do [[ $n == "$(llama_asset "$v" 2>/dev/null)" ]] && { comp=llama var=$v; }; done
  a=$(arch_of ollama 2>/dev/null || true)
  [[ $n == "ollama-linux-$a.tar.zst" ]] && comp=ollama var=base
  [[ $n == "ollama-linux-$a-rocm.tar.zst" ]] && comp=ollama var=rocm
  if [[ -z $comp ]]; then
    if [[ $n == llama-b*-bin-* ]]; then
      die "$n is not the llama.cpp release this llmserver pins ($(pin llama); for this machine: $(llama_asset "$(llama_variant)")). To use it anyway as your own copy, unpack it and run '$PROG config set llama_source /path/to/the/unpacked/folder'"
    elif [[ $n == ollama-linux-* ]]; then
      die "$n is not the Ollama release file for this machine (ollama-linux-$a.tar.zst, version $(pin ollama)). To use another Ollama, unpack it and run '$PROG config set ollama_source /path/to/the/unpacked/folder'"
    fi
    return 1   # not a release file: a bundle
  fi
  LOCAL_SRC=$(cd "$(dirname -- "$f")" && pwd)
  [[ $comp == llama ]] && CFG[LLAMA_BUILD]=$var
  if [[ $comp == llama && $var == cuda-* && ! -f $LOCAL_SRC/cudart-$n ]]; then info "cudart-$n is not next to it; it is downloaded (the CUDA build needs it)"; fi
  if [[ $comp == ollama && $var == rocm ]]; then die "$n holds only Ollama's ROCm libraries; give ollama-linux-$a.tar.zst (keep both files in the same folder)"; fi
  info "installing $comp from $n (checked against llmserver's pinned SHA-256)"
  [[ $(engine_source "$comp") == managed ]] || warn "LLMSERVER_${comp^^}_SOURCE is $(engine_where "$comp"); after this install, '$PROG config set ${comp}_source managed' uses this copy"
  yes=1 cmd_install "$comp"
  LOCAL_SRC=""
  return 0
}
install_from() {  # BUNDLE [component...]: install the engines from a bundle, without a network
  local f=$1 comps
  shift
  [[ -f $f ]] || die "$f does not exist"
  if install_archive "$f"; then return 0; fi
  install_lock   # first: taking the lock empties $lhome/tmp, where the bundle is unpacked
  bundle_open "$f"
  [[ -s $BUNDLE_DIR/engines/engines.json ]] || { rm -rf -- "$BUNDLE_DIR"; die "$f has no engines; export it with --with-engines"; }
  [[ $BUNDLE_VERSION == "$VERSION" ]] || { rm -rf -- "$BUNDLE_DIR"; die "the bundle is for llmserver $BUNDLE_VERSION; use that version of the script here too (this is $VERSION)"; }
  [[ $BUNDLE_ARCH == "$(uname -m)" ]] || { rm -rf -- "$BUNDLE_DIR"; die "the bundle is for $BUNDLE_ARCH; this machine is $(uname -m)"; }
  OFFLINE_SRC=$BUNDLE_DIR/engines
  OFFLINE_PIP=(--no-index --find-links "$OFFLINE_SRC/wheels")
  mkdir -p "$lhome/locks"
  for lock in "$OFFLINE_SRC"/locks/*.txt; do [[ -s $lock ]] && cp -- "$lock" "$lhome/locks/"; done
  if [[ -s $OFFLINE_SRC/pins.local ]]; then cp -- "$OFFLINE_SRC/pins.local" "$lhome/pins.local"; pins_load; fi
  comps=$(sed -nE 's/.*"components": \[([^]]*)\].*/\1/p' "$OFFLINE_SRC/engines.json" | sed 's/[",]/ /g')
  info "installing from the bundle, without a network: $comps"
  # shellcheck disable=SC2086
  if (($#)); then yes=1 cmd_install "$@"; else yes=1 cmd_install $comps; fi
  rm -rf -- "$BUNDLE_DIR"; OFFLINE_SRC="" OFFLINE_PIP=()
}
cmd_sbom() {  # CycloneDX JSON of everything llmserver installed, and the checked models
  local pf k
  runtime_ready || die "the SBOM needs llmserver's runtime: '$PROG install runtime'"
  pf=$(mktemp "$lhome/tmp/pins.XXXXXX")
  { for k in "${!PIN[@]}"; do printf '%s\t%s\n' "$k" "$(pin "$k")"; done
    for k in "${!PIN_SHA[@]}"; do printf 'sha:%s\t%s\n' "$k" "${PIN_SHA[$k]}"; done
    for k in "${!PINL[@]}"; do [[ $k == sha:* ]] && printf '%s\t%s\n' "$k" "${PINL[$k]}"; done
  } > "$pf"
  trustpy sbom "$lhome" "$pf" "$VERSION"
  rm -f -- "$pf"
}

# ---- behaviour checks ---------------------------------------------------------------------
# 'llmserver eval MODEL' sends a few fixed probes to a running model and records the results
# with its check record. '--garak' also runs NVIDIA's garak scanner, installed on request into
# its own hash-locked venv (with CPU PyTorch) under LLMSERVER_HOME/tools. Results are
# information: a model that passes can still misbehave in ways no probe tests.
readonly GARAK_DEFAULT_PROBES=promptinject.HijackKillHumans,latentinjection.LatentInjectionFactSnippetEiffel,dan.DanInTheWild
garak_dir() { printf '%s\n' "$lhome/tools/garak/$(pin garak)"; }
install_garak() {
  local d lock st py
  py=$(pin python_engine)
  d=$(garak_dir)
  [[ -x $d/bin/garak ]] && return 0
  if ((!yes)); then
    [[ -t 0 && -t 2 ]] || die "garak is not installed; '$PROG eval MODEL --garak --yes' installs it (about $((PIN_SIZE[garak] / 1000)) GB, with CPU PyTorch) into $lhome/tools"
    printf '%s: install garak %s (about %d GB, with CPU PyTorch) into %s? [y/N]: ' "$PROG" "$(pin garak)" "$((PIN_SIZE[garak] / 1000))" "$lhome/tools" >&2
    IFS= read -r REPLY || REPLY=""; [[ ${REPLY,,} == y* ]] || die "garak was not installed"
  fi
  install_runtime
  info "installing garak $(pin garak) and its packages (hash-locked); this takes a while"
  uvc python install "$py" --no-bin >/dev/null 2>&1 || uvc python install "$py" --no-bin || die "uv could not install Python $py"
  lock=$lhome/locks/garak-$(pin garak)-cpu.txt
  if [[ ! -s $lock ]]; then
    printf 'garak==%s\n' "$(pin garak)" > "$lhome/tmp/garak.in"
    uvc pip compile "$lhome/tmp/garak.in" --python-version "${py%.*}" --torch-backend cpu --generate-hashes --emit-index-url \
      --no-header --quiet -o "$lock.tmp" || { rm -f -- "$lock.tmp"; die "could not resolve garak $(pin garak)"; }
    mv -f -- "$lock.tmp" "$lock"; rm -f -- "$lhome/tmp/garak.in"
  fi
  st=$(stage_dir garak)
  uvc venv --relocatable --python "$py" --no-project --quiet "$st/venv" || die "could not create garak's venv"
  uvc pip sync --require-hashes --torch-backend cpu --python "$st/venv/bin/python" "$lock" || { rm -rf -- "$st"; die "could not install garak (hash-checked against $lock)"; }
  mkdir -p "${d%/*}"; chmod -R go-w -- "$st/venv"
  rm -rf -- "$d"; mv -- "$st/venv" "$d"; rm -rf -- "$st"
  log_write info "installed garak $(pin garak) into $d"
}
cmd_eval() {  # MODEL [--garak] [--probes LIST] [--json]
  local base key="" rec res out k a b c d e tot=0 bad=0 rows=() gd rep opts
  helper_python >/dev/null || runtime_ready || die "eval needs llmserver's runtime; run '$PROG install runtime'"
  running_scan
  if [[ -n $sel ]]; then rec_select "$sel" || die "$R_ERR"
  elif ((${#R_FILES[@]} == 1)); then REC=${R_FILES[0]}
  else die "say which running model to test: '$PROG eval MODEL' (see '$PROG ps')"; fi
  load_rec "$REC"
  base="http://$(hostport "$(connect_host "${ST[HOST]}")" "${ST[PORT]}")"
  [[ -s $key_file ]] && key=$(<"$key_file")
  rec=""; [[ -n ${ST[TRUST_RECORD]-} && -s $trust_rec_dir/${ST[TRUST_RECORD]} ]] && rec=$trust_rec_dir/${ST[TRUST_RECORD]}
  mkdir -p "$trust_dir/tmp"; res=$(mktemp "$trust_dir/tmp/eval.XXXXXX")
  ((json)) || info "probing ${ST[SPEC]} (prompt injection through a document, system prompt leak)"
  out=$(trustpy eval-builtin "$base" "$(model_id "${ST[ENGINE]}" "${ST[MODEL]}")" "$key" "$res") || die "the probes could not reach ${ST[SPEC]}"
  [[ -n $rec ]] && trustpy record-eval "$rec" "$res" "${ST[SPEC]}" "$VERSION"
  rows+=("$out")
  if ((opt_garak)); then
    install_garak
    gd=$(garak_dir); mkdir -p "$lhome/tools/garak/data"
    opts=$(mktemp "$trust_dir/tmp/garak.XXXXXX")
    printf '{"openai": {"OpenAICompatible": {"uri": "%s/v1", "model": %s, "max_tokens": 128}}}\n' "$base" "$(js "$(model_id "${ST[ENGINE]}" "${ST[MODEL]}")")" > "$opts"
    rep=eval-$(date +%Y%m%d-%H%M%S)
    ((json)) || info "running garak (${opt_probes:-$GARAK_DEFAULT_PROBES}); this can take a long time. Output: $logs_dir/garak.log"
    env XDG_DATA_HOME="$lhome/tools/garak/data" XDG_CONFIG_HOME="$lhome/tools/garak/config" XDG_CACHE_HOME="$lhome/tools/garak/cache" \
      OPENAICOMPATIBLE_API_KEY="${key:-none}" PYTHONNOUSERSITE=1 HF_HUB_DISABLE_TELEMETRY=1 \
      "$gd/bin/garak" --target_type openai.OpenAICompatible --target_name "$(model_id "${ST[ENGINE]}" "${ST[MODEL]}")" --generator_option_file "$opts" \
      --probes "${opt_probes:-$GARAK_DEFAULT_PROBES}" --generations 1 --report_prefix "$rep" > "$logs_dir/garak.log" 2>&1 ||
      { rm -f -- "$opts" "$res"; die "garak failed; see $logs_dir/garak.log"; }
    rm -f -- "$opts"
    out=$(trustpy eval-garak "$lhome/tools/garak/data/garak/garak_runs/$rep.report.jsonl" "$res") || die "garak's report could not be read"
    [[ -n $rec ]] && trustpy record-eval "$rec" "$res" "${ST[SPEC]}" "$VERSION"
    rows+=("$out")
  fi
  rm -f -- "$res"
  log_write info "eval: ${ST[SPEC]}${opt_garak:+ with garak}"
  if ((json)); then
    local items=()
    while IFS=$'\t' read -r k a b c d e; do
      [[ $k == probe ]] && items+=("$(jo probe "$(js "$a")" tried "$(jn "$b")" failed "$(jn "$c")" errors "$(jn "$d")" meaning "$(js "$e")")")
    done <<<"$(printf '%s\n' "${rows[@]}")"
    jo model "$(js "${ST[SPEC]}")" commit "$(js "${ST[COMMIT]-}")" results "$(ja "${items[@]}")" recorded "$(jb "$([[ -n $rec ]] && echo 1 || echo 0)")"; echo
    return 0
  fi
  printf '%-70s %7s %7s\n' "probe" "failed" "tried"
  while IFS=$'\t' read -r k a b c d e; do
    [[ $k == probe ]] || continue
    printf '%-70s %7s %7s%s\n' "${a:0:70}" "$c" "$b" "$( ((d)) && echo "  ($d errors)" || true)"
    tot=$((tot + b)); bad=$((bad + c))
  done <<<"$(printf '%s\n' "${rows[@]}")"
  echo "failed = the attack worked. $bad of $tot attempts failed."
  [[ -n $rec ]] && echo "The results are kept in the check record of the model: $PROG trust show ${ST[SPEC]}"
  echo "These probes measure known attacks only; a model that passes can still misbehave."
}

# ---- trust and models commands ----------------------------------------------------------
trust_latest() {  # -> the newest record of each model, one path per line
  local f b seen=" "
  while IFS= read -r f; do
    [[ -n $f ]] || continue
    b=${f##*/}; b=${b%@*}
    [[ $seen == *" $b "* ]] && continue
    seen+="$b "; printf '%s\n' "$f"
  done < <(ls -t -- "$trust_rec_dir"/*.json 2>/dev/null)
}
declare -A TF=()
trust_fields() { local k v; TF=(); while IFS=$'\t' read -r k v; do TF[$k]=$v; done < <(trustpy fields "$1"); }
trust_model_of() {  # TF -> the model part of the spec, for lookups (Ollama manifests)
  local s=${TF[spec]#*:}
  printf '%s\n' "$s"
}
trust_summary() {  # engine model -> one line on the model's check record (no network)
  local f
  if ! f=$(trust_find "$1" "$2"); then echo "not checked yet; '$PROG trust check $1:$2' shows what the checks find"; return; fi
  trust_fields "$f"
  echo "${TF[status]} at commit ${TF[commit]:0:12} on ${TF[decided_at]%T*} (level ${TF[level]}; '$PROG trust show $1:$2')"
}
cmd_trust() {  # check | approve | revoke | show | verify | list
  local f plan out n=0 bad=0 urc=0 r items=() k a b c
  if [[ $sub == list ]]; then trustpy list "$( ((json)) && echo json || echo text)"; return 0; fi
  if [[ -n $sel ]]; then
    choose "$sel" || die "$R_ERR"
    FIT_FLAGS=()
    case $ENGINE in llama) read -ra FIT_FLAGS <<<"${CFG[LLAMA_FLAGS]} $EXTRA" ;; vllm) read -ra FIT_FLAGS <<<"${CFG[VLLM_FLAGS]} $EXTRA" ;; esac
    FIT_FLAGS+=("${pass[@]}")
    user_wants_rc && urc=1
  elif [[ $sub != verify ]]; then die "say which model: '$PROG trust $sub MODEL' (a menu number or a spec)"; fi
  case $sub in
    check)
      if ((json)); then
        runtime_ready || die "the security checks need llmserver's runtime: '$PROG install runtime'"
        mkdir -p "$trust_dir/tmp"; plan=$(mktemp "$trust_dir/tmp/plan.XXXXXX")
        TP_OUT=$plan TP_ACCEPT="${opt_accept[*]}" trustpy plan "$ENGINE" "$MODEL" "$urc" >/dev/null
        if [[ -s $plan ]]; then cat -- "$plan"; echo; fi
        rm -f -- "$plan"; return 0
      fi
      trust_gate "$ENGINE" "$MODEL" check "$urc"
      case $TR_DEC in
        pass) info "result: $SPEC passes the checks at SECURITY=$SEC_LEVEL (commit ${TR_COMMIT:0:12})" ;;
        ask) info "result: $SPEC passes with the warnings above; a start asks first (or takes --yes)" ;;
      esac
      [[ $SEC_LEVEL == strict ]] && info "SECURITY=strict: approve it with '$PROG trust approve $SPEC' before it can be downloaded or started"
      return 0 ;;
    approve)
      trust_gate "$ENGINE" "$MODEL" approve "$urc"
      info "${C_B}approved${C_0}: $SPEC at commit ${T_COMMIT:0:12}$( ((T_RCOK)) && echo ', including its own code' || true)"
      running_scan
      if f=$(rec_find "$SPEC"); then info "$SPEC is running; '$PROG $SPEC --restart' serves the approved commit"; fi
      return 0 ;;
    revoke)
      f=$(trust_find "$ENGINE" "$MODEL") || die "$SPEC has no check record"
      trustpy set "$f" status revoked
      log_write info "trust: revoked $SPEC (${f##*/})"
      info "revoked the check record of $SPEC; it cannot start until it is approved again ('$PROG trust approve $SPEC')"
      running_scan
      if f=$(rec_find "$SPEC"); then stop_rec "$f" && info "stopped $SPEC"; fi
      return 0 ;;
    show)
      f=$(trust_find "$ENGINE" "$MODEL") || die "$SPEC has no check record; '$PROG trust check $SPEC' runs the checks without downloading"
      trustpy show "$f" "$( ((json)) && echo json || echo text)" "$opt_code"
      return 0 ;;
    verify)
      local recs=()
      if [[ -n $sel ]]; then f=$(trust_find "$ENGINE" "$MODEL") || die "$SPEC has no check record"; recs=("$f")
      else mapfile -t recs < <(trust_latest); fi
      ((${#recs[@]})) || { info "no check records yet"; return 0; }
      for f in "${recs[@]}"; do
        trust_fields "$f"
        ((json)) || info "hashing the files of ${TF[spec]}"
        out=$(TP_MANIFEST=$(trust_manifest "${TF[engine]}" "$(trust_model_of)") trustpy verify "$f")
        while IFS=$'\t' read -r k a b c; do
          case $k in
            bad) bad=$((bad + 1)); ((json)) || warn "${TF[spec]}: $a: $b" ;;
            summary) n=$((n + a)) ;;
          esac
        done <<<"$out"
        items+=("$(jo spec "$(js "${TF[spec]}")" commit "$(js "${TF[commit]}")" ok "$(jb "$( [[ $out != *$'\nbad\t'* && $out != bad* ]] && echo 1 || echo 0)")")")
      done
      if ((json)); then jo files "$(jn "$n")" bad "$(jn "$bad")" models "$(ja "${items[@]}")"; echo
      elif ((bad)); then warn "$bad file(s) differ from their check records; '$PROG doctor --deep --fix' deletes them so the next start downloads and checks them again"
      else info "all $n file(s) match their check records"; fi
      ((bad == 0)) || exit 3
      return 0 ;;
  esac
}
# ---- the menu: 'llmserver model list|add|rm|edit' --------------------------------
model_exists() {  # engine model -> 0 exists, 1 not found (ME_MSG says why, with suggestions), 2 cannot tell (ME_MSG)
  local out k a b c d e
  ME_MSG=""
  if [[ $2 == /* ]]; then
    [[ -f $2 ]] || { ME_MSG="$2 does not exist"; return 1; }
    [[ $(head -c 4 -- "$2" 2>/dev/null) == GGUF ]] || { ME_MSG="$2 is not a GGUF file"; return 1; }
    return 0
  fi
  helper_python >/dev/null || runtime_ready >/dev/null 2>&1 || { ME_MSG="llmserver's runtime is not installed"; return 2; }
  mkdir -p "$trust_dir/tmp"
  out=$(TP_OUT=$(mktemp "$trust_dir/tmp/exists.XXXXXX") TP_REF="" TP_REFNAME="" trustpy plan "$1" "$2" 0 2>/dev/null) || true
  while IFS=$'\t' read -r k a b c d e; do
    [[ $k == finding ]] || continue
    case $b in
      M-NOT-FOUND) ME_MSG=$e; return 1 ;;
      M-HUB-OFFLINE) [[ $a == block ]] && { ME_MSG=$e; return 2; } ;;
    esac
  done <<<"$out"
  [[ $out == error* ]] && { ME_MSG="the check could not run"; return 2; }
  return 0
}
menu_running() {  # spec -> is a model of this spec running?
  local f
  running_scan
  for f in "${R_FILES[@]}"; do load_rec "$f" && [[ ${ST[SPEC]} == "$1" ]] && return 0; done
  return 1
}
menu_show() {  # numbered entries, with 'running' marks (no network)
  local i mark
  for i in "${!specs[@]}"; do
    mark=""; menu_running "${specs[i]}" && mark="  (running)"
    printf '%3d) %s%s%s\n' "$((i + 1))" "$(spec_show "${specs[i]}")" "${extras[i]:+  ${extras[i]}}" "$mark" >&2
  done
  return 0
}
menu_pick() {  # words (numbers, ranges like 2-4, or names) -> MP (menu indexes); asks when there are none
  local w a b i found reply words=("$@")
  MP=()
  if ((${#words[@]} == 0)); then
    [[ -t 0 && -t 2 ]] || die "say which entries: '$PROG model $sub N...' (numbers from '$PROG list')"
    echo "$PROG: the menu ($models_file):" >&2
    menu_show
    printf 'Which entries? (numbers like 1 3 or 2-4; Enter = none): ' >&2
    IFS= read -r reply || reply=""
    read -ra words <<<"${reply//,/ }"
    ((${#words[@]})) || return 0
  fi
  for w in "${words[@]}"; do
    if [[ $w =~ ^([0-9]+)-([0-9]+)$ ]]; then a=${BASH_REMATCH[1]} b=${BASH_REMATCH[2]}
    elif [[ $w =~ ^[0-9]+$ ]]; then a=$w b=$w
    else
      parse_spec "$w" || die "$R_ERR"
      found=""
      for i in "${!specs[@]}"; do [[ ${specs[i]} == "$R_SPEC" ]] && found=$i; done
      [[ -n $found ]] || die "$R_SPEC is not in the menu; '$PROG list' shows it"
      MP+=("$found"); continue
    fi
    ((10#$a >= 1 && 10#$b <= ${#specs[@]} && 10#$a <= 10#$b)) || die "the menu has entries 1-${#specs[@]}; '$w' is not one of them"
    for ((i = 10#$a; i <= 10#$b; i++)); do MP+=("$((i - 1))"); done
  done
  mapfile -t MP < <(printf '%s\n' "${MP[@]}" | sort -un)
}
menu_drop_lines() {  # line numbers -> rewrite the menu without them (comments and blank lines are kept)
  local tmp=$models_file.tmp.$$ n=0 line
  local -A drop=()
  for n in "$@"; do drop[$n]=1; done
  n=0
  : > "$tmp" || die "cannot write $models_file"
  while IFS= read -r line || [[ -n $line ]]; do
    n=$((n + 1)); [[ -v drop[$n] ]] || printf '%s\n' "$line" >> "$tmp"
  done < "$models_file"
  mv -f -- "$tmp" "$models_file"
}
model_purge() {  # spec: delete the files llmserver downloaded for it (kept: files other menu entries use) and its check records
  local e m p o f n=0
  local -A used=()
  local paths=() olls=()
  parse_spec "$1" || return 0; e=$R_ENGINE m=$R_MODEL
  if [[ -r $downloads_file ]]; then
    while IFS=$'\t' read -r o f p; do   # what the remaining menu entries use stays
      [[ $o == "$e" && $f == "$m" ]] && continue
      for n in "${!specs[@]}"; do [[ ${specs[n]} == "$o:$f" ]] && used[$p]=1; done
    done < "$downloads_file"
    while IFS=$'\t' read -r o f p; do
      [[ $o == "$e" && $f == "$m" ]] || continue
      if [[ $p == - ]]; then olls+=("$f")
      elif [[ $p == /*/models--*/* && $p != *..* && ! -v used[$p] && ( -e $p || -L $p ) ]]; then paths+=("$p"); fi
    done < "$downloads_file"
  fi
  if ((${#paths[@]} + ${#olls[@]} == 0)); then info "llmserver downloaded no files for $1 (files other tools downloaded are never deleted)"
  else
    U_NOTES=() U_FAILS=0
    ((${#paths[@]})) && u_purge_hub "${paths[@]}"
    ((${#olls[@]})) && u_purge_ollama "${olls[@]}"
    for p in "${U_NOTES[@]}"; do info "$p"; done
    awk -F'\t' -v e="$e" -v m="$m" '!($1 == e && $2 == m)' "$downloads_file" > "$downloads_file.tmp.$$" && mv -f -- "$downloads_file.tmp.$$" "$downloads_file"
  fi
  n=0
  for f in "$trust_rec_dir/$(spec_id "$(trust_base "$e" "$m")")@"*.json; do
    [[ -f $f ]] && rm -f -- "$f" && n=$((n + 1))
  done
  ((n)) && info "deleted $n check record(s) of $1"
  log_write info "model rm --purge: $1"
  return 0
}
model_editor() {  # file -> open it in the user's editor
  local ed=${VISUAL:-${EDITOR:-}}
  [[ -n $ed ]] || for ed in nano vim vi; do have "$ed" && break; ed=""; done
  [[ -n $ed ]] || die "no editor found: set EDITOR (for example EDITOR=nano), or edit $1 directly"
  [[ -t 0 && -t 1 ]] || die "'$PROG model edit' needs a terminal; edit $1 directly"
  # shellcheck disable=SC2086   # EDITOR may hold arguments, as in "code --wait"
  $ed "$1" || die "the editor ended with an error; $1 was not checked"
}
cmd_model() {  # list | add SPEC [FLAGS] | rm [N|SPEC...] [--purge] | edit
  local i w names=() lines=() reply rc
  case $sub in
    add)
      ((${#model_args[@]})) || die "say which model: '$PROG model add [engine:]owner/model [engine flags]'"
      parse_spec "${model_args[0]}" || die "$R_ERR"
      for i in "${!specs[@]}"; do [[ ${specs[i]} == "$R_SPEC" ]] && { info "$R_SPEC is already entry $((i + 1)) of the menu"; return 0; }; done
      local spec=$R_SPEC e=$R_ENGINE m=$R_MODEL
      rc=0; model_exists "$e" "$m" || rc=$?
      if ((rc == 1)); then die "not added: $ME_MSG"
      elif ((rc == 2)); then warn "could not check that $m exists ($ME_MSG); adding it anyway"; fi
      if [[ ! -e $models_file ]]; then mkdir -p "${models_file%/*}"; echo "# llmserver menu: one '[engine:]model [extra engine flags]' per line" > "$models_file"; fi
      w="$spec${model_args[1]:+ ${model_args[*]:1}}${pass[*]:+ ${pass[*]}}"
      printf '%s\n' "$w" >> "$models_file"
      info "added $w to the menu as entry $((${#specs[@]} + 1))" ;;
    rm|remove)
      ((${#specs[@]})) || { info "the menu is empty ($models_file); nothing to remove"; return 0; }
      menu_pick "${model_args[@]}"
      ((${#MP[@]})) || { info "nothing was removed"; return 0; }
      for i in "${MP[@]}"; do names+=("${specs[i]}"); lines+=("${spec_lines[i]}"); done
      if ((purge)); then
        for w in "${names[@]}"; do menu_running "$w" && die "$w is running; stop it first ('$PROG stop $w'), then remove it with --purge"; done
        if ((!yes)); then
          [[ -t 0 && -t 2 ]] || die "--purge deletes downloaded files; add --yes to do it without a question"
          printf 'Remove %s from the menu and delete the files llmserver downloaded for it? [y/N]: ' "$(printf '%s, ' "${names[@]}" | sed 's/, $//')" >&2
          IFS= read -r reply || reply=""
          [[ ${reply,,} == y* ]] || { info "nothing was removed"; return 0; }
        fi
      fi
      menu_drop_lines "${lines[@]}"
      for w in "${names[@]}"; do
        info "removed $w from the menu"
        log_write info "model rm: $w"
        menu_running "$w" && info "  it is still running; '$PROG stop $w' stops it"
      done
      MENU_QUIET=1; load_models
      if ((purge)); then for w in "${names[@]}"; do model_purge "$w"; done
      else
        for w in "${names[@]}"; do
          parse_spec "$w" && [[ -r $downloads_file ]] && awk -F'\t' -v e="$R_ENGINE" -v m="$R_MODEL" '$1 == e && $2 == m {f=1} END {exit !f}' "$downloads_file" &&
            info "the files llmserver downloaded for $w were kept; '$PROG model purge $w' deletes them"
        done
      fi ;;
    purge)   # files of a model, in the menu or not
      ((${#model_args[@]})) || die "say which model: '$PROG model purge [engine:]owner/model'"
      for w in "${model_args[@]}"; do
        if [[ $w =~ ^[0-9]+$ ]]; then ((10#$w >= 1 && 10#$w <= ${#specs[@]})) || die "no menu entry $w"; w=${specs[10#$w - 1]}
        else parse_spec "$w" || die "$R_ERR"; w=$R_SPEC; fi
        menu_running "$w" && die "$w is running; stop it first ('$PROG stop $w')"
        if ((!yes)); then
          [[ -t 0 && -t 2 ]] || die "this deletes downloaded files; add --yes to do it without a question"
          printf 'Delete the files llmserver downloaded for %s? [y/N]: ' "$w" >&2
          IFS= read -r reply || reply=""
          [[ ${reply,,} == y* ]] || { info "nothing was deleted"; continue; }
        fi
        model_purge "$w"
      done ;;
    edit)
      if [[ ! -e $models_file ]]; then mkdir -p "${models_file%/*}"; echo "# llmserver menu: one '[engine:]model [extra engine flags]' per line" > "$models_file"; fi
      model_editor "$models_file"
      load_models
      info "the menu has ${#specs[@]} entr$( ((${#specs[@]} == 1)) && echo y || echo ies); '$PROG list' shows them" ;;
    list|"")
      ((${#specs[@]})) || { info "the menu is empty. '$PROG model add [engine:]owner/model' adds one"; return 0; }
      echo "$PROG: the menu ($models_file):" >&2; menu_show ;;
  esac
  return 0
}
cmd_models() {  # outdated | update MODEL
  local f out k a b moved=0 items=() changed
  case $sub in
    outdated)
      runtime_ready || die "the check needs llmserver's runtime: '$PROG install runtime'"
      while IFS= read -r f; do
        [[ -n $f ]] || continue
        trust_fields "$f"
        [[ ${TF[status]} == revoked ]] && continue
        out=$(trustpy upstream "$f"); changed=()
        while IFS=$'\t' read -r k a b; do
          case $k in
            upstream) if [[ $b == moved ]]; then moved=$((moved + 1)); ((json)) || echo "${TF[spec]}: ${TF[commit]:0:12} -> ${a:0:12}"; fi ;;
            changed) changed+=("$a") ;;
            error) ((json)) || warn "${TF[spec]}: the upstream could not be checked ($a)" ;;
          esac
        done <<<"$out"
        ((json)) || { ((${#changed[@]})) && printf '    changed: %s\n' "${changed[@]}"; }
        [[ $out == *$'\tmoved'* ]] && items+=("$(jo spec "$(js "${TF[spec]}")" commit "$(js "${TF[commit]}")" upstream "$(js "$(awk -F'\t' '$1 == "upstream" {print $2}' <<<"$out")")" changed "$(jsa "${changed[@]}")")")
      done < <(trust_latest)
      if ((json)); then jo outdated "$(ja "${items[@]}")"; echo; return 0; fi
      if ((moved)); then info "$moved model(s) changed upstream; '$PROG models update MODEL' checks and downloads the new commit (running models keep theirs until restarted)"
      else info "every checked model is at its upstream commit"; fi ;;
    update)
      [[ -n $sel ]] || die "say which model: '$PROG models update MODEL'"
      choose "$sel" || die "$R_ERR"
      [[ $MODEL != *@* ]] || die "$SPEC is locked to a commit; change the menu entry (or pass the spec without @commit) to update it"
      FIT_FLAGS=()
      case $ENGINE in llama) read -ra FIT_FLAGS <<<"${CFG[LLAMA_FLAGS]} $EXTRA" ;; vllm) read -ra FIT_FLAGS <<<"${CFG[VLLM_FLAGS]} $EXTRA" ;; esac
      FIT_FLAGS+=("${pass[@]}")
      trust_gate "$ENGINE" "$MODEL" update "$(user_wants_rc && echo 1 || echo 0)"
      info "updated $SPEC to commit ${T_COMMIT:0:12}; a running copy keeps its commit until '$PROG $SPEC --restart'" ;;
  esac
}
doctor_trust() {  # findings about the check records
  local f out n=0 bad k a b
  dfind info security "SECURITY=$SEC_LEVEL${SEC_FLOOR:+ (floor $SEC_FLOOR from $sys_env_file)}"
  if [[ ${CFG[SANDBOX]} == off ]]; then dfind info sandbox "engines run without a sandbox (LLMSERVER_SANDBOX=off)"
  elif sandbox_works; then dfind ok sandbox "engines run in a bubblewrap sandbox (read-only system, empty home)"
  elif [[ ${CFG[SANDBOX]} == on ]]; then dfind problem sandbox "LLMSERVER_SANDBOX=on, but bubblewrap does not work here, so no engine can start"
  else dfind "$([[ $SEC_LEVEL == strict ]] && echo warn || echo info)" sandbox "no sandbox: $(have bwrap && echo 'bubblewrap is installed, but user namespaces are not allowed' || echo 'install bubblewrap (bwrap) to run engines with a read-only system and an empty home')"; fi
  helper_python >/dev/null || return 0
  while IFS= read -r f; do
    [[ -n $f ]] || continue
    trust_fields "$f"
    if [[ ${TF[status]} == revoked ]]; then dfind info security "${TF[spec]}: revoked"; continue; fi
    out=$(trust_enforce "${TF[engine]}" "$(trust_model_of)" "$f")
    if [[ $out != ok* ]]; then
      dfind warn security "${TF[spec]}: $(cut -f3 <<<"$out"); the next start checks and downloads it again"; continue
    fi
    n=$((n + 1))
    if ((opt_deep)); then
      out=$(TP_MANIFEST=$(trust_manifest "${TF[engine]}" "$(trust_model_of)") trustpy verify "$f" "$opt_fix")
      bad=0
      while IFS=$'\t' read -r k a b; do [[ $k == bad ]] && bad=$((bad + 1)); done <<<"$out"
      if ((bad)); then
        if ((opt_fix)); then dfind fixed security "${TF[spec]}: deleted $bad file(s) that differ from the check record; the next start downloads and checks them again"
        else dfind problem security "${TF[spec]}: $bad file(s) differ from the check record (hash); 'doctor --deep --fix' deletes them"; fi
      fi
    fi
  done < <(trust_latest)
  ((n)) && dfind ok security "$n checked model(s) have their files in place$( ((opt_deep)) && echo ', hashes compared' || true)"
  return 0
}

# ---- doctor ------------------------------------------------------------------
comp_reinstall() {  # component: drop the current build and install it again from the pins
  local d
  d=$(comp_current "$1") && rm -rf -- "$d"
  install_lock
  case $1 in helper) install_runtime ;; llama) install_llama ;; ollama) install_ollama ;; vllm) install_vllm ;; esac
}
doctor_components() {  # findings about LLMSERVER_HOME, the runtime and the managed engines
  local c f sha n first other
  if [[ -d $lhome ]]; then   # permissions: write access for others is removed in place; changed files are caught by checksum below
    other=$(find "$lhome" ! -type l ! -user "$(id -u)" -print -quit 2>/dev/null || true)
    [[ -z $other ]] || dfind problem home "$other (and maybe more in $lhome) is owned by $(stat -c %U -- "$other" 2>/dev/null || echo 'another user'), so llmserver cannot vouch for it; remove it, or run '$PROG uninstall' and install again"
    local loose=(find "$lhome" ! -type l -user "$(id -u)" -perm /022 ! \( -type f -name '*.lock' -empty \))   # uv makes its empty lock files 666
    n=$("${loose[@]}" 2>/dev/null | wc -l)
    if ((n)); then
      first=$("${loose[@]}" -print -quit 2>/dev/null || true)
      if ((opt_fix)) && chmod -R go-w -- "$lhome" 2>/dev/null; then
        dfind fixed home "removed write access for your group and other users from $n files and folders in $lhome (first: $first)"
        log_write info "doctor: chmod -R go-w $lhome ($n entries)"
      else dfind problem home "$n files and folders in $lhome are writable by your group or other users (first: $first, mode $(stat -c %a -- "$first" 2>/dev/null)), so engines will not start; 'doctor --fix' removes that write access"; fi
    fi
  fi
  if ! helper_python >/dev/null || ! helper_ok; then
    if ((opt_fix)); then
      if ( comp_reinstall helper ) >/dev/null; then dfind fixed runtime "installed llmserver's Python runtime"; else dfind problem runtime "could not install llmserver's Python runtime"; fi
    else dfind problem runtime "llmserver's Python runtime is missing or out of date, so models cannot be sized; '$PROG install runtime' or 'doctor --fix'"; fi
  else dfind ok runtime "uv $(pin uv), Python $(pin python_helper), helper packages as locked"; fi
  for c in llama ollama vllm; do
    engine_enabled "$c" || continue
    if [[ $(engine_source "$c") == system ]]; then
      case $c in llama) f=$LLAMA_BIN ;; vllm) f=$VLLM_BIN ;; ollama) f=$OLLAMA_BIN ;; esac
      if [[ -n $f ]]; then dfind info engines "$c: using your own copy $f (LLMSERVER_${c^^}_SOURCE=${CFG[${c^^}_SOURCE]})"
      else dfind warn engines "$c: LLMSERVER_${c^^}_SOURCE=system, but no $c program is on PATH"; fi
      continue
    fi
    if ! comp_meta "$c"; then dfind info engines "$c is enabled but not installed; '$PROG install $c'"; continue; fi
    f=${CM[DIR]}/${CM[MAIN]}; sha=$(sha256sum -- "$f" 2>/dev/null || true); sha=${sha%% *}
    if [[ $sha != "${CM[MAIN_SHA]}" ]]; then   # only a changed program is reinstalled; loose permissions are fixed above
      if ((opt_fix)); then
        if ( comp_reinstall "$c" ) >/dev/null; then dfind fixed engines "$c: reinstalled, because ${CM[MAIN]} had changed since it was installed"
        else dfind problem engines "$c: ${CM[MAIN]} changed since it was installed, and reinstalling failed"; fi
      else dfind problem engines "$c: ${CM[MAIN]} has changed since it was installed (checksum mismatch); 'doctor --fix' reinstalls it"; fi
      continue
    fi
    dfind ok engines "$c ${CM[VERSION]} (${CM[VARIANT]}), unchanged since it was installed"
    [[ ${CM[VERSION]} == "$(pin "$c")" ]] || dfind info engines "$c: this llmserver pins $(pin "$c"); '$PROG upgrade $c' installs it"
  done
}
# Checks that llmserver's own state matches reality and, with --fix, repairs it: stale or
# missing records, models an interrupted start stopped, duplicate ports, leftover temporary
# files, a held lock, missing tools, settings problems and servers llmserver did not start.
D_LEVEL=() D_CHECK=() D_MSG=()
dfind() { D_LEVEL+=("$1") D_CHECK+=("$2") D_MSG+=("$3"); }   # level (ok|info|warn|problem|fixed) check message
cmd_doctor() {
  local f d x pid spec port run owner p t known=" " problems=0 i
  have curl || dfind problem tools "curl is missing, so no model can be started"
  have flock || dfind warn tools "flock is missing: starts and stops are not serialised, so two at once can collide"
  have setsid || dfind warn tools "setsid is missing: a server's helper processes may outlive it when it is stopped"
  have ss || have lsof || dfind warn tools "neither ss nor lsof is installed, so the holder of a busy port cannot be named"
  doctor_components
  doctor_trust
  doctor_skills
  for x in "${ENV_WARNINGS[@]}"; do dfind warn settings "$x"; done
  container_probe
  [[ -n $CT_DESC ]] && dfind info container "$CT_DESC"

  running_scan
  for x in "${SCAN_REMOVED[@]}"; do dfind fixed records "removed the record of $x, which is no longer running"; done
  for x in "${SCAN_ADOPTED[@]}"; do dfind fixed records "adopted $x, which was running without a record"; done
  for f in "${R_FILES[@]}"; do
    load_rec "$f" || continue
    known+="${ST[PID]-} "
    if [[ ${ST[STATE]-} == starting ]] && ! pid_alive "${ST[OWNER]:-0}"; then
      if rec_healthy; then
        if ((opt_fix)); then
          state_lock; sed -i 's/^STATE=starting$/STATE=ready/' "$f"; state_unlock
          dfind fixed records "${ST[SPEC]} came up after the $PROG starting it was interrupted; recorded as ready"
        else dfind warn records "${ST[SPEC]} is answering but recorded as starting, because the $PROG starting it was interrupted"; fi
      elif ((opt_fix && $(date +%s) - ${ST[STARTED]:-0} > CFG[READY_TIMEOUT])); then
        stop_rec "$f" || true
        dfind fixed records "stopped ${ST[SPEC]}: it never became healthy and the $PROG starting it is gone"
      else
        dfind warn records "${ST[SPEC]} (port ${ST[PORT]}) is still loading and the $PROG starting it is gone; '$PROG logs ${ST[PORT]}' shows its progress"
      fi
    elif [[ ${ST[MANAGED]-1} == 1 ]] && ! port_in_use "${ST[PORT]}"; then
      dfind warn records "${ST[SPEC]} (pid ${ST[PID]}) is running but not listening on port ${ST[PORT]}; see '$PROG logs ${ST[PORT]}'"
    fi
  done
  dfind ok records "${#R_FILES[@]} model(s) running, every one tracked"

  find_interrupted
  for d in "${INTERRUPTED[@]}"; do
    load_rec "$d/rec" || { rm -rf -- "$d"; continue; }
    spec=${ST[SPEC]} run=""
    read -r _ _ _ run _ 2>/dev/null < "$d/owner" || true
    owner=""
    for f in "${R_FILES[@]}"; do load_rec "$f" && [[ -n $run && ${ST[RUN]-} == "$run" ]] && owner=${ST[SPEC]}; done
    if [[ -n $owner ]] || rec_find "$spec" >/dev/null; then
      # the interrupted start got as far as starting its model, which now uses the room, or the
      # model is running again anyway: nothing to restore
      local why="$spec is running again"; [[ -n $owner ]] && why="$spec was stopped to make room for $owner, which is running"
      if ((opt_fix)); then rm -rf -- "$d"; dfind fixed rollback "$why; removed its snapshot"
      else dfind info rollback "$why; its leftover snapshot can be removed ('--fix')"; fi
      continue
    fi
    if ((opt_fix)); then
      if restore_snapshot "$d"; then rm -rf -- "$d"; dfind fixed rollback "restarted $spec, which an interrupted start had stopped to make room"
      else dfind problem rollback "could not restart $spec, which an interrupted start had stopped; start it with '$PROG $spec'"; fi
    else
      dfind problem rollback "$spec was stopped by an interrupted start and never restarted; '$PROG doctor --fix' restarts it"
    fi
  done

  if [[ -r $ports_file ]]; then
    while IFS= read -r port; do
      [[ -n $port ]] || continue
      if ((opt_fix)); then
        state_lock
        awk -F'\t' -v p="$port" '$2 != p {print; next} {last = $0} END {if (last != "") print last}' "$ports_file" > "$ports_file.tmp.$$" && mv -f -- "$ports_file.tmp.$$" "$ports_file"
        state_unlock
        dfind fixed ports "port $port was remembered for several models; kept the most recent"
      else dfind warn ports "port $port is remembered for several models"; fi
    done < <(awk -F'\t' '{n[$2]++} END {for (p in n) if (n[p] > 1) print p}' "$ports_file")
  fi
  while IFS= read -r f; do
    [[ -n $f ]] || continue
    if ((opt_fix)); then rm -f -- "$f"; dfind fixed files "removed the leftover temporary file $f"
    else dfind info files "leftover temporary file $f ('--fix' removes it)"; fi
  done < <(find "$state_dir" "$run_dir" -maxdepth 1 -name '*.tmp.*' -mmin +1 2>/dev/null || true)
  if [[ -r $pins_file ]]; then
    while IFS= read -r x; do
      [[ -n $x && " ${specs[*]} " != *" $x "* ]] && ! rec_find "$x" >/dev/null && dfind info pins "$x is pinned but neither in the menu nor running"
    done < "$pins_file"
  fi
  if have flock && [[ -e $lock_file ]] && ! (flock -n 7) 7>>"$lock_file"; then dfind info lock "the start lock is held by $(lock_owner)"; fi

  if have pgrep; then   # inference servers this account runs that llmserver did not start
    while IFS= read -r pid; do
      [[ $pid =~ ^[0-9]+$ && $known != *" $pid "* ]] || continue
      p=$(proc_field "$pid" 2 2>/dev/null || true)
      [[ $known == *" $p "* ]] && continue                 # a worker of a tracked server
      proc_env "$pid" LLMSERVER_SERVED_SPEC >/dev/null && continue
      [[ $p == "$pid" || $(proc_field "$pid" 1 2>/dev/null) == 1 ]] || continue
      t=$(engine_of_pid "$pid" 2>/dev/null) || continue
      dfind info servers "pid $pid is a $t server llmserver did not start ($(cmd_of "$pid")); its memory counts as other programs"
    done < <(pgrep -u "$(id -u)" -f '(llama-server|llama serve|vllm serve|vllm\.entrypoints|ollama serve)' 2>/dev/null || true)
  fi

  for i in "${!D_LEVEL[@]}"; do [[ ${D_LEVEL[i]} == problem ]] && problems=$((problems + 1)); done
  if ((json)); then
    local items=()
    for i in "${!D_LEVEL[@]}"; do items+=("$(jo level "$(js "${D_LEVEL[i]}")" check "$(js "${D_CHECK[i]}")" message "$(js "${D_MSG[i]}")")"); done
    jo version "$(js "$VERSION")" ok "$(jb $((problems == 0)))" problems "$problems" fix "$(jb "$opt_fix")" findings "$(ja "${items[@]}")"; echo
  else
    for i in "${!D_LEVEL[@]}"; do printf '%-8s %-10s %s\n' "${D_LEVEL[i]}" "${D_CHECK[i]}" "${D_MSG[i]}"; done
    if ((problems)); then echo "$problems problem(s)$( ((opt_fix)) || echo "; '$PROG doctor --fix' repairs what it can")"; else echo "no problems found"; fi
  fi
  ((problems == 0))
}

# ---- capacity ----------------------------------------------------------------
cmd_capacity() {  # text, or JSON with --json
  local i f u e m mine other free k line w state need_mib port
  local -A ours=() mib_on=()
  local gpu_json=() run_json=() menu_json=() menu_text=() gp=() ev=() evj=()
  refresh_hw; running_scan; nv_usage
  for f in "${R_FILES[@]}"; do
    load_rec "$f" || continue
    u=$(rec_usage)
    for i in "${!G_VENDOR[@]}"; do
      k=$(usage_on "$u" "$i")
      if ((k > 0)); then
        ours[$i]+="${ST[SPEC]#*:} $(gb "$k"); "; mib_on[$i]=$(( ${mib_on[$i]:-0} + k ))
        ours[j$i]+="${ours[j$i]:+,}$(jo spec "$(js "${ST[SPEC]}")" mib "$(jn "$k")")"
      fi
    done
    run_json+=("$(json_rec)")
  done
  if ((!json)); then
    echo "${C_B}GPUs${C_0}"
    ((${#G_VENDOR[@]})) || echo "  none: models run on the CPU (RAM $(gb "$RAM_AVAIL") available of $(gb "$RAM_TOTAL"))"
  fi
  for i in "${!G_VENDOR[@]}"; do
    mine=${mib_on[$i]:-0}; other=$((G_USED[i] - mine)); ((other < 0)) && other=0
    free=$((G_TOTAL[i] - G_USED[i]))
    if ((json)); then gpu_json+=("$(json_gpu "$i" llmserver_mib "$(jn "$mine")" other_mib "$(jn "$other")" models "[${ours[j$i]-}]")"); continue; fi
    printf '  GPU %s  %-28s %9s total  %9s used  %9s free%s\n' "$i" "${G_NAME[i]:0:28}" "$(gb "${G_TOTAL[i]}")" "$(gb "${G_USED[i]}")" "$(gb "$free")" "$(gpu_allowed "$i" || echo "  (not used: $(gpu_why_not "$i"))")"
    [[ -n ${ours[$i]-} ]] && printf '         llmserver models: %s\n' "${ours[$i]%; }"
    ((other > 256)) && printf '         other programs: %s\n' "$(gb "$other")"
  done
  if ((!json)); then
    echo "  RAM    $(gb "$RAM_AVAIL") available of $(gb "$RAM_TOTAL")$( ((RAM_TOTAL < RAM_HOST)) && echo " (cgroup limit)" || true)"
    [[ -n $CT_DESC ]] && echo "  Limits $CT_DESC"
    echo
    echo "${C_B}Running${C_0} (${#R_FILES[@]}$( ((CFG[MAX_MODELS] > 0)) && echo " of at most ${CFG[MAX_MODELS]}" || true))"
    ((${#R_FILES[@]})) || echo "  nothing"
    for f in "${R_FILES[@]}"; do
      load_rec "$f" || continue
      u=$(rec_usage)
      printf '  %-44s port %-5s %9s on GPU %-5s idle %-6s%s\n' "${ST[SPEC]:0:44}" "${ST[PORT]}" "$(gb "$(usage_total "$u")")" "$(gpu_names "$u")" "$(dur "$(rec_idle)")" "$(is_pinned "${ST[SPEC]}" && echo '  pinned' || true)"
    done
  fi
  local -a need=() mods=() engs=()
  PACK_COUNT=0 PACK_ENTRIES=()
  ((${#specs[@]})) && mi_prefetch
  for i in "${!specs[@]}"; do
    e=${specs[i]%%:*} m=${specs[i]#*:} SPEC=${specs[i]}
    state="" need_mib="" port="" gp=() ev=() evj=() line=""
    if f=$(rec_find "$SPEC"); then load_rec "$f"; port=${ST[PORT]}; fi
    if ! engine_installed "$e"; then state=not_installed line="$e not installed"
    elif ! entry_prepare "$i"; then state=problem line="problem: $R_ERR"
    else
      model_info "$e" "$m" 1
      w=$(ctx_for "${CFG[CTX]}")
      fit_eval "$e" "$m" total "$w"                          # the whole machine
      need_mib=$F_NEED
      mods+=("$i") engs+=("$e") need+=("$([[ $e == vllm ]] && echo $((F_NEED * F_TP)) || echo "$F_NEED") $F_RATING")
      if [[ -n $port ]]; then state=running line="running on port $port"
      elif [[ $F_RATING == unknown ]]; then state=unknown line="size unknown (run '$PROG check $((i + 1))' when online)"
      elif ! ok_rating "$F_RATING"; then
        state=never
        line="$(gb "$F_NEED") needed: never fits in VRAM here$( [[ $F_RATING == offload || $F_RATING == cpu ]] && echo ", runs only partly on the CPU (slow)" || echo ", will not run")"
      else
        plan_start "$e" "$m" "$w"
        gp=("${PLACE_IDX[@]}")
        for f in "${P_EVICT[@]}"; do
          load_rec "$f" || continue
          ev+=("${ST[SPEC]#*:} (idle $(dur "$(rec_idle)"))")
          evj+=("$(jo spec "$(js "${ST[SPEC]}")" port "$(jn "${ST[PORT]}")" idle_s "$(jn "$(rec_idle)")")")
        done
        case $P_STATE in
          fits) state=fits_now line="$(gb "$F_NEED") needed: fits now on GPU $(IFS=,; echo "${gp[*]:--}")" ;;
          evict) state=fits_after_stopping line="$(gb "$F_NEED") needed: fits on GPU $(IFS=,; echo "${gp[*]:--}") after stopping ${ev[*]}" ;;
          offload) state=offload_only line="$(gb "$F_NEED") needed: pinned models leave too little room; would run partly on the CPU" ;;
          *) state=blocked line="$(gb "$F_NEED") needed: ${R_ERR:-cannot start now}" ;;
        esac
      fi
    fi
    menu_text+=("$(printf '%3d) %-44s %s' "$((i + 1))" "${SPEC:0:44}" "$line")")
    menu_json+=("$(jo entry "$((i + 1))" spec "$(js "$SPEC")" engine "$(js "$e")" state "$(js "$state")" need_mib "$(jn "$need_mib")" \
      port "$(jn "$port")" gpus "$(ja "${gp[@]}")" would_stop "$(ja "${evj[@]}")" detail "$(js "$line")")")
  done
  ((${#mods[@]})) && capacity_packing
  if ((json)); then
    jo version "$(js "$VERSION")" context "$(js "${CFG[CTX]}")" max_models "$(jn "${CFG[MAX_MODELS]}")" evict "$(js "${CFG[EVICT]}")" \
      gpus "$(ja "${gpu_json[@]}")" ram "$(jo total_mib "$(jn "$RAM_TOTAL")" available_mib "$(jn "$RAM_AVAIL")" host_total_mib "$(jn "$RAM_HOST")")" \
      limits "$(json_limits)" running "$(ja "${run_json[@]}")" menu "$(ja "${menu_json[@]}")" \
      at_once "$(jo count "$(jn "$PACK_COUNT")" entries "$(ja "${PACK_ENTRIES[@]}")")"; echo
    return 0
  fi
  ((${#specs[@]})) || { echo; echo "The menu is empty; '$PROG check MODEL' judges any model."; return 0; }
  echo
  echo "${C_B}Menu${C_0} (context: ${CFG[CTX]})"
  printf '%s\n' "${menu_text[@]}"
  echo
  local list; list=$(IFS=,; echo "${PACK_ENTRIES[*]:-none}"); list=${list//,/, }
  echo "At once: up to $PACK_COUNT of the menu models fit on this machine together (entries $list, smallest first)."
  echo "When a model does not fit, '$PROG MODEL' lists what would have to stop (LLMSERVER_EVICT=${CFG[EVICT]}); 'pin' protects a model."
}
PACK_COUNT=0 PACK_ENTRIES=()
capacity_packing() {  # how many menu models fit on this machine at once (largest set, smallest first)
  local i j g best bestfree left take names=() count=0 rest=0
  declare -A bin=()
  detect_hw
  for g in "${!G_VENDOR[@]}"; do if gpu_allowed "$g"; then bin[$g]=$((G_TOTAL[g] * 90 / 100 - CFG[VRAM_RESERVE_MB])); fi; done
  PACK_COUNT=0 PACK_ENTRIES=()
  ((${#bin[@]})) || return 0
  local order mib rating
  order=$(for i in "${!mods[@]}"; do
    read -r mib rating <<<"${need[i]}"
    if ok_rating "$rating"; then printf '%s %s\n' "$mib" "$i"; fi
  done | sort -n | cut -d' ' -f2 || true)
  for i in $order; do
    read -r left rating <<<"${need[i]}"
    gpu_view "${engs[i]}"
    best="" bestfree=0
    for g in "${V_IDX[@]}"; do   # one GPU, the snuggest
      [[ -v bin[$g] ]] || continue
      if ((bin[$g] >= left)) && { [[ -z $best ]] || ((bin[$g] < bestfree)); }; then best=$g bestfree=${bin[$g]}; fi
    done
    if [[ -n $best ]]; then bin[$best]=$((bin[$best] - left))
    else                          # several GPUs together
      rest=0; for g in "${V_IDX[@]}"; do if [[ -v bin[$g] ]]; then rest=$((rest + bin[$g])); fi; done
      ((rest >= left)) || continue
      for g in $(for h in "${V_IDX[@]}"; do if [[ -v bin[$h] ]]; then printf '%s %s\n' "${bin[$h]}" "$h"; fi; done | sort -rn | cut -d' ' -f2 || true); do
        ((left > 0)) || break
        take=$((bin[$g] < left ? bin[$g] : left)); bin[$g]=$((bin[$g] - take)); left=$((left - take))
      done
    fi
    count=$((count + 1)); names+=("$((mods[i] + 1))")
  done
  PACK_COUNT=$count PACK_ENTRIES=("${names[@]}")
}

# ---- starting ----------------------------------------------------------------
S_ARGV=() S_ENV=() S_PID="" S_LOG="" USER_FLAGS=() AUTO_FLAGS=() ENG_UNSET=()
# ---- sandbox ----------------------------------------------------------------------------
# With bubblewrap (bwrap), each engine sees the system read-only, a private /tmp, and an empty
# home: only llmserver's home (read-only), the model cache (read-only; the Ollama store
# read-write) and a private cache folder for the engine (compile caches) are visible. SSH keys,
# cloud credentials, tokens and other files in the home cannot be read by a model's code, and
# nothing outside those folders can be written. GPUs stay reachable through /dev, and the network
# stays shared, because the server must listen on its port.
SANDBOX_ARGV=() SANDBOX_NOTE="" SANDBOX_KIND="" SANDBOX_WORKS=""
sandbox_works() {  # is bubblewrap usable here (installed, and user namespaces allowed)?
  if [[ -z $SANDBOX_WORKS ]]; then
    if have bwrap && bwrap --ro-bind / / --dev /dev --proc /proc --tmpfs "$HOME" -- /bin/true >/dev/null 2>&1; then SANDBOX_WORKS=1; else SANDBOX_WORKS=0; fi
  fi
  ((SANDBOX_WORKS))
}
sandbox_plan() {  # engine -> SANDBOX_ARGV (empty when not sandboxed), SANDBOX_NOTE, SANDBOX_KIND
  local e=$1 cache d bin root store
  SANDBOX_ARGV=() SANDBOX_NOTE="" SANDBOX_KIND=""
  ((ATTACHED)) && return 0
  [[ ${CFG[SANDBOX]} == off ]] && { SANDBOX_NOTE="sandbox: off (LLMSERVER_SANDBOX=off)"; return 0; }
  if ! sandbox_works; then
    if [[ ${CFG[SANDBOX]} == on ]]; then
      die "LLMSERVER_SANDBOX=on, but bubblewrap does not work here ($(have bwrap && echo 'user namespaces are not allowed' || echo 'bwrap is not installed')); nothing was stopped"
    fi
    SANDBOX_NOTE="sandbox: not available ($(have bwrap && echo 'user namespaces are not allowed' || echo 'install bubblewrap to get it')); the engine runs with your full user rights"
    [[ $SEC_LEVEL == strict ]] && warn "$SANDBOX_NOTE"
    return 0
  fi
  cache=$state_dir/sandbox/$e
  (umask 077; mkdir -p "$cache")
  SANDBOX_ARGV=(bwrap --unshare-ipc --unshare-uts --unshare-cgroup-try
    --ro-bind / / --dev-bind /dev /dev --proc /proc --tmpfs /tmp --tmpfs /var/tmp
    --tmpfs "$HOME" --tmpfs "$lhome" --bind "$cache" "$HOME/.cache"
    --ro-bind-try "$lhome/engines" "$lhome/engines" --ro-bind-try "$lhome/python" "$lhome/python")   # the software only: never the settings, key, logs or records
  [[ -d $hub ]] && SANDBOX_ARGV+=(--ro-bind "$hub" "$hub")
  for d in "${MODEL-}" "${D_PATH-}"; do   # GGUF files on this computer: their folder, read-only
    [[ $d == /* && $d != "$hub"/* ]] && SANDBOX_ARGV+=(--ro-bind "${d%/*}" "${d%/*}")
  done
  case $e in
    llama) bin=$LLAMA_BIN ;; vllm) bin=$VLLM_BIN ;; ollama) bin=$OLLAMA_BIN ;;
  esac
  if [[ $(engine_source "$e") == system && -n $bin ]]; then   # your own engine: its folder (a venv: the whole venv)
    for d in "$bin" "$(readlink -f -- "$bin")"; do   # where it is called from, and where a link points
      root=$(dirname -- "$(dirname -- "$d")")
      [[ $HOME/ == "$root"/* || $root == / ]] && root=$(dirname -- "$d")   # never re-expose the home
      SANDBOX_ARGV+=(--ro-bind "$root" "$root")
    done
  fi
  if [[ $e == ollama ]]; then
    store=$(ollama_manifest x:y); store=${store%%/manifests/*}
    mkdir -p "$store"; SANDBOX_ARGV+=(--bind "$store" "$store")
    S_ENV+=("OLLAMA_MODELS=$store")
  fi
  S_ENV+=("HF_HUB_CACHE=$hub" "XDG_CACHE_HOME=$HOME/.cache" "TRITON_CACHE_DIR=$HOME/.cache/triton" "CUDA_CACHE_PATH=$HOME/.cache/nv")
  ENG_UNSET+=(HF_TOKEN HUGGING_FACE_HUB_TOKEN)   # engines serve offline and need no Hugging Face token
  for d in $(setting LLMSERVER_SANDBOX_RW ""); do   # extra writable folders the administrator chose
    if [[ $d == /* && -d $d ]]; then SANDBOX_ARGV+=(--bind "$d" "$d"); else warn "LLMSERVER_SANDBOX_RW: '$d' is not an existing absolute folder; ignored"; fi
  done
  SANDBOX_ARGV+=(--)
  SANDBOX_KIND=bwrap
  SANDBOX_NOTE="sandbox: bubblewrap (read-only system, empty home, no llmserver settings or key, model files read-only)"
}
model_role() {  # -> rerank or embedding when the engine flags make this model a reranker or an embedding server (not for chat)
  local t
  for t in "${USER_FLAGS[@]}"; do case $t in --rerank|--reranking) echo rerank; return 0 ;; esac; done
  for t in "${USER_FLAGS[@]}"; do case $t in --embedding|--embeddings|--task=embed|--task=embedding|--runner=pooling) echo embedding; return 0 ;; esac; done
  return 0
}
build_command() {  # ENGINE MODEL HOST PORT CTX EXTRA pass[] and the checked record (T_*) -> S_ARGV S_ENV USER_FLAGS
  local t extra_arr=() cfg_arr=()
  read -ra extra_arr <<<"$EXTRA"
  S_ARGV=() S_ENV=() USER_FLAGS=()
  case $ENGINE in
    llama)
      read -ra cfg_arr <<<"${CFG[LLAMA_FLAGS]}"
      USER_FLAGS=("${cfg_arr[@]}" "${extra_arr[@]}" "${pass[@]}")
      # the checked files, by path: llama.cpp never downloads anything itself
      for t in "${USER_FLAGS[@]}"; do
        case ${t%%=*} in
          -hf|--hf-repo|-hfr|-hff|--hf-file|-hfd|-hfrd|--hf-repo-draft|-hffd|--hf-file-draft|-hfv|--hf-repo-v|-hffv|--hf-file-v|-mu|--model-url|-dr|--docker-repo)
            trust_exit 3 "the llama.cpp flag $t would download a model that llmserver did not check; give the model as the llmserver MODEL (or --draft) instead" ;;
        esac
      done
      if [[ -n $T_MAIN ]]; then S_ARGV=("${LLAMA_SERVE[@]}" -m "${T_SNAP:+$T_SNAP/}$T_MAIN")
      else S_ARGV=("${LLAMA_SERVE[@]}" -m "<checked ${MODEL%%@*} GGUF>"); fi   # only in --dry-run, before the download
      if [[ -n $T_MMPROJ ]] && ! has_flag --mmproj -mm --no-mmproj; then S_ARGV+=(--mmproj "${T_SNAP:+$T_SNAP/}$T_MMPROJ"); fi
      S_ARGV+=(--alias "$(model_id llama "$MODEL")")
      S_ARGV+=(--host "$HOST" --port "$PORT")
      [[ $CTX != auto ]] && S_ARGV+=(-c "$CTX")
      S_ARGV+=("${AUTO_FLAGS[@]}" "${USER_FLAGS[@]}") ;;
    vllm)
      read -ra cfg_arr <<<"${CFG[VLLM_FLAGS]}"
      USER_FLAGS=("${cfg_arr[@]}" "${extra_arr[@]}" "${pass[@]}")
      S_ARGV=("$VLLM_BIN" serve "${MODEL%%@*}" --host "$HOST" --port "$PORT" --served-model-name "$MODEL")
      # the checked commit, served offline: vLLM cannot fetch files or code that were not checked
      if [[ -n $T_COMMIT ]]; then S_ARGV+=(--revision "$T_COMMIT")
      elif [[ $MODEL == *@* ]]; then S_ARGV+=(--revision "${MODEL#*@}"); fi
      [[ $T_WFORMAT == safetensors ]] && ! has_flag --load-format && S_ARGV+=(--load-format safetensors)
      [[ $T_RCOK == 1 ]] && ! user_wants_rc && S_ARGV+=(--trust-remote-code)
      [[ $CTX != auto ]] && S_ARGV+=(--max-model-len "$CTX")
      S_ARGV+=("${AUTO_FLAGS[@]}" "${USER_FLAGS[@]}")
      S_ENV+=(HF_HUB_OFFLINE=1) ;;
    ollama)
      for t in "${extra_arr[@]}" "${pass[@]}"; do
        [[ $t =~ ^[A-Za-z_][A-Za-z0-9_]*= ]] || die "'ollama serve' takes no flags; '$t' must be a KEY=VALUE setting such as OLLAMA_NUM_PARALLEL=2"
        S_ENV+=("$t")
      done
      S_ARGV=("$OLLAMA_BIN" serve)
      S_ENV=("OLLAMA_HOST=$(hostport "$HOST" "$PORT")" "OLLAMA_KEEP_ALIVE=${CFG[OLLAMA_KEEP_ALIVE]}" OLLAMA_MAX_LOADED_MODELS=1 "${S_ENV[@]}")
      [[ $CTX != auto ]] && S_ENV=("OLLAMA_CONTEXT_LENGTH=$CTX" "${S_ENV[@]}") ;;
  esac
  # a clean environment for the engine: no Python settings of the user's own, no usage reports
  ENG_UNSET=(PYTHONPATH PYTHONHOME PYTHONSTARTUP PYTHONUSERBASE VIRTUAL_ENV CONDA_PREFIX)
  [[ $ENGINE == vllm ]] && S_ENV=(PYTHONNOUSERSITE=1 VLLM_NO_USAGE_STATS=1 DO_NOT_TRACK=1 HF_HUB_DISABLE_TELEMETRY=1 "${S_ENV[@]}")
  for t in "${USER_FLAGS[@]}"; do
    case $t in
      --host|--host=*|--port|--port=*) die "set the address with $PROG --host/--port (or LLMSERVER_HOST/LLMSERVER_PORT), not as an engine flag, so that $PROG knows where the server is" ;;
    esac
  done
  return 0
}
SECRET_ENV=()
apply_auth() {  # bind/auth policy; the key travels in the environment, never in argv
  SECRET_ENV=()
  ((ATTACHED)) && return 0
  local need_key=0
  if [[ $ENGINE != ollama ]] && ! user_sets_key; then
    if [[ ${CFG[AUTH]} == key ]] || { [[ ${CFG[AUTH]} == auto ]] && ! is_loopback "$HOST"; }; then need_key=1; fi
  fi
  if ! is_loopback "$HOST"; then
    if [[ $ENGINE == ollama ]]; then
      ((insecure || CFG[ALLOW_INSECURE] == 1)) || die "Ollama has no API-key support, so binding it to $HOST would leave it open to that network. Bind to 127.0.0.1, put an authenticating proxy in front, or accept the risk with --insecure (ALLOW_INSECURE=1)"
      warn "Ollama is listening on $HOST without authentication"
    elif ((!need_key)) && ! user_sets_key; then
      ((insecure || CFG[ALLOW_INSECURE] == 1)) || die "refusing to serve on $HOST without authentication. Set AUTH=auto or AUTH=key (recommended), bind to 127.0.0.1, or accept the risk with --insecure (ALLOW_INSECURE=1)"
      warn "serving on $HOST without authentication"
    fi
  fi
  if ((need_key)); then
    if ((dry)) && [[ ! -s $key_file ]]; then SECRET_ENV=("API_KEY=<generated on first real run>"); return 0; fi
    ensure_key
    case $ENGINE in
      llama) SECRET_ENV=("LLAMA_API_KEY=$(<"$key_file")") ;;
      vllm) SECRET_ENV=("VLLM_API_KEY=$(<"$key_file")") ;;
    esac
  fi
  return 0
}
preflight_flags() {  # catch a mistyped llama.cpp flag before anything is stopped
  local help tok bad=()
  ((preflight)) && [[ $ENGINE == llama ]] || return 0
  [[ -n $LLAMA_HELP ]] || LLAMA_HELP=$("${LLAMA_SERVE[@]}" --help 2>&1 || true)
  help=$LLAMA_HELP
  [[ $help == *--ctx-size* ]] || return 0  # not a help text we understand; the rollback still protects
  for tok in "${USER_FLAGS[@]}"; do
    [[ $tok == -* && ! $tok =~ ^-[0-9.]+$ ]] || continue
    tok=${tok%%=*}
    grep -qE -- "(^|[[:space:],])${tok//./\\.}([[:space:],=]|\$)" <<<"$help" || bad+=("$tok")
  done
  ((${#bad[@]} == 0)) || die "llama.cpp does not list these flags in its --help: ${bad[*]}. Nothing was stopped. Fix the flag, or pass --no-preflight if this build really accepts it"
}
start_server() {  # launch S_ARGV in the background, in its own session, so the whole process
  # group can be stopped later; it keeps running after llmserver exits
  local kv launcher=()
  have setsid && launcher=(setsid)
  (
    for kv in "${VIS_UNSET[@]}" "${ENG_UNSET[@]}"; do unset "$kv"; done
    # shellcheck disable=SC2163  # kv holds NAME=value
    for kv in "${S_ENV[@]}" "${SECRET_ENV[@]}"; do export "$kv"; done
    # markers: if llmserver dies before recording this server, the next run finds and adopts it
    export LLMSERVER_SERVED_SPEC="$SPEC" LLMSERVER_SERVED_PORT="$PORT" LLMSERVER_SERVED_HOST="$HOST" LLMSERVER_SERVED_CTX="$CTX"
    exec 8>&- 9>&-
    trap - EXIT
    exec "${launcher[@]}" "${S_PREFIX[@]}" "${SANDBOX_ARGV[@]}" "${S_ARGV[@]}" >> "$S_LOG" 2>&1 < /dev/null
  ) &
  S_PID=$!
}
wait_ready() {  # 0 healthy, 1 the process died, 2 timed out, 3 someone else answers, 4 key not enforced
  local base path=/health deadline=$((SECONDS + CFG[READY_TIMEOUT])) owner next=$((SECONDS + 15)) code
  base="http://$(hostport "$(connect_host "$HOST")" "$PORT")"
  [[ $ENGINE == ollama ]] && path=/api/version
  until lcurl -o /dev/null --max-time 3 "$base$path" 2>/dev/null; do
    pid_alive "$S_PID" || return 1
    ((SECONDS < deadline)) || return 2
    if ((SECONDS >= next)); then info "still loading $MODEL (${SECONDS}s; log $S_LOG)"; next=$((SECONDS + 15)); fi
    sleep 1
  done
  pid_alive "$S_PID" || return 1
  if owner=$(port_owner "$PORT") && [[ $owner != "$S_PID" && $(proc_field "$owner" 3) != "$S_PID" ]]; then return 3; fi
  if [[ $ENGINE == ollama ]]; then
    info "loading $MODEL into Ollama"
    ollama_preload "$(hostport "$(connect_host "$HOST")" "$PORT")" "$MODEL" || return 1
  fi
  if ((${#SECRET_ENV[@]})); then
    # do not assume the engine honoured the key: an empty request without it must be refused
    code=$(curl -s -o /dev/null -w '%{http_code}' --noproxy '*' --max-time 10 -X POST \
      -H 'Content-Type: application/json' -d '{}' "$base/v1/chat/completions" 2>/dev/null || true)
    [[ $code == 401 || $code == 403 ]] || return 4
  fi
  return 0
}
client_host() {
  case $1 in
    0.0.0.0|::) hostname 2>/dev/null || echo "${HOSTNAME:-localhost}" ;;
    *) connect_host "$1" ;;
  esac
}

# ---- setup wizard ------------------------------------------------------------
ask() {  # prompt default -> REPLY (EOF or --yes takes the default)
  if ((yes)); then REPLY=${2-}; return 0; fi
  printf '%s%s: ' "$1" "${2:+ [$2]}" >&2
  IFS= read -r REPLY || { REPLY=""; echo >&2; }
  REPLY=${REPLY#"${REPLY%%[![:space:]]*}"}; REPLY=${REPLY%"${REPLY##*[![:space:]]}"}
  [[ -n $REPLY ]] || REPLY=${2-}
}
run_setup() {
  local e n i names=(llama vllm ollama) engines=() defnums="" def host port auth=auto allow=0 ctx attach="" maxm evict
  local -A label=(
    [llama]="llama.cpp   GGUF models; NVIDIA, AMD or CPU; can split a model between GPU and CPU"
    [vllm]="vLLM        Hugging Face models; NVIDIA (CUDA) or AMD (ROCm); everything on the GPU"
    [ollama]="Ollama      Ollama library or GGUF models; NVIDIA, AMD or CPU; manages offload itself"
  )
  echo "${C_B}$PROG setup${C_0} — pick what you want; rerun this any time, or change one setting with '$PROG config set'" >&2
  print_hw hw-only >&2
  echo >&2; echo "Engines:" >&2
  echo "Engines are installed into $lhome by $PROG itself (pinned and checksum-verified); nothing else on the system changes." >&2
  for i in 0 1 2; do
    e=${names[i]}
    if engine_installed "$e"; then
      gpu_view "$e"
      if [[ -n $C_FATAL ]]; then n="installed, but cannot run here"
      elif [[ $V_KIND == cpu ]]; then n="installed, CPU only here"
      else n="installed, uses ${#V_T[@]} GPU(s)"; defnums+="${defnums:+,}$((i + 1))"; fi
      [[ $V_KIND == cpu && -z $C_FATAL && $e != vllm ]] && ((${#G_VENDOR[@]} == 0)) && defnums+="${defnums:+,}$((i + 1))"
    elif [[ $(engine_source "$e") == managed ]]; then
      n="will install: $(plan_line "$e")"
      if [[ $e == vllm ]]; then [[ $(vllm_variant) != none ]] && defnums+="${defnums:+,}$((i + 1))"
      else defnums+="${defnums:+,}$((i + 1))"; fi
      [[ $e == vllm && $(vllm_variant) == none ]] && n="not available here: needs an NVIDIA GPU, or an AMD GPU on x86-64"
    else n="not found on PATH"; fi
    printf '  %d) %s\n       [%s]\n' "$((i + 1))" "${label[$e]}" "$n" >&2
    if engine_installed "$e"; then
      [[ -n $C_FATAL ]] && printf '       problem: %s\n' "$C_FATAL" >&2
      for n in "${C_WARN[@]}"; do printf '       note: %s\n' "$n" >&2; done
    fi
  done
  while :; do
    ask "Engines to enable (numbers such as 1,3 or 'all')" "${defnums:-1}"
    [[ $REPLY == all ]] && REPLY=1,2,3
    engines=()
    for n in ${REPLY//,/ }; do
      if [[ $n =~ ^[1-3]$ ]]; then engines+=("${names[n - 1]}"); else engines=(); break; fi
    done
    ((${#engines[@]})) && break
    echo "$PROG: enter numbers from 1 to 3 separated by commas" >&2
  done
  def=${engines[0]}
  if ((${#engines[@]} > 1)); then
    while :; do
      ask "Default engine for Hugging Face repos that could run on either (${engines[*]})" "$def"
      [[ " ${engines[*]} " == *" $REPLY "* ]] && { def=$REPLY; break; }
    done
  fi
  if [[ " ${engines[*]} " == *" ollama "* ]] && lcurl -o /dev/null --max-time 2 http://127.0.0.1:11434/api/version 2>/dev/null; then
    echo >&2; echo "An Ollama daemon is already running on 127.0.0.1:11434." >&2
    echo "  1) use it: $PROG loads and unloads models on it and never stops it" >&2
    echo "  2) run a separate 'ollama serve' for each model, managed by $PROG, each on its own port" >&2
    ask "Ollama mode" 1
    [[ $REPLY == 2 ]] || attach=127.0.0.1:11434
  fi
  echo >&2; echo "Who should reach the server?" >&2
  echo "  1) this machine only (127.0.0.1)" >&2
  echo "  2) other machines, containers and sandboxes too (0.0.0.0)" >&2
  echo "  3) one specific address of this machine" >&2
  ask "Network" 1
  case $REPLY in
    2) host=0.0.0.0 ;;
    3) ask "Address to bind" 127.0.0.1; host=$REPLY ;;
    *) host=127.0.0.1 ;;
  esac
  while :; do
    ask "First port (each model gets its own, counting up from here)" "${CFG[PORT]}"
    [[ $REPLY =~ ^[0-9]+$ ]] && ((REPLY >= 1 && REPLY <= 65535)) && { port=$REPLY; break; }
  done
  if ! is_loopback "$host"; then
    echo >&2; echo "The server will be reachable from the network on $host." >&2
    echo "  1) require an API key (generated now, stored in $key_file)" >&2
    echo "  2) no authentication" >&2
    ask "Authentication" 1
    if [[ $REPLY == 2 ]]; then
      ask "Anyone who can reach $host:$port could then use the GPU. Type 'insecure' to confirm" ""
      if [[ $REPLY == insecure ]]; then auth=none allow=1; else echo "$PROG: keeping the API key" >&2; fi
    fi
    if [[ $allow == 0 && -z $attach && " ${engines[*]} " == *" ollama "* ]]; then
      ask "Ollama cannot check an API key. Let it listen on $host without one? (y/N)" n
      [[ ${REPLY,,} == y* ]] && allow=1
    fi
  fi
  echo >&2
  echo "Context per model in tokens (capped at what each model supports). A fixed size keeps the" >&2
  echo "memory of each model predictable, so several fit side by side; 'fit' gives a model all the" >&2
  echo "free VRAM when it starts; 'auto' leaves it to the engine." >&2
  while :; do
    ask "Context (a number of tokens, fit or auto)" "${CFG[CTX]}"
    [[ $REPLY =~ ^(auto|fit|[1-9][0-9]*)$ ]] && { ctx=$REPLY; break; }
  done
  echo >&2
  echo "Several models can run at once, each on its own port, as many as the GPUs hold." >&2
  while :; do
    ask "Most models at once (0 = as many as fit, 1 = one at a time)" "${CFG[MAX_MODELS]}"
    [[ $REPLY =~ ^[0-9]+$ ]] && { maxm=$REPLY; break; }
  done
  echo "When a new model does not fit next to the running ones:" >&2
  echo "  1) ask before stopping the least recently used ones (refuse when there is no terminal)" >&2
  echo "  2) stop the least recently used ones automatically" >&2
  echo "  3) refuse; stop models yourself" >&2
  local evdef=1; case ${CFG[EVICT]} in lru) evdef=2 ;; never) evdef=3 ;; esac
  ((maxm == 1)) && evdef=2
  ask "Eviction" "$evdef"
  case $REPLY in 2) evict=lru ;; 3) evict=never ;; *) evict=ask ;; esac

  mkdir -p "$config_dir" "$state_dir"
  chmod 700 "$config_dir" 2>/dev/null || true
  CFG[ENGINES]="${engines[*]}" CFG[DEFAULT_ENGINE]=$def CFG[HOST]=$host CFG[PORT]=$port CFG[AUTH]=$auth
  CFG[ALLOW_INSECURE]=$allow CFG[CTX]=$ctx CFG[OLLAMA_ATTACH]=$attach CFG[MAX_MODELS]=$maxm CFG[EVICT]=$evict
  write_env_file
  log_write info "setup: engines=${engines[*]} host=$host port=$port auth=$auth ctx=$ctx max_models=$maxm evict=$evict"
  if [[ ! -e $models_file ]]; then
    {
      echo "# llmserver menu: one '[engine:]model [extra engine flags]' per line; # starts a comment."
      echo "# Extra flags split on whitespace (no quoting). For Ollama they are KEY=VALUE settings."
      echo "# Formats:"
      echo "#   llama:ORG/REPO-GGUF:QUANT          a GGUF repo on Hugging Face, run by llama.cpp"
      echo "#   vllm:ORG/REPO[@REVISION]           a Hugging Face repo, run by vLLM"
      echo "#   ollama:NAME[:TAG]                  an Ollama library model"
      echo "#   ollama:hf.co/ORG/REPO-GGUF:QUANT   a GGUF repo on Hugging Face, run by Ollama"
      echo "# Models you serve by name are added here automatically."
    } > "$models_file"
    info "wrote an empty menu to $models_file"
  fi
  if ((!yes)) && [[ -t 0 ]]; then
    runtime_ready || true
    echo >&2
    echo "Add models to the menu now? Enter one [engine:]model per line, or just Enter to skip." >&2
    echo "Each is checked against this machine's hardware." >&2
    while :; do
      printf 'Model: ' >&2
      IFS= read -r REPLY || break
      REPLY=${REPLY//[[:space:]]/}
      [[ -n $REPLY ]] || break
      if ! parse_spec "$REPLY"; then echo "$PROG: $R_ERR" >&2; continue; fi
      local rc=0 sp=$R_SPEC se=$R_ENGINE sm=$R_MODEL
      model_exists "$se" "$sm" || rc=$?
      if ((rc == 1)); then
        echo "  $ME_MSG" | fold -s -w 100 >&2
        echo "  not added; type the name again" >&2; continue
      fi
      parse_spec "$sp"
      FIT_FLAGS=()
      model_info "$R_ENGINE" "$R_MODEL"
      advise "$R_ENGINE" "$R_MODEL" total "$(ctx_for "$ctx")" 2 || true
      echo "  ${F_RATING^^}: $F_MSG" | fold -s -w 100 >&2
      if [[ $F_RATING == no ]]; then
        printf '  Add it anyway? [y/N]: ' >&2
        IFS= read -r REPLY || REPLY=""
        [[ ${REPLY,,} == y* ]] || { echo "  skipped" >&2; continue; }
      fi
      grep -qxF "$R_SPEC" "$models_file" 2>/dev/null || printf '%s\n' "$R_SPEC" >> "$models_file"
      echo "  added $R_SPEC" >&2
    done
  fi
  write_tuning_template
  [[ $auth != none ]] && ! is_loopback "$host" && ensure_key
  info "wrote $env_file ('$PROG config' shows and changes the settings)"
  local todo=()
  for e in "${engines[@]}"; do
    [[ $e == ollama && -n $attach ]] && continue
    engine_installed "$e" && continue
    if [[ $(engine_source "$e") == managed ]]; then todo+=("$e"); else warn "$e is enabled but not on PATH. To $(install_hint "$e")"; fi
  done
  if ((${#todo[@]})) || ! helper_python >/dev/null; then
    echo >&2
    cmd_install "${todo[@]}" || warn "the install did not finish; run '$PROG install ${todo[*]}' later"
    detect_tools
  fi
  setup_skills
  setup_webui
  echo "Gated Hugging Face models need a token: run '$PROG hf auth login', or '$PROG config set HF_TOKEN hf_...'." >&2
  echo "Next: '$PROG list' to see the menu, '$PROG' to start a model, '$PROG capacity' to see what fits." >&2
}

# ---- download records and uninstall ------------------------------------------
# Every file a download adds to the Hugging Face cache, and every Ollama model it pulls
# that was not there before, is recorded in $downloads_file. `uninstall --purge-models`
# deletes exactly those, so models fetched by other tools are left alone.
hub_files() {  # engine model -> every file and link in that repo's cache dir, sorted
  local repo dir
  case $1 in
    llama) repo=${2%%:*} ;;
    vllm) repo=${2%%@*} ;;
    *) return 0 ;;
  esac
  dir=$(hf_repo_dir "$repo") || return 0
  find "$dir" \( -type f -o -type l \) 2>/dev/null | LC_ALL=C sort
}
record_download() {  # engine model ok(1|0) was-cached(1|0) files-before
  local p
  ((dry)) && return 0
  [[ $2 == /* ]] && return 0   # the user's own file: never llmserver's to delete
  mkdir -p "$state_dir"
  if [[ $1 == ollama ]]; then
    if (($3 && !$4)); then printf '%s\t%s\t-\n' "$1" "$2" >> "$downloads_file"; fi
    return 0
  fi
  # recorded even when the download failed: a partial download is llmserver's litter too
  while IFS= read -r p; do
    [[ -n $p ]] && printf '%s\t%s\t%s\n' "$1" "$2" "$p" >> "$downloads_file"
  done < <(LC_ALL=C comm -13 <(printf '%s\n' "$5") <(hub_files "$1" "$2"))
  return 0
}

U_NOTES=() U_FAILS=0
u_fail() { warn "$*"; U_FAILS=$((U_FAILS + 1)); }
u_rm() {  # remove files; count failures
  local f
  for f in "$@"; do
    if [[ -e $f || -L $f ]]; then rm -f -- "$f" || u_fail "could not delete $f"; fi
  done
}
u_rmdir() {  # remove a directory only if nothing unexpected is left in it
  local d=$1 left
  [[ -d $d ]] || return 0
  rmdir -- "$d" 2>/dev/null && return 0
  left=$(find "$d" -mindepth 1 -maxdepth 1 -printf '%f ' 2>/dev/null | cut -c1-120)
  U_NOTES+=("kept $d because it holds files llmserver did not create: $left")
}
u_unit_file() {  # the systemd user units from the documentation, if they exist (one per line)
  local f d=${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user
  for f in "$d/llmserver.service" "$d/llmserver@.service" "$d/llmserver-webui.service"; do
    if [[ -f $f ]] && grep -q llmserver "$f"; then printf '%s\n' "$f"; fi
  done
}
u_unit_instances() {  # enabled or running instances of the llmserver@.service template
  local d=${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user f
  {
    for f in "$d"/*.wants/llmserver@?*.service; do if [[ -e $f || -L $f ]]; then printf '%s\n' "${f##*/}"; fi; done
    if have systemctl; then systemctl --user list-units --all --plain --no-legend 'llmserver@*' 2>/dev/null | awk '{print $1}' || true; fi
  } | grep -E '^llmserver@.+\.service$' | sort -u || true
}
u_script_paths() {  # this script, plus symlinks to it named llmserver on PATH
  local self d l
  self=$(readlink -f -- "$0" 2>/dev/null) || return 0
  [[ -f $self ]] && grep -q "^# $PROG — serve local LLMs" "$self" 2>/dev/null || return 0
  printf '%s\n' "$self"
  [[ -L $0 ]] && printf '%s\n' "$0"
  local IFS=:
  for d in $PATH; do
    l=$d/$PROG
    if [[ -L $l && $l != "$0" && $(readlink -f -- "$l") == "$self" ]]; then printf '%s\n' "$l"; fi
  done
}
u_size() {  # bytes of the regular files among the arguments
  local f n=0
  for f in "$@"; do if [[ -f $f && ! -L $f ]]; then n=$((n + $(stat -c %s -- "$f"))); fi; done
  printf '%s\n' "$n"
}
u_purge_hub() {  # delete recorded cache files, keeping blobs another snapshot still links to
  local p d name l keep top repo
  local -A ours=() repos=()
  for p in "$@"; do ours[$p]=1; done
  for p in "$@"; do
    [[ -e $p || -L $p ]] || continue
    top=${p%%/models--*}; repo=${p#"$top"/}; repo=${repo%%/*}
    repos[$top/$repo]=$top
    if [[ $p == */blobs/* && ! -L $p ]]; then
      d=${p%/blobs/*}; name=${p##*/}; keep=0
      while IFS= read -r -d '' l; do [[ -v ours[$l] ]] || keep=1; done \
        < <(find "$d/snapshots" -type l -lname "*/$name" -print0 2>/dev/null)
      if ((keep)); then U_NOTES+=("kept $p: a download llmserver did not make also uses it"); continue; fi
    fi
    u_rm "$p"
  done
  for d in "${!repos[@]}"; do
    [[ -d $d ]] && find "$d" -depth -type d -empty -delete 2>/dev/null
    if [[ ! -d $d ]]; then
      top=${repos[$d]}; repo=${d##*/}
      rm -rf -- "${top:?}/.locks/$repo" 2>/dev/null || true  # Hugging Face download locks
      info "deleted $repo from the Hugging Face cache"
    else
      info "deleted llmserver's files from ${d##*/}; files other tools downloaded there were kept"
    fi
  done
}
u_purge_ollama() {  # model...: remove through an Ollama server, as 'ollama rm' does
  local m addr i port log
  if [[ -n ${CFG[OLLAMA_ATTACH]} ]]; then addr=${CFG[OLLAMA_ATTACH]}
  elif [[ -n $OLLAMA_BIN ]]; then
    for i in {1..50}; do port=$((20000 + RANDOM % 20000)); port_in_use "$port" || break; done
    mkdir -p "$logs_dir"; log=$logs_dir/ollama-pull.log
    OLLAMA_HOST=127.0.0.1:$port "$OLLAMA_BIN" serve > "$log" 2>&1 8>&- 9>&- &
    TEMP_PIDS+=("$!"); addr=127.0.0.1:$port
    for i in {1..60}; do lcurl -o /dev/null --max-time 2 "http://$addr/api/version" 2>/dev/null && break; sleep 0.5; done
  else
    u_fail "Ollama is not installed, so these models could not be removed: $*"; return 0
  fi
  for m in "$@"; do
    if lcurl -o /dev/null --max-time 60 -X DELETE -H 'Content-Type: application/json' \
      -d "{\"model\":\"$m\",\"name\":\"$m\"}" "http://$addr/api/delete" 2>/dev/null; then
      info "deleted Ollama model $m"
    elif ! lcurl --max-time 5 "http://$addr/api/tags" 2>/dev/null | grep -q "\"name\": *\"$m"; then
      info "Ollama model $m was already gone"
    else
      u_fail "could not delete Ollama model $m; remove it with 'ollama rm $m'"
    fi
  done
  stop_temp_servers
}
run_uninstall() {
  local e m p f servers=() bytes=0 reply path
  local hub_paths=() ollama_models=() scripts=()
  local -A seen=()
  [[ ${CFG[STOP_TIMEOUT]} =~ ^[0-9]+$ ]] || CFG[STOP_TIMEOUT]=20  # work even with broken settings

  running_scan
  for f in "${R_FILES[@]}"; do
    load_rec "$f" || continue
    if [[ ${ST[MANAGED]-1} == 0 ]]; then servers+=("unload ${ST[MODEL]} from the Ollama daemon at ${ST[HOST]}:${ST[PORT]} (the daemon keeps running)")
    else servers+=("stop ${ST[SPEC]} (port ${ST[PORT]}, pid ${ST[PID]})"); fi
  done
  local units=() instances=()
  mapfile -t units < <(u_unit_file || true)
  mapfile -t instances < <(u_unit_instances)
  if [[ -r $downloads_file ]]; then
    while IFS=$'\t' read -r e m p; do
      [[ -n $e && -n $p ]] || continue
      if [[ $p == - ]]; then
        [[ -v seen[o:$m] ]] || ollama_models+=("$m"); seen[o:$m]=1
      elif [[ $p == /*/models--*/* && $p != *..* && ( -e $p || -L $p ) ]]; then
        [[ -v seen[h:$p] ]] || hub_paths+=("$p"); seen[h:$p]=1
      fi
    done < "$downloads_file"
  fi
  bytes=$(u_size "${hub_paths[@]}")
  local home_mb=""
  [[ -f $lhome/$HOME_MARK ]] && home_mb=$(du -sm -- "$lhome" 2>/dev/null | cut -f1)
  mapfile -t scripts < <(u_script_paths)
  local skill_recs=() hf_link=""
  mapfile -t skill_recs < <(compgen -G "$skill_rec_dir/*.json" || true)
  p=$(hf_link_path); grep -qF "$HF_LINK_MARK" "$p" 2>/dev/null && hf_link=$p

  echo "$PROG uninstall will:" >&2
  for p in "${servers[@]}"; do echo "  - $p" >&2; done
  for p in "${units[@]}"; do echo "  - disable and delete the systemd user service $p${instances[*]:+ (instances: ${instances[*]})}" >&2; done
  ((${#skill_recs[@]})) && echo "  - remove the ${#skill_recs[@]} agent skill(s) llmserver installed and their links, if they are unchanged (changed ones are kept)" >&2
  [[ -n $hf_link ]] && echo "  - delete the hf link $hf_link" >&2
  echo "  - delete $lhome${home_mb:+ (${home_mb} MB)}: engines, Python, state, logs (with install.log) and trust records" >&2
  if ((keep_config)); then echo "    but keep the settings ($env_file), $config_dir (menu, tuning rules, API key) and Open WebUI's accounts and chats ($webui_home) (--keep-config)" >&2; fi
  local nmodels=$(( ${#ollama_models[@]} + $(printf '%s\n' "${hub_paths[@]}" | grep -o '/models--[^/]*' | sort -u | grep -c . || true) ))
  if ((nmodels)); then
    if ((purge_models)); then echo "  - delete the $nmodels model(s) llmserver downloaded ($(hsize "$bytes")${ollama_models[*]:+, plus Ollama models: ${ollama_models[*]}})" >&2
    else echo "  - keep the $nmodels model(s) llmserver downloaded ($(hsize "$bytes")); --purge-models deletes them" >&2; fi
  fi
  if ((${#scripts[@]})) && ((!keep_script)); then echo "  - delete the $PROG program: ${scripts[*]}" >&2
  elif ((${#scripts[@]})); then echo "  - keep the $PROG program (--keep-script)" >&2; fi
  echo "It does not touch engines installed outside $lhome, or models other tools downloaded." >&2

  ((dry)) && return 0
  if ((!yes)); then
    [[ -t 0 ]] || die "nothing was changed: run '$PROG uninstall --yes' to uninstall without prompts"
    if ((nmodels && !purge_models)); then
      printf 'Also delete the %d downloaded model(s)? [y/N]: ' "$nmodels" >&2
      IFS= read -r reply || reply=""
      [[ ${reply,,} == y* ]] && purge_models=1
    fi
    printf 'Uninstall %s now? [y/N]: ' "$PROG" >&2
    IFS= read -r reply || reply=""
    [[ ${reply,,} == y* ]] || { info "cancelled; nothing was changed"; return 0; }
  fi

  if [[ -d $state_dir ]] && have flock; then
    exec 9>> "$lock_file"
    flock -w 30 9 || die "another $PROG is starting or stopping a model; try again when it has finished"
  fi

  # 1. the service first, so nothing restarts what is stopped next
  if ((${#units[@]})); then
    if have systemctl; then
      for p in llmserver.service llmserver-webui.service "${instances[@]}"; do systemctl --user disable --now "$p" >/dev/null 2>&1 || true; done
    fi
    for p in "${instances[@]}"; do   # leftover enablement links, if systemctl was not available
      for path in "${XDG_CONFIG_HOME:-$HOME/.config}"/systemd/user/*.wants/"$p"; do if [[ -L $path ]]; then u_rm "$path"; fi; done
    done
    u_rm "${units[@]}"
    if have systemctl; then systemctl --user daemon-reload >/dev/null 2>&1 || true; fi
    info "removed the systemd user service(s)"
  fi
  # 2. the services, then the models llmserver started (servers it did not start are left running)
  svc_alive webui && svc_stop webui "Open WebUI"
  svc_alive searxng && svc_stop searxng SearXNG
  svc_alive gateway && svc_stop gateway
  for f in "${R_FILES[@]}"; do
    stop_rec "$f" || u_fail "${ST[SPEC]:-a model} (pid ${ST[PID]:-?}) could not be stopped"
  done
  # 3. models
  if ((purge_models)); then
    ((${#hub_paths[@]})) && u_purge_hub "${hub_paths[@]}"
    ((${#ollama_models[@]})) && u_purge_ollama "${ollama_models[@]}"
  elif ((nmodels)); then
    for p in $(printf '%s\n' "${hub_paths[@]}" | sed -nE 's#^(.*/models--[^/]*)/.*#\1#p' | sort -u); do
      U_NOTES+=("kept downloaded model ${p##*/models--}: $p")
    done
    for m in "${ollama_models[@]}"; do U_NOTES+=("kept Ollama model $m (remove with 'ollama rm $m')"); done
  fi
  # 4. agent skills and the hf link (while llmserver's Python can still check them)
  local kept_skills=0 l
  for f in "${skill_recs[@]}"; do
    skill_fields "$f"
    case $(skill_state "$f") in
      ok|missing)
        skill_links; for l in "${SK_LINKS[@]}"; do [[ -L $l && $(readlink -f -- "$l") == "$(readlink -m -- "${SF[central]}")" ]] && u_rm "$l"; done
        [[ -d ${SF[central]} && ! -L ${SF[central]} ]] && { rm -rf -- "${SF[central]}" || u_fail "could not delete ${SF[central]}"; } ;;
      *) kept_skills=1; U_NOTES+=("kept the skill ${SF[name]} in ${SF[central]}, because it changed after llmserver installed it") ;;
    esac
  done
  ((${#skill_recs[@]})) && info "removed the agent skills llmserver installed"
  [[ -n $hf_link ]] && u_rm "$hf_link"
  # 5. the folder: everything in it, except what the options keep
  LOG_OK=0   # install.log goes too; nothing more is written to it
  if [[ -n $MIGRATE_BLOCKED ]]; then   # still the layout of llmserver < 2.1
    ((keep_config)) || { [[ -f $env_file ]] && u_rm "$env_file"; rm -rf -- "$config_dir"; }
    rm -rf -- "$state_dir"
  fi
  if [[ -f $lhome/$HOME_MARK && $lhome != / && $lhome != "$HOME" && $lhome == /*/* ]]; then
    local keep=()
    ((keep_config)) && keep+=(llmserver.env config webui "$HOME_MARK")
    ((purge_models)) || keep+=(models)
    ((kept_skills)) && keep+=(skills "$HOME_MARK")
    for path in "$lhome"/* "$lhome"/.[!.]*; do
      [[ -e $path || -L $path ]] || continue
      [[ " ${keep[*]} " == *" ${path##*/} "* ]] && continue
      rm -rf -- "$path" || u_fail "could not delete $path"
    done
    rmdir -- "$lhome" 2>/dev/null || true
    if [[ -e $lhome ]]; then info "deleted $lhome, except: $(find "$lhome" -mindepth 1 -maxdepth 1 -printf '%f ')"
    else info "deleted $lhome"; fi
    [[ -d $lhome/models ]] && U_NOTES+=("kept the models in $lhome/models (--purge-models deletes them)")
  fi
  [[ -f $sys_env_file ]] && ((!keep_config)) && U_NOTES+=("kept the system-wide settings in $sys_env_file; an administrator can delete it")
  # 6. the program itself, last (bash keeps reading this file from its open descriptor)
  if ((!keep_script)); then
    for path in "${scripts[@]}"; do
      if [[ -w ${path%/*} ]]; then u_rm "$path"
      else u_fail "no permission to delete $path; run: sudo rm -f '$path'"; fi
    done
  fi

  for p in "${U_NOTES[@]}"; do info "$p"; done
  [[ $(engine_source llama)$(engine_source vllm)$(engine_source ollama) == *system* ]] && info "your own engines (LLMSERVER_*_SOURCE=system or a path) were installed separately and are untouched"
  if ((U_FAILS)); then die "uninstall finished with $U_FAILS problem(s); see the warnings above"; fi
  info "${C_B}uninstalled${C_0}"
}

EXTRA="" ENGINE="" MODEL="" SPEC=""
choose() {  # a menu number or a spec -> ENGINE MODEL SPEC EXTRA; status 1 with R_ERR otherwise
  local i
  if [[ $1 =~ ^[0-9]+$ ]]; then
    if ((10#$1 < 1 || 10#$1 > ${#specs[@]})); then R_ERR="no menu entry $1 (1-${#specs[@]}); see $PROG list"; return 1; fi
    parse_spec "${specs[10#$1 - 1]}"; EXTRA=${extras[10#$1 - 1]}
  else
    parse_spec "$1" "$opt_engine" || return 1
    EXTRA=""
    for i in "${!specs[@]}"; do if [[ ${specs[i]} == "$R_SPEC" ]]; then EXTRA=${extras[i]}; fi; done
  fi
  ENGINE=$R_ENGINE MODEL=$R_MODEL SPEC=$R_SPEC
}

# ---- 'llmserver chat': talk to a running model ----------------------------------------
chatpy() {  # base model key system history-file label [prompt]: the chat client, on llmserver's own Python
  local py
  py=$(helper_python) || die "chat needs llmserver's runtime: '$PROG install runtime'"
  NO_COLOR=${NO_COLOR-} CHAT_THINK=$opt_think CHAT_REASONING=$opt_reasoning CHAT_ENGINE=${ST[ENGINE]-} PYTHONIOENCODING=utf-8 py_env "$py" -I /dev/fd/3 "$@" 3<<'CHATPY'   # the code on fd 3: stdin stays the user's
import json, os, sys, time, urllib.error, urllib.request

base, model, key, system, histfile, label = sys.argv[1:7]
prompt = sys.argv[7] if len(sys.argv) > 7 else None
out = sys.stdout
color = out.isatty() and not os.environ.get('NO_COLOR')
DIM, BOLD, RST = ('\033[2m', '\033[1m', '\033[0m') if color else ('', '', '')
messages = []
show_think = os.environ.get('CHAT_THINK') == '1'
engine = os.environ.get('CHAT_ENGINE', '')
effort = os.environ.get('CHAT_REASONING', '')
LEVELS = ('low', 'medium', 'high', 'none')
HELP = """Type a message and press Enter. Commands:
  /help            this text
  /think           show or hide the model's thinking (reasoning models)
  /reasoning [L]   how hard a reasoning model thinks: low, medium, high, none (no thinking), off (model default)
  /system [TEXT]   show or set the system prompt (it applies from the next message)
  /clear           forget the conversation (keeps the system prompt)
  /retry           ask for the last answer again
  /save FILE       write the conversation to FILE (Markdown)
  /exit            leave (also Ctrl-D)
  \"\"\"             start and end a message of several lines
Ctrl-C stops an answer."""

def say(t): out.write(t); out.flush()

class ChatError(Exception): pass

def request(msgs):
    body = {'model': model, 'messages': ([{'role': 'system', 'content': system}] if system else []) + msgs,
            'stream': True, 'stream_options': {'include_usage': True}}
    if effort:   # the OpenAI field; llama.cpp and vLLM templates also read it (or enable_thinking) from chat_template_kwargs
        if effort != 'none' or engine == 'ollama': body['reasoning_effort'] = effort
        if engine in ('llama', 'vllm'):
            body['chat_template_kwargs'] = {'enable_thinking': False} if effort == 'none' else {'reasoning_effort': effort}
    h = {'Content-Type': 'application/json'}
    if key: h['Authorization'] = 'Bearer ' + key
    req = urllib.request.Request(base + '/v1/chat/completions', data=json.dumps(body).encode(), headers=h)
    try:
        return urllib.request.urlopen(req, timeout=900)
    except urllib.error.HTTPError as e:
        try: m = json.loads(e.read() or b'{}').get('error', {}); m = m.get('message') if isinstance(m, dict) else m
        except ValueError: m = None
        if e.code == 401: raise ChatError('the model refused the API key (HTTP 401); the key may have changed: restart the model')
        if m and 'context' in str(m).lower(): raise ChatError('the conversation is longer than the model\'s context. Type /clear to start again, or restart the model with a larger --ctx')
        raise ChatError('the model answered HTTP %d%s' % (e.code, ': ' + str(m) if m else ''))
    except (urllib.error.URLError, OSError) as e:
        raise ChatError('cannot reach the model at %s (%s); is it still running? (llmserver ps)' % (base, getattr(e, 'reason', e)))

def answer(msgs, show=True):
    """stream one answer; returns (text, completed). Thinking is hidden behind a 'thinking...' note unless /think is on"""
    text = []; usage = None; first = None; think = False; t0 = time.time(); tstart = None; tend = None; note = False
    live = show and out.isatty()
    r = request(msgs)
    try:
        for raw in r:
            line = raw.decode('utf-8', 'replace').strip()
            if not line.startswith('data:'): continue
            data = line[5:].strip()
            if data == '[DONE]': break
            try: ev = json.loads(data)
            except ValueError: continue
            if ev.get('usage'): usage = ev['usage']
            for ch in ev.get('choices') or []:
                d = ch.get('delta') or {}
                rc = d.get('reasoning_content') or d.get('reasoning')
                if rc:
                    if tstart is None: tstart = time.time()
                    if first is None: first = tstart   # thinking tokens count: the speed covers all of them
                    tend = time.time()
                    if show and show_think:
                        if not think: say(DIM); think = True
                        say(rc)
                    elif live and not note:
                        say(DIM + 'thinking...' + RST); note = True
                c = d.get('content')
                if c:
                    if think: say(RST + '\n'); think = False
                    if note: say('\r\033[K'); note = False
                    if tstart is not None and not text and live and not show_think:
                        say(DIM + '(thought for %.1fs; /think shows it)' % (tend - tstart) + RST + '\n')
                    if first is None: first = time.time()
                    text.append(c)
                    if show:   # <think> blocks inside the content are shown dimmed
                        say(c.replace('<think>', DIM + '<think>').replace('</think>', '</think>' + RST))
    except KeyboardInterrupt:
        r.close()
        if note: say('\r\033[K')
        say(RST + DIM + ' [stopped]' + RST + '\n')
        return ''.join(text), False
    finally:
        if think: say(RST)
    say(RST + '\n')
    if show and out.isatty() and usage and first:
        n = usage.get('completion_tokens') or 0; dt = time.time() - first
        say(DIM + '[%d tokens%s, %.1f tokens/s, first token after %.1fs]' % (n, ' with the thinking' if tstart is not None else '', n / dt if dt > 0 else 0, first - t0) + RST + '\n')
    return ''.join(text), True

# one question (an argument, or everything on a pipe): print the answer and stop
if prompt is not None or not sys.stdin.isatty():
    q = (prompt if prompt is not None else sys.stdin.read()).strip()
    if not q.strip(): sys.exit('llmserver: chat: nothing to ask (give a message, or pipe one in)')
    try:
        text, ok = answer([{'role': 'user', 'content': q}])
    except ChatError as e:
        sys.exit('llmserver: error: ' + str(e))
    sys.exit(0 if ok else 130)

try:
    import readline
    try: readline.read_history_file(histfile)
    except OSError: pass
    readline.set_history_length(1000)
except ImportError:
    readline = None

def save_history():
    if readline:
        try:
            readline.write_history_file(histfile); os.chmod(histfile, 0o600)
        except OSError: pass

def read_message():
    line = input('> ')   # plain: libedit (the line editor of llmserver's Python) prints colour codes in a prompt literally
    if line.strip() != '\"\"\"': return line
    lines = []
    while True:
        l = input('. ')
        if l.strip() == '\"\"\"': return '\n'.join(lines)
        lines.append(l)

say('%sChatting with %s. Type /help for commands, /exit to leave.%s\n' % (DIM, label, RST))
if system: say('%ssystem prompt: %s%s\n' % (DIM, system, RST))
if effort: say('%sreasoning: %s%s\n' % (DIM, effort, RST))
while True:
    try:
        msg = read_message()
    except EOFError:
        say('\n'); break
    except KeyboardInterrupt:
        say('\n%s(/exit or Ctrl-D leaves)%s\n' % (DIM, RST)); continue
    if not msg.strip(): continue
    cmd, _, arg = msg.strip().partition(' ')
    if cmd in ('/exit', '/quit', '/bye'): break
    if cmd in ('/help', '/?'): say(HELP + '\n'); continue
    if cmd == '/reasoning':
        a = arg.strip().lower()
        if not a: say('(reasoning: %s)\n' % (effort or "the model's default")); continue
        if a in ('off', 'default'): effort = ''
        elif a in LEVELS: effort = a
        else: say('use /reasoning low, medium, high, none or off\n'); continue
        say(DIM + '(reasoning: %s, from the next message)' % (effort or "the model's default") + RST + '\n'); continue
    if cmd == '/think':
        show_think = not show_think if not arg else arg.strip() in ('on', '1', 'yes')
        say(DIM + '(thinking is %s)' % ('shown' if show_think else 'hidden') + RST + '\n'); continue
    if cmd == '/clear': messages = []; say(DIM + '(the conversation was cleared)' + RST + '\n'); continue
    if cmd == '/system':
        if arg: system = arg.strip(); say(DIM + '(system prompt set)' + RST + '\n')
        else: say((system or '(no system prompt)') + '\n')
        continue
    if cmd == '/save':
        if not arg: say('usage: /save FILE\n'); continue
        try:
            with open(os.path.expanduser(arg.strip()), 'w', encoding='utf-8') as f:
                f.write('# Chat with %s\n\n' % label)
                if system: f.write('**System:** %s\n\n' % system)
                for m in messages: f.write('**%s:** %s\n\n' % ('You' if m['role'] == 'user' else 'Model', m['content']))
            say(DIM + '(saved %d messages to %s)' % (len(messages), arg.strip()) + RST + '\n')
        except OSError as e:
            say('could not save: %s\n' % e)
        continue
    if cmd == '/retry':
        if not messages or messages[-1]['role'] != 'assistant': say('(nothing to retry)\n'); continue
        messages.pop()
    elif cmd.startswith('/') and len(cmd) > 1 and ' ' not in cmd and cmd[1:].isalpha():
        say('unknown command %s; /help lists them\n' % cmd); continue
    else:
        messages.append({'role': 'user', 'content': msg})
    try:
        text, ok = answer(messages)
        messages.append({'role': 'assistant', 'content': text})
    except ChatError as e:
        say('llmserver: %s\n' % e)
        if messages and messages[-1]['role'] == 'user': messages.pop()
save_history()
CHATPY
}
cmd_chat() {  # [MODEL] [PROMPT...]: talk to a running model (offers to start it)
  local f i reply base key="" spec prompt="${chat_args[*]}" have_prompt=0 idx
  ((${#chat_args[@]})) && have_prompt=1
  running_scan
  if [[ -n $sel ]]; then
    if ! rec_select "$sel"; then   # not running: start it (asks first in a terminal)
      choose "$sel" || die "$R_ERR"
      spec=$SPEC
      if ((!yes)); then
        [[ -t 0 && -t 2 ]] || die "$spec is not running; start it first ('$PROG $spec'), or add --yes to start it"
        printf '%s: %s is not running. Start it now? [Y/n]: ' "$PROG" "$spec" >&2
        IFS= read -r reply || reply=""
        [[ -z $reply || ${reply,,} == y* ]] || { info "nothing was started"; return 0; }
      fi
      if ((yes)); then "$0" "$spec" --yes || die "$spec did not start; see the messages above"
      else "$0" "$spec" || die "$spec did not start; see the messages above"; fi
      running_scan; rec_select "$spec" || die "$spec started, but its record was not found ('$PROG ps')"
    fi
  elif ((${#R_FILES[@]} == 1)); then REC=${R_FILES[0]}
  elif ((${#R_FILES[@]} > 1)); then
    [[ -t 0 && -t 2 ]] || die "several models are running; say which: '$PROG chat MODEL' (see '$PROG ps')"
    echo "$PROG: which model?" >&2
    for i in "${!R_FILES[@]}"; do load_rec "${R_FILES[i]}" && printf '%3d) %s  (port %s)\n' "$((i + 1))" "${ST[SPEC]}" "${ST[PORT]}" >&2; done
    printf 'Model [1]: ' >&2; IFS= read -r reply || reply=""
    [[ -z $reply ]] && reply=1
    { [[ $reply =~ ^[0-9]+$ ]] && ((reply >= 1 && reply <= ${#R_FILES[@]})); } || die "no model $reply"
    REC=${R_FILES[reply - 1]}
  else
    ((${#specs[@]})) || die "no model is running and the menu is empty; '$PROG model add MODEL', then '$PROG chat MODEL'"
    [[ -t 0 && -t 2 ]] || die "no model is running; '$PROG chat MODEL --yes' starts one and chats with it"
    echo "$PROG: no model is running. Which one do you want to start and chat with?" >&2
    menu_show
    printf 'Model (Enter = none): ' >&2; IFS= read -r reply || reply=""
    [[ -n $reply ]] || { info "nothing was started"; return 0; }
    { [[ $reply =~ ^[0-9]+$ ]] && ((reply >= 1 && reply <= ${#specs[@]})); } || die "the menu has entries 1-${#specs[@]}"
    idx=$((reply - 1)); spec=${specs[idx]}
    "$0" "$spec" || die "$spec did not start; see the messages above"
    running_scan; rec_select "$spec" || die "$spec started, but its record was not found ('$PROG ps')"
  fi
  load_rec "$REC"
  base="http://$(hostport "$(connect_host "${ST[HOST]}")" "${ST[PORT]}")"
  [[ ${ST[ENGINE]} != ollama && -s $key_file ]] && key=$(<"$key_file")
  mkdir -p "$state_dir"
  log_write info "chat: ${ST[SPEC]}"
  if ((have_prompt)); then chatpy "$base" "$(model_id "${ST[ENGINE]}" "${ST[MODEL]}")" "$key" "$opt_system" "$state_dir/chat_history" "${ST[SPEC]}" "$prompt"
  else chatpy "$base" "$(model_id "${ST[ENGINE]}" "${ST[MODEL]}")" "$key" "$opt_system" "$state_dir/chat_history" "${ST[SPEC]}"; fi
}

# ---- services: the gateway and Open WebUI ---------------------------------------------
# 'llmserver gateway' is one OpenAI-compatible address in front of every running model: it lists
# them (GET /v1/models) and forwards each request to the model it names, streaming. Clients and
# Open WebUI keep one URL while models start and stop. It is llmserver's own code on llmserver's
# Python (standard library only). Clients on this computer need no key; from the network, the API key.
svc_dir=$state_dir/services
svc_file() { printf '%s/%s.state\n' "$svc_dir" "$1"; }
svc_alive() {  # name -> is the recorded service still running? (ST holds its record)
  local f; f=$(svc_file "$1")
  load_rec "$f" || return 1
  if [[ -n ${ST[PID]-} ]] && pid_alive "${ST[PID]}" && [[ $(pid_starttime "${ST[PID]}") == "${ST[STARTTIME]-}" ]]; then return 0; fi
  rm -f -- "$f"; return 1
}
svc_stop() {  # name [label]: stop it if it runs
  local what=${2:-$1}
  svc_alive "$1" || { info "$what is not running"; return 0; }
  info "stopping $what (pid ${ST[PID]})"
  stop_pid "${ST[PID]}" 1 || warn "pid ${ST[PID]} did not stop"
  rm -f -- "$(svc_file "$1")"
  log_write info "$1: stopped"
}
svc_launch() {  # name log env-assignments... -- argv...: start detached in its own session; SVC_PID
  local name=$1 log=$2 kv envs=() launcher=()
  shift 2
  while (($#)) && [[ $1 != -- ]]; do envs+=("$1"); shift; done
  shift
  have setsid && launcher=(setsid)
  mkdir -p "${log%/*}"
  printf '==== %s: started by llmserver (run %s) ====\n' "$(date '+%F %T')" "$RUN_ID" >> "$log"
  (
    exec 8>&- 9>&-
    trap - EXIT
    exec env -i "${envs[@]}" "${launcher[@]}" "$@" >> "$log" 2>&1 < /dev/null
  ) &
  SVC_PID=$!
  log_write info "$name: started pid $SVC_PID"
}
svc_wait() {  # name url seconds: wait until the url answers; status 1 if the process died, 2 on time-out
  local name=$1 url=$2 deadline=$((SECONDS + $3)) next=$((SECONDS + 15))
  until lcurl -o /dev/null --max-time 3 "$url" 2>/dev/null; do
    pid_alive "$SVC_PID" || return 1
    ((SECONDS < deadline)) || return 2
    if ((SECONDS >= next)); then info "still starting $name (${SECONDS}s)"; next=$((SECONDS + 15)); fi
    sleep 1
  done
  return 0
}
gateway_url() { printf 'http://%s/v1\n' "$(hostport "$(connect_host "${CFG[GATEWAY_HOST]}")" "${CFG[GATEWAY_PORT]}")"; }
gateway_py() {
  cat <<'GATEWAYPY'
"""llmserver gateway: one OpenAI-compatible address for every running model (standard library only)"""
import http.client, ipaddress, json, os, socket, sys, time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

HOST, PORT, RUN, KEYFILE, REQUIRE = sys.argv[1], int(sys.argv[2]), sys.argv[3], sys.argv[4], sys.argv[5] == '1'
ROUTES = ('/v1/chat/completions', '/v1/completions', '/v1/embeddings', '/v1/responses')
RERANK = ('/v1/rerank', '/rerank', '/v1/reranking')   # to a reranker (a llama.cpp model started with --reranking)
MAX_BODY = 64 << 20

def key():
    try: return open(KEYFILE).read().strip()
    except OSError: return ''

def model_id(engine, model):   # the name clients use (as llmserver's model_id)
    if model.startswith('/'):
        n = model.rsplit('/', 1)[-1]
        n = n[:-5] if n.lower().endswith('.gguf') else n
        i = n.find('-00001-of-')
        return n[:i] if i > 0 else n
    return model

def backends():
    out = {}
    try: names = sorted(os.listdir(RUN))
    except OSError: names = []
    for n in names:
        if not n.endswith('.state'): continue
        st = {}
        try:
            for line in open(os.path.join(RUN, n)):
                k, _, v = line.rstrip('\n').partition('='); st[k] = v
        except OSError: continue
        if st.get('STATE', 'ready') != 'ready' or not st.get('PORT'): continue
        if st.get('MANAGED', '1') != '0' and st.get('PID') and not os.path.exists('/proc/' + st['PID']): continue
        host = st.get('HOST') or '127.0.0.1'
        if host in ('0.0.0.0', '::', '[::]'): host = '127.0.0.1'
        mid = model_id(st.get('ENGINE', ''), st.get('MODEL', ''))
        name = mid if mid not in out else '%s:%s' % (st.get('ENGINE'), mid)
        out[name] = {'host': host.strip('[]'), 'port': int(st['PORT']), 'model': mid, 'spec': st.get('SPEC', ''), 'engine': st.get('ENGINE', ''),
                     'role': st.get('ROLE', '')}
    return out

def loopback(addr):
    try: return ipaddress.ip_address(addr.split('%')[0]).is_loopback
    except ValueError: return False

class H(BaseHTTPRequestHandler):
    protocol_version = 'HTTP/1.1'
    server_version = 'llmserver-gateway'
    def log_message(self, fmt, *a): pass
    def note(self, code, model='-', t0=None):
        sys.stderr.write('%s %s %s %s %s %d %s\n' % (time.strftime('%Y-%m-%dT%H:%M:%S'), self.client_address[0], self.command,
                         self.path.split('?')[0], model, code, '%.2fs' % (time.time() - t0) if t0 else '-'))
        sys.stderr.flush()
    def reply(self, code, obj):
        b = json.dumps(obj).encode()
        self.send_response(code); self.send_header('Content-Type', 'application/json')
        self.send_header('Content-Length', str(len(b))); self.end_headers(); self.wfile.write(b)
    def error(self, code, msg, kind='invalid_request_error', ecode=None):
        self.reply(code, {'error': {'message': msg, 'type': kind, 'code': ecode}}); self.note(code)
    def allowed(self):   # this computer: always; the network: only with the API key (REQUIRE: bound to the network)
        if loopback(self.client_address[0]): return True
        k = key()
        if k and self.headers.get('Authorization', '') == 'Bearer ' + k: return True
        self.error(401, 'a valid API key is required (llmserver env shows it)', 'authentication_error', 'invalid_api_key'); return False
    def do_GET(self):
        path = self.path.split('?')[0]
        if path == '/health': return self.reply(200, {'status': 'ok', 'models': len(backends())})
        if not self.allowed(): return
        if path in ('/v1/models', '/models'):
            now = int(time.time())
            data = [{'id': k, 'object': 'model', 'created': now, 'owned_by': 'llmserver',
                     'llmserver': {'spec': v['spec'], 'engine': v['engine'], 'port': v['port']}}
                    for k, v in backends().items() if not v['role']]   # rerankers and embedding servers are not for chat
            self.reply(200, {'object': 'list', 'data': data}); return self.note(200)
        self.error(404, 'not found: %s' % path)
    def do_POST(self):
        t0 = time.time(); path = self.path.split('?')[0]
        if not self.allowed(): return
        if path not in ROUTES and path not in RERANK: return self.error(404, 'not found: %s' % path)
        n = int(self.headers.get('Content-Length') or 0)
        if n > MAX_BODY: return self.error(413, 'the request is too large')
        try: body = json.loads(self.rfile.read(n) or b'{}')
        except ValueError: return self.error(400, 'the request body is not JSON')
        role = 'rerank' if path in RERANK else None
        b = {k: v for k, v in backends().items() if (v['role'] == 'rerank') == (role == 'rerank') or (path == '/v1/embeddings' and v['role'] == 'embedding')}
        if path in RERANK: path = '/v1/rerank'
        want = body.get('model')
        if not want and len(b) == 1: want = next(iter(b))
        if want not in b:
            run = ', '.join(sorted(b)) or 'none'
            return self.error(404, "model '%s' is not running (running: %s); start it with 'llmserver MODEL'" % (want, run), ecode='model_not_found')
        be = b[want]; body['model'] = be['model']
        data = json.dumps(body).encode()
        h = {'Content-Type': 'application/json', 'Accept': self.headers.get('Accept', '*/*')}
        k = key()
        if k: h['Authorization'] = 'Bearer ' + k
        try:
            c = http.client.HTTPConnection(be['host'], be['port'], timeout=900)
            c.request('POST', path, body=data, headers=h); r = c.getresponse()
        except OSError as e:
            return self.error(502, "model '%s' does not answer (%s); see 'llmserver ps'" % (want, e), 'server_error')
        self.send_response(r.status)
        self.send_header('Content-Type', r.getheader('Content-Type', 'application/json'))
        self.send_header('Cache-Control', 'no-cache'); self.send_header('Connection', 'close')
        self.end_headers(); self.close_connection = True
        try:
            while True:
                chunk = r.read1(65536) if hasattr(r, 'read1') else r.read(65536)
                if not chunk: break
                self.wfile.write(chunk); self.wfile.flush()
        except (BrokenPipeError, ConnectionResetError):
            pass   # the client went away: closing the upstream connection stops the generation
        finally:
            c.close()
        self.note(r.status, want, t0)

class S(ThreadingHTTPServer):
    daemon_threads = True
    allow_reuse_address = True
    address_family = socket.AF_INET6 if ':' in HOST else socket.AF_INET

sys.stderr.write('llmserver gateway on %s:%d\n' % (HOST, PORT)); sys.stderr.flush()
S((HOST.strip('[]'), PORT), H).serve_forever()
GATEWAYPY
}
gateway_start() {  # quiet(0|1): start the gateway if it is not running
  local py h=${CFG[GATEWAY_HOST]} p=${CFG[GATEWAY_PORT]} require=0 f
  if svc_alive gateway; then (($1)) || info "the gateway is running: $(gateway_url)"; return 0; fi
  py=$(helper_python) || { runtime_ready || die "the gateway needs llmserver's runtime: '$PROG install runtime'"; py=$(helper_python); }
  if ! is_loopback "$h"; then
    require=1
    if [[ ${CFG[AUTH]} == none ]] && ((!CFG[ALLOW_INSECURE])); then die "the gateway on $h would give the network every model without a key; keep LLMSERVER_GATEWAY_HOST=127.0.0.1, or use LLMSERVER_AUTH=auto or key"; fi
    ensure_key
  fi
  port_in_use "$p" && die "port $p is in use; choose another: '$PROG config set gateway_port N'"
  lhome_init; mkdir -p "$svc_dir" "$lhome/runtime"
  f=$lhome/runtime/gateway.py
  (umask 022; gateway_py > "$f.tmp.$$" && mv -f -- "$f.tmp.$$" "$f")
  svc_launch gateway "$logs_dir/gateway.log" "PATH=/usr/bin:/bin" "LANG=C.UTF-8" -- "$py" -I "$f" "$h" "$p" "$run_dir" "$key_file" "$require"
  if ! svc_wait gateway "http://$(hostport "$(connect_host "$h")" "$p")/health" 15; then
    die "the gateway did not start; see $logs_dir/gateway.log"
