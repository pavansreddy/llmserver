# ---- skills -------------------------------------------------------------------------------
# Marketplace skills come only from Hugging Face's own marketplace (the huggingface/skills
# bucket, or an administrator's mirror of it). Each is checked before it is installed; nothing
# in a skill is ever run by llmserver.
SKILL_BUCKET = 'huggingface/skills'
SKILL_EXT = ('.md', '.py', '.sh', '.json', '.txt', '.tsx', '.ts', '.js', '.example', '.yaml', '.yml', '.toml', '.csv')
SKILL_FILE_MAX, SKILL_MAX = 1 << 20, 5 << 20
RULES.update({
    'S-NOT-LISTED': ('block', 'block', 'no'), 'S-FILETYPE': ('block', 'block', 'no'), 'S-LINK': ('block', 'block', 'no'),
    'S-SIZE': ('block', 'block', 'no'), 'S-NO-SKILLMD': ('block', 'block', 'no'), 'S-HUB-OFFLINE': ('block', 'block', 'no'),
    'S-ISSUE-SECURITY': ('block', 'block', 'risk'), 'S-ISSUE-OPEN': ('note', 'ask', 'risk'),
    'S-RECENT': ('ask', 'block', 'risk'), 'S-PATTERN': ('ask', 'ask', 'risk'), 'S-UNICODE': ('ask', 'block', 'risk'),
    'S-DOMAINS': ('note', 'ask', 'risk'), 'S-TOOLS': ('note', 'ask', 'risk'), 'S-GITHUB-OFFLINE': ('ask', 'block', 'risk'),
    'S-SCRIPTS': ('note', 'note', 'no'),
})
GH_API = os.environ.get('T_GH_API', 'https://api.github.com').rstrip('/')
MIRROR = os.environ.get('T_SKILLS_MIRROR', '')
SEC_WORDS = re.compile(r'(?i)\b(security|malicious|malware|vulnerab\w*|exfiltrat\w*|backdoor|prompt[ -]injection|credential\w*|cve-\d+)')
DL_RUN = re.compile(r'(?i)\b(curl|wget|iwr|invoke-webrequest)\b[^\n|]*\|\s*(sudo\s+)?(ba|z|da|k)?sh\b|\biex\s*\(|invoke-expression')
B64_RUN = re.compile(r'(?i)base64\s+(-d|--decode)[^\n|]*\|\s*(sudo\s+)?(ba|z)?sh\b|\b(exec|eval)\s*\(\s*(base64|codecs|zlib|marshal|bytes\.fromhex)')
CRED = re.compile(r'(?i)(~|\$HOME|\$\{HOME\}|/home/[^/\s]+|/root)/\.(ssh|aws/credentials|netrc|gnupg|docker/config\.json|kube/config)|\bid_(rsa|ed25519|ecdsa)\b|/etc/shadow')
INJ = re.compile(r'(?i)\b(ignore|disregard|forget)\s+(all\s+|any\s+)?(the\s+|your\s+)?(previous|prior|above|earlier|system)\s+(instructions|rules|prompts?|messages)')
HIDDEN = re.compile('[​-‏‪-‮⁠-⁤⁦-⁩﻿\U000e0000-\U000e007f]')
OK_HOSTS = ('huggingface.co', 'hf.co', 'github.com', 'githubusercontent.com', 'pypi.org', 'python.org', 'pytorch.org', 'hf.space')

def hf_api():
    from huggingface_hub import HfApi
    return HfApi(endpoint=HF, token=False)

def market():
    """-> {name: entry}, source"""
    if MIRROR:
        d = json.load(open(os.path.join(MIRROR, 'marketplace.json')))
        src = 'mirror'
    else:
        import tempfile
        with tempfile.TemporaryDirectory() as t:
            p = os.path.join(t, 'marketplace.json')
            hf_api().download_bucket_files(SKILL_BUCKET, [('marketplace.json', p)], raise_on_missing_files=True)
            d = json.load(open(p))
        src = 'marketplace'
    items = d.get('plugins') or d.get('skills') or []
    return {str(i.get('name')): i for i in items if i.get('name')}, src, (d.get('metadata') or {}).get('version')

def cmd_skills_market(fmt='text'):
    try: m, src, ver = market()
    except Exception as e:
        print('error\toffline\t%s' % type(e).__name__); return
    if fmt == 'json':
        print(json.dumps([{'name': k, 'description': v.get('description')} for k, v in sorted(m.items())])); return
    for k, v in sorted(m.items()):
        print('skill\t%s\t%s' % (k, (v.get('description') or '').replace('\t', ' ').replace('\n', ' ')))

def skill_files_remote(name, entry):
    src = str(entry.get('source') or '').strip()
    while src.startswith('./'): src = src[2:]
    src = src.strip('/')
    if not src or '..' in src.split('/') or src.startswith('/'): raise ValueError('bad source path')
    if MIRROR:
        base = os.path.join(MIRROR, src); out = []
        for root, dirs, fs in os.walk(base, followlinks=False):
            for n in fs:
                full = os.path.join(root, n); rel = os.path.relpath(full, base)
                st = os.lstat(full)
                out.append({'path': rel, 'size': st.st_size, 'uploaded_at': datetime.datetime.fromtimestamp(st.st_mtime, datetime.timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ'),
                            'link': os.path.islink(full), 'src': full})
            for n in dirs:
                if os.path.islink(os.path.join(root, n)): out.append({'path': os.path.relpath(os.path.join(root, n), base), 'size': 0, 'link': True, 'src': None})
        return out
    from huggingface_hub._buckets import BucketFile
    api = hf_api(); out = []
    for it in api.list_bucket_tree(SKILL_BUCKET, prefix=src, recursive=True):
        if not isinstance(it, BucketFile) or not it.path.startswith(src + '/'): continue
        ua = it.uploaded_at.strftime('%Y-%m-%dT%H:%M:%SZ') if getattr(it, 'uploaded_at', None) else None
        out.append({'path': it.path[len(src) + 1:], 'size': int(it.size or 0), 'uploaded_at': ua, 'link': False, 'src': it})
    return out

def gh_issues():
    """open issues of the skills' source repository, cached for 24 h"""
    cache = os.path.join(os.environ.get('T_CACHE', '/tmp'), 'github-huggingface-skills-issues.json')
    try:
        c = json.load(open(cache))
        if time.time() - c.get('fetched', 0) < 86400: return c['issues']
    except (OSError, ValueError, KeyError): pass
    issues = []
    h = {'User-Agent': 'llmserver-trust', 'Accept': 'application/vnd.github+json'}
    if os.environ.get('GITHUB_TOKEN'): h['Authorization'] = 'Bearer ' + os.environ['GITHUB_TOKEN']
    for page in range(1, 6):
        url = '%s/repos/huggingface/skills/issues?state=open&per_page=100&page=%d' % (GH_API, page)
        with urllib.request.urlopen(urllib.request.Request(url, headers=h), timeout=15) as r:
            batch = json.loads(r.read())
        if not isinstance(batch, list): raise ValueError('unexpected answer')
        issues += [{'number': i.get('number'), 'title': i.get('title') or '', 'body': (i.get('body') or '')[:4000],
                    'labels': [l.get('name', '') for l in i.get('labels') or []], 'url': i.get('html_url')}
                   for i in batch if 'pull_request' not in i]
        if len(batch) < 100: break
    try:
        os.makedirs(os.path.dirname(cache), exist_ok=True)
        with open(cache + '.tmp', 'w') as f: json.dump({'fetched': time.time(), 'issues': issues}, f)
        os.replace(cache + '.tmp', cache)
    except OSError: pass
    return issues

def issue_rules(P, name):
    try: issues = gh_issues()
    except Exception as e:
        finding(P, 'S-GITHUB-OFFLINE', 'the open issues of github.com/huggingface/skills could not be read (%s), so reports about this skill are unknown' % type(e).__name__); return
    pat = re.compile(r'(?i)(?<![\w-])%s(?![\w-])' % re.escape(name))
    for i in issues:
        text = i['title'] + '\n' + i['body']
        if not pat.search(text): continue
        sec = SEC_WORDS.search(text) or any('security' in l.lower() for l in i['labels'])
        finding(P, 'S-ISSUE-SECURITY' if sec else 'S-ISSUE-OPEN', 'open issue #%s: %s (%s)' % (i['number'], i['title'][:120], i['url']))

def content_rules(P, root):
    hosts = set(); scripts = []
    for f in P['files']:
        p = os.path.join(root, f['path'])
        data = open(p, 'rb').read()
        if b'\0' in data:
            finding(P, 'S-FILETYPE', 'is a binary file', f['path']); continue
        try: text = data.decode('utf-8')
        except UnicodeDecodeError:
            finding(P, 'S-FILETYPE', 'is not UTF-8 text', f['path']); continue
        if f['path'].endswith(('.py', '.sh', '.js', '.ts', '.tsx')): scripts.append(f['path'])
        for rx, what in ((DL_RUN, 'downloads and runs code'), (B64_RUN, 'decodes and runs hidden code'), (CRED, 'reads credential files')):
            m = rx.search(text)
            if m: finding(P, 'S-PATTERN', '%s: "%s"' % (what, m.group(0)[:80].replace('\n', ' ')), f['path'])
        m = HIDDEN.search(text)
        if m: finding(P, 'S-UNICODE', 'holds invisible or direction-changing characters (U+%04X), which can hide instructions' % ord(m.group(0)), f['path'])
        m = INJ.search(text)
        if m: finding(P, 'S-UNICODE', 'tells the agent to "%s"' % m.group(0)[:80], f['path'])
        for h in re.findall(r'https?://([A-Za-z0-9.-]+)', text):
            h = h.lower().rstrip('.')
            if not any(h == d or h.endswith('.' + d) for d in OK_HOSTS): hosts.add(h)
        if f['path'] == 'SKILL.md' and text.startswith('---'):
            fm = text.split('---', 2)[1] if text.count('---') >= 2 else ''
            m = re.search(r'(?m)^allowed-tools:\s*(.+)$', fm)
            if m: finding(P, 'S-TOOLS', 'asks the agent to allow these tools without asking: %s' % m.group(1).strip()[:200], f['path'])
    if hosts: finding(P, 'S-DOMAINS', 'refers to sites outside Hugging Face, GitHub and PyPI: %s' % ', '.join(sorted(hosts)[:12]))
    if scripts: finding(P, 'S-SCRIPTS', '%d script(s) that an agent may run (llmserver never runs them): %s' % (len(scripts), ', '.join(scripts[:8])))
    P['scripts'] = scripts

def skill_plan(name):
    return {'schema': 1, 'kind': 'skill', 'name': name, 'source': None, 'files': [], 'findings': [], 'level': LEVEL,
            'checked_at': now(), 'marketplace_version': None}

def cmd_skill_fetch(name, stage):
    """download a marketplace skill into stage/name and check it"""
    P = skill_plan(name)
    try: m, src, ver = market()
    except Exception as e:
        finding(P, 'S-HUB-OFFLINE', "Hugging Face's skills marketplace could not be reached (%s)" % type(e).__name__)
        decide(P); save(P); emit_skill(P); return
    P['source'] = src; P['marketplace_version'] = ver
    if name not in m:
        finding(P, 'S-NOT-LISTED', '"%s" is not in Hugging Face\'s skills marketplace (%s); only listed skills can be installed' % (name, 'mirror ' + MIRROR if MIRROR else SKILL_BUCKET))
        decide(P); save(P); emit_skill(P); return
    P['description'] = m[name].get('description')
    try: files = skill_files_remote(name, m[name])
    except Exception as e:
        finding(P, 'S-HUB-OFFLINE', 'the files of "%s" could not be listed (%s)' % (name, type(e).__name__))
        decide(P); save(P); emit_skill(P); return
    total = 0; ok = []
    for f in files:
        p = f['path']
        if f.get('link'): finding(P, 'S-LINK', 'is a link', p); continue
        if p.startswith('/') or '..' in p.split('/') or '\\' in p: finding(P, 'S-LINK', 'leaves the skill folder', p); continue
        if not p.lower().endswith(SKILL_EXT): finding(P, 'S-FILETYPE', 'has a file type that skills do not need', p); continue
        if f['size'] > SKILL_FILE_MAX: finding(P, 'S-SIZE', 'is %s; the limit is 1 MB per file' % human(f['size']), p); continue
        total += f['size']; ok.append(f)
    if total > SKILL_MAX: finding(P, 'S-SIZE', 'the skill is %s; the limit is 5 MB' % human(total))
    if not any(f['path'] == 'SKILL.md' for f in ok): finding(P, 'S-NO-SKILLMD', 'the skill has no SKILL.md')
    recent = [f for f in ok if f.get('uploaded_at') and
              (datetime.datetime.now(datetime.timezone.utc) - datetime.datetime.strptime(f['uploaded_at'], '%Y-%m-%dT%H:%M:%SZ').replace(tzinfo=datetime.timezone.utc)).days < 7]
    if recent: finding(P, 'S-RECENT', '%d file(s) changed in the last 7 days (newest %s); new changes have had little review' % (len(recent), max(f['uploaded_at'] for f in recent)))
    issue_rules(P, name)
    if any(f['severity'] == 'block' and f['override'] == 'no' for f in P['findings']):
        decide(P); save(P); emit_skill(P); return
    dest = os.path.join(stage, name)
    os.makedirs(dest, exist_ok=True)
    if MIRROR:
        import shutil
        for f in ok:
            os.makedirs(os.path.dirname(os.path.join(dest, f['path'])) or dest, exist_ok=True)
            shutil.copyfile(f['src'], os.path.join(dest, f['path']), follow_symlinks=False)
    else:
        specs = []
        for f in ok:
            lp = os.path.join(dest, *f['path'].split('/'))
            os.makedirs(os.path.dirname(lp), exist_ok=True); specs.append((f['src'], lp))
        hf_api().download_bucket_files(SKILL_BUCKET, specs)
    for f in ok:
        lp = os.path.join(dest, f['path'])
        if os.path.getsize(lp) != f['size']: finding(P, 'S-SIZE', 'downloaded size differs from the listing', f['path'])
        P['files'].append({'path': f['path'], 'size': os.path.getsize(lp), 'sha256': sha256_file(lp), 'uploaded_at': f.get('uploaded_at')})
    content_rules(P, dest)
    local_scans(P, [os.path.join(dest, f['path']) for f in P['files']], 'S-LOCAL-SCAN',
                [os.path.join(dest, x) for x in P.get('scripts') or []])
    decide(P); save(P); emit_skill(P)

def cmd_skill_local(name, root, source, generator=''):
    """a skill llmserver generated itself: record its files"""
    P = skill_plan(name); P['source'] = source
    if generator: P['generator'] = dict(kv.split('=', 1) for kv in generator.split(',') if '=' in kv)
    for r, _, fs in os.walk(root):
        for n in fs:
            full = os.path.join(r, n); rel = os.path.relpath(full, root)
            P['files'].append({'path': rel, 'size': os.path.getsize(full), 'sha256': sha256_file(full)})
    P['files'].sort(key=lambda f: f['path'])
    decide(P); save(P); emit_skill(P)

