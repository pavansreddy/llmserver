# holds them (the admin can change them in Admin Panel > Settings). So llmserver also writes them
# into the database before a start, but only those whose llmserver setting changed since llmserver
# last wrote them: a change the admin made stays until the llmserver setting changes.
webui_rag_settings() {  # reranker (fast|best|off) -> RAG_KV: "ENV_NAME db.key json-value"
  local rr=$1 hybrid=false k=6 model="" engine="" url="" search=false
  [[ ${CFG[WEBUI_RAG]} == hybrid ]] && hybrid=true k=20   # hybrid: 20 candidates from each search; the reranker keeps the best 6
  case $rr in fast) model=$RERANK_REPO ;; best) engine=external model=${RERANK_BEST_SPEC#llama:} url=$(gateway_url)/rerank ;; esac
