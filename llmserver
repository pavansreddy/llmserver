webui_hf_model() {  # repo commit what "path sha256"...: fetch a model once, at the pinned commit, checking every file
  local repo=$1 commit=$2 what=$3 d e f sha got n=0 hfe=${HF_ENDPOINT:-https://huggingface.co}
  shift 3
  d=$webui_home/models/models--${repo//\//--}
  for e in "$@"; do
    f=${e% *} sha=${e#* }
    if [[ -f $d/snapshots/$commit/$f ]]; then got=$(sha256sum < "$d/snapshots/$commit/$f"); [[ ${got%% *} == "$sha" ]] && continue; fi
    mkdir -p "$(dirname -- "$d/snapshots/$commit/$f")"
    fetch_verified "${hfe%/}/$repo/resolve/$commit/$f" "$sha" "$d/snapshots/$commit/$f" || die "could not download $f of $repo"
    n=$((n + 1))
  done
  mkdir -p "$d/refs"; printf '%s' "$commit" > "$d/refs/main"
  ((n)) && info "fetched $what ($repo at ${commit:0:12}, $n files, every SHA-256 checked)"
  return 0
