def cmd_hfcli_rewrite(src, dst, version):
    """the pinned hf's own skill, made to call 'llmserver hf' and to install nothing"""
    lines = open(src, encoding='utf-8').read().split('\n'); out = []; skip = False
    hub_ver = ''
    for ln in lines:
        if ln.startswith('### ') or ln.startswith('## '):
            skip = ln.startswith(('### `hf skills`', '### `hf extensions`', '## Mounting'))
            if skip: continue
        if skip: continue
        if ln.startswith('Install:') or ln.startswith('- `hf update`') or 'hf update' in ln: continue
        m = re.match(r'Generated with `huggingface_hub v([^`]+)`', ln)
        if m:
            hub_ver = m.group(1)
            out.append('Generated by llmserver %s from huggingface_hub v%s. Run `llmserver skills update hf-cli` to regenerate.' % (version, hub_ver)); continue
        if ln.startswith('The Hugging Face Hub CLI tool `hf` is available'):
            out.append('The Hugging Face Hub CLI is available as `llmserver hf` (the copy that llmserver pins and installs; plain `hf` is usually not on PATH). '
                       'Do not install another `hf` with curl, pip, uv or brew. The `hf` command replaces the deprecated `huggingface-cli`.')
            out.append('')
            out.append('Skills are installed and updated with `llmserver skills`, which checks them first; `llmserver hf skills add/update` is refused.')
            continue
        ln = ln.replace('`hf ', '`llmserver hf ').replace('`hf`', '`llmserver hf`')
        out.append(ln)
    text = '\n'.join(out)
    left = re.findall(r'`hf |install\.sh|brew install|curl -|pip install', text)
    if left or not hub_ver:
        print('error\tthe rewritten hf-cli skill still contains %s' % (left[:3] or 'no version line')); sys.exit(3)
    open(dst, 'w', encoding='utf-8').write(text)
    print('ok\t%s' % hub_ver)

# ---- wheels by hash (for offline installs) ----------------------------------------------------
def parse_lock(path):
    """-> [(name, version, marker, {sha256...})], [index urls in uv's order]"""
    reqs, idx, extra, cur = [], None, [], None
    for raw in open(path, encoding='utf-8'):
        ln = raw.strip()
        if not ln or ln.startswith('#'): continue
        if ln.startswith('--index-url'): idx = ln.split(None, 1)[1].strip(); continue
        if ln.startswith('--extra-index-url'): extra.append(ln.split(None, 1)[1].strip()); continue
        if ln.startswith('--hash=sha256:'):
            if cur: cur[3].add(ln.split(':', 1)[1].rstrip(' \\').strip())
            continue
        if ln.startswith('--'): continue
        body = ln.rstrip(' \\').strip()
        spec, _, marker = body.partition(';')
        if '==' not in spec: continue
        name, ver = [x.strip() for x in spec.split('==', 1)]
        cur = (name, ver, marker.strip(), set()); reqs.append(cur)
    return reqs, extra + [idx or (os.environ.get('T_PYPI', 'https://pypi.org').rstrip('/') + '/simple')]

def index_files(index, name):
    """-> [(filename, url, sha256)] from a PEP 691 (JSON) or PEP 503 (HTML) simple index"""
    from packaging.utils import canonicalize_name
    url = '%s/%s/' % (index.rstrip('/'), canonicalize_name(name))
    try:
        body, headers = http(url, accept='application/vnd.pypi.simple.v1+json, text/html;q=0.1')
    except urllib.error.HTTPError as e:
        if e.code == 404: return []
        raise
    ctype = headers.get('Content-Type') or ''
    out = []
    if 'json' in ctype:
        for f in json.loads(body).get('files', []):
            out.append((f['filename'], urllib.parse.urljoin(url, f['url']), (f.get('hashes') or {}).get('sha256')))
    else:
        for href, text in re.findall(r'<a\s[^>]*href="([^"]+)"[^>]*>([^<]+)</a>', body.decode('utf-8', 'replace')):
            href = href.replace('&amp;', '&'); u, _, frag = href.partition('#')
            sha = frag[7:] if frag.startswith('sha256=') else None
            out.append((text.strip(), urllib.parse.urljoin(url, u), sha))
    return out

def target_tags(pyver):
    from packaging import tags
    major, minor = (int(x) for x in pyver.split('.')[:2])
    plats = list(tags.platform_tags())
    return set(tags.cpython_tags(python_version=(major, minor), platforms=plats)) | \
        set(tags.compatible_tags(python_version=(major, minor), platforms=plats))

def cmd_wheels(lock, dest, pyver, mode='download'):
    from packaging.markers import Marker
    from packaging.utils import parse_wheel_filename
    reqs, indexes = parse_lock(lock)
    extra_idx = os.environ.get('T_EXTRA_INDEXES', '').split()
    for r in reqs:   # PyTorch's own index for +cuXXX / +rocmX.Y builds
        m = re.search(r'\+(cu\d+|rocm[\d.]+|cpu)$', r[1])
        if m: extra_idx.append('https://download.pytorch.org/whl/' + m.group(1))
    indexes = list(dict.fromkeys(extra_idx + indexes))
    want_tags = target_tags(pyver)
    env = {'python_version': '.'.join(pyver.split('.')[:2]), 'python_full_version': pyver}
    os.makedirs(dest, exist_ok=True); missing = 0; total = 0
    for name, ver, marker, hashes in reqs:
        if marker:
            try:
                if not Marker(marker).evaluate(env): continue
            except Exception: pass
        pick = None
        for ix in indexes:
            try: files = index_files(ix, name)
            except Exception: continue
            wheels, sdists = [], []
            for fn, url, sha in files:
                if not sha or sha not in hashes: continue
                if fn.endswith('.whl'):
                    try: _, _, _, wt = parse_wheel_filename(fn)
                    except Exception: continue
                    if wt & want_tags: wheels.append((fn, url, sha))
                else: sdists.append((fn, url, sha))
            if wheels or sdists: pick = (wheels or sdists)[0]; break
        if not pick:
            print('missing\t%s==%s' % (name, ver)); missing += 1; continue
        fn, url, sha = pick
        path = os.path.join(dest, urllib.parse.unquote(fn))
        if mode == 'resolve': print('wheel\t%s\t%s\t%s' % (fn, sha, url)); continue
        if not (os.path.isfile(path) and sha256_file(path) == sha):
            download(url, path + '.part', sha)
            os.replace(path + '.part', path)
        total += os.path.getsize(path)
        print('wheel\t%s\t%s' % (os.path.basename(path), sha))
    print('summary\t%d\t%d' % (missing, total))
    if missing: sys.exit(3)

def download(url, dest, sha):
    h = hashlib.sha256()
    req = urllib.request.Request(url, headers={'User-Agent': 'llmserver-trust'})
    if TOK and url.startswith(HF): req.add_header('Authorization', 'Bearer ' + TOK)
    if not url.startswith('https://') and not url.startswith(HF): raise ValueError('refusing a non-HTTPS download: ' + url)
    with OPEN.open(req, timeout=60) as r, open(dest, 'wb') as f:
        for c in iter(lambda: r.read(1 << 22), b''): h.update(c); f.write(c)
    if h.hexdigest() != sha:
        os.remove(dest); raise ValueError('checksum mismatch for ' + url)

# ---- bundles (air-gapped transfer) ---------------------------------------------------------
# A bundle is an uncompressed tar: SHA256SUMS (and SHA256SUMS.sig), manifest.json, the model
# records under records/, the content-addressed model files under blobs/sha256/, and with
# --with-engines everything an offline install needs under engines/. SHA256SUMS lists every
# other member; it is what gets signed, and both checks need only sha256sum and ssh-keygen, so
# a machine without llmserver's runtime can verify a bundle before anything is unpacked.
import tarfile, uuid, shutil

def cmd_bundle_write(out, who, version, engines_dir, *recs):
    """recs: record[=ollama-manifest-path]... -> out.d/ with manifest.json, SHA256SUMS and the member list"""
    work = out + '.d'; os.makedirs(work, exist_ok=True)
    members = {}; sums = []
    man = {'schema': 1, 'kind': 'llmserver-bundle', 'id': str(uuid.uuid4()), 'created': now(), 'created_by': who,
           'llmserver': version, 'level': LEVEL, 'arch': os.uname().machine, 'models': [], 'engines': None}
    def add(bpath, src, sha=None):
        sha = sha or sha256_file(src)
        if bpath not in members: members[bpath] = src; sums.append((sha, bpath))
        return sha
    for arg in recs:
        rec, _, manpath = arg.partition('=')
        R = json.load(open(rec))
        entry = {'spec': spec_of(R), 'engine': R['engine'], 'commit': R.get('commit'), 'status': R.get('status'),
                 'record': 'records/model/' + os.path.basename(rec), 'place': []}
        add(entry['record'], rec)
        if R['engine'] == 'ollama':
            if not manpath or not os.path.isfile(manpath):
                print('error\t%s: its Ollama manifest is not readable here' % entry['spec']); sys.exit(3)
            store = manpath.split('/manifests/')[0]
            rel = os.path.relpath(manpath, store)
            sha = add('blobs/sha256/' + sha256_file(manpath), manpath)
            entry['place'].append({'blob': 'blobs/sha256/' + sha, 'rel': rel, 'name': None, 'kind': 'ollama-manifest'})
            for d in R.get('local_digests') or []:
                src = os.path.join(store, 'blobs', 'sha256-' + d)
                got = sha256_file(src)
                if got != d: print('error\t%s: the Ollama layer %s changed; run llmserver trust verify' % (entry['spec'], d[:12])); sys.exit(3)
                add('blobs/sha256/' + d, src, d)
                entry['place'].append({'blob': 'blobs/sha256/' + d, 'rel': None, 'name': 'sha256-' + d, 'kind': 'ollama-blob'})
        else:
            for f in files_of(R):
                link = snap_path(R, f['path']); real = os.path.realpath(link)
                sha = sha256_file(real)
                ok = (sha == f['sha256']) if f.get('sha256') else (not f.get('git_oid') or git_oid(real, os.path.getsize(real)) == f['git_oid'])
                if not ok or os.path.getsize(real) != f['size']:
                    print('error\t%s: %s does not match its check record; run llmserver trust verify' % (entry['spec'], f['path'])); sys.exit(3)
                add('blobs/sha256/' + sha, real, sha)
                entry['place'].append({'blob': 'blobs/sha256/' + sha, 'rel': f['path'], 'name': os.path.basename(real), 'kind': 'hf'})
        man['models'].append(entry)
    if engines_dir and engines_dir != '-':
        man['engines'] = json.load(open(os.path.join(engines_dir, 'engines.json')))
        for root, _, fs in os.walk(engines_dir):
            for n in sorted(fs):
                full = os.path.join(root, n)
                add('engines/' + os.path.relpath(full, engines_dir), full)
    mpath = os.path.join(work, 'manifest.json')
    with open(mpath, 'w') as f: json.dump(man, f, indent=1, sort_keys=True); f.write('\n')
    add('manifest.json', mpath)
    with open(os.path.join(work, 'SHA256SUMS'), 'w') as f:
        for sha, p in sorted(sums, key=lambda x: x[1]): f.write('%s  %s\n' % (sha, p))
    with open(os.path.join(work, 'members.json'), 'w') as f: json.dump(members, f)
    print('id\t%s' % man['id']); print('files\t%d' % len(members))

def cmd_bundle_pack(work, out):
    members = json.load(open(os.path.join(work, 'members.json')))
    tmp = out + '.part'
    def tinfo(t, src, name):
        ti = t.gettarinfo(src, name); ti.uid = ti.gid = 0; ti.uname = ti.gname = ''; ti.mode = 0o644; ti.mtime = int(time.time())
        return ti
    with tarfile.open(tmp, 'w', format=tarfile.PAX_FORMAT) as t:
        for n in ('SHA256SUMS', 'SHA256SUMS.sig'):
            p = os.path.join(work, n)
            if os.path.exists(p):
                with open(p, 'rb') as fh: t.addfile(tinfo(t, p, n), fh)
        for name in sorted(members, key=lambda n: (n != 'manifest.json', n)):
            with open(members[name], 'rb') as fh: t.addfile(tinfo(t, members[name], name), fh)
    os.replace(tmp, out)
    print('bundle\t%s\t%d' % (out, os.path.getsize(out)))

def cmd_bundle_place(dest, ollama_store, who):
    """move the checked model files into the Hugging Face cache or the Ollama store, and write the records"""
    man = json.load(open(os.path.join(dest, 'manifest.json'))); placed = 0
    def put(src, target):
        os.makedirs(os.path.dirname(target), exist_ok=True)
        if os.path.exists(src): shutil.move(src, target + '.llmserver-tmp')
        else: shutil.copyfile(os.path.join(dest, 'blobs', 'sha256', os.path.basename(src)), target + '.llmserver-tmp')
        os.replace(target + '.llmserver-tmp', target)
    used = {}
    for m in man['models']:
        for p in m['place']: used[p['blob']] = used.get(p['blob'], 0) + 1
    def take(blob, target):
        used[blob] -= 1
        src = os.path.join(dest, blob)
        if used[blob] > 0: shutil.copyfile(src, target + '.llmserver-tmp'); os.replace(target + '.llmserver-tmp', target)
        else: put(src, target)
    for m in man['models']:
        R = json.load(open(os.path.join(dest, m['record'])))
        if m['engine'] == 'ollama':
            for p in m['place']:
                if p['kind'] == 'ollama-blob':
                    if not re.fullmatch(r'sha256-[0-9a-f]{64}', p['name'] or ''): continue
                    target = os.path.join(ollama_store, 'blobs', p['name'])
                else:
                    if not p['rel'] or not safe_member(p['rel']) or not p['rel'].startswith('manifests/'): continue
                    target = os.path.join(ollama_store, p['rel'])
                os.makedirs(os.path.dirname(target), exist_ok=True); take(p['blob'], target)
        else:
            repo_dir = hub_repo_dir(R['repo'])
            for p in m['place']:
                if not safe_member(p['rel'] or '..') or not re.fullmatch(r'[0-9a-f]{40,64}', p['name'] or ''): continue
                blob = os.path.join(repo_dir, 'blobs', p['name'])
                os.makedirs(os.path.dirname(blob), exist_ok=True)
                if os.path.isfile(blob): used[p['blob']] -= 1
                else: take(p['blob'], blob)
                link = os.path.join(repo_dir, 'snapshots', R['commit'], p['rel'])
                os.makedirs(os.path.dirname(link), exist_ok=True)
                if os.path.lexists(link): os.remove(link)
                os.symlink(os.path.relpath(blob, os.path.dirname(link)), link)
        R['imported'] = {'bundle': man['id'], 'at': now(), 'by': who, 'created_by': man.get('created_by'), 'status_at_export': R.get('status')}
        R['status'] = 'imported'
        os.makedirs(RECDIR, exist_ok=True)
        save_to(os.path.join(RECDIR, os.path.basename(m['record'])), R)
        print('placed\t%s\t%s' % (m['spec'], R.get('commit'))); placed += 1
    print('summary\t%d' % placed)

def safe_member(name):
    return not (name.startswith('/') or '..' in name.split('/') or '\\' in name)

# ---- software bill of materials -----------------------------------------------------------
def cmd_sbom(lhome, pinsfile, version):
    pins = {'sha': {}}
    for ln in open(pinsfile):
        k, _, v = ln.rstrip('\n').partition('\t')
        if k.startswith('sha:'): pins['sha'][k[4:]] = v
        elif k: pins[k] = v
    comps = []
    def comp(typ, name, ver, purl, hashes=(), props=None, bom_ref=None):
        c = {'type': typ, 'name': name, 'version': ver, 'bom-ref': bom_ref or purl or name}
        if purl: c['purl'] = purl
        if hashes: c['hashes'] = [{'alg': 'SHA-256', 'content': h} for h in sorted(hashes)]
        if props: c['properties'] = [{'name': 'llmserver:' + k, 'value': str(v)} for k, v in sorted(props.items()) if v]
        comps.append(c)
    uvf = [k for k in pins['sha'] if k.startswith('uv-')]
    comp('application', 'uv', pins['uv'], 'pkg:github/astral-sh/uv@%s' % pins['uv'], [pins['sha'][k] for k in uvf], {'archives': ' '.join(uvf)})
    for root, kind in (('runtime/helper', 'helper'), ('engines/llama.cpp', 'llama'), ('engines/ollama', 'ollama'), ('engines/vllm', 'vllm')):
        cur = os.path.join(lhome, root, 'current', '.llmserver-component')
        if not os.path.isfile(cur): continue
        meta = dict(l.rstrip('\n').split('=', 1) for l in open(cur) if '=' in l)
        props = {'variant': meta.get('VARIANT'), 'installed': meta.get('INSTALLED'), 'main_sha256': meta.get('MAIN_SHA'), 'lock': meta.get('LOCK')}
        if kind == 'llama':
            arch = [k for k in pins['sha'] if k.startswith('llama-%s-' % meta['VERSION']) or k.startswith('cudart-llama-%s-' % meta['VERSION'])]
            comp('application', 'llama.cpp', meta['VERSION'], 'pkg:github/ggml-org/llama.cpp@%s' % meta['VERSION'],
                 [pins['sha'][k] for k in arch if meta.get('VARIANT', '') in k or meta.get('VARIANT') == 'cpu'], props)
        elif kind == 'ollama':
            arch = [k for k in pins['sha'] if k.endswith('@' + meta['VERSION'])]
            comp('application', 'ollama', meta['VERSION'], 'pkg:github/ollama/ollama@%s' % meta['VERSION'], [pins['sha'][k] for k in arch], props)
        elif kind == 'helper':
            comp('application', 'cpython', meta['VERSION'], 'pkg:generic/python.org/cpython@%s' % meta['VERSION'], (), {'use': 'llmserver helper'}, 'cpython-helper')
        elif kind == 'vllm':
            comp('application', 'cpython', meta.get('PYTHON', ''), 'pkg:generic/python.org/cpython@%s' % meta.get('PYTHON', ''), (), {'use': 'vLLM'}, 'cpython-vllm')
    seen = set()
    for lock in sorted(os.listdir(os.path.join(lhome, 'locks'))) if os.path.isdir(os.path.join(lhome, 'locks')) else []:
        if not lock.endswith('.txt'): continue
        for name, ver, marker, hashes in parse_lock(os.path.join(lhome, 'locks', lock))[0]:
            purl = 'pkg:pypi/%s@%s' % (name.lower().replace('_', '-'), urllib.parse.quote(ver, safe='.+-'))
            if purl in seen: continue
            seen.add(purl)
            comp('library', name, ver, purl, hashes, {'lock': lock, 'marker': marker})
    if RECDIR and os.path.isdir(RECDIR):
        for n in sorted(os.listdir(RECDIR)):
            if not n.endswith('.json'): continue
            R = json.load(open(os.path.join(RECDIR, n)))
            sel = set(R.get('selected') or [])
            comp('machine-learning-model', spec_of(R), R.get('commit') or '',
                 'pkg:huggingface/%s@%s' % (R['repo'], R.get('commit')) if R.get('repo') else None,
                 [f['sha256'] for f in R['files'] if f['path'] in sel and f.get('sha256')],
                 {'status': R.get('status'), 'decided_at': R.get('decided_at'), 'level': R.get('level')}, 'model:' + n)
    bom = {'bomFormat': 'CycloneDX', 'specVersion': '1.6', 'serialNumber': 'urn:uuid:' + str(uuid.uuid4()), 'version': 1,
           'metadata': {'timestamp': now(), 'tools': {'components': [{'type': 'application', 'name': 'llmserver', 'version': version}]},
                        'component': {'type': 'application', 'name': 'llmserver', 'version': version, 'bom-ref': 'llmserver'}},
           'components': comps}
    print(json.dumps(bom, indent=1))

