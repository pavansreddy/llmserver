MI_W=0 MI_KVEL=0 MI_LAYERS=0 MI_TCTX=0 MI_HEADS=0 MI_EXPERTS=0 MI_EUSED=0 MI_SRC=none MI_EST=0
pyinfo() {  # helper for GGUF headers, safetensors configs and registry lookups, on llmserver's own Python
