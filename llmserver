def hub_tree(repo, commit):
    url = '%s/api/models/%s/tree/%s?recursive=true&expand=true' % (HF, repo, q(commit))
    out = []
    while url:
        body, headers = http(url)
        out += json.loads(body)
        url = None
        m = re.search(r'<([^>]+)>;\s*rel="next"', headers.get('Link') or '')
        if m: url = m.group(1)
    return out

BAD = {'unsafe', 'malicious', 'infected', 'dangerous'}
PEND = {'queued', 'unscanned', 'pending', 'scanning', 'not_scanned', 'notscanned', ''}
SCANS = ('avScan', 'protectAiScan', 'jFrogScan', 'virusTotalScan', 'pickleImportScan')
def scan_rules(P, f):
    s = f.get('scan')
    path = f['path']
    if not s:
        finding(P, 'M-SCAN-PENDING', 'Hugging Face has no scan result for this file', path); return
    overall = str(s.get('status') or '').lower()
    subs = {k: str((s.get(k) or {}).get('status') or '').lower() for k in SCANS}
    bad = [k for k, v in subs.items() if v in BAD]
    if overall in BAD or bad:
        finding(P, 'M-SCAN-UNSAFE', 'Hugging Face flags this file as %s%s' % (overall or 'unsafe', (' (' + ', '.join(bad) + ')') if bad else ''), path); return
    for imp in (s.get('pickleImportScan') or {}).get('pickleImports') or []:
        safety = str(imp.get('safety') or '').lower()
        if safety == 'innocuous': continue
        name = '%s.%s' % (imp.get('module'), imp.get('name'))
        if safety == 'dangerous': finding(P, 'M-PICKLE-IMPORT', 'the pickle imports %s (%s)' % (name, safety), path)
        else: finding(P, 'M-SCAN-WARN', 'the pickle imports %s (%s)' % (name, safety or 'unknown'), path)
    if overall == 'safe': return
    if overall in PEND: finding(P, 'M-SCAN-PENDING', 'Hugging Face has not scanned this file yet (status %s)' % (overall or 'none'), path)
    else: finding(P, 'M-SCAN-WARN', 'Hugging Face scan status is "%s"' % overall, path)

