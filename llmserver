  local h=${CFG[WEBUI_HOST]} p=${CFG[WEBUI_PORT]} ip
  if [[ $h == 0.0.0.0 || $h == :: ]]; then
    for ip in $(hostname -I 2>/dev/null); do [[ $ip == 127.* || $ip == *:* ]] || { printf 'http://%s:%s\n' "$ip" "$p"; break; }; done
    printf 'http://127.0.0.1:%s\n' "$p"
  else printf 'http://%s\n' "$(hostport "$h" "$p")"; fi
}
webui_accounts() {  # -> "users pending" from its database (read-only), or nothing
  local py db=$webui_home/data/webui.db
  [[ -r $db ]] && py=$(helper_python) || return 0
  py_env "$py" -I -c 'import sqlite3, sys
c = sqlite3.connect("file:%s?mode=ro" % sys.argv[1], uri=True)
r = c.execute("select count(*), sum(role = \"pending\") from user").fetchone()
print(r[0], r[1] or 0)' "$db" 2>/dev/null || true
}
webui_start() {
  local d h=${CFG[WEBUI_HOST]} p=${CFG[WEBUI_PORT]} envs=() sb=() auth=True u n acc rr=${CFG[WEBUI_RERANKER]} search=off e ev dk jv changed
  if svc_alive webui; then info "Open WebUI is running: $(webui_urls | head -n 1)"; return 0; fi
  if ! webui_installed; then
    if ((!yes)); then
      [[ -t 0 && -t 2 ]] || die "Open WebUI is not installed; '$PROG install webui' installs it (about $((PIN_SIZE[webui] / 1000)) GB)"
      printf '%s: install Open WebUI %s (about %d GB, with CPU PyTorch) into %s? [y/N]: ' "$PROG" "$(pin webui)" "$((PIN_SIZE[webui] / 1000))" "$lhome/tools" >&2
      IFS= read -r REPLY || REPLY=""; [[ ${REPLY,,} == y* ]] || die "Open WebUI was not installed"
    fi
    install_lock; install_webui
  fi
  d=$(webui_dir)
  mkdir -p "$webui_home"/{data,home,models}; chmod 700 "$webui_home"
  webui_models
  port_in_use "$p" && die "port $p is in use; choose another: '$PROG config set webui_port N'"
  gateway_start 1
  RB_STARTED=0
  [[ $rr == best ]] && { rerank_best_start || rr=fast; }
  if [[ ${CFG[WEBUI_SEARCH]} == on ]]; then searxng_start && search=on; fi
  local save=${CFG[WEBUI_SEARCH]}; CFG[WEBUI_SEARCH]=$search
  webui_rag_settings "$rr"; CFG[WEBUI_SEARCH]=$save
  changed=$(webui_apply) || changed=""
  [[ -n $changed ]] && info "updated in Open WebUI's settings (from llmserver's): $changed"
  [[ ${CFG[WEBUI_AUTH]} == off ]] && auth=False
  envs=("PATH=$d/bin:/usr/bin:/bin" "HOME=$webui_home/home" "LANG=C.UTF-8" "PYTHONNOUSERSITE=1"
    "DATA_DIR=$webui_home/data" "STATIC_DIR=$webui_home/data/static" "WEBUI_SECRET_KEY=$(webui_secret)" "WEBUI_AUTH=$auth" "DEFAULT_USER_ROLE=pending"
    "OPENAI_API_BASE_URL=$(gateway_url)" "OPENAI_API_KEY=none" "ENABLE_OPENAI_API=True" "ENABLE_OLLAMA_API=False"
    "OFFLINE_MODE=true" "HF_HUB_OFFLINE=1" "SENTENCE_TRANSFORMERS_HOME=$webui_home/models"
    "RAG_EMBEDDING_MODEL_AUTO_UPDATE=False" "RAG_RERANKING_MODEL_AUTO_UPDATE=False"
    "RAG_EMBEDDING_MODEL_TRUST_REMOTE_CODE=False" "RAG_RERANKING_MODEL_TRUST_REMOTE_CODE=False"
    "ENABLE_LOCAL_WEB_FETCH=False" "FORWARDED_ALLOW_IPS=127.0.0.1"
    "ENABLE_COMMUNITY_SHARING=False" "ENABLE_VERSION_UPDATE_CHECK=False" "ANONYMIZED_TELEMETRY=False" "DO_NOT_TRACK=true" "SCARF_NO_ANALYTICS=true")
  for e in "${RAG_KV[@]}"; do read -r ev dk jv <<<"$e"; jv=${jv#\"}; envs+=("$ev=${jv%\"}"); done   # for its first start
  mapfile -t -O "${#envs[@]}" envs < <(proxy_env)   # web pages for web search; never this computer through a proxy
  if [[ ${CFG[SANDBOX]} != off ]] && sandbox_works; then
    sb=(bwrap --unshare-ipc --unshare-uts --unshare-cgroup-try --ro-bind / / --dev /dev --proc /proc --tmpfs /tmp --tmpfs /var/tmp
      --tmpfs "$HOME" --tmpfs "$lhome" --ro-bind "$d" "$d" --ro-bind-try "$lhome/python" "$lhome/python"
      --ro-bind "$webui_home/models" "$webui_home/models" --bind "$webui_home/data" "$webui_home/data" --bind "$webui_home/home" "$webui_home/home")
    mapfile -t -O "${#sb[@]}" sb < <(ca_binds); sb+=(--)
  elif [[ ${CFG[SANDBOX]} == on ]]; then die "LLMSERVER_SANDBOX=on, but bubblewrap does not work here"; fi
  info "starting Open WebUI $(pin webui) on $(hostport "$h" "$p")$( ((${#sb[@]})) && echo ', in the sandbox')"
  svc_launch webui "$logs_dir/webui.log" "${envs[@]}" -- "${sb[@]}" "$d/bin/open-webui" serve --host "$h" --port "$p"
  local rc=0; svc_wait "Open WebUI" "http://$(hostport "$(connect_host "$h")" "$p")/health" "${CFG[READY_TIMEOUT]}" || rc=$?
  case $rc in
    1) die "Open WebUI stopped while starting; see $logs_dir/webui.log" ;;
    2) stop_pid "$SVC_PID" 1 || true; die "Open WebUI did not start within ${CFG[READY_TIMEOUT]}s; see $logs_dir/webui.log" ;;
  esac
  rec_write "$(svc_file webui)" "ENGINE=service" "PID=$SVC_PID" "STARTTIME=$(pid_starttime "$SVC_PID")" "HOST=$h" "PORT=$p" "LOG=$logs_dir/webui.log" "STARTED=$(date +%s)" "VERSION=$(pin webui)" \
    "RAG=${CFG[WEBUI_RAG]}" "RERANKER=$rr" "SEARCH=$search" "RERANK_STARTED=$RB_STARTED"
  info "${C_B}Open WebUI ready${C_0}: $(webui_urls | head -n 1)$( [[ $h == 0.0.0.0 ]] && echo " (people on your network use this address; here also $(webui_urls | tail -n 1))")"
  read -r n acc <<<"$(webui_accounts)"
  if [[ $auth == True && ${n:-0} == 0 ]]; then info "  open it and create the first account: it becomes the admin. Then add people in Admin Panel > Users, or turn on new sign-ups there (they wait for the admin's approval)"; fi
  info "  it chats with every running model through the gateway ($(gateway_url)); start models with '$PROG MODEL'"
  info "  documents: $(webui_rag_line "${CFG[WEBUI_RAG]}" "$rr"); web search: $(webui_search_line "$search")"
}
webui_rag_line() {  # rag reranker -> how documents are searched, in words
  if [[ $1 == vector ]]; then echo "vector search (WEBUI_RAG=vector)"; return 0; fi
  case $2 in
    fast) echo "hybrid (keywords + meaning), reranked by $RERANK_REPO on the CPU" ;;
    best) echo "hybrid (keywords + meaning), reranked by bge-reranker-v2-m3 on llama.cpp" ;;
    *) echo "hybrid (keywords + meaning), without a reranker" ;;
  esac
}
webui_search_line() { if [[ $1 == on ]]; then echo "on, through SearXNG on 127.0.0.1:${CFG[WEBUI_SEARCH_PORT]} (each chat turns it on with its Web Search button)"; else echo "off ('$PROG config set webui_search on' turns it on)"; fi; }
webui_stop() {
  local rs=0
  if svc_alive webui; then [[ ${ST[RERANK_STARTED]:-0} == 1 ]] && rs=1; fi
  svc_stop webui "Open WebUI"
  svc_alive searxng && svc_stop searxng SearXNG
  if ((rs)) && rerank_best_running; then "$0" stop "${ST[PORT]}" || warn "the reranker did not stop; '$PROG ps' shows it"; fi
  svc_stop gateway
}
cmd_webui() {
  local n acc
  case $sub in
    start) webui_start ;;
    stop) webui_stop ;;
    restart) webui_stop; webui_start ;;
    status)
      if ! webui_installed; then echo "Open WebUI: not installed ('$PROG install webui')"; return 0; fi
      if svc_alive webui; then
        echo "Open WebUI $(pin webui): running at $(webui_urls | head -n 1), pid ${ST[PID]}"
        local rag=${ST[RAG]:-hybrid} rr=${ST[RERANKER]:-fast} se=${ST[SEARCH]:-off}
        echo "  documents: $(webui_rag_line "$rag" "$rr")"
        if [[ $rr == best && $rag == hybrid ]] && ! rerank_best_running; then echo "  the reranker is not running, so questions about documents fail: '$PROG webui restart'"; fi
        echo "  web search: $(webui_search_line "$se")"
        if [[ $se == on ]] && ! svc_alive searxng; then echo "  SearXNG is not running, so web search fails: '$PROG webui restart'"; fi
        if [[ $rag != "${CFG[WEBUI_RAG]}" || ($rr != "${CFG[WEBUI_RERANKER]}" && ${CFG[WEBUI_RERANKER]} != best) || $se != "${CFG[WEBUI_SEARCH]}" ]]; then
          echo "  the settings changed since it started; '$PROG webui restart' applies them"
        fi
      else echo "Open WebUI $(pin webui): installed, not running ('$PROG webui start')"
        echo "  documents: $(webui_rag_line "${CFG[WEBUI_RAG]}" "${CFG[WEBUI_RERANKER]}"); web search: $(webui_search_line "${CFG[WEBUI_SEARCH]}")"
      fi
      read -r n acc <<<"$(webui_accounts)"
      [[ -n $n ]] && echo "  accounts: $n$( ((acc > 0)) && echo ", $acc waiting for approval (Admin Panel > Users)")"
      echo "  data: $webui_home/data (accounts, chats, uploads); log: $logs_dir/webui.log"
      cmd_gateway_status_line ;;
  esac
  return 0
}
cmd_gateway_status_line() { if svc_alive gateway; then echo "  gateway: $(gateway_url), pid ${ST[PID]}"; else echo "  gateway: not running"; fi; }
# ---- the API key: 'llmserver key show|new' -------------------------------------------
cmd_key() {
  local f n=0 old
  case $sub in
    show)
      if [[ -s $key_file ]]; then old=$(<"$key_file"); echo "API key: ${old:0:17}…(hidden) in $key_file"; echo "'$PROG env MODEL' prints it as OPENAI_API_KEY for a client."
      else echo "no API key yet: one is made when a model is bound to the network (LLMSERVER_AUTH=auto), or always with LLMSERVER_AUTH=key; '$PROG key new' makes one now"; fi ;;
    new)
      if [[ -s $key_file ]] && ((!yes)); then
        [[ -t 0 && -t 2 ]] || die "this replaces the API key, and clients with the old key stop working; add --yes to do it without a question"
        printf 'Replace the API key? Clients that use the old key stop working. [y/N]: ' >&2
        IFS= read -r REPLY || REPLY=""; [[ ${REPLY,,} == y* ]] || { info "the key was not changed"; return 0; }
      fi
      [[ -s $key_file ]] && mv -f -- "$key_file" "$key_file.old"
      ensure_key; rm -f -- "$key_file.old"
      running_scan
      for f in "${R_FILES[@]}"; do
        load_rec "$f" || continue
        [[ ${ST[ENGINE]} != ollama ]] || continue
        ((n++)) || info "these models still use the old key until they restart:"
        info "  ${ST[SPEC]} (port ${ST[PORT]}): '$PROG ${ST[SPEC]} --restart'"
      done
      info "clients get the new key with '$PROG env MODEL'" ;;
  esac
  return 0
}

# ---- start models at login or boot: 'llmserver autostart list|on|off' ---------------
as_dir() { printf '%s\n' "${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"; }
as_unit() {  # spec -> the instance name of llmserver@.service
  if have systemd-escape; then printf 'llmserver@%s.service\n' "$(systemd-escape -- "$1")"
  else printf 'llmserver@%s.service\n' "$(printf '%s' "$1" | sed -e 's/\\/\\x5c/g' -e 's/-/\\x2d/g' -e 's#/#-#g' -e 's/:/\\x3a/g' -e 's/@/\\x40/g')"; fi
}
as_template() {  # write llmserver@.service (it starts the model given as the instance name)
  local self d; self=$(readlink -f -- "$0"); d=$(as_dir)
  mkdir -p "$d"
  cat > "$d/llmserver@.service.tmp.$$" <<UNIT
# made by '$PROG autostart'; '$PROG autostart off' and '$PROG uninstall' remove it
[Unit]
Description=llmserver model %I
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
$( [[ ${LLMSERVER_HOME-} ]] && printf 'Environment=LLMSERVER_HOME=%s\n' "$lhome" )ExecStart=$self %I --foreground --evict
ExecStop=$self stop %I
Restart=on-failure
RestartSec=10
TimeoutStartSec=$(( CFG[READY_TIMEOUT] + 60 ))

[Install]
WantedBy=default.target
UNIT
  mv -f -- "$d/llmserver@.service.tmp.$$" "$d/llmserver@.service"
}
as_webui() {  # on|off: Open WebUI (and its gateway) at login, as a systemd user service
  local d f self; d=$(as_dir); f=$d/llmserver-webui.service; self=$(readlink -f -- "$0")
  if [[ $1 == on ]]; then
    webui_installed || die "Open WebUI is not installed; '$PROG install webui' first"
    mkdir -p "$d"
    cat > "$f.tmp.$$" <<UNIT
# made by '$PROG autostart on webui'; '$PROG autostart off webui' and '$PROG uninstall' remove it
[Unit]
Description=llmserver: Open WebUI and the gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
$( [[ ${LLMSERVER_HOME-} ]] && printf 'Environment=LLMSERVER_HOME=%s\n' "$lhome" )ExecStart=$self webui start
ExecStop=$self webui stop
TimeoutStartSec=$(( CFG[READY_TIMEOUT] + 60 ))

[Install]
WantedBy=default.target
UNIT
    mv -f -- "$f.tmp.$$" "$f"
    systemctl --user daemon-reload >/dev/null 2>&1 || true
    systemctl --user enable llmserver-webui.service >/dev/null 2>&1 || die "systemctl could not enable llmserver-webui.service"
    info "Open WebUI starts automatically when you log in (llmserver-webui.service); at boot without a login: 'loginctl enable-linger ${USER:-$(id -un)}'"
  else
    systemctl --user disable llmserver-webui.service >/dev/null 2>&1 || true
    rm -f -- "$f" "$d/default.target.wants/llmserver-webui.service"; systemctl --user daemon-reload >/dev/null 2>&1 || true
    info "Open WebUI no longer starts automatically (it keeps running until '$PROG webui stop')"
  fi
  log_write info "autostart $1: webui"
}
cmd_autostart() {
  local w u units=() d
  d=$(as_dir)
  have systemctl || die "autostart needs systemd user services (systemctl), which this system does not have"
  case $sub in
    list)
      mapfile -t units < <(u_unit_instances)
      [[ -f $d/llmserver-webui.service ]] && echo "Open WebUI starts automatically ('$PROG autostart off webui' stops that)"
      ((${#units[@]})) || { info "no model starts automatically; '$PROG autostart on MODEL' adds one"; return 0; }
      echo "Models that start automatically:"
      for u in "${units[@]}"; do
        w=${u#llmserver@}; w=${w%.service}; have systemd-escape && w=$(systemd-escape --unescape -- "$w")
        printf '  %-50s %s\n' "$w" "$(systemctl --user is-active "$u" 2>/dev/null || true)"
      done ;;
    on|off)
      ((${#config_args[@]})) || die "say which model: '$PROG autostart $sub MODEL...' (a menu number or a name)"
      for w in "${config_args[@]}"; do
        if [[ $w == webui ]]; then as_webui "$sub"; continue; fi
        if [[ $w =~ ^[0-9]+$ ]]; then ((10#$w >= 1 && 10#$w <= ${#specs[@]})) || die "no menu entry $w"; w=${specs[10#$w - 1]}
        else parse_spec "$w" || die "$R_ERR"; w=$R_SPEC; fi
        u=$(as_unit "$w")
        if [[ $sub == on ]]; then
          as_template
          systemctl --user daemon-reload >/dev/null 2>&1 || true
          systemctl --user enable "$u" >/dev/null 2>&1 || die "systemctl could not enable $u (see 'systemctl --user status $u')"
          info "$w starts automatically when you log in ($u)"
          info "  to start it now: 'systemctl --user start $u'; to start it at boot without a login: 'loginctl enable-linger ${USER:-$(id -un)}'"
        else
          systemctl --user disable --now "$u" >/dev/null 2>&1 || true
          rm -f -- "$d/default.target.wants/$u"
          info "$w no longer starts automatically"
        fi
        log_write info "autostart $sub: $w"
      done
      if [[ $sub == off && -z $(u_unit_instances) ]]; then rm -f -- "$d/llmserver@.service"; systemctl --user daemon-reload >/dev/null 2>&1 || true; fi ;;
  esac
  return 0
}

# ---- settings: 'llmserver config list|get|set|unset|edit' ---------------------------
cfg_key() {  # a name -> CK (the full variable name) and CK_KIND (llmserver|engine); dies with help when unknown
  local k=${1^^} short
  k=${k//-/_}
  short=${k#LLMSERVER_}
  if [[ -v CFG[$short] || " ${PATH_KEYS[*]} " == *" $short "* ]]; then CK=LLMSERVER_$short CK_KIND=llmserver
  elif [[ $k == LLMSERVER_* || $1 != *[A-Z]* ]]; then   # engine variables are written in capitals
    local c best="" d bd=99
    for c in "${CFG_ORDER[@]}" "${PATH_KEYS[@]}"; do
      d=$(lev "$short" "$c"); [[ $c == *"$short"* || $short == *"$c"* ]] && d=1
      ((d < bd)) && { bd=$d best=$c; }
    done
    ((bd <= 3)) || best=""
    die "LLMSERVER_$short is not a setting${best:+ (did you mean LLMSERVER_$best?)}; '$PROG config list' shows them. An engine variable is written in capitals, for example HF_TOKEN"
  elif [[ $k =~ ^[A-Z_][A-Z0-9_]*$ ]]; then CK=$k CK_KIND=engine
  else die "'$1' is not a setting name; '$PROG config list' shows them"; fi
  [[ $CK == LLMSERVER_HOME ]] && die "LLMSERVER_HOME cannot be set in $env_file, which is inside it; set it in your environment (export LLMSERVER_HOME=...) or in $sys_env_file"
  [[ $CK == LLMSERVER_SECURITY_FLOOR || $CK == LLMSERVER_SYS_ENV_FILE ]] && die "$CK is for administrators, in $sys_env_file"
  return 0
}
cfg_secret() { [[ $1 =~ (TOKEN|KEY|SECRET|PASSWORD) ]]; }
cfg_show() {  # name value -> masked when it is a secret
  if cfg_secret "$1" && [[ -n $2 ]]; then printf '%s…(hidden)' "${2:0:4}"; else printf '%s' "$2"; fi
}
cfg_from() {  # full name -> where its value comes from
  if [[ -v $1 && ! -v ENVF_EXPORTED[$1] ]]; then echo "environment"
  elif [[ -v ENVF[$1] ]]; then local f=${ENVF_SRC[$1]%:*}; [[ $f == "$env_file" ]] && echo "llmserver.env" || echo "$f"
  else echo "default"; fi
}
cfg_value() {  # full name -> the value in effect
  local short=${1#LLMSERVER_}
  if [[ $1 == LLMSERVER_* && -v CFG[$short] ]]; then printf '%s' "${CFG[$short]}"; else setting "$1" ""; fi
}
cfg_check() {  # name value: would the settings be valid with this value? (llmserver itself checks, with the value in its environment)
  env "$1=$2" "$0" config list >/dev/null 2>&1 && return 0
  env "$1=$2" "$0" config list 2>&1 >/dev/null | sed -n 's/^.*error: //p' | head -n 1
  return 1
}
cfg_write() {  # name value|"" unset(0|1): change the settings file in place, keeping comments and other lines
  local name=$1 val=$2 un=$3 tmp=$env_file.tmp.$$ line done=0
  mkdir -p "${env_file%/*}"
  [[ -e $env_file ]] || (umask 077; printf '# llmserver settings (KEY=VALUE, parsed, never executed). '"'"'%s config'"'"' changes them.\n' "$PROG" > "$env_file")
  (umask 077; : > "$tmp")
  while IFS= read -r line || [[ -n $line ]]; do
    if [[ $line =~ ^[[:space:]]*(export[[:space:]]+)?${name}[[:space:]]*= ]]; then
      ((un || done)) && continue
      printf '%s=%s\n' "$name" "$(env_val "$val")" >> "$tmp"; done=1
    else printf '%s\n' "$line" >> "$tmp"; fi
  done < "$env_file"
  ((un || done)) || printf '%s=%s\n' "$name" "$(env_val "$val")" >> "$tmp"
  chmod 600 "$tmp"; mv -f -- "$tmp" "$env_file"
}
cmd_config() {  # list | get NAME | set NAME VALUE | unset NAME | edit [tuning]
  local a=${config_args[0]-} b=${config_args[1]-} k v err items=() n
  case $sub in
    list)
      if ((json)); then
        for k in "${CFG_ORDER[@]}"; do items+=("$(jo name "$(js "LLMSERVER_$k")" value "$(js "$(cfg_show "$k" "${CFG[$k]}")")" from "$(js "$(cfg_from "LLMSERVER_$k")")")"); done
        for k in "${!ENVF[@]}"; do [[ $k == LLMSERVER_* && -v CFG[${k#LLMSERVER_}] ]] && continue
          items+=("$(jo name "$(js "$k")" value "$(js "$(cfg_show "$k" "$(setting "$k" "")")")" from "$(js "$(cfg_from "$k")")")"); done
        jo settings_file "$(js "$env_file")" settings "$(ja "${items[@]}")"; echo; return 0
      fi
      echo "Settings in effect (environment > $env_file > $sys_env_file > default):"
      for k in "${CFG_ORDER[@]}"; do
        printf '  %-28s %-24s %s\n' "LLMSERVER_$k" "$(cfg_show "$k" "${CFG[$k]}")" "$(n=$(cfg_from "LLMSERVER_$k"); [[ $n == default ]] && echo "" || echo "($n)")"
      done
      n=0
      for k in $(printf '%s\n' "${!ENVF[@]}" | sort); do
        [[ $k == LLMSERVER_* && -v CFG[${k#LLMSERVER_}] ]] && continue
        ((n++)) || echo "Other variables (paths, mirrors, and engine variables passed to every engine):"
        printf '  %-28s %-24s (%s)\n' "$k" "$(cfg_show "$k" "$(setting "$k" "")")" "$(cfg_from "$k")"
      done
      echo "Change one with '$PROG config set NAME VALUE'; '$PROG config edit' opens the file." ;;
    get)
      [[ -n $a ]] || die "say which setting: '$PROG config get NAME'"
      cfg_key "$a"; v=$(cfg_value "$CK"); printf '%s\n' "$v" ;;
    set)
      [[ -n $a && ${#config_args[@]} -ge 2 ]] || die "say what to set: '$PROG config set NAME VALUE' (for example: $PROG config set port 9000)"
      v="${config_args[*]:1}"
      cfg_key "$a"
      if [[ $CK_KIND == llmserver ]]; then
        err=$(cfg_check "$CK" "$v") || die "not saved: $err"
      fi
      cfg_write "$CK" "$v" 0
      info "set $CK=$(cfg_show "$CK" "$v") in $env_file"
      [[ $CK_KIND == engine ]] && info "  $CK is passed to llmserver and every engine it starts"
      [[ -v $CK ]] && warn "$CK is also set in your environment, which takes precedence over the file"
      if [[ $CK == LLMSERVER_WEBUI_* || $CK == LLMSERVER_GATEWAY_* ]] && svc_alive webui; then info "  Open WebUI is running: '$PROG webui restart' applies the change"; fi
      return 0 ;;
    unset)
      [[ -n $a ]] || die "say which setting: '$PROG config unset NAME'"
      cfg_key "$a"
      grep -qE "^[[:space:]]*(export[[:space:]]+)?${CK}[[:space:]]*=" "$env_file" 2>/dev/null || { info "$CK is not in $env_file"; return 0; }
      if [[ $CK_KIND == llmserver ]]; then
        [[ -v DEFAULT_CFG[${CK#LLMSERVER_}] ]] && { err=$(cfg_check "$CK" "${DEFAULT_CFG[${CK#LLMSERVER_}]}") || die "not changed: $err"; }
      fi
      cfg_write "$CK" "" 1
      info "removed $CK from $env_file$([[ $CK == LLMSERVER_* && -v DEFAULT_CFG[${CK#LLMSERVER_}] ]] && echo "; the default applies: '${DEFAULT_CFG[${CK#LLMSERVER_}]}'")" ;;
    edit)
      if [[ $a == tuning ]]; then write_tuning_template 2>/dev/null || true; model_editor "$tuning_file"; info "saved; the rules apply to the next start"; return 0; fi
      [[ -z $a || $a == settings ]] || die "'$PROG config edit' opens the settings; '$PROG config edit tuning' the tuning rules; '$PROG model edit' the menu"
      [[ -e $env_file ]] || write_env_file
      model_editor "$env_file"
      err=$("$0" config list 2>&1 >/dev/null) || { printf '%s\n' "$err" >&2; die "the settings have a problem (above); run '$PROG config edit' again to correct it"; }
      [[ -n $err ]] && printf '%s\n' "$err" >&2
      info "saved $env_file; the settings are valid" ;;
  esac
  return 0
}

# ---- main --------------------------------------------------------------------
load_config
if [[ $cmd == config ]]; then
  if [[ $sub == list ]]; then validate_config   # 'list' also reports a problem; set/unset/edit work on a broken file to correct it
  else [[ -n $MIGRATE_BLOCKED ]] || lhome_init; MUTATING=1; fi
  cmd_config; exit 0
fi
log_start
pins_load
detect_tools
if [[ $cmd == setup ]]; then run_setup; exit 0; fi
if [[ $cmd == uninstall ]]; then run_uninstall; exit 0; fi
if [[ $cmd == log ]]; then cmd_log; exit 0; fi
if ((!have_config)) && [[ $cmd == serve && -t 0 && -t 2 && $dry == 0 ]]; then
  info "no settings yet; starting setup"
  run_setup; load_config
elif ((!have_config)) && [[ ! $cmd =~ ^(ps|env|install|upgrade|rollback|versions|doctor|hf|skills|import|export)$ ]]; then
  info "no settings file at $env_file; using built-in defaults (run '$PROG setup' to choose)"
fi
[[ -n $opt_host ]] && CFG[HOST]=$opt_host
[[ -n $opt_ctx ]] && CFG[CTX]=$opt_ctx
validate_config
HOST=${CFG[HOST]} PORT=${CFG[PORT]} CTX=${CFG[CTX]}
case $cmd in
  install) if [[ -n $opt_from ]]; then install_from "$opt_from" "${positional[@]}"; else cmd_install "${positional[@]}"; fi; exit 0 ;;
  upgrade) cmd_upgrade "$sel"; exit 0 ;;
  rollback) cmd_rollback "$sel"; exit 0 ;;
  versions) if ((opt_sbom)); then cmd_sbom; else cmd_versions; fi; exit 0 ;;
  import) cmd_import; exit 0 ;;
  hf) cmd_hf; exit 0 ;;
  skills) cmd_skills "$sub" "${skill_names[@]}"; exit 0 ;;
esac
if [[ -n $opt_engine && ! $opt_engine =~ ^(llama|vllm|ollama)$ ]]; then die "unknown engine '$opt_engine' (llama, vllm or ollama)"; fi

load_models
case $cmd in   # commands that size models need llmserver's Python runtime
  check|list|capacity|serve|download|bench|trust|models|export|chat) runtime_ready || true; detect_tools ;;
esac
case $cmd in
  ps) if ((json)); then cmd_ps json; else cmd_ps; fi; exit ;;
  stop) cmd_stop; exit 0 ;;
  env) cmd_env; exit 0 ;;
  logs) cmd_logs; exit 0 ;;
  pin|unpin) cmd_pin "$cmd"; exit 0 ;;
  capacity) cmd_capacity; exit 0 ;;
  doctor) if cmd_doctor; then exit 0; else exit 1; fi ;;
  trust) cmd_trust; exit 0 ;;
  export) cmd_export; exit 0 ;;
  eval) cmd_eval; exit 0 ;;
  chat) cmd_chat; exit $? ;;
  models) cmd_models; exit 0 ;;
  model) cmd_model; exit 0 ;;
  key) MUTATING=1; cmd_key; exit 0 ;;
  gateway) MUTATING=1; cmd_gateway; exit 0 ;;
  webui) MUTATING=1; cmd_webui; exit 0 ;;
  autostart) MUTATING=1; cmd_autostart; exit 0 ;;
esac
if [[ -r $last_file ]]; then
  IFS= read -r last < "$last_file" || last=""
  for i in "${!specs[@]}"; do if [[ ${specs[i]} == "$last" ]]; then default=$((i + 1)); fi; done
fi
if [[ $cmd == check ]]; then cmd_check; exit 0; fi
if [[ $cmd == bench ]]; then cmd_bench; exit 0; fi
if [[ $cmd == list ]]; then
  if ((json)); then
    survey_models
    items=()
    for i in "${!specs[@]}"; do
      items+=("$(jo entry "$((i + 1))" spec "$(js "${specs[i]}")" engine "$(js "${specs[i]%%:*}")" extra "$(js "${extras[i]}")" \
        cache "$(js "${STATE[$i]}")" size_mib "$(jn "${WSIZE[$i]:-}")" verdict "$(js "${FIT[$i],,}")" default "$(jb $((i + 1 == default)))")")
    done
    jo version "$(js "$VERSION")" menu_file "$(js "$models_file")" context "$(js "${CFG[CTX]}")" entries "$(ja "${items[@]}")"; echo
    exit 0
  fi
  ((${#specs[@]})) || die "the menu is empty. Add a model with '$PROG model add [engine:]owner/model', start one by name, or run '$PROG setup'"
  survey_models
  echo "$PROG models (Enter = $default). Change them with '$PROG model add|rm|edit' ($models_file)"
  print_menu 1
  exit 0
fi

# ---- pick --------------------------------------------------------------------
if [[ -n $sel ]]; then
  [[ $sel == *[:/]* || $sel =~ ^[0-9]+$ || " ${specs[*]} " == *" ollama:$sel "* || -n $opt_engine ]] || cmd_typo "$sel"
  choose "$sel" || die "$R_ERR"
elif ((${#specs[@]} == 0)); then
  die "no model given and the menu is empty. Pass one, for example '$PROG llama:ORG/REPO-GGUF:QUANT', or run '$PROG setup'"
else
  survey_models
  echo "$PROG: pick a model (Enter = $default, q = quit, or type any [engine:]model; '$PROG model rm' removes entries)" >&2
  print_menu 2
  while :; do
    printf 'Model [%s]: ' "$default" >&2
    IFS= read -r reply || { reply=""; echo >&2; }  # EOF (no tty) takes the default
    reply=${reply//[[:space:]]/}
    case $reply in
      "") reply=$default ;;
      q|quit|exit) exit 0 ;;
    esac
    choose "$reply" && break
    echo "$PROG: $R_ERR" >&2
  done
fi
require_engine "$ENGINE"
resolve_draft || die "$R_ERR"
note "request: $SPEC${EXTRA:+ ($EXTRA)}${D_SPEC:+ draft $D_SPEC}"

ATTACHED=0
if [[ $ENGINE == ollama && -n ${CFG[OLLAMA_ATTACH]} ]]; then
  ATTACHED=1 HOST=${CFG[OLLAMA_ATTACH]%:*} PORT=${CFG[OLLAMA_ATTACH]##*:}
  ((${#pass[@]} == 0)) && [[ -z $EXTRA ]] || die "settings after '--' cannot be applied to an attached Ollama daemon; configure the daemon itself"
  if ((!dry)); then
    lcurl -o /dev/null --max-time 3 "http://${CFG[OLLAMA_ATTACH]}/api/version" 2>/dev/null ||
      die "the Ollama daemon at ${CFG[OLLAMA_ATTACH]} (LLMSERVER_OLLAMA_ATTACH) is not answering. Start it, or clear LLMSERVER_OLLAMA_ATTACH to let $PROG run its own"
  fi
fi

# ---- will it run here? -------------------------------------------------------
FIT_FLAGS=()
case $ENGINE in
  llama) read -ra FIT_FLAGS <<<"${CFG[LLAMA_FLAGS]} $EXTRA" ;;
  vllm) read -ra FIT_FLAGS <<<"${CFG[VLLM_FLAGS]} $EXTRA" ;;
  ollama) read -ra FIT_FLAGS <<<"$EXTRA" ;;
esac
FIT_FLAGS+=("${pass[@]}")
draft_info
model_info "$ENGINE" "$MODEL"
want_ctx=$CTX
CTX=$(ctx_for "$CTX")
[[ $CTX != "$want_ctx" ]] && info "context: $CTX tokens, the most this model supports (LLMSERVER_CTX is $want_ctx)"
if [[ $cmd == download ]]; then
  advise "$ENGINE" "$MODEL" total "$CTX" || warn "downloading anyway, as asked"
  [[ -n $D_MODEL ]] && trust_gate "$D_ENGINE" "$D_MODEL" download
  trust_gate "$ENGINE" "$MODEL" download "$(user_wants_rc && echo 1 || echo 0)"
  exit 0
fi
have curl || die "curl is required for health checks"
running_scan
RESTART_FILE=""
if f=$(rec_find "$SPEC"); then
  load_rec "$f"
  if ((!restart)); then
    info "$SPEC is already running at $(rec_url) (pid ${ST[PID]:-daemon}). '--restart' starts it again with the current settings"
    exit 0
  fi
  RESTART_FILE=$f
fi
if ((!ATTACHED)); then pick_port "$SPEC" "${opt_port:-$PORT_TOKEN}"; fi

# ---- room on the GPUs ----------------------------------------------------------
plan_start "$ENGINE" "$MODEL" "$CTX"
evict_policy=${CFG[EVICT]}
((opt_evict)) && evict_policy=lru
if ((opt_offload)) && [[ $P_STATE == evict ]]; then
  # keep every running model; take what fits now, partly on the CPU if need be
  P_EVICT=("${P_EVICT[@]:0:P_FORCED}"); P_STATE=offload
fi
if [[ -n $RESTART_FILE ]]; then
  P_EVICT=("$RESTART_FILE" "${P_EVICT[@]}")
fi
optional=$(( ${#P_EVICT[@]} - P_FORCED - (${#RESTART_FILE} > 0 ? 1 : 0) ))
if [[ $P_STATE == no && -n ${R_ERR:-} && $R_ERR == *MAX_MODELS* ]]; then die "$R_ERR; nothing was changed. Unpin one ('$PROG unpin MODEL') or raise LLMSERVER_MAX_MODELS"; fi
if ((${#P_EVICT[@]} > (${#RESTART_FILE} > 0 ? 1 : 0))); then
  why="to make room"
  ((P_FORCED > 0 && optional == 0)) && why="because LLMSERVER_MAX_MODELS=${CFG[MAX_MODELS]}"
  ((P_FORCED > 0 && optional > 0)) && why="because of LLMSERVER_MAX_MODELS=${CFG[MAX_MODELS]} and to make room"
  list=$(evict_lines "${P_EVICT[@]}")
  case $evict_policy in
    lru)
      info "starting $SPEC stops these least recently used models $why:"; printf '%s\n' "$list" >&2
      note "evicting ($( ((opt_evict)) && echo '--evict' || echo 'LLMSERVER_EVICT=lru')): $(tr -s ' \n' ' ' <<<"$list")" ;;
    never)
      printf '%s\n' "$list" >&2
      die "$SPEC needs these models stopped $why, and LLMSERVER_EVICT=never; nothing was changed. Stop them yourself ('$PROG stop MODEL'), or pass --evict" ;;
    ask)
      if ((dry)); then info "starting $SPEC would ask to stop these models $why:"; printf '%s\n' "$list" >&2
      elif [[ -t 0 && -t 2 ]]; then
        echo "$PROG: $SPEC does not fit next to the running models. To start it, these would stop $why (least recently used first):" >&2
        printf '%s\n' "$list" >&2
        alt=""
        if ((optional > 0)) && [[ $ENGINE != vllm ]]; then
          sim_evict "${P_EVICT[@]:0:P_FORCED}"; place "$ENGINE" "$MODEL" "$CTX"
          [[ $F_RATING == offload || $F_RATING == cpu ]] && alt="o"
        fi
        printf 'Stop them and start %s? [y]es, %s[N]o: ' "$SPEC" "${alt:+[o] start it partly on the CPU instead, keeping them; }" >&2
        IFS= read -r reply || reply=""
        case ${reply,,} in
          y|yes) note "user agreed to stop: $(tr -s ' \n' ' ' <<<"$list")" ;;
          o) [[ -n $alt ]] || die "cancelled; nothing was changed"
             P_EVICT=("${P_EVICT[@]:0:P_FORCED}"); note "user chose CPU offload instead of evicting" ;;
          *) die "cancelled; nothing was changed" ;;
        esac
      else
        printf '%s\n' "$list" >&2
        die "$SPEC needs these models stopped $why, and there is no terminal to ask (LLMSERVER_EVICT=ask); nothing was changed. Pass --evict to stop them, --offload to start it partly on the CPU instead, or stop them yourself"
      fi ;;
  esac
fi
sim_evict "${P_EVICT[@]}"
advise "$ENGINE" "$MODEL" place "$CTX" ||
  die "$SPEC will not run well enough on this machine now (VRAM_GUARD=${CFG[VRAM_GUARD]}); nothing was downloaded or stopped. '$PROG capacity' shows what is using the GPUs; --no-vram-guard tries anyway"
PLAN_IDX=("${PLACE_IDX[@]}")

# ---- security check, and download if needed ------------------------------------
# nothing is stopped before this point, so a refusal leaves every running model alone
D_COMMIT="" D_PATH="" REFIT=0
if [[ -n $D_MODEL ]]; then
  trust_gate "$D_ENGINE" "$D_MODEL" serve
  D_COMMIT=$T_COMMIT; [[ -n $T_MAIN ]] && D_PATH=${T_SNAP:+$T_SNAP/}$T_MAIN
  ((T_FETCHED)) && REFIT=1
fi
trust_gate "$ENGINE" "$MODEL" serve "$(user_wants_rc && echo 1 || echo 0)"
((T_FETCHED)) && REFIT=1
if ((${REFIT:-0})); then   # exact figures from the downloaded files
  draft_info; model_info "$ENGINE" "$MODEL"; CTX=$(ctx_for "$want_ctx")
  sim_evict "${P_EVICT[@]}"
  advise "$ENGINE" "$MODEL" place "$CTX" 2 || die "$F_MSG; nothing was stopped"
  PLAN_IDX=("${PLACE_IDX[@]}")
fi

# ---- settings derived from the hardware -------------------------------------
VIS_ENV=() VIS_UNSET=()
prepare_command() {  # from F_* and PLACE_IDX: context, offload, splitting, GPU visibility, flags
  local t devs=() vend="" i ok=1 v=()
  AUTO_FLAGS=() VIS_ENV=() VIS_UNSET=()
  if [[ $want_ctx == fit ]]; then
    if [[ $F_RATING == unknown ]]; then
      if [[ $ENGINE == vllm ]]; then CTX=auto; else CTX=8192; fi
      info "context: $CTX (the model could not be sized, so 'fit' could not be worked out)"
    else
      CTX=$F_CTX
      info "context: $CTX tokens ($(ok_rating "$F_RATING" && echo 'the largest that fits in the free VRAM' || echo 'the model does not fit in the free VRAM, so a modest default'))"
    fi
  fi
  if [[ $ENGINE == llama && $F_RATING == offload && -n $F_NGL && -z $(flag_in -ngl --gpu-layers --n-gpu-layers) ]] && ! llama_help_has --fit; then
    AUTO_FLAGS+=(-ngl "$F_NGL")
    info "offloading $F_NGL of $MI_LAYERS layers to the GPU (-ngl $F_NGL); the rest run on the CPU"
  fi
  if [[ $ENGINE == vllm ]]; then
    if ((F_TP > 1)) && [[ -z $(flag_in -tp --tensor-parallel-size) ]]; then
      AUTO_FLAGS+=(--tensor-parallel-size "$F_TP"); info "splitting the model over $F_TP GPUs (--tensor-parallel-size $F_TP)"
    fi
    if [[ -n $F_UTIL && -z $(flag_in --gpu-memory-utilization) ]]; then
      AUTO_FLAGS+=(--gpu-memory-utilization "$F_UTIL"); info "vLLM takes ${F_UTIL#0.}% of each GPU it uses (--gpu-memory-utilization $F_UTIL), leaving the rest to other models"
    fi
  fi
  # which GPUs this model may use
  if ((${#PLACE_IDX[@]})); then
    for i in "${PLACE_IDX[@]}"; do
      [[ -z $vend || $vend == "${G_VENDOR[i]}" ]] || vend=mixed
      [[ -z $vend ]] && vend=${G_VENDOR[i]}
      if [[ -n ${G_LDEV[i]-} ]]; then devs+=("${G_LDEV[i]}"); else ok=0; fi
      [[ ${G_VIDX[i]:--1} == -1 ]] || v+=("${G_VIDX[i]}")
    done
    if [[ $ENGINE == llama ]] && ((ok)) && llama_help_has --device && [[ -z $(flag_in -dev --device) ]]; then
      AUTO_FLAGS+=(--device "$(IFS=,; echo "${devs[*]}")")
    elif [[ $vend != mixed && ${#v[@]} -eq ${#PLACE_IDX[@]} ]]; then
      # absolute numbers, a subset of any mask llmserver inherited, so the model stays inside it
      case $vend:$ENGINE in
        nvidia:*) VIS_ENV=(CUDA_DEVICE_ORDER=PCI_BUS_ID "CUDA_VISIBLE_DEVICES=$(IFS=,; echo "${v[*]}")") ;;
        amd:*)
          if [[ $ENGINE == ollama || $INH_ROCR != __unset__ || $INH_HIP != __unset__ ]]; then
            VIS_ENV=("ROCR_VISIBLE_DEVICES=$(IFS=,; echo "${v[*]}")"); VIS_UNSET=(HIP_VISIBLE_DEVICES)
          else VIS_ENV=("HIP_VISIBLE_DEVICES=$(IFS=,; echo "${v[*]}")"); fi ;;
      esac
    fi
    t=$(IFS=,; echo "${PLACE_IDX[*]}"); info "GPU placement: GPU ${t//,/, GPU } (${V_DESC})"
  fi
  draft_flags
  if ((!ATTACHED)); then numa_plan "$ENGINE"; [[ -n $NUMA_NOTE ]] && info "memory placement: $NUMA_NOTE"; fi
  if ((!ATTACHED)); then
    tune_rules "$ENGINE"
    AUTO_FLAGS+=("${TUNE_FLAGS[@]}")
    for t in "${TUNE_LOG[@]}"; do info "tuning rule, $t"; done
  fi
  build_command
  S_ENV+=("${VIS_ENV[@]}" "${TUNE_ENV[@]}")
  sandbox_plan "$ENGINE"
  apply_auth
  preflight_flags
}
for v in CUDA_VISIBLE_DEVICES HIP_VISIBLE_DEVICES ROCR_VISIBLE_DEVICES; do
  [[ -v $v ]] && note "$v=${!v} was inherited; models are placed only on the GPUs it allows"
done
prepare_command

if ((dry)); then
  for f in "${P_EVICT[@]}"; do load_rec "$f" && echo "would stop: ${ST[SPEC]} (port ${ST[PORT]})"; done
  if ((ATTACHED)); then echo "would load $MODEL on the Ollama daemon at ${CFG[OLLAMA_ATTACH]}"; exit 0; fi
  echo "would serve on port $PORT: $(hostport "$(client_host "$HOST")" "$PORT")"
  printf '+'
  for kv in "${S_ENV[@]}" "${SECRET_ENV[@]}"; do
    case $kv in *API_KEY=*) printf ' %s' "${kv%%=*}=<redacted>" ;; *) printf ' %q' "$kv" ;; esac
  done
  printf ' %q' "${S_PREFIX[@]}" "${SANDBOX_ARGV[@]}" "${S_ARGV[@]}"; echo
  exit 0
fi

# ---- start -------------------------------------------------------------------
mkdir -p "$state_dir" "$log_dir" "$run_dir"
if have flock; then
  exec 9> "$lock_file"
  if ! flock -n 9; then
    info "$(lock_owner) is starting or stopping a model; waiting for it (up to 10 minutes)"
    flock -w 600 9 || die "gave up waiting for $(lock_owner); nothing was changed"
    # the other run may have changed what is running, and taken the port: plan again
    running_scan
    if [[ -z $RESTART_FILE ]] && f=$(rec_find "$SPEC"); then
      load_rec "$f"; info "$SPEC was started meanwhile by the other $PROG; it is running at $(rec_url)"; exit 0
    fi
    if ((!ATTACHED)); then pick_port "$SPEC" "${opt_port:-$PORT_TOKEN}"; fi
    plan_start "$ENGINE" "$MODEL" "$CTX"
    [[ -n $RESTART_FILE ]] && P_EVICT=("$RESTART_FILE" "${P_EVICT[@]}")
    if [[ $P_STATE == evict && $evict_policy != lru ]] && ((${#P_EVICT[@]} > 0)); then
      die "the GPUs changed while waiting, and $SPEC would now need other models stopped; run the command again"
    fi
    sim_evict "${P_EVICT[@]}"; advise "$ENGINE" "$MODEL" place "$CTX" 2 || die "$F_MSG; nothing was changed"
    prepare_command
  fi
fi
printf '%s %s\n' "$$" "$SPEC" > "$lock_file.owner" 2>/dev/null || true
find_interrupted
if ((${#INTERRUPTED[@]})); then
  warn "an earlier start was interrupted after stopping $(for d in "${INTERRUPTED[@]}"; do load_rec "$d/rec" && printf '%s ' "${ST[SPEC]}"; done)to make room; '$PROG doctor --fix' restarts them"
fi
id=$(spec_id "$SPEC")
fail_start() {  # message: undo and exit
  trap '' INT TERM HUP
  warn "$1"
  if ((!ATTACHED)) && [[ -n $S_PID ]]; then stop_pid "$S_PID" 1 || true; rec_remove "$run_dir/$id.state" "$S_PID"; fi
  rollback
  die "$SPEC was not started${STOPPED_SNAP:+; the models stopped for it were restarted}"
}
# from here until the new model is up, an interrupt undoes everything this run did
trap 'fail_start "interrupted by a signal"' INT TERM HUP
for f in "${P_EVICT[@]}"; do stop_rec "$f" keep || fail_start "${ST[SPEC]:-a model} could not be stopped"; done
if ((${#P_EVICT[@]})); then
  sleep 1  # let the driver release the memory before measuring
  FREE_ADD=() PLACE_NOTE=""
  pre_rank=$(rank "$F_RATING")
  advise "$ENGINE" "$MODEL" place "$CTX" 2 || fail_start "$F_MSG"
  if (($(rank "$F_RATING") > pre_rank)); then warn "now that the models have stopped, the measured free VRAM is lower than expected: $F_MSG"; fi
  if [[ "${PLACE_IDX[*]}" != "${PLAN_IDX[*]}" ]]; then prepare_command; fi
fi

declare -A USED0=()
refresh_hw; for i in "${!G_VENDOR[@]}"; do USED0[$i]=${G_USED[i]}; done
if ((ATTACHED)); then
  info "loading $MODEL on the Ollama daemon at ${CFG[OLLAMA_ATTACH]}"
  ollama_preload "${CFG[OLLAMA_ATTACH]}" "$MODEL" || fail_start "the Ollama daemon could not load $MODEL"
  S_PID="" S_LOG=""
else
  S_LOG=$log_dir/$id.log
  if [[ -f $S_LOG ]] && (($(stat -c %s -- "$S_LOG") > 50 * 1048576)); then mv -f -- "$S_LOG" "$S_LOG.1"; fi
  printf '\n==== %s: started by %s (run %s) ====\n' "$(date '+%F %T')" "$PROG" "$RUN_ID" >> "$S_LOG"
  info "starting $SPEC on port $PORT"
  note "command: $(printf '%q ' "${S_ENV[@]}" "${S_PREFIX[@]}" "${SANDBOX_ARGV[@]}" "${S_ARGV[@]}")"
  [[ -n $SANDBOX_NOTE ]] && info "$SANDBOX_NOTE"
  t0=$SECONDS
  start_server
  # recorded at once, so a crash from here on leaves a record (and the port taken)
  rec_write "$run_dir/$id.state" "ENGINE=$ENGINE" "MODEL=$MODEL" "SPEC=$SPEC" "HOST=$HOST" "PORT=$PORT" "PID=$S_PID" \
    "STARTTIME=$(pid_starttime "$S_PID" || true)" "MANAGED=1" "LOG=$S_LOG" "STARTED=$(date +%s)" "CTX=$CTX" "STATE=starting" "RUN=$RUN_ID" "OWNER=$$" \
    "COMMIT=$T_COMMIT" "TRUST=$T_STATUS" "TRUST_RECORD=${T_REC##*/}" "SANDBOX=${SANDBOX_KIND}" "ROLE=$(model_role)"
  ports_set "$SPEC" "$PORT"
  wait_ready && rc=0 || rc=$?
  case $rc in
    1) fail_start "the $ENGINE server exited before it became healthy (log: $S_LOG; last lines: $(tail -n 3 "$S_LOG" 2>/dev/null | tr '\n' ' ' | cut -c1-300))" ;;
    2) fail_start "the $ENGINE server was not healthy after ${CFG[READY_TIMEOUT]}s (LLMSERVER_READY_TIMEOUT; log: $S_LOG)" ;;
    3) fail_start "port $PORT is answering, but not from the server that was just started" ;;
    4) fail_start "the $ENGINE server accepted a request without the API key, so it was stopped rather than left open. If this build takes the key another way, pass it after '--' (for example --api-key-file) or set LLMSERVER_AUTH=none" ;;
  esac
  note "$SPEC became healthy in $((SECONDS - t0))s"
fi

# what it really uses: per process on NVIDIA, the change in used memory elsewhere
sleep 1; refresh_hw; PG_READ=0
meas=""
if [[ -n $S_PID ]]; then nv_usage; for i in "${!G_VENDOR[@]}"; do [[ -n ${PG_USE[$S_PID:$i]-} ]] && meas+="${meas:+,}$i:${PG_USE[$S_PID:$i]}"; done; fi
if [[ -z $meas ]]; then
  for i in "${!G_VENDOR[@]}"; do d=$((G_USED[i] - ${USED0[$i]:-0})); ((d > 64)) && meas+="${meas:+,}$i:$d"; done
fi
est=""
if ((${#PLACE_IDX[@]})); then
  per=$((F_NEED / ${#PLACE_IDX[@]})); [[ $ENGINE == vllm ]] && per=$F_NEED
  for i in "${PLACE_IDX[@]}"; do est+="${est:+,}$i:$per"; done
fi
rec_write "$run_dir/$id.state" "ENGINE=$ENGINE" "MODEL=$MODEL" "SPEC=$SPEC" "HOST=$HOST" "PORT=$PORT" "PID=$S_PID" \
  "STARTTIME=$([[ -n $S_PID ]] && pid_starttime "$S_PID" || true)" "MANAGED=$( ((ATTACHED)) && echo 0 || echo 1)" "LOG=$S_LOG" \
  "STARTED=$(date +%s)" "CTX=$CTX" "DRAFT=${D_SPEC:+$D_SPEC x$D_N}" "TUNE=${TUNE_ENV[*]}" "EST=$est" "MEAS=$meas" "RUN=$RUN_ID" "STATE=ready" \
  "COMMIT=$T_COMMIT" "TRUST=$T_STATUS" "TRUST_RECORD=${T_REC##*/}" "SANDBOX=${SANDBOX_KIND}" "ROLE=$(model_role)"
((ATTACHED)) || ports_set "$SPEC" "$PORT"
trap - INT TERM HUP
for d in "${STOPPED_SNAP[@]}"; do rm -rf -- "$d"; done   # the start succeeded: nothing to roll back
STOPPED_SNAP=()
[[ -n ${_LLMSERVER_SERVICE-} ]] || printf '%s\n' "$SPEC" > "$last_file"
if [[ " ${specs[*]} " != *" $SPEC "* && -z ${_LLMSERVER_SERVICE-} ]]; then   # (not a model a service started for itself)
  if [[ ! -e $models_file ]]; then mkdir -p "${models_file%/*}"; echo "# llmserver menu: one '[engine:]model [extra engine flags]' per line" > "$models_file"; fi
  printf '%s\n' "$SPEC" >> "$models_file" && info "added $SPEC to the menu as entry $((${#specs[@]} + 1))"
fi
post_start_check
if have flock; then exec 9>&-; fi

url="http://$(hostport "$(client_host "$HOST")" "$PORT")/v1"
info "${C_B}ready${C_0}: $MODEL via $ENGINE at $url (model id \"$(model_id "$ENGINE" "$MODEL")\"; ${meas:+uses $(gb "$(usage_total "$meas")") of VRAM; }log $S_LOG)"
note "running: $SPEC port=$PORT pid=${S_PID:-daemon} gpus=${PLACE_IDX[*]:-none} est=${est:-?} measured=${meas:-?} ctx=$CTX"
running_scan; info "${#R_FILES[@]} model(s) running; '$PROG ps' lists them, '$PROG capacity' shows the room left"
if ((${#SECRET_ENV[@]})); then info "clients need the API key in $key_file; '$PROG env $SPEC' prints ready-made exports"; fi
if ((foreground)) && [[ -n $S_PID ]]; then
  # stay attached: show the server's output and stop it on Ctrl-C
  trap 'info "stopping $SPEC"; stop_pid "$S_PID" 1 || true; rec_remove "$run_dir/$id.state" "$S_PID"; exit 0' INT TERM HUP
  tail -n 0 -f --pid="$S_PID" -- "$S_LOG" &
  while pid_alive "$S_PID"; do sleep 1; done
  rec_remove "$run_dir/$id.state" "$S_PID"
  warn "$SPEC exited by itself; see $S_LOG"
  exit 1
fi
