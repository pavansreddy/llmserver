def files_of(R):
    return [f for f in R['files'] if f['path'] in set(R['selected'])]

def cmd_enforce(recfile):
    R = json.load(open(recfile))
    st = R.get('status')
    if st == 'revoked': print('fail\trevoked\tthe check record was revoked (llmserver trust approve SPEC to approve it again)'); return
    if LEVEL == 'strict' and st not in ('approved', 'imported'):
        print('fail\tapproval\tSECURITY=strict needs an approved record, and this one is "%s"' % st); return
    if R['engine'] == 'ollama':
        man = os.environ.get('T_MANIFEST', '')
        if R.get('local_digests') and man and os.path.isfile(man):
            local = {str(l.get('digest', ''))[7:] for l in json.load(open(man)).get('layers', [])}
            if not set(R['local_digests']) <= local:
                print('fail\tchanged\tthe model in the Ollama store changed since it was checked'); return
        elif os.environ.get('T_ATTACHED') != '1' and not (man and os.path.isfile(man)):
            print('fail\tmissing\tthe model is not in the Ollama store'); return
        print('ok\t%s\t%s' % (st, R.get('commit') or '')); return
    for f in files_of(R):
        p = snap_path(R, f['path'])
        if not os.path.exists(p):
            print('fail\tmissing\t%s is missing%s' % (f['path'], '' if R.get('source') == 'file' else ' from the cache')); return
        if os.path.getsize(p) != f['size']:
            print('fail\tchanged\t%s changed size since it was checked' % f['path']); return
        if R.get('source') == 'file' and f.get('mtime') and int(os.path.getmtime(p)) != f['mtime']:
            print('fail\tchanged\t%s was modified since it was checked' % f['path']); return
    print('ok\t%s\t%s' % (st, R.get('commit') or ''))

def cmd_verify(recfile, delete='0'):
    R = json.load(open(recfile)); bad = 0; n = 0
    if R['engine'] == 'ollama':
        man = os.environ.get('T_MANIFEST', '')
        if not man or not os.path.isfile(man):
            print('skip\t%s\tthe Ollama store is not readable from here' % spec_of(R)); print('summary\t0\t0'); return
        blobs = man.split('/manifests/')[0] + '/blobs'
        for d in R.get('local_digests') or []:
            p = os.path.join(blobs, 'sha256-' + d); n += 1
            if not os.path.isfile(p): print('bad\t%s\tmissing' % d[:12]); bad += 1; continue
            if sha256_file(p) != d:
                print('bad\t%s\tSHA-256 differs' % d[:12]); bad += 1
                if delete == '1': remove(p, p)
                continue
            print('ok\t%s\t%d' % (d[:12], os.path.getsize(p)))
        print('summary\t%d\t%d' % (n, bad)); return
    for f in files_of(R):
        p = snap_path(R, f['path'])
        if not os.path.exists(p): print('bad\t%s\tmissing' % f['path']); bad += 1; continue
        real = os.path.realpath(p); n += 1
        why = None
        if os.path.getsize(real) != f['size']: why = 'size differs'
        elif f.get('sha256') and sha256_file(real) != f['sha256']: why = 'SHA-256 differs'
        elif not f.get('sha256') and f.get('git_oid') and git_oid(real, f['size']) != f['git_oid']: why = 'content differs'
        if why:
            print('bad\t%s\t%s' % (f['path'], why)); bad += 1
            if delete == '1': remove(p, real)
            continue
        print('ok\t%s\t%s' % (f['path'], f['size']))
    print('summary\t%d\t%d' % (n, bad))

def cmd_set(recfile, key, value):
