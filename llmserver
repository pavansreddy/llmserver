def decide(P):
    accept = set(os.environ.get('T_ACCEPT', '').split())
    rc_ok = os.environ.get('T_RC_OK') == '1' or P.get('remote_code_approved')
    approving = os.environ.get('T_APPROVE') == '1'
    worst = 'pass'; order = {'pass': 0, 'ask': 1, 'approve': 2, 'block': 3}
    for f in P['findings']:
        s = f['severity']
        if s == 'note': continue
        if f['override'] == 'risk' and f['id'] in accept:
            f['accepted'] = True; continue
        if f['override'] == 'approve':
            if (f['id'] == 'M-REMOTE-CODE' and rc_ok) or (f['id'] != 'M-REMOTE-CODE' and approving):
                f['accepted'] = True; continue
            s = 'approve' if s == 'ask' or f['id'] == 'M-REMOTE-CODE' else s
        if order[s] > order[worst]: worst = s
    P['decision'] = worst
    return worst

