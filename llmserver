#!/usr/bin/env bash
# shellcheck shell=bash
#
# llmserver — serve local LLMs, each behind its own OpenAI-compatible API.
#
# Engines:  llama.cpp (GGUF from Hugging Face), vLLM (safetensors from Hugging Face),
#           Ollama (Ollama library, or GGUF repos from Hugging Face via hf.co/...).
# Pick any mix of them in `llmserver setup`.
#
# Several models can run at once, each on its own port (a model keeps its port across
# restarts). Before a model starts, llmserver works out where it fits on the installed GPUs
# next to what is already running:
#   1. download the model if it is missing and check every file against its content hash,
#      while the running models keep answering;
#   2. place it on the GPU(s) where it fits best, or, when the GPUs are full, list the least
#      recently used models that would have to stop (and ask, unless told what to do);
#   3. stop those models (SIGTERM, then SIGKILL after a grace period), start the new one and
#      wait for its health endpoint;
#   4. if it does not come up, restart the models it stopped and exit non-zero.
#
# Self-contained: llmserver installs uv, its own Python and the engines (llama.cpp, Ollama,
# vLLM) into one folder it owns, ~/.llmserver (LLMSERVER_HOME), pinned and checksum-verified,
# and keeps its settings, menu, logs and state there too. It never uses sudo, system packages,
# the system Python or the user's Python setup.
#
# Files (all in ~/.llmserver):
#   llmserver.env       every setting and engine variable (KEY=VALUE, parsed, never sourced)
#   config/models       menu entries: [engine:]model [extra engine flags]
#   config/api-key      generated API key (mode 600)
#   logs/install.log    the activity log; logs/models/ has each model's output
#
# Hardware: NVIDIA GPUs (via nvidia-smi), AMD GPUs (via the amdgpu driver), or none (CPU).
# It estimates the memory each model needs on this machine and says whether it will run well,
# run partly on the CPU, or not run at all, and how many models fit at once.
#
# Linux only: it reads /proc and /sys and uses GNU coreutils and util-linux. bash 4.4+, curl
# and tar are required; ss or lsof, flock and setsid are used when present. Python is not
# needed on the system: llmserver brings its own.
# Run `llmserver --help` for usage.

set -euo pipefail

readonly PROG=llmserver VERSION=2.7.1
if ((BASH_VERSINFO[0] < 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] < 4))); then
  echo "$PROG: bash 4.4 or newer is required (this is $BASH_VERSION)" >&2; exit 1
fi
if [[ $(uname -s 2>/dev/null) != Linux ]]; then
  echo "$PROG: runs on Linux only; this system is $(uname -s 2>/dev/null || echo unknown)" >&2; exit 1
fi
if [[ ! -r /proc/self/stat || ! -d /sys/class ]]; then
  echo "$PROG: /proc and /sys must be mounted (in a container, mount them read-only)" >&2; exit 1
fi
for _c in awk sed grep sort stat readlink find od mktemp tar sha256sum; do
  command -v "$_c" >/dev/null 2>&1 || { echo "$PROG: '$_c' is required (GNU coreutils, findutils, grep, sed, gawk or mawk)" >&2; exit 1; }
done
unset _c
ORIG_ARGS=("$@")

# ---- where everything lives ------------------------------------------------------
# One folder holds everything llmserver writes: LLMSERVER_HOME, default ~/.llmserver (mode 700).
# Set LLMSERVER_HOME in the environment or in /etc/llmserver_env to use another disk; the folder
# can also be moved later, and llmserver adjusts itself. Inside it:
#   llmserver.env     the settings (mode 600)
#   config/           models (the menu), tuning, api-key
#   logs/             install.log, ollama-pull.log, garak.log; logs/models/ for each model
#   state/            running models, ports, pins, rollback snapshots, sandbox caches, locks
#   skills/           agent skills (linked from ~/.agents/skills and ~/.claude/skills)
#   trust/            check records
#   engines/ runtime/ python/ uv/ bin/ locks/ tools/   installed software
#   cache/ tmp/       downloads and staging (on the same disk, so installs move into place at once)
#   models/           model files, only with LLMSERVER_MODEL_STORE=private
# Model files otherwise stay in the shared Hugging Face and Ollama caches, so other tools use
# them too. /etc/llmserver_env holds system-wide settings for every user.
#
# The settings file is KEY=VALUE, parsed and never executed (also valid for systemd
# EnvironmentFile and 'docker --env-file'). LLMSERVER_* keys configure llmserver; any other
# variable (HF_TOKEN, HF_HOME, OLLAMA_MODELS, ...) is exported to llmserver and every engine it
# starts, unless it is already set in the environment. Precedence: command line > environment >
# llmserver.env > /etc/llmserver_env > built-in defaults.
sys_env_file=${LLMSERVER_SYS_ENV_FILE:-/etc/llmserver_env}
env_file=""
declare -A ENVF=() ENVF_SRC=()
ENV_WARNINGS=()
read_env_file() {  # file: parse KEY=VALUE lines into ENVF (later files win)
  local f=$1 line key val n=0
  [[ -r $f ]] || return 0
  while IFS= read -r line || [[ -n $line ]]; do
    n=$((n + 1))
    [[ $line =~ ^[[:space:]]*(#|$) ]] && continue
    line=${line#"${line%%[![:space:]]*}"}; line=${line#export }
    if [[ $line =~ ^([A-Za-z_][A-Za-z0-9_]*)[[:space:]]*=[[:space:]]*(.*)$ ]]; then
      key=${BASH_REMATCH[1]} val=${BASH_REMATCH[2]}
      if [[ $val =~ ^\"([^\"]*)\" || $val =~ ^\'([^\']*)\' ]]; then val=${BASH_REMATCH[1]}
      else val=${val%%[[:space:]]#*}; val=${val%"${val##*[![:space:]]}"}; fi
      [[ $val == \~/* ]] && val=$HOME/${val#\~/}
      ENVF[$key]=$val ENVF_SRC[$key]="$f:$n"
    else
      ENV_WARNINGS+=("$f line $n is not KEY=VALUE; ignored")
    fi
  done < "$f"
  if [[ $f == "$env_file" ]] && grep -qE '^[[:space:]]*(export[[:space:]]+)?[A-Z_]*(TOKEN|KEY|SECRET|PASSWORD)[A-Z_]*[[:space:]]*=[[:space:]]*[^[:space:]#]' "$f" 2>/dev/null; then
    local mode; mode=$(stat -c %a -- "$f" 2>/dev/null || echo 600)
    [[ $mode =~ ^[0-7]00$ ]] || ENV_WARNINGS+=("$f holds a secret and is readable by other users (mode $mode); run: chmod 600 '$f'")
  fi
}
read_env_file "$sys_env_file"
lhome=${LLMSERVER_HOME:-${ENVF[LLMSERVER_HOME]:-$HOME/.llmserver}}
lhome=${lhome%/}
MIGRATED=() MIGRATE_BLOCKED=""
migrate_layout() {  # one time: move the folders of llmserver 2.0 and older into LLMSERVER_HOME
  local oh=${XDG_DATA_HOME:-$HOME/.local/share}/llmserver oc=${XDG_CONFIG_HOME:-$HOME/.config}/llmserver
  local os=${XDG_STATE_HOME:-$HOME/.local/state}/llmserver oe=$HOME/.llmserver_env f pid custom=""
  [[ -e $lhome/llmserver.env || -e $lhome/.llmserver-layout ]] && return 0
  [[ -f $oe || -d $oc || -d $os || -f $oh/.llmserver-home ]] || return 0
  for f in "$os"/running/*.state; do   # never move what a running model uses
    [[ -f $f ]] || continue
    pid=$(sed -n 's/^PID=//p' "$f" | head -n 1)
    if [[ $pid =~ ^[0-9]+$ && -d /proc/$pid ]]; then MIGRATE_BLOCKED=$os; return 0; fi
  done
  [[ -f $oe ]] && custom=$(sed -nE 's/^[[:space:]]*(export[[:space:]]+)?LLMSERVER_HOME[[:space:]]*=[[:space:]]*["'\'']?([^"'\''#[:space:]]*).*/\2/p' "$oe" | tail -n 1)
  if [[ -n $custom && -z ${LLMSERVER_HOME-} && -z ${ENVF[LLMSERVER_HOME]-} ]]; then
    lhome=${custom%/}; MIGRATED+=("kept LLMSERVER_HOME=$lhome from $oe; put it in the environment or /etc/llmserver_env from now on")
  fi
  if [[ -f $oh/.llmserver-home && $oh != "$lhome" ]] && { [[ ! -e $lhome ]] || [[ -z $(ls -A -- "$lhome" 2>/dev/null) ]]; }; then
    rmdir -- "$lhome" 2>/dev/null || true
    mkdir -p -- "$(dirname -- "$lhome")" && mv -- "$oh" "$lhome" && MIGRATED+=("moved $oh to $lhome")
    printf '%s\n' "$oh" > "$lhome/.llmserver-path"   # lhome_init adjusts the venvs and links to the new place
  fi
  mkdir -p -- "$lhome/config" "$lhome/state" "$lhome/logs/models"; chmod 700 "$lhome"
  [[ -f $lhome/.llmserver-home ]] || printf '%s folder: everything llmserver installs and keeps. "%s uninstall" removes it.\n' "$PROG" "$PROG" > "$lhome/.llmserver-home"
  if [[ -f $oe ]]; then mv -- "$oe" "$lhome/llmserver.env" && chmod 600 "$lhome/llmserver.env" && MIGRATED+=("moved $oe to $lhome/llmserver.env"); fi
  if [[ -d $oc ]]; then
    for f in "$oc"/* "$oc"/.[!.]*; do [[ -e $f ]] && mv -- "$f" "$lhome/config/"; done
    rmdir -- "$oc" 2>/dev/null || true; MIGRATED+=("moved $oc to $lhome/config")
  fi
  if [[ -d $os ]]; then
    if [[ -d $os/logs ]]; then for f in "$os"/logs/*; do [[ -e $f ]] && mv -- "$f" "$lhome/logs/models/"; done; rmdir -- "$os/logs" 2>/dev/null || true; fi
    for f in "$os"/install.log*; do [[ -e $f ]] && mv -- "$f" "$lhome/logs/"; done
    for f in "$os"/* "$os"/.[!.]*; do [[ -e $f ]] && mv -- "$f" "$lhome/state/"; done
    rmdir -- "$os" 2>/dev/null || true; MIGRATED+=("moved $os to $lhome/state and $lhome/logs")
  fi
  if [[ -d $lhome/state/running ]]; then   # records name their log file: point them at logs/models
    for f in "$lhome"/state/running/*.state; do [[ -f $f ]] && sed -i "s#^LOG=$os/logs/#LOG=$lhome/logs/models/#" "$f"; done
  fi
  : > "$lhome/.llmserver-layout"
}
migrate_layout
if [[ -n $MIGRATE_BLOCKED ]]; then   # models of the old layout are running: use it for this run
  lhome=${ENVF[LLMSERVER_HOME]:-${XDG_DATA_HOME:-$HOME/.local/share}/llmserver}
  env_file=$HOME/.llmserver_env config_dir=${XDG_CONFIG_HOME:-$HOME/.config}/llmserver state_dir=$MIGRATE_BLOCKED
  logs_dir=$state_dir log_dir=$state_dir/logs
else
  env_file=$lhome/llmserver.env config_dir=$lhome/config state_dir=$lhome/state logs_dir=$lhome/logs log_dir=$lhome/logs/models
fi
read_env_file "$env_file"
[[ -v ENVF[LLMSERVER_HOME] && ${ENVF_SRC[LLMSERVER_HOME]%%:*} == "$env_file" ]] &&
  ENV_WARNINGS+=("LLMSERVER_HOME in $env_file has no effect (that file lives inside it); set it in the environment or in $sys_env_file")
setting() {  # NAME default -> environment, else settings file, else default
  local n=$1
  if [[ -v $n ]]; then printf '%s\n' "${!n}"; elif [[ -v ENVF[$n] ]]; then printf '%s\n' "${ENVF[$n]}"; else printf '%s\n' "${2-}"; fi
}
# engine variables from the settings file reach llmserver itself and every engine it starts
declare -A ENVF_EXPORTED=()
for _k in "${!ENVF[@]}"; do
  [[ $_k == LLMSERVER_* || -v $_k ]] && continue
  export "$_k=${ENVF[$_k]}"; ENVF_EXPORTED[$_k]=1
done
unset _k
# GPU masks set by a container runtime, a scheduler or the user: llmserver never goes beyond them
INH_CUDA=${CUDA_VISIBLE_DEVICES-__unset__} INH_ROCR=${ROCR_VISIBLE_DEVICES-__unset__} INH_HIP=${HIP_VISIBLE_DEVICES-__unset__}


models_file=$config_dir/models
key_file=$config_dir/api-key
last_file=$state_dir/last
downloads_file=$state_dir/downloads
lock_file=$state_dir/lock
# model files: the shared caches (default), or LLMSERVER_MODEL_STORE=private inside LLMSERVER_HOME
if [[ $(setting LLMSERVER_MODEL_STORE shared) == private ]]; then
  [[ -v HF_HUB_CACHE || -v HF_HOME ]] || export HF_HUB_CACHE=$lhome/models/huggingface/hub
  [[ -v OLLAMA_MODELS ]] || export OLLAMA_MODELS=$lhome/models/ollama
fi
hub=${HF_HUB_CACHE:-${HF_HOME:-$HOME/.cache/huggingface}/hub}

# ---- output ------------------------------------------------------------------
if [[ -t 2 && -z ${NO_COLOR-} ]]; then
  C_B=$'\e[1m' C_Y=$'\e[33m' C_R=$'\e[31m' C_0=$'\e[0m'
else
  C_B="" C_Y="" C_R="" C_0=""
fi
info() { printf '%s\n' "$PROG: $*" >&2; ((MUTATING)) && log_write info "$*"; return 0; }
warn() { printf '%s\n' "$PROG: ${C_Y}warning:${C_0} $*" >&2; log_write warn "$*"; }
die() { printf '%s\n' "$PROG: ${C_R}error:${C_0} $*" >&2; DIED=1; log_write error "$*"; exit 1; }
note() { log_write info "$*"; ((VERBOSE)) && printf '%s\n' "$PROG: $*" >&2; return 0; }  # the log only
MUTATING=0 VERBOSE=0 DIED=0
have() { command -v "$1" >/dev/null 2>&1; }
gb() { printf '%d.%d GB' "$(($1 / 1024))" "$((($1 % 1024) * 10 / 1024))"; }  # MiB -> "x.y GB"
# JSON for --json output (stdout only; messages stay on stderr)
js() {  # string -> JSON string
  local v=$1
  v=${v//\\/\\\\}; v=${v//\"/\\\"}; v=${v//$'\n'/\\n}; v=${v//$'\t'/\\t}; v=${v//$'\r'/}
  printf '"%s"' "$v"
}
jn() { if [[ $1 =~ ^-?[0-9]+(\.[0-9]+)?$ ]]; then printf '%s' "$1"; else printf 'null'; fi; }   # number or null
jb() { if [[ $1 == 1 || $1 == true ]]; then printf true; else printf false; fi; }               # boolean
jt() { if "$@"; then printf true; else printf false; fi; }                                       # command -> boolean
ja() { local IFS=,; printf '[%s]' "$*"; }   # already-encoded values -> JSON array
jsa() { local x enc=(); for x in "$@"; do enc+=("$(js "$x")"); done; ja "${enc[@]}"; }   # strings -> JSON array
jo() {  # key value-already-encoded ... -> JSON object
  local enc=()
  while (($# >= 2)); do enc+=("$(js "$1"):$2"); shift 2; done
  local IFS=,; printf '{%s}' "${enc[*]}"
}
hsize() { if (($1 >= 1073741824)); then gb $(($1 / 1048576)); else printf '%d MB' $(($1 / 1000000)); fi; }  # bytes

# ---- activity log ------------------------------------------------------------
# install.log records every run of llmserver and everything it changes: downloads, starts,
# stops, evictions, rollbacks, recoveries and uninstalls, with timestamps, a run id
# and the outcome. Secrets are redacted. 'llmserver log' shows it.
log_file=$logs_dir/install.log
LOG_LEVEL=$(setting LLMSERVER_LOG_LEVEL info)
RUN_ID=$(od -An -N3 -tx1 /dev/urandom 2>/dev/null | tr -d ' \n' || echo $$)
RUN_T0=$(date +%s)
LOG_OK=1 VERBOSE=0
redact() {
  sed -E -e 's/sk-llmserver-[0-9a-f]+/sk-llmserver-<redacted>/g' \
    -e 's/hf_[A-Za-z0-9]{12,}/hf_<redacted>/g' \
    -e 's/(Bearer )[^ "]+/\1<redacted>/g' \
    -e 's/([A-Z_]*(TOKEN|API_KEY|SECRET|PASSWORD)[A-Z_]*=)[^ "]*/\1<redacted>/g' <<<"$1"
}
log_write() {  # level message
  ((LOG_OK)) || return 0
  local msg
  if [[ ! -d ${log_file%/*} ]]; then mkdir -p "${log_file%/*}" 2>/dev/null || { LOG_OK=0; return 0; }; fi
  msg=$(redact "$2"); msg=${msg//$'\n'/ | }
  (umask 077; printf '%s level=%s run=%s pid=%s cmd=%s msg="%s"\n' "$(date '+%Y-%m-%dT%H:%M:%S%z')" "$1" "$RUN_ID" "$$" "${cmd:-?}" "${msg//\"/\'}" >> "$log_file") 2>/dev/null || LOG_OK=0
}
debug() {
  [[ $LOG_LEVEL == debug ]] && log_write debug "$*"
  ((VERBOSE)) && printf '%s\n' "$PROG: debug: $*" >&2
  return 0
}
log_rotate() {  # keep install.log under LOG_MAX_MB, with 3 older copies
  local max i
  max=$(setting LLMSERVER_LOG_MAX_MB 5)
  max=$(awk -v m="$max" 'BEGIN {if (m ~ /^[0-9]+(\.[0-9]+)?$/) printf "%d", m * 1048576; else print 5242880}')
  [[ -f $log_file ]] && (($(stat -c %s -- "$log_file" 2>/dev/null || echo 0) > max)) || return 0
  for i in 2 1; do [[ -f $log_file.$i ]] && mv -f -- "$log_file.$i" "$log_file.$((i + 1))"; done
  mv -f -- "$log_file" "$log_file.1"
}
MUTATING=0
log_start() {
  if [[ -z $MIGRATE_BLOCKED ]]; then lhome_init; fi
  case $cmd in serve|start|stop|download|setup|uninstall|pin|unpin|bench|install|upgrade|rollback) MUTATING=1 ;; doctor) MUTATING=$opt_fix ;; esac
  log_rotate 2>/dev/null || true
  if ((MUTATING)); then log_write info "run start: $PROG $VERSION $(printf '%q ' "${ORIG_ARGS[@]}")(user ${USER:-$(id -un 2>/dev/null)}, host $(hostname 2>/dev/null))"
  else debug "run start: $PROG $VERSION $(printf '%q ' "${ORIG_ARGS[@]}")"; fi
  local w; for w in "${ENV_WARNINGS[@]}"; do warn "$w"; done
  for w in "${MIGRATED[@]}"; do info "$w"; log_write info "layout: $w"; done
  [[ -n $MIGRATE_BLOCKED ]] && warn "models started by an older $PROG are running; stop them ('$PROG stop all') to let $PROG move everything into ${LLMSERVER_HOME:-$HOME/.llmserver}"
  return 0
}
log_end() {  # exit status
  local d=$(($(date +%s) - RUN_T0))
  # 'ps' exits 1 when nothing runs; that is an answer, not a failure
  if ((MUTATING || DIED)); then log_write "$( (($1 == 0)) && echo info || echo error)" "run end: exit $1 after ${d}s"
  else debug "run end: exit $1 after ${d}s"; fi
}

usage() {
  cat <<EOF2
$PROG $VERSION — serve local models, each behind its own OpenAI-compatible API

Usage:
  $PROG [start] [MODEL] [options] [-- ENGINE_FLAGS...]
                              start MODEL on its own port (menu when omitted); models already
                              running keep running if there is room on the GPUs
  $PROG ps [--json]           the running models: port, GPUs, memory, idle time (alias: status)
  $PROG capacity [--json]     memory per GPU, who uses it, which menu models fit now, which
                              would need others stopped, and how many fit at once
  $PROG stop MODEL|all        stop one model (name, menu number or port) or all of them
  $PROG pin MODEL / unpin MODEL
                              a pinned model is never stopped to make room for another
  $PROG chat [MODEL] [MESSAGE] [--system TEXT]
                              talk to a model in the terminal (answers stream as they come;
                              /help lists the chat commands). Offers to start MODEL if it is not
                              running. With MESSAGE, or a pipe, it answers once and exits
  $PROG webui [start|stop|restart|status]
                              Open WebUI, a web chat for people on the network (installed on
                              first use, about 2.5 GB): accounts, every running model, chats.
                              Documents: hybrid search (keywords + meaning) and a reranker
                              (webui_rag, webui_reranker fast|best|off); web search through a
                              private SearXNG with 'config set webui_search on'
  $PROG gateway [start|stop|status]
                              one OpenAI-compatible address (default http://127.0.0.1:8000/v1)
                              for every running model; Open WebUI uses it, other clients may too
  $PROG env [MODEL]           print OPENAI_BASE_URL / OPENAI_API_KEY exports for a model
  $PROG logs [MODEL]          follow a model's server output
  $PROG log [-f] [--errors] [--lines N]
                              show llmserver's own activity log (install.log)
  $PROG setup                 choose engines, network, auth, context and limits; installs what
                              is needed into LLMSERVER_HOME
  $PROG install [COMPONENT...]
                              install runtime, llama, ollama, vllm, all (the engines), webui or searxng
                              into LLMSERVER_HOME
                              (pinned versions, SHA-256 verified; asks first)
  $PROG upgrade [COMPONENT] [--latest]
                              move to this llmserver's pinned versions, or with --latest to the
                              newest upstream release that publishes checksums
  $PROG rollback COMPONENT    go back to the previously installed build
  $PROG versions [--json]     what is installed, from where, and the previous builds
  $PROG versions --sbom       a CycloneDX software bill of materials of everything llmserver
                              installed, with every hash, and the checked models
  $PROG check [MODEL] [--json]
                              the GPUs, limits, what each engine can use, and how well MODEL
                              (or every menu entry) runs here, in total and right now
  $PROG list [--json]         the menu with cache status and fit
  $PROG model add MODEL [-- FLAGS]
                              add a model to the menu (checks that it exists first)
  $PROG model rm [N|MODEL...] [--purge]
                              remove menu entries (asks which when none are given); --purge
                              also deletes the files llmserver downloaded for them
  $PROG model purge MODEL     delete the files llmserver downloaded for a model
  $PROG model edit            open the menu in your editor (\$EDITOR), then check it
  $PROG config [list] [--json] / config get NAME
                              the settings in effect and where each comes from
  $PROG config set NAME VALUE / config unset NAME
                              change one setting (for example 'config set port 9000');
                              checked before it is saved. Engine variables such as HF_TOKEN too
  $PROG config edit [tuning]  open the settings (or the tuning rules) in your editor
  $PROG key [show|new]        the API key for clients: where it is, or make a new one
  $PROG autostart [list] / autostart on|off MODEL...
                              start models when you log in (systemd user services)
  $PROG doctor [--fix] [--json]
                              check that llmserver's records match what is running; --fix
                              repairs them and restarts models an interrupted start stopped
  $PROG bench [MODEL] [--json] [--reasoning LEVEL]
                              measure a running model: prefill (TTFT, prompt speed), decode
                              (speed, TPOT, ITL p50/p90/p99), end-to-end latency, for a short
                              and a long prompt; then one real answer: thinking and answer apart
  $PROG download [MODEL]      check and fetch a model; running models are untouched
  $PROG trust check MODEL [--json]
                              run the security checks without downloading: commit, files,
                              Hugging Face scan results, rules, decision
  $PROG trust approve MODEL [--remote-code] [--accept-risk ID]...
                              check, download and approve MODEL (needed with SECURITY=strict);
                              --remote-code allows its own Python code for this commit only
  $PROG trust revoke MODEL    withdraw the approval (stops it if it is running)
  $PROG trust show MODEL [--code] [--json]
                              the check record: commit, files, hashes, findings, decision
  $PROG trust verify [MODEL] [--json]
                              hash the downloaded files again against their records
  $PROG trust list [--json]   every check record
  $PROG models outdated [--json]
                              models whose upstream moved since they were checked
  $PROG models update MODEL   check and download the new upstream commit
  $PROG skills [list] [--json]
                              agent skills: installed, generated by llmserver, and Hugging
                              Face's skills marketplace
  $PROG skills add [NAME...] [--project] [--yes] [--accept-risk ID] [--force]
                              check and install skills for AI agents (default: llmserver and
                              hf-cli) into ~/.llmserver/skills, linked from ~/.agents/skills
                              and ~/.claude/skills
  $PROG skills check|preview NAME
                              run the skill checks, or show the skill, without installing
  $PROG skills update [NAME...] / skills remove NAME...
                              update or remove skills llmserver installed (never your changes
                              without --force)
  $PROG export MODEL... -o FILE [--with-engines] [--sign KEY]
                              write checked models (and with --with-engines, everything an
                              offline install needs) into one bundle for an air-gapped machine;
                              --sign signs it with an ssh key
  $PROG import FILE           check a bundle (signature, every SHA-256) and place its models
  $PROG install --from FILE   install the engines from a bundle, without a network; or from a
                              llama.cpp / Ollama release file you downloaded (it must be the
                              pinned release: its SHA-256 is checked)
  $PROG eval [MODEL] [--garak [--probes LIST]] [--json]
                              probe a running model for prompt injection and system prompt
                              leaks; --garak also runs NVIDIA garak (installed on request)
  $PROG hf ARGS...            the Hugging Face CLI that llmserver pins (for example
                              '$PROG hf auth login'); 'hf --link' puts it on PATH as 'hf'
  $PROG uninstall             stop every model and delete ~/.llmserver (settings, state, logs,
                              engines) and the program itself; shows the plan and asks first

MODEL is a menu number or [engine:]model:
  llama:ORG/REPO-GGUF[:QUANT][@COMMIT]
                                     llama.cpp, GGUF repo on Hugging Face
  vllm:ORG/REPO[@REVISION]           vLLM, Hugging Face repo
  ollama:NAME[:TAG]                  Ollama library model
  ollama:hf.co/ORG/REPO-GGUF[:QUANT] Ollama pulling a GGUF repo from Hugging Face
  /path/to/model.gguf (or ~/..., ./...)
                                     llama.cpp, a GGUF file on this computer (used where it
                                     is; checked once: GGUF header, SHA-256, local scanners)
Without a prefix the engine is inferred: GGUF repos and files go to llama.cpp, other Hugging
Face repos to vLLM, bare names to Ollama.

When the GPUs are full, starting a model lists the least recently used models that would
have to stop. LLMSERVER_EVICT decides what happens: ask (default: asks in a terminal,
refuses otherwise), lru (stops them), never (refuses). Pinned models are never stopped.

Before a model is downloaded or started, llmserver resolves the exact commit, reads Hugging
Face's scan results for every file, downloads only the files the engine needs (no pickle or
other formats), checks them again by SHA-256, size and format, and writes a check record.
Starts use the recorded commit, offline, in a bubblewrap sandbox when bwrap is installed
(read-only system, empty home). LLMSERVER_SECURITY=strict also needs an explicit
'trust approve'. A refusal exits with status 3; a needed answer or approval with status 4.

Options:
  -e, --engine NAME     llama | vllm | ollama, for a MODEL given without a prefix
      --host ADDR       bind address for this run (setting: LLMSERVER_HOST)
      --port N          port for this model (default: its last port, else the first free one
                        from LLMSERVER_PORT)
  -c, --ctx N           context for this run (default 32768, capped at what the model
                        supports); 'fit' = the largest that fits; 'auto' = engine default
      --restart         restart MODEL if it is already running (same port)
      --evict           stop the least recently used models if needed, without asking
      --offload         if MODEL does not fit, run it partly on the CPU instead of stopping
                        other models
      --foreground      stay attached: show the server's output; Ctrl-C stops the model
  -n, --dry-run         show what would be downloaded, stopped and started; change nothing
      --insecure        allow a non-loopback bind without authentication for this run
      --no-vram-guard   do not refuse a model that will not fit; skip the hardware checks
      --no-preflight    skip validating llama.cpp flags against its --help
      --draft MODEL     speculative decoding with a small draft model of the same family
                        (llama.cpp: a GGUF repo; vLLM: a repo, or 'ngram' for prompt lookup)
      --draft-n N       tokens the draft proposes per step (setting: DRAFT_N, default 4)
      --no-draft        turn off a draft set in the menu entry
  -y, --yes             accept defaults in setup, security warnings, or uninstall without
                        prompting (never approves a model's own code)
      --accept-risk ID  accept one refused finding by its rule ID (for example M-SCAN-PENDING);
                        written into the check record. Repeat for several
      --remote-code     with 'trust approve': allow the model's own Python code
      --project         with 'skills': the current folder (.agents/skills) instead of ~
  -o, --output FILE     with 'export': the bundle to write
      --with-engines    with 'export': also the engines, Python and packages, for 'install --from'
      --sign KEY        with 'export': sign the bundle with this ssh private key
      --from FILE       with 'install': install from a bundle instead of the network
      --garak           with 'eval': also run garak; --probes LIST picks its probes
      --force           with 'skills': replace or remove a skill that was changed, or one
                        that llmserver did not install
  -v, --verbose         also print the details that go to install.log
Bench options:
      --runs N          measured runs per prompt length (default 3, after one warm-up)
      --long N          tokens in the long prompt (default: 8192, or less to fit the context)
      --gen N           tokens to generate per run (default 128)
      --history         show earlier results instead of measuring
Inspection commands (ps, check, capacity, list, doctor, trust, models) take --json.
'doctor --deep' also hashes every checked file; with --fix it deletes files that differ.
Log options:
  -f, --follow          keep printing new lines
      --errors          only warnings and errors
      --lines N         how many lines to show (default 40)
Uninstall options:
      --purge-models    also delete the models llmserver downloaded (never other tools' models)
Model options:
      --purge           with 'model rm': also delete the files llmserver downloaded
Chat options:
      --system TEXT     a system prompt for the conversation ('/system' changes it in a chat)
      --think           show a reasoning model's thinking (hidden by default; '/think' toggles it)
      --reasoning LEVEL how hard a reasoning model thinks: low, medium, high, or none (no
                        thinking); sent as reasoning_effort. '/reasoning' changes it in a chat
  -y, --yes             start MODEL without asking if it is not running
      --keep-config     keep the settings, model menu and API key
      --keep-script     keep the llmserver program itself
  -h, --help   -V, --version

Unknown options are rejected. Flags meant for the engine go after '--':
  $PROG 2 --port 9931 -- --temp 0.7 --parallel 2
For Ollama, the tokens after '--' are KEY=VALUE environment settings instead.

Home:     $lhome (everything llmserver installs and keeps; LLMSERVER_HOME)
Settings: $env_file (every setting and engine variable; /etc/llmserver_env is read first)
Models:   $models_file
Activity: $log_file, and $log_dir/ for each model
Model files: $hub (LLMSERVER_MODEL_STORE=$(setting LLMSERVER_MODEL_STORE shared))
Any setting can be overridden for one run with LLMSERVER_<KEY>=value in the environment.
EOF2
}

# ---- arguments ---------------------------------------------------------------
readonly KNOWN_OPTS=(--engine --host --port --ctx --dry-run --insecure --no-vram-guard --no-preflight
  --yes --help --version --list --download --purge-models --keep-config --keep-script --runs --long
  --gen --history --draft --draft-n --no-draft --restart --evict --offload --foreground --json
  --verbose --follow --errors --lines --fix --latest --accept-risk --remote-code --code --deep --project --global --force
  --output --with-engines --sign --from --sbom --garak --probes --purge --system --think --reasoning)
lev() {  # a b -> edit distance (short words only)
  local a=$1 b=$2 i j c prev=() cur=()
  for ((j = 0; j <= ${#b}; j++)); do prev[j]=$j; done
  for ((i = 1; i <= ${#a}; i++)); do
    cur=("$i")
    for ((j = 1; j <= ${#b}; j++)); do
      c=${prev[j - 1]}; [[ ${a:i-1:1} == "${b:j-1:1}" ]] || c=$((c + 1))
      ((prev[j] + 1 < c)) && c=$((prev[j] + 1)); ((cur[j - 1] + 1 < c)) && c=$((cur[j - 1] + 1))
      cur[j]=$c
    done
    prev=("${cur[@]}")
  done
  printf '%s\n' "${prev[${#b}]}"
}
COMMANDS=(setup list download ps status stop env logs log start uninstall check bench capacity pin unpin doctor install upgrade
  rollback versions trust model models config key autostart chat gateway webui skills export import eval hf)
cmd_typo() {  # a bare word that is not in the menu: a mistyped command? -> dies with a suggestion
  local w=${1,,} c d best="" bd=99
  [[ $1 =~ ^[A-Za-z]+$ && ${#1} -ge 2 ]] || return 0
  for c in "${COMMANDS[@]}"; do
    d=$(lev "$w" "$c"); ((d < bd)) && { bd=$d best=$c; }
  done
  ((bd <= (${#w} > 4 ? 2 : 1))) || return 0
  die "'$1' is not a command (did you mean '$PROG $best'?). To start an Ollama model with this name, use 'ollama:$1'"
}
suggest() {  # a near-miss for a mistyped option, if there is one
  local n=${1%%=*} o m
  n=${n//[-_]/}; n=${n,,}
  for o in "${KNOWN_OPTS[@]}"; do
    m=${o//-/}
    if [[ $m == "$n" ]] || { ((${#n} >= 3)) && [[ $m == "$n"* || $n == "$m"* ]]; }; then
      printf " (did you mean '%s'?)" "$o"; return 0
    fi
  done
  return 0
}

cmd="" sel="" opt_engine="" opt_host="" opt_port="" opt_ctx="" opt_draft="" opt_draft_n="" no_draft=0
opt_fix=0 opt_latest=0 dry=0 insecure=0 guard_off=0 preflight=1 yes=0 restart=0 opt_evict=0 opt_offload=0 foreground=0 json=0
purge_models=0 keep_config=0 keep_script=0 b_runs=3 b_long="" b_gen=128 b_history=0 bench_opt=0
l_follow=0 l_errors=0 l_lines=40 log_opt=0 opt_remote_code=0 opt_code=0 opt_deep=0 sub=""
opt_garak=0 opt_probes="" opt_project=0 opt_force=0 opt_output="" opt_with_engines=0 opt_sign="" opt_from="" opt_sbom=0 export_names=()
pass=() positional=() opt_accept=() hf_args=() skill_names=() model_args=() config_args=() chat_args=() purge=0 opt_system="" opt_think=0 opt_reasoning=""
if [[ ${1-} == hf ]]; then cmd=hf; shift; hf_args=("$@"); set --; fi   # everything after 'hf' is for the hf CLI
need_value() { (($# >= 2)) || die "option $1 needs a value"; }
while (($#)); do
  case $1 in
    -h|--help) usage; exit 0 ;;
    -V|--version) echo "$PROG $VERSION"; exit 0 ;;
    -e|--engine) need_value "$@"; opt_engine=$2; shift ;;
    --engine=*) opt_engine=${1#*=} ;;
    --host) need_value "$@"; opt_host=$2; shift ;;
    --host=*) opt_host=${1#*=} ;;
    --port) need_value "$@"; opt_port=$2; shift ;;
    --port=*) opt_port=${1#*=} ;;
    -c|--ctx) need_value "$@"; opt_ctx=$2; shift ;;
    --ctx=*) opt_ctx=${1#*=} ;;
    -n|--dry-run) dry=1 ;;
    --insecure) insecure=1 ;;
    --no-vram-guard) guard_off=1 ;;
    --no-preflight) preflight=0 ;;
    -y|--yes) yes=1 ;;
    --restart) restart=1 ;;
    --evict) opt_evict=1 ;;
    --offload) opt_offload=1 ;;
    --foreground) foreground=1 ;;
    --json) json=1 ;;
    --fix) opt_fix=1 ;;
    --latest) opt_latest=1 ;;
    --accept-risk) need_value "$@"; opt_accept+=("${2^^}"); shift ;;
    --accept-risk=*) opt_accept+=("${1#*=}"); opt_accept[-1]=${opt_accept[-1]^^} ;;
    --remote-code) opt_remote_code=1 ;;
    --code) opt_code=1 ;;
    --deep) opt_deep=1 ;;
    --project) opt_project=1 ;;
    -g|--global) opt_project=0 ;;
    --force) opt_force=1 ;;
    -o|--output) need_value "$@"; opt_output=$2; shift ;;
    --output=*) opt_output=${1#*=} ;;
    --with-engines) opt_with_engines=1 ;;
    --sign) need_value "$@"; opt_sign=$2; shift ;;
    --sign=*) opt_sign=${1#*=} ;;
    --from) need_value "$@"; opt_from=$2; shift ;;
    --from=*) opt_from=${1#*=} ;;
    --sbom) opt_sbom=1 ;;
    --garak) opt_garak=1 ;;
    --probes) need_value "$@"; opt_probes=$2; shift ;;
    --probes=*) opt_probes=${1#*=} ;;
    -v|--verbose) VERBOSE=1 ;;
    -f|--follow) l_follow=1 log_opt=1 ;;
    --errors) l_errors=1 log_opt=1 ;;
    --lines) need_value "$@"; l_lines=$2 log_opt=1; shift ;;
    --lines=*) l_lines=${1#*=} log_opt=1 ;;
    --purge-models) purge_models=1 ;;
    --purge) purge=1 ;;
    --system) need_value "$@"; opt_system=$2; shift ;;
    --system=*) opt_system=${1#*=} ;;
    --think) opt_think=1 ;;
    --reasoning) need_value "$@"; opt_reasoning=${2,,}; shift ;;
    --reasoning=*) opt_reasoning=${1#*=}; opt_reasoning=${opt_reasoning,,} ;;
    --keep-config) keep_config=1 ;;
    --keep-script) keep_script=1 ;;
    --draft) need_value "$@"; opt_draft=$2; shift ;;
    --draft=*) opt_draft=${1#*=} ;;
    --draft-n) need_value "$@"; opt_draft_n=$2; shift ;;
    --draft-n=*) opt_draft_n=${1#*=} ;;
    --no-draft) no_draft=1 ;;
    --runs) need_value "$@"; b_runs=$2 bench_opt=1; shift ;;
    --long) need_value "$@"; b_long=$2 bench_opt=1; shift ;;
    --gen) need_value "$@"; b_gen=$2 bench_opt=1; shift ;;
    --history) b_history=1 bench_opt=1 ;;
    --list) cmd=list ;;
    --download) cmd=download ;;
    --) shift; pass=("$@"); break ;;
    -*) die "unknown option '$1'$(suggest "$1"). Nothing was changed. Flags for the engine itself go after '--'; see $PROG --help" ;;
    *) positional+=("$1") ;;
  esac
  shift
done
if [[ -z $cmd && ${#positional[@]} -gt 0 ]]; then
  case ${positional[0]} in
    setup|list|download|status|ps|stop|env|logs|log|serve|start|uninstall|check|bench|capacity|pin|unpin|doctor|install|upgrade|rollback|versions|trust|models|model|menu|config|key|autostart|chat|gateway|webui|skills|export|import|eval)
      cmd=${positional[0]}; positional=("${positional[@]:1}") ;;
  esac
fi
if [[ $cmd == model || $cmd == menu || ( $cmd == models && ${positional[0]-} != @(outdated|update) ) ]]; then
  cmd=model sub=${positional[0]-list}; model_args=("${positional[@]:1}"); positional=()
  [[ $sub =~ ^(list|add|rm|remove|purge|edit)$ ]] || die "say what to do: '$PROG model list|add|rm|purge|edit' (or '$PROG models outdated|update')"
fi
if [[ $cmd == gateway || $cmd == webui ]]; then
  sub=${positional[0]-}; positional=("${positional[@]:1}")
  [[ -n $sub ]] || { [[ $cmd == webui ]] && sub=start || sub=status; }
  if [[ $cmd == webui ]]; then [[ $sub =~ ^(start|stop|restart|status)$ ]] || die "say what to do: '$PROG webui start|stop|restart|status'"
  else [[ $sub =~ ^(start|stop|status)$ ]] || die "say what to do: '$PROG gateway start|stop|status'"; fi
fi
if [[ $cmd == config || $cmd == key || $cmd == autostart ]]; then
  sub=${positional[0]-}; config_args=("${positional[@]:1}"); positional=()
  case $cmd:$sub in
    config:) sub=list ;; key:) sub=show ;; autostart:) sub=list ;;
    config:list|config:get|config:set|config:unset|config:edit|key:show|key:new|autostart:list|autostart:on|autostart:off) ;;
    config:*) die "say what to do: '$PROG config list|get|set|unset|edit'" ;;
    key:*) die "say what to do: '$PROG key show' or '$PROG key new'" ;;
    autostart:*) die "say what to do: '$PROG autostart list|on|off [MODEL...]'" ;;
  esac
fi
((purge)) && [[ $cmd != model || ! $sub =~ ^(rm|remove)$ ]] && die "--purge only applies to '$PROG model rm'"
if [[ $cmd == skills ]]; then
  sub=${positional[0]-list}; skill_names=("${positional[@]:1}"); positional=()
  [[ $sub =~ ^(list|check|preview|add|update|remove)$ ]] || die "say what to do: '$PROG skills list|check|preview|add|update|remove [NAME...]'"
fi
if [[ $cmd == trust || $cmd == models ]]; then
  sub=${positional[0]-}; positional=("${positional[@]:1}")
  case $cmd:$sub in
    trust:check|trust:approve|trust:revoke|trust:show|trust:verify|trust:list|models:outdated|models:update) ;;
    trust:*) die "say what to do: '$PROG trust check|approve|revoke|show|verify|list [MODEL]'" ;;
    models:*) die "say what to do: '$PROG models outdated' or '$PROG models update MODEL'" ;;
  esac
fi
[[ -n $cmd ]] || cmd=serve
[[ $cmd == start ]] && cmd=serve
[[ $cmd == status ]] && cmd="ps"
if [[ $cmd == export ]]; then export_names=("${positional[@]}"); positional=(); fi
if [[ $cmd == chat ]]; then chat_args=("${positional[@]:1}"); positional=("${positional[@]:0:1}"); fi
[[ (-n $opt_system || $opt_think == 1) && $cmd != chat ]] && die "--system and --think only apply to '$PROG chat'"
[[ -n $opt_reasoning && $cmd != chat && $cmd != bench ]] && die "--reasoning only applies to '$PROG chat' and '$PROG bench'"
[[ -z $opt_reasoning || $opt_reasoning =~ ^(low|medium|high|none)$ ]] || die "--reasoning takes low, medium, high or none"
if [[ $cmd == serve && ${#positional[@]} -gt 1 ]]; then cmd_typo "${positional[0]}"; fi
if [[ ! $cmd =~ ^(install|skills|model|config|key|autostart|gateway|webui)$ ]]; then ((${#positional[@]} <= 1)) || die "unexpected argument '${positional[1]}'. Flags for the engine go after '--'"; fi
sel=${positional[0]-}
if ((purge_models || keep_config || keep_script)) && [[ $cmd != uninstall ]]; then
  die "--purge-models, --keep-config and --keep-script only apply to '$PROG uninstall'"
fi
if ((bench_opt)) && [[ $cmd != bench ]]; then die "--runs, --long, --gen and --history only apply to '$PROG bench'"; fi
if ((log_opt)) && [[ $cmd != log ]]; then die "--follow, --errors and --lines only apply to '$PROG log'"; fi
if ((json)) && [[ ! $cmd =~ ^(ps|check|capacity|list|doctor|versions|trust|models|skills|eval|config|bench)$ ]]; then die "--json applies to ps, check, capacity, list, doctor, versions, trust, models, skills, eval, config and bench"; fi
((opt_garak)) || [[ -n $opt_probes ]] && [[ $cmd != eval ]] && die "--garak and --probes only apply to '$PROG eval'"
[[ -n $opt_probes ]] && ((!opt_garak)) && die "--probes selects garak probes; add --garak"
[[ -z $opt_probes || $opt_probes =~ ^[A-Za-z0-9_.,]+$ ]] || die "--probes takes garak probe names separated by commas"
((opt_project || opt_force)) && [[ $cmd != skills ]] && die "--project and --force only apply to '$PROG skills'"
[[ -n $opt_output || -n $opt_sign ]] || ((opt_with_engines)) && [[ $cmd != export ]] && die "-o, --with-engines and --sign only apply to '$PROG export'"
[[ -n $opt_from && $cmd != install ]] && die "--from only applies to '$PROG install --from BUNDLE'"
((opt_sbom)) && [[ $cmd != versions ]] && die "--sbom only applies to '$PROG versions --sbom'"
if ((${#opt_accept[@]})); then
  for v in "${opt_accept[@]}"; do [[ $v =~ ^[MS]-[A-Z-]+$ ]] || die "--accept-risk takes a rule ID such as M-SCAN-PENDING or S-RECENT, got '$v'"; done
  [[ $cmd =~ ^(serve|download|trust|models|skills)$ ]] || die "--accept-risk applies when a model or skill is checked: serve, download, trust approve, models update, skills add/update"
fi
((opt_remote_code)) && [[ $cmd:$sub != trust:approve ]] && die "--remote-code only applies to '$PROG trust approve MODEL --remote-code'"
((opt_code)) && [[ $cmd:$sub != trust:show ]] && die "--code only applies to '$PROG trust show MODEL --code'"
((opt_deep)) && [[ $cmd != doctor ]] && die "--deep only applies to '$PROG doctor --deep'"
if ((opt_latest)) && [[ $cmd != upgrade ]]; then die "--latest only applies to '$PROG upgrade'"; fi
if ((opt_fix)) && [[ $cmd != doctor ]]; then die "--fix only applies to '$PROG doctor'"; fi
if ((restart || opt_evict || opt_offload || foreground)) && [[ $cmd != serve ]]; then
  die "--restart, --evict, --offload and --foreground only apply when starting a model"
fi
((opt_evict && opt_offload)) && die "--evict and --offload contradict each other; pick one"
for v in "$b_runs" "$b_gen" "${b_long:-0}" "$l_lines"; do [[ $v =~ ^[0-9]+$ ]] || die "--runs, --long, --gen and --lines take a number"; done

# ---- configuration -----------------------------------------------------------
declare -A CFG=(
  [ENGINES]=""                # engines enabled in setup, space-separated
  [DEFAULT_ENGINE]=""         # engine for Hugging Face repos when it cannot be inferred
  [HOST]=127.0.0.1            # bind address
  [PORT]=8080                 # first port; each model gets its own, counting up from here
  [PORT_SPAN]=100             # how many ports above PORT may be handed out
  [AUTH]=auto                 # auto (key unless bound to loopback) | key | none
  [ALLOW_INSECURE]=0          # 1 = allow a non-loopback bind without authentication
  [CTX]=32768                 # context per model (capped at what the model supports), fit, or auto
  [MAX_MODELS]=0              # models running at once; 0 = as many as fit
  [EVICT]=ask                 # ask | lru | never: what to do when a new model does not fit
  [GPUS]=""                   # GPU numbers llmserver may use (as 'check' lists them); empty = all
  [LLAMA_FLAGS]="--jinja"
  [VLLM_FLAGS]=""
  [OLLAMA_ATTACH]=""          # host:port of an Ollama daemon to use instead of starting one
  [OLLAMA_KEEP_ALIVE]=-1      # -1 keeps the model loaded
  [DRAFT_N]=4                 # tokens a draft model proposes per step
  [NUMA]=auto                 # auto: run each server on the NUMA node of its GPU; off
  [TUNING]=on                 # on: apply the rules in config/tuning; off
  [LLAMA_SOURCE]=managed      # managed: llmserver's own copy in LLMSERVER_HOME; system: from PATH; or the program's path or folder
  [VLLM_SOURCE]=managed
  [OLLAMA_SOURCE]=managed
  [LLAMA_BUILD]=auto          # auto | cpu | vulkan | cuda-12.8 | cuda-13.4 (managed llama.cpp)
  [AUTO_INSTALL]=on           # on: install the small Python runtime on first use; off: only on 'install'
  [VRAM_GUARD]=enforce        # off | warn | enforce (refuse what will not run) | strict
  [VRAM_RESERVE_MB]=512       # headroom kept free on top of the estimate
  [VERIFY]=require            # require | off  (content-hash check after a download; strict requires it)
  [SECURITY]=standard         # standard | strict: how the security checks treat unknowns (see 'llmserver trust')
  [ALLOW_PICKLE]=off          # on: allow vLLM repositories that have only pickle weights (never under strict)
  [LOCK_MODELS]=off           # off | ask | on: write the checked commit into the menu entry (repo@commit)
  [SKILLS]=ask                # ask | on | off: setup offers (ask), installs (on) or skips (off) the llmserver and hf-cli skills
  [SCANNERS]=auto             # auto: also run clamscan, modelscan and gitleaks when they are on PATH; off
  [TRUST_SIGNERS]=""          # ssh allowed_signers file: bundles must be signed by one of its keys (needed with strict)
  [SANDBOX]=auto              # auto: run engines in a bubblewrap sandbox when bwrap works here; on: required; off
  [GATEWAY_HOST]=127.0.0.1    # the gateway: one OpenAI-compatible address for every running model
  [GATEWAY_PORT]=8000
  [WEBUI]=ask                 # ask | on | off: setup offers (ask), installs (on) or skips (off) Open WebUI
  [WEBUI_HOST]=0.0.0.0        # Open WebUI: 0.0.0.0 = people on the network can use it (with accounts); 127.0.0.1 = this computer only
  [WEBUI_PORT]=3000
  [WEBUI_AUTH]=on             # on: accounts (the first is the admin, who adds people); off: only with WEBUI_HOST=127.0.0.1
  [WEBUI_RAG]=hybrid          # documents: hybrid (BM25 + vector search, then the reranker) | vector
  [WEBUI_RERANKER]=fast       # fast (small, on the CPU) | best (bge-reranker-v2-m3 on llama.cpp, GPU) | off
  [WEBUI_SEARCH]=off          # on: web search through a private SearXNG (the questions go to public search engines) | off
  [WEBUI_SEARCH_PORT]=8888    # SearXNG's port, on 127.0.0.1 only (only Open WebUI uses it)
  [READY_TIMEOUT]=900         # seconds to wait for a new server to become healthy
  [STOP_TIMEOUT]=20           # seconds between SIGTERM and SIGKILL
  [LOG_LEVEL]=info            # info | debug  (install.log detail)
  [LOG_MAX_MB]=5              # install.log is rotated past this size; 3 old copies are kept
)
declare -A DEFAULT_CFG=()
for _k in "${!CFG[@]}"; do DEFAULT_CFG[$_k]=${CFG[$_k]}; done; unset _k
readonly CFG_ORDER=(ENGINES DEFAULT_ENGINE HOST PORT PORT_SPAN AUTH ALLOW_INSECURE CTX MAX_MODELS EVICT GPUS
  LLAMA_FLAGS VLLM_FLAGS OLLAMA_ATTACH OLLAMA_KEEP_ALIVE DRAFT_N NUMA TUNING VRAM_GUARD VRAM_RESERVE_MB VERIFY
  READY_TIMEOUT STOP_TIMEOUT LOG_LEVEL LOG_MAX_MB LLAMA_SOURCE VLLM_SOURCE OLLAMA_SOURCE LLAMA_BUILD AUTO_INSTALL
  SECURITY ALLOW_PICKLE LOCK_MODELS SKILLS SCANNERS TRUST_SIGNERS SANDBOX GATEWAY_HOST GATEWAY_PORT WEBUI WEBUI_HOST WEBUI_PORT WEBUI_AUTH WEBUI_RAG WEBUI_RERANKER WEBUI_SEARCH WEBUI_SEARCH_PORT)
readonly PATH_KEYS=(MODEL_STORE SYSFS PROCFS DEVFS OLLAMA_REGISTRY SYS_ENV_FILE
  HOME GITHUB GITHUB_API PYPI VLLM_ROCM_INDEX FLASHINFER_INDEX SECURITY_FLOOR SKILLS_MIRROR SANDBOX_RW)
have_config=0
load_config() {
  local key n
  [[ -r $env_file || -r $sys_env_file ]] && have_config=1
  for key in "${CFG_ORDER[@]}"; do
    n=LLMSERVER_$key
    if [[ -v $n ]]; then CFG[$key]=${!n}; elif [[ -v ENVF[$n] ]]; then CFG[$key]=${ENVF[$n]}; fi
  done
  for n in "${!ENVF[@]}"; do
    [[ $n == LLMSERVER_* ]] || continue
    key=${n#LLMSERVER_}
    [[ -v CFG[$key] || " ${PATH_KEYS[*]} " == *" $key "* ]] && continue
    warn "unknown setting $n in ${ENVF_SRC[$n]}; ignored"
  done
  # settings the python helper reads from its environment
  n=LLMSERVER_OLLAMA_REGISTRY
  [[ -v $n || ! -v ENVF[$n] ]] || export "$n=${ENVF[$n]}"
  debug "settings: $(for key in "${CFG_ORDER[@]}"; do printf '%s=%q ' "$key" "${CFG[$key]}"; done)"
}
env_val() {  # value -> a form safe for the settings file
  if [[ $1 =~ ^[A-Za-z0-9._,:/@+-]*$ ]]; then printf '%s' "$1"; else printf '"%s"' "${1//\"/}"; fi
}
write_env_file() {  # write llmserver.env from CFG, keeping any engine variables already in it
  local tmp=$env_file.tmp.$$ keep=""
  mkdir -p "${env_file%/*}"
  if [[ -r $env_file ]]; then
    keep=$(grep -E '^[[:space:]]*(export[[:space:]]+)?[A-Za-z_][A-Za-z0-9_]*[[:space:]]*=' "$env_file" | grep -vE '^[[:space:]]*(export[[:space:]]+)?LLMSERVER_' || true)
  fi
  (umask 077; {
    cat <<HDR
# llmserver settings: every variable and parameter in one place.
# Written by '$PROG' on $(date +%F); edit freely, it is re-read on every run.
#
# Format: KEY=VALUE lines (also usable as a systemd EnvironmentFile or 'docker --env-file').
# It is parsed, never executed: no \$VARIABLES are expanded; a leading ~/ means your home folder.
# Precedence: command-line options > environment variables > this file > /etc/llmserver_env > defaults.
# Run '$PROG check' after editing; errors are reported and recorded in install.log.

## Engines and models
# Engines offered: any of llama vllm ollama
LLMSERVER_ENGINES=$(env_val "${CFG[ENGINES]}")
# Engine for Hugging Face repos when it cannot be inferred from the name
LLMSERVER_DEFAULT_ENGINE=$(env_val "${CFG[DEFAULT_ENGINE]}")
# Context per model in tokens (capped at what the model supports); fit = the largest that fits in
# the free VRAM when it starts; auto = the engine's own default
LLMSERVER_CTX=$(env_val "${CFG[CTX]}")
# Flags added to every 'llama serve' / 'vllm serve' (split on whitespace). For example
# "--jinja -fa on --cache-type-k q8_0 --cache-type-v q8_0" halves llama.cpp's KV cache
LLMSERVER_LLAMA_FLAGS=$(env_val "${CFG[LLAMA_FLAGS]}")
LLMSERVER_VLLM_FLAGS=$(env_val "${CFG[VLLM_FLAGS]}")
# Tokens a draft model proposes per step (speculative decoding)
LLMSERVER_DRAFT_N=$(env_val "${CFG[DRAFT_N]}")

## Several models at once
# Most models running at the same time; 0 = as many as the GPUs hold. 1 = one at a time
LLMSERVER_MAX_MODELS=$(env_val "${CFG[MAX_MODELS]}")
# When a new model does not fit: ask = list what would have to stop and ask (refuse without a
# terminal); lru = stop the least recently used unpinned models automatically; never = refuse
LLMSERVER_EVICT=$(env_val "${CFG[EVICT]}")
# GPUs llmserver may use, as numbered by '$PROG check' (for example 0,2); empty = all
LLMSERVER_GPUS=$(env_val "${CFG[GPUS]}")

## Self-contained engines (installed into LLMSERVER_HOME by '$PROG install'; nothing outside it)
# managed: llmserver's own pinned, checksum-verified copy; system: the program found on PATH;
# or the full path of your own copy (the program, or its folder: also bin/ and build/bin/ inside)
LLMSERVER_LLAMA_SOURCE=$(env_val "${CFG[LLAMA_SOURCE]}")
LLMSERVER_VLLM_SOURCE=$(env_val "${CFG[VLLM_SOURCE]}")
LLMSERVER_OLLAMA_SOURCE=$(env_val "${CFG[OLLAMA_SOURCE]}")
# llama.cpp build: auto (picked from the GPUs and driver) | cpu | vulkan | cuda-12.8 | cuda-13.4
LLMSERVER_LLAMA_BUILD=$(env_val "${CFG[LLAMA_BUILD]}")
# on: install the small Python runtime (uv, Python, helper) automatically when first needed
LLMSERVER_AUTO_INSTALL=$(env_val "${CFG[AUTO_INSTALL]}")
# LLMSERVER_GITHUB=https://github.com        (a mirror works: every file is checked against its pinned SHA-256)
# LLMSERVER_PYPI=https://pypi.org            (a Python package mirror; hashes are still enforced)

## Network and security
# Bind address. Each model gets its own port, counting up from PORT (at most PORT_SPAN above it);
# a model keeps the same port across restarts
LLMSERVER_HOST=$(env_val "${CFG[HOST]}")
LLMSERVER_PORT=$(env_val "${CFG[PORT]}")
LLMSERVER_PORT_SPAN=$(env_val "${CFG[PORT_SPAN]}")
# auto (API key unless bound to loopback) | key (always) | none. llama.cpp and vLLM only
LLMSERVER_AUTH=$(env_val "${CFG[AUTH]}")
# 1 = allow a non-loopback bind without authentication
LLMSERVER_ALLOW_INSECURE=$(env_val "${CFG[ALLOW_INSECURE]}")

## Web chat: the gateway and Open WebUI ('$PROG webui')
# The gateway: one OpenAI-compatible address (http://HOST:PORT/v1) for every running model
LLMSERVER_GATEWAY_HOST=$(env_val "${CFG[GATEWAY_HOST]}")
LLMSERVER_GATEWAY_PORT=$(env_val "${CFG[GATEWAY_PORT]}")
# Open WebUI: ask | on | off (offered, installed or skipped by setup)
LLMSERVER_WEBUI=$(env_val "${CFG[WEBUI]}")
# 0.0.0.0 = people on the network can use it (each with an account); 127.0.0.1 = this computer only
LLMSERVER_WEBUI_HOST=$(env_val "${CFG[WEBUI_HOST]}")
LLMSERVER_WEBUI_PORT=$(env_val "${CFG[WEBUI_PORT]}")
# on: accounts (the first one is the admin, who adds people or allows sign-ups); off: only on 127.0.0.1
LLMSERVER_WEBUI_AUTH=$(env_val "${CFG[WEBUI_AUTH]}")
# documents: hybrid (keyword BM25 + vector search, merged, then reranked) | vector
LLMSERVER_WEBUI_RAG=$(env_val "${CFG[WEBUI_RAG]}")
# fast (small, CPU) | best (bge-reranker-v2-m3 on llama.cpp, GPU, many languages) | off
LLMSERVER_WEBUI_RERANKER=$(env_val "${CFG[WEBUI_RERANKER]}")
# on: web search through a private SearXNG on 127.0.0.1 (the questions go to public search engines) | off
LLMSERVER_WEBUI_SEARCH=$(env_val "${CFG[WEBUI_SEARCH]}")
LLMSERVER_WEBUI_SEARCH_PORT=$(env_val "${CFG[WEBUI_SEARCH_PORT]}")

## Ollama
# host:port of an existing Ollama daemon to load models on; empty = one 'ollama serve' per model
LLMSERVER_OLLAMA_ATTACH=$(env_val "${CFG[OLLAMA_ATTACH]}")
# -1 keeps a model loaded; otherwise a duration such as 30m
LLMSERVER_OLLAMA_KEEP_ALIVE=$(env_val "${CFG[OLLAMA_KEEP_ALIVE]}")

## Hardware checks and placement
# off | warn | enforce (refuse models that cannot run) | strict (also refuse tight or CPU-offloaded fits)
LLMSERVER_VRAM_GUARD=$(env_val "${CFG[VRAM_GUARD]}")
# VRAM in MiB kept free on every GPU on top of the models
LLMSERVER_VRAM_RESERVE_MB=$(env_val "${CFG[VRAM_RESERVE_MB]}")
# auto: run each server on the NUMA node of its GPU; off
LLMSERVER_NUMA=$(env_val "${CFG[NUMA]}")
# on: apply the rules in $config_dir/tuning; off
LLMSERVER_TUNING=$(env_val "${CFG[TUNING]}")

## Downloads, timeouts and logging
# require | off: check every downloaded file against its content hash
LLMSERVER_VERIFY=$(env_val "${CFG[VERIFY]}")
# Seconds to wait for a new server to become healthy, and between SIGTERM and SIGKILL
LLMSERVER_READY_TIMEOUT=$(env_val "${CFG[READY_TIMEOUT]}")
LLMSERVER_STOP_TIMEOUT=$(env_val "${CFG[STOP_TIMEOUT]}")
# install.log detail: info | debug; rotated past LOG_MAX_MB, 3 old copies kept
LLMSERVER_LOG_LEVEL=$(env_val "${CFG[LOG_LEVEL]}")
LLMSERVER_LOG_MAX_MB=$(env_val "${CFG[LOG_MAX_MB]}")

## Model files: shared (the usual Hugging Face and Ollama caches, used by other tools too) or
## private (inside $lhome/models)
# LLMSERVER_MODEL_STORE=shared

## Engine environment: passed to llmserver and to every engine it starts
# HF_TOKEN=            # for gated Hugging Face models (this file is then kept private: mode 600)
# HF_HOME=             # Hugging Face cache location (default ~/.cache/huggingface)
# HF_ENDPOINT=         # a Hugging Face mirror
# OLLAMA_MODELS=       # Ollama model store
# ROCM_PATH=           # ROCm installation (default /opt/rocm)
# Note: llmserver sets CUDA_VISIBLE_DEVICES / HIP_VISIBLE_DEVICES per model; use LLMSERVER_GPUS instead.
HDR
    if [[ -n $keep ]]; then printf '%s\n' "$keep"; fi
  } > "$tmp") && mv -f -- "$tmp" "$env_file"
  note "wrote the settings file $env_file"
}
validate_config() {
  local e
  for e in PORT PORT_SPAN; do
    [[ ${CFG[$e]} =~ ^[0-9]+$ ]] || die "LLMSERVER_$e must be a number, got '${CFG[$e]}'"
  done
  ((CFG[PORT] >= 1 && CFG[PORT] <= 65535)) || die "LLMSERVER_PORT must be 1-65535, got '${CFG[PORT]}'"
  [[ ${CFG[HOST]} =~ ^[A-Za-z0-9.:_-]+$ ]] || die "LLMSERVER_HOST '${CFG[HOST]}' is not a valid address"
  [[ ${CFG[AUTH]} =~ ^(auto|key|none)$ ]] || die "LLMSERVER_AUTH must be auto, key or none, got '${CFG[AUTH]}'"
  [[ ${CFG[CTX]} =~ ^(auto|fit|[1-9][0-9]*)$ ]] || die "LLMSERVER_CTX must be a number, 'fit' or 'auto', got '${CFG[CTX]}'"
  [[ ${CFG[EVICT]} =~ ^(ask|lru|never)$ ]] || die "LLMSERVER_EVICT must be ask, lru or never, got '${CFG[EVICT]}'"
  [[ ${CFG[GPUS]} =~ ^[0-9,[:space:]]*$ ]] || die "LLMSERVER_GPUS must list GPU numbers such as 0,2 (see '$PROG check'), got '${CFG[GPUS]}'"
  [[ ${CFG[VRAM_GUARD]} =~ ^(off|warn|enforce|strict)$ ]] || die "LLMSERVER_VRAM_GUARD must be off, warn, enforce or strict"
  [[ ${CFG[VERIFY]} =~ ^(require|off)$ ]] || die "LLMSERVER_VERIFY must be 'require' or 'off'"
  [[ ${CFG[SECURITY]} =~ ^(standard|strict)$ ]] || die "LLMSERVER_SECURITY must be 'standard' or 'strict', got '${CFG[SECURITY]}'"
  [[ ${CFG[ALLOW_PICKLE]} =~ ^(on|off)$ ]] || die "LLMSERVER_ALLOW_PICKLE must be 'on' or 'off'"
  [[ ${CFG[LOCK_MODELS]} =~ ^(off|ask|on)$ ]] || die "LLMSERVER_LOCK_MODELS must be off, ask or on"
  [[ ${CFG[SKILLS]} =~ ^(ask|on|off)$ ]] || die "LLMSERVER_SKILLS must be ask, on or off"
  [[ ${CFG[SCANNERS]} =~ ^(auto|off)$ ]] || die "LLMSERVER_SCANNERS must be auto or off"
  [[ ${CFG[SANDBOX]} =~ ^(auto|on|off)$ ]] || die "LLMSERVER_SANDBOX must be auto, on or off"
  for e in GATEWAY_PORT WEBUI_PORT WEBUI_SEARCH_PORT; do
    { [[ ${CFG[$e]} =~ ^[0-9]+$ ]] && ((CFG[$e] >= 1 && CFG[$e] <= 65535)); } || die "LLMSERVER_$e must be a port number (1-65535), got '${CFG[$e]}'"
  done
  ((CFG[GATEWAY_PORT] != CFG[WEBUI_PORT])) || die "LLMSERVER_GATEWAY_PORT and LLMSERVER_WEBUI_PORT must differ"
  ((CFG[WEBUI_SEARCH_PORT] != CFG[WEBUI_PORT] && CFG[WEBUI_SEARCH_PORT] != CFG[GATEWAY_PORT])) || die "LLMSERVER_WEBUI_SEARCH_PORT must differ from the gateway's and Open WebUI's ports"
  [[ ${CFG[WEBUI_RAG]} =~ ^(hybrid|vector)$ ]] || die "LLMSERVER_WEBUI_RAG must be hybrid or vector"
  [[ ${CFG[WEBUI_RERANKER]} =~ ^(fast|best|off)$ ]] || die "LLMSERVER_WEBUI_RERANKER must be fast, best or off"
  [[ ${CFG[WEBUI_SEARCH]} =~ ^(on|off)$ ]] || die "LLMSERVER_WEBUI_SEARCH must be on or off"
  for e in GATEWAY_HOST WEBUI_HOST; do [[ ${CFG[$e]} =~ ^[A-Za-z0-9.:_-]+$ ]] || die "LLMSERVER_$e '${CFG[$e]}' is not a valid address"; done
  [[ ${CFG[WEBUI]} =~ ^(ask|on|off)$ ]] || die "LLMSERVER_WEBUI must be ask, on or off"
  [[ ${CFG[WEBUI_AUTH]} =~ ^(on|off)$ ]] || die "LLMSERVER_WEBUI_AUTH must be on or off"
  if [[ ${CFG[WEBUI_AUTH]} == off ]] && ! is_loopback "${CFG[WEBUI_HOST]}"; then
    die "LLMSERVER_WEBUI_AUTH=off is only allowed with LLMSERVER_WEBUI_HOST=127.0.0.1: on the network, everyone needs an account"
  fi
  for e in LLAMA VLLM OLLAMA; do
    case ${CFG[${e}_SOURCE]} in
      managed|system) ;;
      /*) [[ -e ${CFG[${e}_SOURCE]} ]] || die "LLMSERVER_${e}_SOURCE: ${CFG[${e}_SOURCE]} does not exist" ;;
      *) die "LLMSERVER_${e}_SOURCE must be managed, system, or the full path of the program or its folder, got '${CFG[${e}_SOURCE]}'" ;;
    esac
  done
  [[ $(setting LLMSERVER_MODEL_STORE shared) =~ ^(shared|private)$ ]] || die "LLMSERVER_MODEL_STORE must be shared or private"
  [[ -z ${CFG[TRUST_SIGNERS]} || -r ${CFG[TRUST_SIGNERS]} ]] || die "LLMSERVER_TRUST_SIGNERS: cannot read ${CFG[TRUST_SIGNERS]}"
  sec_floor; e=$SEC_FLOOR
  [[ -z $e || $e =~ ^(standard|strict)$ ]] || ENV_WARNINGS+=("LLMSERVER_SECURITY_FLOOR in $sys_env_file must be 'standard' or 'strict'; ignored")
  SEC_LEVEL=${CFG[SECURITY]}
  if [[ $e == strict && $SEC_LEVEL != strict ]]; then
    SEC_LEVEL=strict; note "SECURITY=strict, because the administrator set LLMSERVER_SECURITY_FLOOR=strict in $sys_env_file"
  fi
  [[ $SEC_LEVEL == strict && ${CFG[VERIFY]} == off ]] && die "LLMSERVER_VERIFY=off is not allowed with SECURITY=strict"
  [[ ${CFG[NUMA]} =~ ^(auto|off)$ ]] || die "LLMSERVER_NUMA must be 'auto' or 'off'"
  [[ ${CFG[TUNING]} =~ ^(on|off)$ ]] || die "LLMSERVER_TUNING must be 'on' or 'off'"
  [[ ${CFG[LLAMA_BUILD]} =~ ^(auto|cpu|vulkan|cuda-12\.8|cuda-13\.4)$ ]] || die "LLMSERVER_LLAMA_BUILD must be auto, cpu, vulkan, cuda-12.8 or cuda-13.4"
  [[ ${CFG[AUTO_INSTALL]} =~ ^(on|off)$ ]] || die "LLMSERVER_AUTO_INSTALL must be 'on' or 'off'"
  [[ ${CFG[LOG_LEVEL]} =~ ^(info|debug)$ ]] || die "LLMSERVER_LOG_LEVEL must be 'info' or 'debug'"
  [[ ${CFG[LOG_MAX_MB]} =~ ^[0-9]+(\.[0-9]+)?$ ]] || die "LLMSERVER_LOG_MAX_MB must be a number, got '${CFG[LOG_MAX_MB]}'"
  for e in READY_TIMEOUT STOP_TIMEOUT VRAM_RESERVE_MB DRAFT_N MAX_MODELS; do
    [[ ${CFG[$e]} =~ ^[0-9]+$ ]] || die "LLMSERVER_$e must be a number, got '${CFG[$e]}'"
  done
  for e in ${CFG[ENGINES]} ${CFG[DEFAULT_ENGINE]}; do
    [[ $e =~ ^(llama|vllm|ollama)$ ]] || die "unknown engine '$e' in the settings"
  done
  if [[ -n ${CFG[OLLAMA_ATTACH]} ]]; then
    [[ ${CFG[OLLAMA_ATTACH]} =~ ^[A-Za-z0-9.:_-]+:[0-9]+$ ]] || die "LLMSERVER_OLLAMA_ATTACH must be host:port"
  fi
  CFG[GPUS]=${CFG[GPUS]//[[:space:]]/}
}

# ---- self-contained runtime and engines ------------------------------------------
# llmserver installs everything it runs into one folder it owns, LLMSERVER_HOME, and nothing
# anywhere else: no sudo, no system packages, no system Python, no services, no PATH or shell
# changes. The only things it needs from the operating system are the kernel GPU driver and,
# for the Vulkan build of llama.cpp, the Vulkan loader that comes with the graphics driver.
#
#   LLMSERVER_HOME/
#     bin/uv                    uv, pinned and checksum-verified; never put on PATH
#     python/                   Python builds installed by uv (it verifies their checksums)
#     runtime/helper/           venv: llmserver's helper and the 'hf' CLI, installed from hashes
#     engines/llama.cpp/        prebuilt llama.cpp release for the GPUs found (CUDA, Vulkan, CPU)
#     engines/ollama/           Ollama release, plus its ROCm libraries on AMD
#     engines/vllm/             venv: vLLM and its own PyTorch (CUDA or ROCm), hash-locked
#     locks/                    the exact package set (with hashes) of every Python venv
#     cache/, tmp/              downloads and staging; emptied after each install
#     trust/records/model/      one check record per model and commit (see 'llmserver trust')
#
# Every download is pinned below by version and SHA-256 and checked before it is unpacked.
# Archives are unpacked by Python's tarfile with the 'data' filter, which refuses absolute
# paths, '..', links that leave the folder, device files and setuid bits. Each component is
# built in tmp/, checked (it must run), then renamed into place and made 'current'; the
# version it replaces stays as 'previous' for 'llmserver rollback'. Models stay in the usual
# caches (Hugging Face, Ollama), so they are shared with other tools instead of downloaded twice.
readonly HOME_MARK=.llmserver-home

