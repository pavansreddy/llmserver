def finding(P, rid, msg, path=None):
    std, strict, ov = RULES[rid]
    for f in P['findings']:
        if f['id'] == rid and f.get('file') == path: return
    P['findings'].append({'id': rid, 'severity': strict if LEVEL == 'strict' else std, 'override': ov,
