searxng_treehash() {  # dir -> SHA-256 over searx/ and the requirements: the pin, whichever way the source came
  "$(helper_python)" -I - "$1" <<'PY'
import hashlib, os, sys
root, out = sys.argv[1], []
for dp, dns, fns in os.walk(os.path.join(root, 'searx')):
    for fn in fns:
        p = os.path.join(dp, fn)
        h = 'link:' + os.readlink(p) if os.path.islink(p) else hashlib.sha256(open(p, 'rb').read()).hexdigest()
        out.append('%s  %s\n' % (h, os.path.relpath(p, root)))
for f in ('requirements.txt', 'requirements-server.txt', 'LICENSE'):
    out.append('%s  %s\n' % (hashlib.sha256(open(os.path.join(root, f), 'rb').read()).hexdigest(), f))
print(hashlib.sha256(''.join(sorted(out)).encode()).hexdigest())
PY
}
install_searxng() {
  local c d st py lock got
  c=${PIN[searxng]} d=$(searxng_dir) py=$(pin python_engine)
  searxng_installed && return 0
  install_runtime
  info "installing SearXNG (source ${c:0:12}, about ${PIN_SIZE[searxng]} MB) for web search"
  st=$(stage_dir searxng)
  note "download: $GH/searxng/searxng/archive/$c.tar.gz (checked by its content SHA-256 $SEARXNG_TREE)"
  if curl -fsSL --proto '=https' --proto-redir '=https' --tlsv1.2 --retry 3 --connect-timeout 30 --max-redirs 5 -o "$st/src.tar.gz" -- "$GH/searxng/searxng/archive/$c.tar.gz" 2>>"$st/err"; then
    mkdir -p "$st/x"; untar_safe "$st/src.tar.gz" "$st/x"
    [[ -d $st/x/searxng-$c ]] || { rm -rf -- "$st"; die "the SearXNG archive does not have the expected layout"; }
    mv -- "$st/x/searxng-$c" "$st/src"
  elif have git; then   # the archive host is unreachable: the same commit with git (the content check below decides)
    note "the archive did not download ($(tr '\n' ' ' < "$st/err")); fetching commit $c with git"
    if ! { git init -q "$st/src" && git -C "$st/src" fetch -q --depth 1 "$GH/searxng/searxng.git" "$c" && git -C "$st/src" -c advice.detachedHead=false checkout -q FETCH_HEAD; }; then
      rm -rf -- "$st"; die "could not download SearXNG (from $GH, as an archive or with git); check the network or LLMSERVER_GITHUB"
    fi
    rm -rf -- "$st/src/.git"
  else
    rm -rf -- "$st"; die "could not download SearXNG from $GH; check the network or LLMSERVER_GITHUB"
  fi
  got=$(searxng_treehash "$st/src") || got=""
  [[ $got == "$SEARXNG_TREE" ]] || { rm -rf -- "$st"; die "the SearXNG source does not match llmserver's pin (content SHA-256 $got, expected $SEARXNG_TREE); nothing was installed"; }
  find "$st/src" -mindepth 1 -maxdepth 1 ! -name searx ! -name requirements.txt ! -name requirements-server.txt ! -name LICENSE -exec rm -rf -- {} +
  printf '# made by llmserver from the pinned commit\nVERSION_STRING = "%s"\nVERSION_TAG = "%s"\nDOCKER_TAG = ""\nGIT_URL = "https://github.com/searxng/searxng"\nGIT_BRANCH = "master"\n' \
    "${c:0:12}" "${c:0:12}" > "$st/src/searx/version_frozen.py"
  uvc python install "$py" --no-bin >/dev/null 2>&1 || uvc python install "$py" --no-bin || die "uv could not install Python $py"
  lock=$lhome/locks/searxng-${c:0:12}.txt
  if [[ ! -s $lock ]]; then
    uvc pip compile "$st/src/requirements.txt" "$st/src/requirements-server.txt" --python-version "${py%.*}" --generate-hashes \
      --no-header --quiet -o "$lock.tmp" || { rm -rf -- "$lock.tmp" "$st"; die "could not resolve SearXNG's packages"; }
    mv -f -- "$lock.tmp" "$lock"
  fi
  uvc venv --relocatable --python "$py" --no-project --quiet "$st/venv" || die "could not create SearXNG's venv"
  uvc pip sync --quiet --require-hashes --python "$st/venv/bin/python" "$lock" || { rm -rf -- "$st"; die "could not install SearXNG's packages (hash-checked against $lock)"; }
  "$st/venv/bin/python" -I -c 'import flask, lxml, granian, msgspec' 2>/dev/null || { rm -rf -- "$st"; die "the installed SearXNG packages do not load"; }
  chmod -R go-w -- "$st/venv" "$st/src"
  rm -rf -- "$d"; mkdir -p "$d"; mv -- "$st/src" "$d/src"; mv -- "$st/venv" "$d/venv"; rm -rf -- "$st"
  log_write info "installed SearXNG ${c:0:12} into $d"
}
