                return r.read(), r.headers
        except urllib.error.HTTPError as e:
            if e.code < 500: raise
            last = e
        except (urllib.error.URLError, OSError) as e:
            last = e
        time.sleep(1 + attempt)
    raise Offline(net_reason(last))

