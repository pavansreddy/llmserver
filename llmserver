    "ENABLE_RAG_HYBRID_SEARCH rag.enable_hybrid_search $hybrid"
    "RAG_HYBRID_BM25_WEIGHT rag.hybrid_bm25_weight 0.5"
    "RAG_TOP_K rag.top_k $k"
