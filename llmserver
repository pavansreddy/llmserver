    "RAG_EXTERNAL_RERANKER_API_KEY rag.external_reranker_api_key \"none\""
    "ENABLE_WEB_SEARCH web.search.enable $search"
    "WEB_SEARCH_ENGINE web.search.engine \"searxng\""
    "SEARXNG_QUERY_URL web.search.searxng_query_url \"http://127.0.0.1:${CFG[WEBUI_SEARCH_PORT]}/search?q=<query>\""
