def cmd_upstream(recfile):
    R = json.load(open(recfile))
    if R.get('source') == 'file':   # a local file has no upstream
        print('upstream\t%s\tsame' % R.get('commit')); return
    try:
        if R['engine'] == 'ollama' and R.get('source') == 'registry':
            name, _, tag = R['name'].partition(':')
            full = name if '/' in name else 'library/' + name
            body, _ = http('%s/v2/%s/manifests/%s' % (REG, full, q(tag)), accept='application/vnd.docker.distribution.manifest.v2+json')
            cur = hashlib.sha256(body).hexdigest(); changed = []
        else:
            info = getj('%s/api/models/%s/revision/%s' % (HF, R['repo'], q(R.get('ref') or 'main')))
            cur = info.get('sha'); changed = []
            if cur and cur != R.get('commit'):
                new = {e['path']: (e.get('lfs') or {}).get('oid') or e.get('oid') for e in hub_tree(R['repo'], cur) if e.get('type') == 'file'}
                old = {f['path']: f.get('sha256') or f.get('git_oid') for f in R['files']}
                changed = sorted(p for p in set(new) | set(old) if new.get(p) != old.get(p))
    except Exception as e:
        print('error\t%s' % type(e).__name__); return
    print('upstream\t%s\t%s' % (cur, 'same' if cur == R.get('commit') else 'moved'))
    for p in changed[:50]: print('changed\t%s' % p)

