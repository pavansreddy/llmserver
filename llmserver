# Memory placement: on machines with several NUMA nodes (multi-socket, or CPUs with several
# memory domains), run each server on the CPU cores and memory nearest its GPU(s).
NUMA_NODES=0 S_PREFIX=() NUMA_NOTE=""
numa_plan() {  # engine -> S_PREFIX (numactl or taskset), NUMA_NOTE, for the GPUs in PLACE_IDX
  local i n="" node cpus idx=()
  S_PREFIX=() NUMA_NOTE=""
  NUMA_NODES=$( { compgen -G "$sysfs/devices/system/node/node[0-9]*" || true; } | wc -l)
  [[ ${CFG[NUMA]} == auto ]] && ((NUMA_NODES > 1)) || return 0
  idx=("${PLACE_IDX[@]}")
  if ((${#idx[@]} == 0)); then gpu_view "$1"; for i in "${V_IDX[@]}"; do ((i >= 0)) && idx+=("$i"); done; fi
  if ((${#idx[@]} == 0)); then NUMA_NOTE="no GPU in use; left to the operating system"; return 0; fi
  for i in "${idx[@]}"; do
    node=${G_NUMA[i]:--1}
    ((node >= 0)) || { NUMA_NOTE="the driver does not report which NUMA node ${G_NAME[i]} is attached to"; return 0; }
    if [[ -z $n ]]; then n=$node; elif [[ $n != "$node" ]]; then NUMA_NOTE="its GPUs sit on different NUMA nodes; left to the operating system"; return 0; fi
  done
  cpus=""; [[ -r $sysfs/devices/system/node/node$n/cpulist ]] && cpus=$(<"$sysfs/devices/system/node/node$n/cpulist")
  container_probe
  if [[ -n $cpus && -n $CT_CPUS ]]; then   # only the CPUs this process may run on (cpuset, affinity)
    cpus=$(cpulist_and "$cpus" "$CT_CPUS")
    [[ -n $cpus ]] || { NUMA_NOTE="none of NUMA node $n's CPUs are allowed for this process ($CT_CPUS); left to the operating system"; return 0; }
  fi
  if have numactl; then   # preferred, not bound: offloaded layers may need more memory than the node has
    if [[ -n $cpus ]]; then S_PREFIX=(numactl "--physcpubind=$cpus" "--preferred=$n")
    else S_PREFIX=(numactl "--cpunodebind=$n" "--preferred=$n"); fi
  elif have taskset && [[ -n $cpus ]]; then
    S_PREFIX=(taskset -c "$cpus")
  else
    NUMA_NOTE="install numactl (or taskset) to run the server next to its GPU on NUMA node $n"; return 0
  fi
  NUMA_NOTE="running on NUMA node $n, where its GPU is attached"
}

