def net_reason(e):
    """a network error in plain words"""
    if isinstance(e, urllib.error.HTTPError): return 'the server answered HTTP %d' % e.code
    r = getattr(e, 'reason', e); t = str(r).lower()
    for k, v in (('refused', 'connection refused'), ('timed out', 'timed out'), ('name or service', 'the name could not be resolved'),
                 ('temporary failure in name', 'the name could not be resolved'), ('certificate', 'the TLS certificate was not accepted'),
                 ('unreachable', 'the network is unreachable'), ('reset', 'the connection was reset')):
