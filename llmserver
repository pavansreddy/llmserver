declare -A PINL=()   # pins.local: newer pins verified by 'upgrade --latest'
pins_load() {
  local line k v
  PINL=()
  [[ -r $lhome/pins.local ]] || return 0
  while IFS= read -r line; do
    [[ $line =~ ^([A-Za-z0-9_.@:+-]+)=([A-Za-z0-9_.+-]+)$ ]] || continue
    k=${BASH_REMATCH[1]} v=${BASH_REMATCH[2]}
    PINL[$k]=$v
  done < "$lhome/pins.local"
}
pin() { if [[ -v PINL[$1] ]]; then printf '%s\n' "${PINL[$1]}"; else printf '%s\n' "${PIN[$1]-}"; fi; }
pin_sha() { if [[ -v PINL[sha:$1] ]]; then printf '%s\n' "${PINL[sha:$1]}"; else printf '%s\n' "${PIN_SHA[$1]-}"; fi; }

arch_of() {  # uv | llama | ollama -> this machine's architecture name in that project's assets
  local m; m=$(uname -m)
  case $1:$m in
    uv:x86_64) echo x86_64 ;; uv:aarch64|uv:arm64) echo aarch64 ;;
    llama:x86_64) echo x64 ;; llama:aarch64|llama:arm64) echo arm64 ;;
    ollama:x86_64) echo amd64 ;; ollama:aarch64|ollama:arm64) echo arm64 ;;
    *) return 1 ;;
  esac
}
glibc_ver() { local v; v=$(getconf GNU_LIBC_VERSION 2>/dev/null) || { echo 0; return; }; echo "${v##* }"; }

LHOME_READY=0
lhome_init() {  # create LLMSERVER_HOME (this user's, mode 700), and adjust it if it was moved
  local was=""
  umask 022   # a shell umask of 002 (usual on Ubuntu, Debian, Fedora) would make new folders group-writable
  ((LHOME_READY)) && return 0
  if [[ -e $lhome && ! -f $lhome/$HOME_MARK ]]; then   # a new folder may already hold the settings and menu the user wrote
    local f
    for f in "$lhome"/* "$lhome"/.[!.]*; do
      [[ -e $f || -L $f ]] || continue
      [[ ${f##*/} == @(llmserver.env|config|logs|state) ]] || die "$lhome exists and was not created by $PROG; choose another LLMSERVER_HOME"
    done
  fi
  mkdir -p "$lhome"/{bin,cache,tmp,locks,runtime,engines,config,state,logs/models,skills}
  [[ -f $lhome/$HOME_MARK ]] || printf '%s folder: everything llmserver installs and keeps. "%s uninstall" removes it.\n' "$PROG" "$PROG" > "$lhome/$HOME_MARK"
  chmod 700 "$lhome"; chmod go-w "$lhome"/* 2>/dev/null || true
  [[ -r $lhome/.llmserver-path ]] && was=$(<"$lhome/.llmserver-path")
  if [[ -n $was && $was != "$lhome" ]]; then lhome_rehome "$was"; fi
  [[ $was == "$lhome" ]] || printf '%s\n' "$lhome" > "$lhome/.llmserver-path"
  LHOME_READY=1
}
sed_esc() { printf '%s' "$1" | sed 's/[][\.*^$|&/]/\\&/g'; }
lhome_rehome() {  # old-path: LLMSERVER_HOME was moved; point its venvs and links at the new place
  local old=$1 f t n=0 o r
  o=$(sed_esc "$old"); r=$(sed_esc "$lhome")
  while IFS= read -r -d '' f; do   # links into the folder (uv's Python links, each venv's bin/python)
    t=$(readlink -- "$f")
    [[ $t == "$old"/* ]] || continue
    ln -sfn -- "$lhome${t#"$old"}" "$f" && n=$((n + 1))
  done < <(find "$lhome" -type l -print0 2>/dev/null)
  while IFS= read -r -d '' f; do   # venv settings, skill records and model records that name the folder
    grep -qF -- "$old" "$f" && sed -i "s|$o|$r|g" "$f" && n=$((n + 1))
  done < <(find "$lhome" \( -name pyvenv.cfg -o -path "$lhome/trust/records/skill/*.json" -o -path "$lhome/state/running/*.state" \) -type f -print0 2>/dev/null)
  for f in "$HOME/.agents/skills"/* "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/skills"/*; do   # agent links to our skills
    [[ -L $f ]] || continue
    t=$(readlink -- "$f"); [[ $t == "$old"/* ]] && ln -sfn -- "$lhome${t#"$old"}" "$f" && n=$((n + 1))
  done
  MIGRATED+=("$PROG's folder moved from $old to $lhome; adjusted $n link(s) and file(s)")
}
HS_WHY=""
home_safe() {  # path -> is it ours and not writable by anyone else? (a tampered engine must not run); HS_WHY says why not
  local p=$1 owner mode
  HS_WHY=""
  while [[ $p == "$lhome"* && -e $p ]]; do
    owner=$(stat -c %u -- "$p") mode=$(stat -c %a -- "$p")
    [[ $owner == "$(id -u)" ]] || { HS_WHY="$p is owned by $(stat -c %U -- "$p"), not by you"; return 1; }
    (( (8#$mode & 8#022) == 0 )) || { HS_WHY="$p is writable by your group or other users (mode $mode)"; return 1; }
    [[ $p == "$lhome" ]] && return 0
    p=${p%/*}
  done
  return 0
}

# uv runs only inside LLMSERVER_HOME: its own cache and Python folder, no user or system uv
# configuration, only uv-managed Python, and nothing installed onto PATH.
uv_env() {
  env -u VIRTUAL_ENV -u CONDA_PREFIX -u PYTHONPATH -u PYTHONHOME -u PYTHONSTARTUP -u PYTHONUSERBASE \
    -u UV_INDEX -u UV_INDEX_URL -u UV_DEFAULT_INDEX -u UV_EXTRA_INDEX_URL -u UV_FIND_LINKS -u UV_INDEX_STRATEGY \
    -u UV_CONSTRAINT -u UV_OVERRIDE -u UV_PYTHON -u UV_PRERELEASE -u UV_TORCH_BACKEND \
    UV_NO_CONFIG=1 UV_CACHE_DIR="$lhome/cache/uv" UV_PYTHON_INSTALL_DIR="$lhome/python" \
    UV_PYTHON_PREFERENCE=only-managed UV_PYTHON_INSTALL_BIN=0 UV_TOOL_DIR="$lhome/cache/tools" \
    UV_TOOL_BIN_DIR="$lhome/cache/tools/bin" UV_NO_MODIFY_PATH=1 UV_PYTHON_DOWNLOADS=manual \
    ${OFFLINE_SRC:+UV_OFFLINE=1 "UV_PYTHON_INSTALL_MIRROR=file://$OFFLINE_SRC/python"} \
    "$@"
}
uvc() { uv_env "$lhome/bin/uv" "$@"; }
py_env() {  # run a program from one of llmserver's venvs with a clean Python environment
  env -u VIRTUAL_ENV -u CONDA_PREFIX -u PYTHONPATH -u PYTHONHOME -u PYTHONSTARTUP -u PYTHONUSERBASE \
    PYTHONNOUSERSITE=1 HF_HUB_DISABLE_TELEMETRY=1 HF_HUB_DISABLE_UPDATE_CHECK=1 "$@"
}

OFFLINE_SRC=""   # set by 'install --from BUNDLE': the bundle's engines/ folder, used instead of the network
LOCAL_SRC=""     # set by 'install --from ARCHIVE': a folder of release files the user downloaded; the rest comes from the network
OFFLINE_PIP=()
fetch_verified() {  # url sha256 dest: download over HTTPS (or take it from a bundle), refuse anything but the pinned bytes
  local url=$1 want=$2 dest=$3 got
  [[ $want =~ ^[0-9a-f]{64}$ ]] || die "no pinned checksum for ${url##*/}; refusing to download it"
  if [[ -n $LOCAL_SRC && -f $LOCAL_SRC/${url##*/} ]]; then   # a release file the user downloaded: the same pinned checksum
    cp -- "$LOCAL_SRC/${url##*/}" "$dest.part"
    got=$(sha256sum -- "$dest.part"); got=${got%% *}
    [[ $got == "$want" ]] || { rm -f -- "$dest.part"; die "${url##*/} in $LOCAL_SRC is not the file llmserver pins (its SHA-256 is $got, expected $want); nothing was installed. Download it again, or unpack it and use it as your own copy: '$PROG config set llama_source FOLDER' (or ollama_source)"; }
    mv -f -- "$dest.part" "$dest"; info "using ${url##*/} from $LOCAL_SRC (SHA-256 matches the pin)"
    return 0
  fi
  if [[ -n $OFFLINE_SRC ]]; then
    [[ -f $OFFLINE_SRC/files/${url##*/} ]] || die "the bundle does not contain ${url##*/}. Export it with --with-engines on a machine of the same kind (CPU architecture and GPU vendor), or set LLMSERVER_LLAMA_BUILD to the build the bundle has"
    cp -- "$OFFLINE_SRC/files/${url##*/}" "$dest.part"
    got=$(sha256sum -- "$dest.part"); got=${got%% *}
    [[ $got == "$want" ]] || { rm -f -- "$dest.part"; die "${url##*/} in the bundle does not match its pinned checksum; nothing was installed"; }
    mv -f -- "$dest.part" "$dest"; note "offline: ${url##*/} from the bundle (sha256 $want)"
    return 0
  fi
  [[ $url == https://* ]] || die "refusing a non-HTTPS download: $url"
  note "download: $url (sha256 $want)"
  local progress=(-sS); [[ -t 2 ]] && progress=(-#)
  curl "${progress[@]}" -fL --proto '=https' --proto-redir '=https' --tlsv1.2 --retry 3 --retry-delay 2 \
    --connect-timeout 30 --max-redirs 5 -o "$dest.part" -- "$url" || { rm -f -- "$dest.part"; return 1; }
  got=$(sha256sum -- "$dest.part"); got=${got%% *}
  if [[ $got != "$want" ]]; then
    rm -f -- "$dest.part"
    log_write error "checksum mismatch: $url expected $want got $got"
    die "the download of ${url##*/} does not match its pinned checksum (expected $want, got $got); it was deleted and nothing was installed"
  fi
  mv -f -- "$dest.part" "$dest"
}
untar_safe() {  # archive dest: unpack with Python's 'data' filter (needs the helper's Python)
  local py
  py=$(helper_python) || die "the helper Python is not installed; run '$PROG install runtime'"
  "$py" -I - "$1" "$2" <<'PY'
import sys, tarfile
with tarfile.open(sys.argv[1]) as t:
    t.extractall(sys.argv[2], filter='data')
PY
}
untar_bootstrap() {  # archive dest: for uv itself, before any Python exists: plain files only
  local bad
  bad=$(tar -tvzf "$1" | awk '$1 !~ /^[-d]/ || $NF ~ /(^\/|(^|\/)\.\.(\/|$))/' | head -n 3)
  [[ -z $bad ]] || die "refusing to unpack ${1##*/}: unexpected entries ($bad)"
  tar -xzf "$1" -C "$2" --no-same-owner --no-same-permissions
}
comp_root() { case $1 in helper) echo "$lhome/runtime/helper" ;; llama) echo "$lhome/engines/llama.cpp" ;; *) echo "$lhome/engines/$1" ;; esac; }
comp_current() { local d; d=$(comp_root "$1")/current; [[ -d $d/ ]] && readlink -f -- "$d"; }
declare -A CM=()
comp_meta() {  # component -> CM from its current folder's metadata; status 1 if not installed
  local d line
  CM=()
  d=$(comp_current "$1") || return 1
  [[ -r $d/.llmserver-component ]] || return 1
  while IFS= read -r line; do [[ $line =~ ^([A-Z_]+)=(.*)$ ]] && CM[${BASH_REMATCH[1]}]=${BASH_REMATCH[2]}; done < "$d/.llmserver-component"
  CM[DIR]=$d
}
comp_write_meta() {  # dir name version variant main [extra KEY=VALUE...]
  local d=$1 name=$2 ver=$3 var=$4 main=$5 sha=""
  shift 5
  [[ -f $d/$main ]] && { sha=$(sha256sum -- "$d/$main"); sha=${sha%% *}; }
  printf '%s\n' "NAME=$name" "VERSION=$ver" "VARIANT=$var" "ARCH=$(uname -m)" "MAIN=$main" "MAIN_SHA=$sha" \
    "INSTALLED=$(date -u +%Y-%m-%dT%H:%M:%SZ)" "BY=$PROG $VERSION" "$@" > "$d/.llmserver-component"
}
comp_activate() {  # component staged-dir final-name: move into place, make it current, keep the old one as previous
  local root id=$3 old
  root=$(comp_root "$1")
  mkdir -p "$root"
  chmod go-w -- "$root" "${root%/*}"
  chmod -R go-w -- "$2"
  if [[ -e $root/$id ]]; then rm -rf -- "$root/$id.old.$$"; mv -- "$root/$id" "$root/$id.old.$$"; fi
  mv -- "$2" "$root/$id"
  rm -rf -- "$root/$id.old.$$"
  old=$(readlink -- "$root/current" 2>/dev/null || true)
  if [[ -n $old && $old != "$id" ]]; then ln -sfn -- "$old" "$root/previous.new.$$" && mv -Tf -- "$root/previous.new.$$" "$root/previous"; fi
  ln -sfn -- "$id" "$root/current.new.$$" && mv -Tf -- "$root/current.new.$$" "$root/current"
  comp_prune "$1"
}
comp_prune() {  # keep current and previous, and any version a running model still uses
  local root d keep cur prev f
  root=$(comp_root "$1")
  cur=$(readlink -- "$root/current" 2>/dev/null || true) prev=$(readlink -- "$root/previous" 2>/dev/null || true)
  for d in "$root"/*/; do
    d=${d%/}; [[ -L $d ]] && continue
    keep=0
    [[ ${d##*/} == "$cur" || ${d##*/} == "$prev" ]] && keep=1
    if ((!keep)); then   # in use by a running server?
      for f in /proc/[0-9]*/exe; do [[ $(readlink "$f" 2>/dev/null) == "$d"/* ]] && { keep=1; break; }; done
    fi
    ((keep)) || { rm -rf -- "$d"; note "removed the old $1 build ${d##*/}"; }
  done
  return 0
}
INSTALL_LOCKED=0
install_lock() {
  ((INSTALL_LOCKED)) && return 0
  lhome_init
  if have flock; then
    exec 7>> "$lhome/install.lock"
    flock -n 7 || { info "another $PROG is installing; waiting for it"; flock -w 3600 7 || die "gave up waiting for the other install"; }
  fi
  INSTALL_LOCKED=1
  rm -rf -- "$lhome"/tmp/* "$lhome"/tmp/.[!.]* 2>/dev/null || true   # staging left by an interrupted install
}
stage_dir() { mktemp -d "$lhome/tmp/$1.XXXXXX"; }

# ---- the components ----
uv_ok() { [[ -x $lhome/bin/uv ]] && [[ $("$lhome/bin/uv" --version 2>/dev/null) == "uv $(pin uv) "* ]]; }
install_uv() {
  local ver a f st
  ver=$(pin uv); a=$(arch_of uv) || die "no uv build for $(uname -m)"
  uv_ok && return 0
  f=uv-$a-unknown-linux-musl.tar.gz; st=$(stage_dir uv)
  info "installing uv $ver (static build, verified by SHA-256) into $lhome"
  fetch_verified "$GH/astral-sh/uv/releases/download/$ver/$f" "$(pin_sha "$f")" "$st/$f" || die "could not download uv; check the network (or LLMSERVER_GITHUB for a mirror)"
  untar_bootstrap "$st/$f" "$st"
  mkdir -p "$lhome/uv/$ver"
  install -m 755 "$st/${f%.tar.gz}/uv" "$lhome/uv/$ver/uv"
  rm -rf -- "$st"
  ln -sfn -- "../uv/$ver/uv" "$lhome/bin/uv.new.$$" && mv -Tf -- "$lhome/bin/uv.new.$$" "$lhome/bin/uv"
  uv_ok || die "the installed uv does not run"
  log_write info "installed uv $ver"
}
helper_python() { local d; d=$(comp_current helper) && [[ -x $d/bin/python ]] && printf '%s\n' "$d/bin/python"; }
helper_ok() {
  comp_meta helper || return 1
  [[ ${CM[VERSION]} == "$(pin python_helper)" && ${CM[LOCK]-} == "$(helper_lock_id)" ]] || return 1
  "${CM[DIR]}/bin/python" -I -c 'import huggingface_hub' 2>/dev/null
}
helper_lock_id() { local s; s=$(printf '%s' "$HELPER_LOCK" | sha256sum); echo "${s:0:16}"; }
install_runtime() {  # uv, a managed Python and the helper venv
  local st py id
  install_lock
  install_uv
  helper_ok && return 0
  py=$(pin python_helper)
  info "installing Python $py (uv-managed) and llmserver's helper packages (hash-locked)"
  uvc python install "$py" --no-bin >/dev/null 2>&1 || uvc python install "$py" --no-bin || die "uv could not install Python $py"
  st=$(stage_dir helper)
  printf '%s\n' "$HELPER_LOCK" > "$lhome/locks/helper.txt"
  uvc venv --relocatable --python "$py" --no-project --quiet "$st/venv" || die "could not create the helper venv"
  uvc pip sync --quiet --require-hashes --python "$st/venv/bin/python" "${OFFLINE_PIP[@]}" "$lhome/locks/helper.txt" || die "could not install the helper packages (hash-checked)"
  py_env "$st/venv/bin/python" -I -c 'import huggingface_hub, tarfile' || die "the helper venv does not work"
  id=py$py-$(helper_lock_id)
  comp_write_meta "$st/venv" helper "$py" "lock-$(helper_lock_id)" bin/python "LOCK=$(helper_lock_id)"
  mv -- "$st/venv" "$st/$id"; comp_activate helper "$st/$id" "$id"; rm -rf -- "$st"
  log_write info "installed the helper runtime (Python $py, lock $(helper_lock_id))"
}
runtime_ready() {  # make sure the helper exists; installs it on first use unless LLMSERVER_AUTO_INSTALL=off
  helper_python >/dev/null && return 0
  if [[ ${CFG[AUTO_INSTALL]} == off ]] || ((dry)); then return 1; fi
  ( install_runtime ) || { warn "could not install llmserver's Python runtime; models cannot be sized until '$PROG install runtime' succeeds"; return 1; }
}

llama_variant() {  # the llama.cpp build for this machine: cuda-13.4 | cuda-12.8 | vulkan | cpu
  local want=${CFG[LLAMA_BUILD]} i nv=0 amd=0 mincc="" drv
  detect_hw
  for i in "${!G_VENDOR[@]}"; do
    gpu_allowed "$i" || continue
    if [[ ${G_VENDOR[i]} == nvidia ]]; then nv=1; [[ -z $mincc ]] || ! ver_ge "${G_CAP[i]:-0}" "$mincc" && mincc=${G_CAP[i]:-0}
    else amd=1; fi
  done
  if [[ $want != auto ]]; then echo "$want"; return; fi
  drv=${NV_DRIVER%%.*}
  if ((nv && !amd)) && [[ $drv =~ ^[0-9]+$ ]]; then
    if ((drv >= 580)) && ver_ge "${mincc:-0}" 7.5; then echo cuda-13.4; return; fi
    if ((drv >= 570)) && [[ $(arch_of llama) == x64 ]]; then echo cuda-12.8; return; fi
  fi
  if ((nv || amd)); then echo vulkan; else echo cpu; fi
}
llama_asset() {  # variant -> release file name
  local a; a=$(arch_of llama) || return 1
  case $1 in cpu) echo "llama-$(pin llama)-bin-ubuntu-$a.tar.gz" ;; *) echo "llama-$(pin llama)-bin-ubuntu-$1-$a.tar.gz" ;; esac
}
install_llama() {
  local var ver f st top need id cr
  install_runtime
  var=$(llama_variant); ver=$(pin llama)
  f=$(llama_asset "$var") || die "llama.cpp publishes no Linux build for $(uname -m)"
  need=2.35; [[ $var == cuda-* ]] && need=2.39
  ver_ge "$(glibc_ver)" "$need" || die "the $var build of llama.cpp needs glibc $need or newer (this system has $(glibc_ver)); to use a llama.cpp you built: '$PROG config set llama_source system'"
  id=$ver-$var
  if comp_meta llama && [[ ${CM[VERSION]} == "$ver" && ${CM[VARIANT]} == "$var" ]]; then info "llama.cpp $ver ($var) is already installed"; return 0; fi
  info "installing llama.cpp $ver, $var build"
  st=$(stage_dir llama)
  fetch_verified "$GH/ggml-org/llama.cpp/releases/download/$ver/$f" "$(pin_sha "$f")" "$st/$f" || die "could not download $f"
  mkdir -p "$st/x"; untar_safe "$st/$f" "$st/x"; rm -f -- "$st/$f"
  top=$(find "$st/x" -mindepth 1 -maxdepth 1 -type d | head -n 1)
  [[ -x $top/llama ]] || die "the llama.cpp archive has no 'llama' program"
  if [[ $var == cuda-* ]]; then   # the CUDA runtime libraries, unpacked next to the binaries ($ORIGIN)
    cr=cudart-$f
    fetch_verified "$GH/ggml-org/llama.cpp/releases/download/$ver/$cr" "$(pin_sha "$cr")" "$st/$cr" || die "could not download $cr"
    mkdir -p "$st/c"; untar_safe "$st/$cr" "$st/c"; rm -f -- "$st/$cr"
    find "$st/c" -type f -name 'lib*.so*' -exec mv -t "$top" -- {} +
  fi
  "$top/llama" --version >/dev/null 2>&1 || die "the downloaded llama.cpp does not run on this system"
  comp_write_meta "$top" llama "$ver" "$var" llama "SOURCE=$GH/ggml-org/llama.cpp/releases/tag/$ver"
  comp_activate llama "$top" "$id"; rm -rf -- "$st"
  log_write info "installed llama.cpp $ver ($var)"
  if [[ $var == vulkan ]] && ! llama_vulkan_ok; then
    warn "the Vulkan build sees no GPU: the Vulkan loader (libvulkan.so.1) or the GPU's Vulkan driver (Mesa RADV for AMD, the NVIDIA driver's Vulkan part) is missing. They come with the graphics driver; until then llama.cpp runs on the CPU"
  fi
}
llama_vulkan_ok() { local d; d=$(comp_current llama) && "$d/llama" serve --list-devices 2>&1 | grep -q 'Vulkan[0-9]'; }
ollama_variant() { local i; detect_hw; for i in "${!G_VENDOR[@]}"; do [[ ${G_VENDOR[i]} == amd ]] && gpu_allowed "$i" && [[ $(arch_of ollama) == amd64 ]] && { echo rocm; return; }; done; echo base; }
install_ollama() {
  local var ver a f st id
  install_runtime
  var=$(ollama_variant); ver=$(pin ollama); a=$(arch_of ollama) || die "Ollama publishes no Linux build for $(uname -m)"
  id=$ver-$var
  if comp_meta ollama && [[ ${CM[VERSION]} == "$ver" && ${CM[VARIANT]} == "$var" ]]; then info "Ollama $ver ($var) is already installed"; return 0; fi
  info "installing Ollama $ver$([[ $var == rocm ]] && echo ' with its ROCm libraries' || true)"
  st=$(stage_dir ollama); mkdir -p "$st/x"
  for f in "ollama-linux-$a.tar.zst" $([[ $var == rocm ]] && echo "ollama-linux-$a-rocm.tar.zst"); do
    fetch_verified "$GH/ollama/ollama/releases/download/$ver/$f" "$(pin_sha "$f@$ver")" "$st/$f" || die "could not download $f"
    untar_safe "$st/$f" "$st/x"; rm -f -- "$st/$f"
  done
  [[ -x $st/x/bin/ollama ]] || die "the Ollama archive has no bin/ollama"
  "$st/x/bin/ollama" --version >/dev/null 2>&1 || "$st/x/bin/ollama" -v >/dev/null 2>&1 || die "the downloaded Ollama does not run on this system"
  comp_write_meta "$st/x" ollama "$ver" "$var" bin/ollama "SOURCE=$GH/ollama/ollama/releases/tag/$ver"
  comp_activate ollama "$st/x" "$id"; rm -rf -- "$st"
  log_write info "installed Ollama $ver ($var)"
}
flashinfer_label() {  # PyTorch's CUDA tag (cu132) -> the newest FlashInfer kernel build it can use (cu130), or nothing
  local maj min v best=""
  [[ $1 =~ ^cu([0-9]{2})([0-9]+)$ ]] || return 0
  maj=${BASH_REMATCH[1]} min=${BASH_REMATCH[2]}
  for v in $(pin flashinfer_cuda); do [[ ${v%%.*} == "$maj" ]] && ((10#${v#*.} <= 10#$min)) && best=cu${v/./}; done
  printf '%s\n' "$best"
}
vllm_kernels_lock() {  # base-lock kernels-lock: FlashInfer's precompiled kernels for this PyTorch, hash-locked; status 1 if none
  local lock=$1 klock=$2 fiv tt lab kidx
  [[ -s $klock ]] && return 0
  fiv=$(sed -n 's/^flashinfer-python==\([^ ]*\).*/\1/p' "$lock" | head -n 1)
  [[ -n $fiv ]] || return 1
  tt=$(sed -n 's/^torch==[^+ ]*+\(cu[0-9]*\).*/\1/p' "$lock" | head -n 1)
  lab=$(flashinfer_label "$tt")
  printf '%s\n' "flashinfer-cubin==${fiv%%+*}" > "$lhome/tmp/kernels.in"
  if [[ -n $lab ]]; then
    printf '%s\n' "flashinfer-jit-cache==${fiv%%+*}+$lab" >> "$lhome/tmp/kernels.in"
    kidx=(--index-url "$FLASHINFER_INDEX/$lab" --extra-index-url "$FLASHINFER_INDEX")
  else kidx=(--index-url "$FLASHINFER_INDEX"); fi
  grep -v '^--' "$lock" > "$lhome/tmp/kernels.constraints"   # the kernels may not change anything vLLM's lock fixed
  uvc pip compile "$lhome/tmp/kernels.in" -c "$lhome/tmp/kernels.constraints" --python-version "$(pin python_engine | cut -d. -f1,2)" \
    "${kidx[@]}" --generate-hashes --emit-index-url --no-header --quiet -o "$klock.tmp" || { rm -f -- "$klock.tmp"; return 1; }
  mv -f -- "$klock.tmp" "$klock"; rm -f -- "$lhome/tmp/kernels.in" "$lhome/tmp/kernels.constraints"
}
vllm_variant() {
  local i nv=0 amd=0
  detect_hw
  for i in "${!G_VENDOR[@]}"; do gpu_allowed "$i" || continue; [[ ${G_VENDOR[i]} == nvidia ]] && nv=1; [[ ${G_VENDOR[i]} == amd ]] && amd=1; done
  if ((nv)); then echo cuda
  elif ((amd)) && [[ $(arch_of llama) == x64 ]]; then echo rocm
  else echo none; fi
}
install_vllm() {
  local var ver py st id lock req idx=()
  install_runtime
  var=$(vllm_variant); ver=$(pin vllm); py=$(pin python_engine)
  case $var in
    none) die "vLLM needs an NVIDIA GPU, or an AMD GPU on x86-64, and none that llmserver may use was found" ;;
    rocm) ver_ge "$(glibc_ver)" 2.39 || die "vLLM's ROCm wheels need glibc 2.39 or newer (this system has $(glibc_ver))"
          req="vllm==$ver+$(pin vllm_rocm)"; idx=(--extra-index-url "$VLLM_ROCM_INDEX/$ver/$(pin vllm_rocm)") ;;
    cuda) req="vllm==$ver"; idx=(--torch-backend "${UV_TORCH_BACKEND:-auto}") ;;   # uv picks the CUDA build for the driver
  esac
  id=$ver-$var
  if comp_meta vllm && [[ ${CM[VERSION]} == "$ver" && ${CM[VARIANT]} == "$var" ]]; then info "vLLM $ver ($var) is already installed"; return 0; fi
  local gbs=${PIN_SIZE[vllm:$var]}
  info "installing vLLM $ver for $var (about $((gbs / 1000)) GB, with its own PyTorch); this takes a while"
  uvc python install "$py" --no-bin >/dev/null 2>&1 || uvc python install "$py" --no-bin || die "uv could not install Python $py"
  lock=$lhome/locks/vllm-$id.txt
  [[ -s $lock || -z $OFFLINE_SRC ]] || die "the bundle has no vLLM lock for $id; export it from a machine with the same GPU vendor"
  if [[ ! -s $lock ]]; then   # resolve once, with hashes; later rebuilds reuse the same lock
    printf '%s\n' "$req" > "$lhome/tmp/vllm-$id.in"
    uvc pip compile "$lhome/tmp/vllm-$id.in" --python-version "${py%.*}" "${idx[@]}" --generate-hashes --emit-index-url \
      --no-header --quiet -o "$lock.tmp" || { rm -f -- "$lock.tmp"; die "could not resolve vLLM $ver for $var"; }
    mv -f -- "$lock.tmp" "$lock"; rm -f -- "$lhome/tmp/vllm-$id.in"
  fi
  st=$(stage_dir vllm)
  uvc venv --relocatable --python "$py" --no-project --quiet "$st/venv" || die "could not create the vLLM venv"
  ((${#OFFLINE_PIP[@]})) && idx=("${OFFLINE_PIP[@]}")
  uvc pip sync --require-hashes --python "$st/venv/bin/python" "${idx[@]}" "$lock" || { rm -rf -- "$st"; die "could not install vLLM (every file is hash-checked against $lock)"; }
  local klock=$lhome/locks/vllm-$id-kernels.txt kern=none
  if [[ $var == cuda ]]; then   # FlashInfer's kernels, installed by llmserver's uv and hash-checked (not 'vllm download-kernels')
    if vllm_kernels_lock "$lock" "$klock"; then
      info "installing FlashInfer's precompiled kernels (hash-locked in ${klock##*/})"
      if uvc pip install --require-hashes --no-deps --python "$st/venv/bin/python" "${OFFLINE_PIP[@]}" -r "$klock"; then
        kern=$(sed -n 's/^\(flashinfer-jit-cache\|flashinfer-cubin\)==\([^ ]*\).*/\1-\2/p' "$klock" | paste -sd, -)
      else warn "could not install FlashInfer's precompiled kernels; vLLM compiles the ones it needs on first use"; fi
    else warn "no precompiled FlashInfer kernels were found for this PyTorch; vLLM compiles the ones it needs on first use"; fi
  fi
  py_env "$st/venv/bin/python" -I -c 'import vllm' 2>/dev/null || { rm -rf -- "$st"; die "the installed vLLM does not import"; }
  local got; got=$(torch_backend "$st/venv/bin/python")
  if [[ $got != "$var" ]]; then
    rm -rf -- "$st"; rm -f -- "$lock"
    die "vLLM's PyTorch was resolved for '$got' instead of '$var' (uv could not see the GPU driver); nothing was changed. Set it ('$PROG config set UV_TORCH_BACKEND cu130', for example) and run '$PROG install vllm' again"
  fi
  comp_write_meta "$st/venv" vllm "$ver" "$var" bin/vllm "PYTHON=$py" "LOCK=${lock##*/}" "KERNELS=$kern" \
    "TORCH=$(py_env "$st/venv/bin/python" -I -c 'import importlib.metadata as m; print(m.version("torch"))' 2>/dev/null || true)"
  mv -- "$st/venv" "$st/$id"; comp_activate vllm "$st/$id" "$id"; rm -rf -- "$st"
  log_write info "installed vLLM $ver ($var)"
}

# ---- engine programs: managed (default) or from PATH (LLMSERVER_<ENGINE>_SOURCE=system) ----
VLLM_BIN="" OLLAMA_BIN="" LLAMA_BIN=""
engine_at() {  # a file or folder from LLMSERVER_<ENGINE>_SOURCE, and program names -> the program in it
  local p=${1%/} n; shift
  if [[ -f $p ]]; then [[ -x $p ]] && printf '%s\n' "$p"; return 0; fi
  for n in "$@"; do
    [[ -x $p/$n && ! -d $p/$n ]] && { printf '%s\n' "$p/$n"; return 0; }
    [[ -x $p/bin/$n && ! -d $p/bin/$n ]] && { printf '%s\n' "$p/bin/$n"; return 0; }
    [[ -x $p/build/bin/$n && ! -d $p/build/bin/$n ]] && { printf '%s\n' "$p/build/bin/$n"; return 0; }
  done
  return 0
}
engine_paths() {
  local d
  LLAMA_BIN="" VLLM_BIN="" OLLAMA_BIN=""
  case ${CFG[LLAMA_SOURCE]} in
    system) LLAMA_BIN=$(command -v llama || command -v llama-server || true) ;;
    /*) LLAMA_BIN=$(engine_at "${CFG[LLAMA_SOURCE]}" llama-server llama) ;;
    *) if d=$(comp_current llama) && [[ -x $d/llama ]]; then LLAMA_BIN=$d/llama; fi ;;
  esac
  case ${CFG[VLLM_SOURCE]} in
    system) VLLM_BIN=$(command -v vllm || true) ;;
    /*) VLLM_BIN=$(engine_at "${CFG[VLLM_SOURCE]}" vllm) ;;
    *) if d=$(comp_current vllm) && [[ -x $d/bin/vllm ]]; then VLLM_BIN=$d/bin/vllm; fi ;;
  esac
  case ${CFG[OLLAMA_SOURCE]} in
    system) OLLAMA_BIN=$(command -v ollama || true) ;;
    /*) OLLAMA_BIN=$(engine_at "${CFG[OLLAMA_SOURCE]}" ollama) ;;
    *) if d=$(comp_current ollama) && [[ -x $d/bin/ollama ]]; then OLLAMA_BIN=$d/bin/ollama; fi ;;
  esac
  return 0
}
engine_source() {  # managed | system (from PATH, or from the folder or program LLMSERVER_<ENGINE>_SOURCE names)
  local v=${CFG[${1^^}_SOURCE]}
  if [[ $v == /* ]]; then echo system; else echo "$v"; fi
}
engine_where() {  # engine -> where a system engine comes from, in words
  local v=${CFG[${1^^}_SOURCE]}
  if [[ $v == /* ]]; then echo "$v"; else echo "PATH"; fi
}
engine_safe() {  # engine -> refuse a managed engine whose files others could have changed
  local b
  [[ $(engine_source "$1") == managed ]] || return 0
  case $1 in llama) b=$LLAMA_BIN ;; vllm) b=$VLLM_BIN ;; ollama) b=$OLLAMA_BIN ;; esac
  [[ -n $b ]] || return 0
  home_safe "$b" || die "refusing to run $1: $HS_WHY, so its files could have been changed by someone else; run '$PROG doctor --fix'"
}

# ---- install / upgrade / rollback / versions commands ----
install_targets() {  # words -> list of components (runtime first)
  local w out=(runtime)
  for w in "$@"; do
    case $w in
      all) out+=(llama ollama vllm) ;;
      runtime) ;;
      llama|llama.cpp) out+=(llama) ;; ollama) out+=(ollama) ;; vllm) out+=(vllm) ;; webui|open-webui) out+=(webui) ;; searxng|search) out+=(searxng) ;;
      *) die "unknown component '$w': runtime, llama, ollama, vllm, all (the engines), webui or searxng" ;;
    esac
  done
  printf '%s\n' "${out[@]}" | awk '!seen[$0]++'
}
plan_line() {  # component -> "what, size" for the plan
  local v
  case $1 in
    runtime) echo "runtime: uv $(pin uv) and Python $(pin python_helper) with llmserver's helper packages (about $((PIN_SIZE[uv] + PIN_SIZE[python_helper] + PIN_SIZE[helper])) MB)" ;;
    llama) v=$(llama_variant); echo "llama.cpp $(pin llama), $v build (about ${PIN_SIZE[llama:$v]:-40} MB)" ;;
    ollama) v=$(ollama_variant); local mb=${PIN_SIZE[ollama:base]}; local extra=${PIN_SIZE[ollama:rocm]}; [[ $v == rocm ]] && mb=$((mb + extra))
      echo "Ollama $(pin ollama)$([[ $v == rocm ]] && echo ' + ROCm libraries' || true) (about $mb MB)" ;;
    webui) echo "Open WebUI $(pin webui): a web chat for people on the network, with Python $(pin python_engine) and CPU PyTorch (about $((PIN_SIZE[webui] / 1000)) GB), and its document models: embeddings and the reranker (about $((PIN_SIZE[rerank_fast] + 90)) MB)$([[ ${CFG[WEBUI_SEARCH]} == on ]] && echo "; SearXNG for web search (about ${PIN_SIZE[searxng]} MB)")" ;;
    searxng) echo "SearXNG ${PIN[searxng]:0:12}: private web search for Open WebUI, with Python $(pin python_engine) (about ${PIN_SIZE[searxng]} MB)" ;;
    vllm) v=$(vllm_variant); if [[ $v == none ]]; then echo "vLLM: not available here (needs an NVIDIA GPU, or AMD on x86-64)"; else local gb=${PIN_SIZE[vllm:$v]}; echo "vLLM $(pin vllm) for $v, with Python $(pin python_engine) and its own PyTorch (about $((gb / 1000)) GB)"; fi ;;
  esac
}
cmd_install() {  # [component...]
  local c targets=() words=("$@")
  ((${#words[@]})) || read -ra words <<<"${CFG[ENGINES]:-llama ollama vllm}"
  mapfile -t targets < <(install_targets "${words[@]}")
  pins_load
  echo "$PROG will install into $lhome (and nowhere else):" >&2
  for c in "${targets[@]}"; do echo "  - $(plan_line "$c")" >&2; done
  echo "Every download is checked against a pinned SHA-256 (Python packages against hash locks)." >&2
  ((dry)) && return 0
  if ((!yes)); then
    [[ -t 0 ]] || die "nothing was installed: run '$PROG install ${words[*]} --yes' to install without a prompt"
    printf 'Install now? [Y/n]: ' >&2; IFS= read -r REPLY || REPLY=""
    [[ -z $REPLY || ${REPLY,,} == y* ]] || { info "cancelled; nothing was installed"; return 0; }
  fi
  install_lock
  for c in "${targets[@]}"; do
    case $c in runtime) install_runtime ;; llama) install_llama ;; ollama) install_ollama ;; webui) install_webui ;; searxng) install_searxng ;; vllm) [[ $(vllm_variant) == none ]] && { warn "skipping vLLM: $(plan_line vllm | sed 's/^vLLM: //')"; continue; }; install_vllm ;; esac
  done
  rm -rf -- "$lhome"/tmp/* 2>/dev/null || true
  info "${C_B}installed${C_0}; '$PROG versions' lists what is installed"
}
cmd_rollback() {  # component
  local root cur prev c=${1:-}
  case $c in llama|llama.cpp) c=llama ;; ollama|vllm|helper) ;; runtime) c=helper ;; *) die "say which component to roll back: llama, ollama, vllm or runtime" ;; esac
  root=$(comp_root "$c")
  cur=$(readlink -- "$root/current" 2>/dev/null || true) prev=$(readlink -- "$root/previous" 2>/dev/null || true)
  [[ -n $prev && -d $root/$prev ]] || die "there is no previous $c build to go back to"
  install_lock
  ln -sfn -- "$prev" "$root/current.new.$$" && mv -Tf -- "$root/current.new.$$" "$root/current"
  ln -sfn -- "$cur" "$root/previous.new.$$" && mv -Tf -- "$root/previous.new.$$" "$root/previous"
  info "$c is back to $prev (was $cur). Running models keep their build until they are restarted ('$PROG MODEL --restart')"
  log_write info "rollback: $c $cur -> $prev"
}
gh_latest() {  # owner/repo -> "tag" and its assets "name sha256" (from the release's digests), via the helper
  local py
  py=$(helper_python) || die "the helper Python is needed; run '$PROG install runtime'"
  curl -fsSL --proto '=https' --tlsv1.2 --max-time 60 -H 'Accept: application/vnd.github+json' "$GH_API/repos/$1/releases/latest" |
    "$py" -I -c 'import json,sys; r=json.load(sys.stdin); print(r["tag_name"]); [print(a["name"], (a.get("digest") or "").removeprefix("sha256:")) for a in r.get("assets", [])]' 2>/dev/null
}
cmd_upgrade() {  # [component] [--latest]
  local c=${1:-all} out tag name sha ok lines=() comps=() k
  pins_load
  case $c in all) comps=(runtime llama ollama vllm) ;; llama.cpp) comps=(llama) ;; runtime|llama|ollama|vllm) comps=("$c") ;; *) die "unknown component '$c'" ;; esac
  if ((opt_latest)); then
    install_runtime
    lhome_init
    for c in "${comps[@]}"; do
      case $c in
        llama|ollama|runtime)
          local repo; case $c in llama) repo=ggml-org/llama.cpp ;; ollama) repo=ollama/ollama ;; *) repo=astral-sh/uv ;; esac
          out=$(gh_latest "$repo") || die "could not ask GitHub for the latest $repo release"
          tag=${out%%$'\n'*}; ok=0
          while read -r name sha; do
            [[ ($name == *linux* || $name == *ubuntu*) && $sha =~ ^[0-9a-f]{64}$ ]] || continue
            if [[ $c == ollama ]]; then lines+=("sha:$name@$tag=$sha"); else lines+=("sha:$name=$sha"); fi; ok=1
          done <<<"$(tail -n +2 <<<"$out")"
          ((ok)) || die "the latest $repo release ($tag) publishes no SHA-256 digests for its Linux files, so it cannot be verified; staying on $(pin "$([[ $c == runtime ]] && echo uv || echo "$c")")"
          lines+=("$([[ $c == runtime ]] && echo uv || echo "$c")=$tag") ;;
        vllm)
          local py; py=$(helper_python)
          tag=$(curl -fsSL --proto '=https' --max-time 60 "$PYPI/pypi/vllm/json" | "$py" -I -c 'import json,sys; print(json.load(sys.stdin)["info"]["version"])') || die "could not ask PyPI for the latest vLLM"
          lines+=("vllm=$tag")
          if [[ $(vllm_variant) == rocm ]]; then
            k=$(curl -fsSL --proto '=https' --max-time 60 "$VLLM_ROCM_INDEX/$tag/" | grep -oE 'rocm[0-9]+' | sort -V | tail -n 1) || true
            [[ -n $k ]] || die "vLLM $tag has no ROCm wheels yet; staying on $(pin vllm)"
            lines+=("vllm_rocm=$k")
          fi ;;
      esac
    done
    for k in "${lines[@]}"; do PINL[${k%%=*}]=${k#*=}; done
    { printf '%s\n' "# newer pins, verified by '$PROG upgrade --latest' on $(date +%F); delete this file to return to the built-in pins"
      for k in "${!PINL[@]}"; do printf '%s=%s\n' "$k" "${PINL[$k]}"; done | sort
    } > "$lhome/pins.local.tmp" && mv -f -- "$lhome/pins.local.tmp" "$lhome/pins.local"
    log_write info "upgrade --latest pinned: ${lines[*]}"
    pins_load
  fi
  yes=1 cmd_install "${comps[@]}"
  [[ " ${comps[*]} " == *" runtime "* ]] && skills_refresh   # the hf-cli skill follows the pinned hf
  return 0
}
cmd_versions() {  # [--json]
  local c src items=() v
  engine_paths
  for c in runtime llama ollama vllm; do
    src=managed; [[ $c != runtime ]] && src=$(engine_source "$c")
    if [[ $src == system ]]; then
      case $c in llama) v=$LLAMA_BIN ;; vllm) v=$VLLM_BIN ;; ollama) v=$OLLAMA_BIN ;; esac
      if ((json)); then items+=("$(jo component "$(js "$c")" source '"system"' path "$(js "$v")")")
      else printf '%-8s %-8s %s\n' "$c" system "${v:-not found on PATH}"; fi
      continue
    fi
    if comp_meta "$([[ $c == runtime ]] && echo helper || echo "$c")"; then
      local prev; prev=$(readlink -- "$(comp_root "$([[ $c == runtime ]] && echo helper || echo "$c")")/previous" 2>/dev/null || true)
      if ((json)); then items+=("$(jo component "$(js "$c")" source '"managed"' version "$(js "${CM[VERSION]}")" variant "$(js "${CM[VARIANT]}")" \
          installed "$(js "${CM[INSTALLED]}")" path "$(js "${CM[DIR]}")" previous "$(js "$prev")" pinned "$(js "$(pin "$([[ $c == runtime ]] && echo python_helper || echo "$c")")")")")
      else printf '%-8s %-8s %-12s %-10s installed %s%s\n' "$c" managed "${CM[VERSION]}" "${CM[VARIANT]}" "${CM[INSTALLED]%T*}" "${prev:+  (previous: $prev)}"; fi
    else
      if ((json)); then items+=("$(jo component "$(js "$c")" source '"managed"' version null)")
      else printf '%-8s %-8s not installed (%s)\n' "$c" managed "$(plan_line "$c")"; fi
    fi
  done
  if webui_installed; then
    if ((json)); then items+=("$(jo component '"webui"' source '"managed"' version "$(js "$(pin webui)")" path "$(js "$(webui_dir)")")")
    else printf '%-8s %-8s %-12s %-10s %s\n' webui managed "$(pin webui)" cpu "(Open WebUI; '$PROG webui status')"; fi
  fi
  if searxng_installed; then
    if ((json)); then items+=("$(jo component '"searxng"' source '"managed"' version "$(js "${PIN[searxng]:0:12}")" path "$(js "$(searxng_dir)")")")
    else printf '%-8s %-8s %-12s %-10s %s\n' searxng managed "${PIN[searxng]:0:12}" cpu "(web search for Open WebUI)"; fi
  fi
  if ((json)); then jo version "$(js "$VERSION")" home "$(js "$lhome")" uv "$(js "$(pin uv)")" components "$(ja "${items[@]}")"; echo
  else echo "Home: $lhome  (uv $(pin uv)$([[ -r $lhome/pins.local ]] && echo '; newer pins from upgrade --latest in pins.local' || true))"; fi
}

# ---- engines -----------------------------------------------------------------
LLAMA_KIND=none LLAMA_SERVE=() HF_CLI=""
detect_tools() {  # the engine programs (managed in LLMSERVER_HOME, or from PATH) and the hf CLI
  local d
  engine_paths
  LLAMA_KIND=none LLAMA_SERVE=() HF_CLI=""
  case ${LLAMA_BIN##*/} in
    llama) LLAMA_KIND=unified LLAMA_SERVE=("$LLAMA_BIN" serve) ;;
    llama-server) LLAMA_KIND=server LLAMA_SERVE=("$LLAMA_BIN") ;;
  esac
  # the hf CLI comes with llmserver's runtime; a system vLLM goes with the system's hf, if any
  if [[ $(engine_source vllm) == system ]]; then HF_CLI=$(command -v hf || command -v huggingface-cli || true); fi
  if [[ -z $HF_CLI ]] && d=$(comp_current helper) && [[ -x $d/bin/hf ]]; then HF_CLI=$d/bin/hf; fi
  return 0
}
engine_installed() {
  case $1 in
    llama) [[ $LLAMA_KIND != none ]] ;;
    vllm) [[ -n $VLLM_BIN ]] ;;
    ollama) [[ -n $OLLAMA_BIN || -n ${CFG[OLLAMA_ATTACH]} ]] ;;
  esac
}
engine_enabled() {
  if [[ -n ${CFG[ENGINES]} ]]; then [[ " ${CFG[ENGINES]} " == *" $1 "* ]]; else engine_installed "$1"; fi
}
install_hint() {
  if [[ $1 == hf ]]; then echo "install llmserver's runtime, which includes it: '$PROG install runtime'"; return; fi
  if [[ $(engine_source "$1") == system ]]; then
    if [[ $(engine_where "$1") == PATH ]]; then echo "put the $1 program on PATH, or switch to llmserver's own copy: '$PROG config set ${1}_source managed' and '$PROG install $1'"
    else echo "check LLMSERVER_${1^^}_SOURCE ($(engine_where "$1")): it must be the $1 program, or a folder with it (also in bin/ or build/bin/)"; fi
  else echo "install the managed copy into $lhome: '$PROG install $1'"; fi
}
require_engine() {  # engine: installed, or installed now (asked first), or a clear refusal
  engine_installed "$1" && { engine_safe "$1"; return 0; }
  if [[ $(engine_source "$1") == managed && -t 0 && -t 2 ]] && ((!dry)); then
    echo "$PROG: the $1 engine is not installed. $(plan_line "$1")" >&2
    printf 'Install it into %s now? [Y/n]: ' "$lhome" >&2; IFS= read -r REPLY || REPLY=""
    if [[ -z $REPLY || ${REPLY,,} == y* ]]; then
      install_lock; case $1 in llama) install_llama ;; ollama) install_ollama ;; vllm) install_vllm ;; esac
      detect_tools; engine_installed "$1" && { engine_safe "$1"; return 0; }
    fi
  fi
  die "the $1 engine is not installed. To $(install_hint "$1")"
}

# ---- model specs -------------------------------------------------------------
spec_show() {  # spec -> for display: a local file under the home folder as ~/...
  local s=$1
  [[ $s == llama:"$HOME"/* ]] && s="llama:~/${s#llama:"$HOME"/}"   # quoted: bash expands ~ after ':' in an assignment
  printf '%s\n' "$s"
}
model_id() {  # engine model -> the name clients use; a local file: its file name without .gguf
  local t=$2
  if [[ $2 == /* ]]; then t=${2##*/}; t=${t%.[gG][gG][uU][fF]}; t=${t%-00001-of-*}; fi
  printf '%s\n' "$t"
}
# parse_spec RAW [ENGINE] -> R_ENGINE R_MODEL R_SPEC, or R_ERR and status 1
R_ENGINE="" R_MODEL="" R_SPEC="" R_ERR=""
parse_spec() {
  local s=$1 want=${2-} e="" m
  s=${s#"${s%%[![:space:]]*}"}; s=${s%"${s##*[![:space:]]}"}   # pasted spaces
  [[ $s == :* ]] && s=${s#:}   # ":model" = the default engine
  local fe="" fp=$s
  case $s in llama:*|vllm:*|ollama:*) fe=${s%%:*} fp=${s#*:} ;; esac
  # shellcheck disable=SC2088   # a literal ~/ (as written in the menu file), expanded below
  if [[ $fp == /* || $fp == '~/'* || $fp == ./* || $fp == ../* || ( ${fp,,} == *.gguf && $fp != *:* && -e $fp ) ]]; then   # a GGUF file on this computer
    # shellcheck disable=SC2088
    [[ $fp == '~/'* ]] && fp=$HOME/${fp#'~/'}
    [[ $fp == /* ]] || fp=$PWD/$fp
    fp=$(realpath -s -m -- "$fp")
    [[ ${fp,,} == *.gguf ]] || { R_ERR="'$s': a model file must be a GGUF (.gguf); other formats come from Hugging Face"; return 1; }
    [[ $fp =~ ^/[^[:space:]:]+$ ]] || { R_ERR="'$fp': the path must not contain spaces or ':'. Rename the file or its folder, or link to it from a path without them"; return 1; }
    [[ -z $fe || $fe == llama ]] || { R_ERR="'$s': a GGUF file on this computer is served by llama.cpp: use llama:$fp"; return 1; }
    [[ -n $want && $want != llama ]] && { R_ERR="'$s': a GGUF file on this computer is served by llama.cpp, not $want"; return 1; }
    R_ENGINE=llama R_MODEL=$fp R_SPEC=llama:$fp; return 0
  fi
  case $s in
    llama:*|vllm:*|ollama:*) e=${s%%:*}; m=${s#*:} ;;
    *) m=$s ;;
  esac
  if [[ -z $e && $s =~ ^([A-Za-z0-9_-]+):[^/]*/ ]]; then   # "vlm:Qwen/..." : a mistyped engine
    R_ERR="'$s' is not a model name: '${BASH_REMATCH[1]}' is not an engine (use llama, vllm or ollama, or leave it out)"; return 1
  fi
  if [[ ! $m =~ ^[A-Za-z0-9][A-Za-z0-9._/:@-]*$ || $m == *..* ]]; then
    R_ERR="'$s' is not a model name. Use [engine:]owner/model, for example Qwen/Qwen3-8B, vllm:Qwen/Qwen3-8B or llama:unsloth/Qwen3-8B-GGUF:Q4_K_M"; return 1
  fi
  if [[ -z $e ]]; then
    if [[ -n $want ]]; then e=$want
    elif [[ $m == hf.co/* || $m == huggingface.co/* ]]; then e=ollama
    elif [[ $m != */* ]]; then
      # a bare name can only be an Ollama library model
      engine_enabled ollama || { R_ERR="'$s' is neither a menu number nor a Hugging Face repo, and Ollama (for library names) is not enabled"; return 1; }
      e=ollama
    elif [[ ${m,,} == *gguf* || ${m#*/} == *:* ]]; then
      if engine_enabled llama || ! engine_enabled ollama; then e=llama; else e=ollama; fi
    elif engine_enabled vllm; then e=vllm
    else e=${CFG[DEFAULT_ENGINE]:-vllm}
    fi
  fi
  case $e in
    llama)
      [[ $m =~ ^[^/:@]+/[^/:@]+(:[^/:@]+)?(@[^/:@]+)?$ ]] || { R_ERR="llama.cpp needs a Hugging Face GGUF repo[:quant][@commit], got '$m'"; return 1; } ;;
    vllm)
      [[ $m =~ ^[^/:@]+/[^/:@]+(@[^/:@]+)?$ ]] || { R_ERR="vLLM needs a Hugging Face repo[@revision], got '$m'"; return 1; } ;;
    ollama)
      # a bare Hugging Face GGUF repo is pulled through Ollama's hf.co/ namespace
      if [[ $m =~ ^[^/:]+/[^/:]+(:[^/:]+)?$ && ${m,,} == *gguf* ]]; then m=hf.co/$m; fi
      [[ $m != *@* ]] || { R_ERR="Ollama models take a :tag, not an @revision: '$m'"; return 1; } ;;
    *) R_ERR="unknown engine '$e' (llama, vllm or ollama)"; return 1 ;;
  esac
  R_ENGINE=$e R_MODEL=$m R_SPEC=$e:$m
}

specs=() extras=() spec_lines=() MENU_QUIET=0
load_models() {
  local line spec rest n=0
  specs=() extras=() spec_lines=()
  [[ -r $models_file ]] || return 0
  while IFS= read -r line || [[ -n $line ]]; do
    n=$((n + 1))
    line=${line%%#*}
    line=${line#"${line%%[![:space:]]*}"}; line=${line%"${line##*[![:space:]]}"}
    [[ -n $line ]] || continue
    spec=${line%%[[:space:]]*}; rest=${line#"$spec"}; rest=${rest#"${rest%%[![:space:]]*}"}
    if parse_spec "$spec"; then specs+=("$R_SPEC"); extras+=("$rest"); spec_lines+=("$n")
    else ((MENU_QUIET)) || warn "skipping line $n of $models_file: $R_ERR ('$PROG model edit' corrects it)"; fi
  done < "$models_file"
}

# ---- Hugging Face cache ------------------------------------------------------
hf_repo_dir() {  # repo -> its hub cache dir; repo names are case-insensitive on the Hub
  local want="models--${1//\//--}" d b
  if [[ -d $hub/$want ]]; then printf '%s\n' "$hub/$want"; return 0; fi
  for d in "$hub"/models--*; do
    b=${d##*/}
    if [[ -d $d && ${b,,} == "${want,,}" ]]; then printf '%s\n' "$d"; return 0; fi
  done
  return 1
}
llama_files() {  # repo[:quant] -> NUL-separated GGUFs of that quant (plus mmproj), any depth; a local file: its parts
  local repo=${1%%:*} quant="" dir f b
  if [[ $1 == /* ]]; then
    if [[ ${1##*/} =~ ^(.*)-00001-of-([0-9]{5})\.gguf$ ]]; then
      for ((f = 1; f <= 10#${BASH_REMATCH[2]}; f++)); do printf '%s/%s-%05d-of-%s.gguf\0' "${1%/*}" "${BASH_REMATCH[1]}" "$f" "${BASH_REMATCH[2]}"; done
    else printf '%s\0' "$1"; fi
    return 0
  fi
  if [[ $1 == *:* ]]; then quant=${1#*:}; quant=${quant%%@*}; quant=${quant,,}; fi
  dir=$(hf_repo_dir "$repo") || return 0
  while IFS= read -r -d '' f; do
    b=${f##*/}; b=${b,,}
    if [[ -z $quant || $b == *"$quant"* || $b == *mmproj* ]]; then printf '%s\0' "$f"; fi
  done < <(find "$dir/snapshots" -name '*.gguf' -print0 2>/dev/null | sort -z)
}
vllm_snapshot() {  # repo[@rev] -> snapshot dir of that revision
  local repo=${1%%@*} rev=main dir commit
  if [[ $1 == *@* ]]; then rev=${1#*@}; fi
  dir=$(hf_repo_dir "$repo") || return 1
  if [[ -r $dir/refs/$rev ]]; then commit=$(<"$dir/refs/$rev"); else commit=$rev; fi
  [[ -d $dir/snapshots/$commit ]] || return 1
  printf '%s\n' "$dir/snapshots/$commit"
}
vllm_files() {
  local snap
  snap=$(vllm_snapshot "$1") || return 0
  find "$snap" \( -type l -o -type f \) -print0 2>/dev/null | sort -z
}

# ---- Ollama helpers ----------------------------------------------------------
hostport() { if [[ $1 == *:* ]]; then printf '[%s]:%s' "$1" "$2"; else printf '%s:%s' "$1" "$2"; fi; }
connect_host() {  # where a local client reaches a server bound to $1
  case $1 in
    0.0.0.0|"") echo 127.0.0.1 ;;
    ::) echo '[::1]' ;;
    *:*) echo "[$1]" ;;
    *) echo "$1" ;;
  esac
}
lcurl() { curl -fsS --noproxy '*' "$@"; }  # local servers must never go through a proxy
ollama_manifest() {  # model -> manifest path in the local store
  local m=$1 tag=latest root=${OLLAMA_MODELS:-$HOME/.ollama/models}/manifests last=${1##*/}
  if [[ $last == *:* ]]; then tag=${last##*:}; m=${m%:*}; fi
  case $m in
    */*/*) ;;
    */*) m=registry.ollama.ai/$m ;;
    *) m=registry.ollama.ai/library/$m ;;
  esac
  printf '%s\n' "$root/$m/$tag"
}
ollama_preload() {  # addr model -> load it with the configured context and keep-alive
  local ka=${CFG[OLLAMA_KEEP_ALIVE]} body
  [[ $ka =~ ^-?[0-9]+$ ]] || ka="\"$ka\""
  body="{\"model\":\"$2\",\"keep_alive\":$ka"
  if [[ $CTX != auto ]]; then body+=",\"options\":{\"num_ctx\":$CTX}"; fi
  lcurl -o /dev/null --max-time "${CFG[READY_TIMEOUT]}" -H 'Content-Type: application/json' \
    -d "$body}" "http://$1/api/generate"
}
ollama_unload_all() {  # addr [keep-model] -> unload everything else the daemon has loaded
  local ps name
  ps=$(lcurl --max-time 5 "http://$1/api/ps" 2>/dev/null) || return 0
  ps=${ps//\": /\":}
  while IFS= read -r name; do
    name=${name#\"name\":\"}; name=${name%\"}
    if [[ -n $name && $name != "${2-}" ]]; then
      info "unloading $name from the Ollama daemon at $1"
      lcurl -o /dev/null --max-time 30 -H 'Content-Type: application/json' \
        -d "{\"model\":\"$name\",\"keep_alive\":0}" "http://$1/api/generate" 2>/dev/null || true
    fi
  done < <(grep -o '"name":"[^"]*"' <<<"$ps" || true)
}

# ---- processes ---------------------------------------------------------------
proc_field() {  # pid index -> field of /proc/pid/stat after the command name (0 = state)
  local s f
  s=$(cat "/proc/$1/stat" 2>/dev/null) || return 1
  read -ra f <<<"${s##*) }"
  printf '%s\n' "${f[$2]-}"
}
pid_alive() { local st; st=$(proc_field "$1" 0) && [[ -n $st && $st != Z ]]; }
pid_starttime() { proc_field "$1" 19; }
engine_of_pid() {  # pid -> llama|vllm|ollama when it is one of the servers we manage
  local a=() i=0 name
  mapfile -d '' -t a 2>/dev/null < "/proc/$1/cmdline" || return 1
  ((${#a[@]})) || return 1
  if [[ ${a[0]##*/} =~ ^(python[0-9.]*|bash|sh|dash|env|uv)$ ]]; then
    if [[ ${a[1]-} == -m && ${a[2]-} == vllm.entrypoints.openai.api_server ]]; then echo vllm; return 0; fi
    i=1
  fi
  name=${a[i]-}; name=${name##*/}
  case $name in
    llama-server) echo llama ;;
    llama) [[ ${a[i + 1]-} == serve ]] && echo llama ;;
    vllm) [[ ${a[i + 1]-} == serve ]] && echo vllm ;;
    ollama) [[ ${a[i + 1]-} == serve ]] && echo ollama ;;
    *) return 1 ;;
  esac
}
engine_root() {  # pid -> "pid engine" for it or its nearest ancestor that is such a server
  local p=$1 e i
  for i in 1 2 3 4 5; do
    [[ $p =~ ^[0-9]+$ ]] && ((p > 1)) || return 1
    [[ -O /proc/$p ]] || return 1
    if e=$(engine_of_pid "$p"); then
      local pp a0=""
      pp=$(proc_field "$p" 1) && { IFS= read -r -d '' a0 < "/proc/$pp/cmdline" || true; }
      [[ ${a0##*/} == bwrap ]] && p=$pp   # a sandboxed server: bubblewrap leads its process group
      printf '%s %s\n' "$p" "$e"; return 0
    fi
    p=$(proc_field "$p" 1) || return 1
  done
  return 1
}
port_in_use() { (exec 3<>"/dev/tcp/127.0.0.1/$1") 2>/dev/null; }
port_owner() {  # port -> listening pid; status 1 = free, 2 = in use by a process we cannot see
  local out="" pid=""
  if have ss; then
    out=$(ss -H -tlnp "sport = :$1" 2>/dev/null || true)
    if [[ $out =~ pid=([0-9]+) ]]; then pid=${BASH_REMATCH[1]}; fi
  elif have lsof; then
    out=$(lsof -nP -iTCP:"$1" -sTCP:LISTEN -t 2>/dev/null || true)
    pid=${out%%$'\n'*}
  fi
  if [[ -z $pid ]]; then
    if [[ -n $out ]] || port_in_use "$1"; then return 2; fi
    return 1
  fi
  printf '%s\n' "$pid"
}
stop_pid() {  # pid group(1|0): SIGTERM, wait STOP_TIMEOUT, then SIGKILL
  local pid=$1 target=$1 i n=$((CFG[STOP_TIMEOUT] * 5))
  if (($2)); then target=-$1; fi
  pid_alive "$pid" || return 0
  kill -TERM -- "$target" 2>/dev/null || kill -TERM -- "$pid" 2>/dev/null || true
  for ((i = 0; i < n; i++)); do pid_alive "$pid" || break; sleep 0.2; done
  if pid_alive "$pid"; then
    warn "pid $pid did not exit within ${CFG[STOP_TIMEOUT]}s of SIGTERM; sending SIGKILL"
    kill -KILL -- "$target" 2>/dev/null || kill -KILL -- "$pid" 2>/dev/null || true
    for ((i = 0; i < 25; i++)); do pid_alive "$pid" || break; sleep 0.2; done
  fi
  if (($2)); then kill -KILL -- "$target" 2>/dev/null || true; fi  # stragglers in its group
  ! pid_alive "$pid"
}


